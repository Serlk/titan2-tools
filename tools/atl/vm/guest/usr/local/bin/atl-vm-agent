# Command agent inside the niri session (spawn-at-startup): runs /host/cmd/*.sh in order, writes
# NAME.out (stdout+stderr) and NAME.rc; the host side (scripts/atl-vm.sh cmd) waits for the .rc.
set -u
cd /home/atl
env >/host/out/session.env
echo "agent up $(date -u +%FT%TZ) WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}" >/host/out/agent.log
while :; do
	for f in /host/cmd/*.sh; do
		[ -e "$f" ] || break
		b=${f%.sh}
		mv "$f" "$b.run" 2>/dev/null || continue
		echo "run $(basename "$b") $(date -u +%T)" >>/host/out/agent.log
		sh "$b.run" >"$b.out" 2>&1
		echo $? >"$b.rc"
	done
	sleep 1
done
