[Desktop Entry]
Type=Application
Name=Install Android app
Name[ru]=Установить Android-приложение
Exec=/usr/local/bin/atl-open-apk %F
Icon=application-vnd.android.package-archive
MimeType=application/vnd.android.package-archive;
NoDisplay=true
Terminal=false
