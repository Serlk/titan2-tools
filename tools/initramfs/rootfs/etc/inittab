# busybox init for the Titan 2 initramfs (/init -> /etc/t2/init -> busybox init)
::sysinit:/etc/t2/rc.init
::respawn:/etc/t2/monitor
::respawn:/etc/t2/dropbear
::respawn:/etc/t2/udhcpd
::respawn:/etc/t2/serial-getty
::ctrlaltdel:/sbin/reboot
::shutdown:/bin/sync
# t2-reboot <mode> (reboot bootloader/recovery): last, after sync
::shutdown:/usr/lib/t2/reboot-mode
