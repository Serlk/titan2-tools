# Login over USB serial (physical cable): root shell after Enter. Pressing Enter
# counts as a session and disarms the automatic reboot (/etc/t2/monitor).
echo
echo "Titan 2 mainline initramfs (ttyGS0). Press Enter for a root shell."
read -r _
: >/run/t2-session
echo "<5>titan2-initramfs: serial: session on ttyGS0" >/dev/kmsg
exec /bin/sh -l
