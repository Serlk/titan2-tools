#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
# sysinit for busybox init (/init -> busybox). Mounts only pseudo file systems; block
# devices are never mounted (see /etc/t2/lib.sh).
# With a t2.root= (/etc/t2/init) this script is run before busybox init; if the root could not
# be attached, busybox init runs it once more, and the second pass does nothing.
[ -e /run/t2-sysinit-done ] && exit 0
/bin/busybox mountpoint -q /proc || /bin/busybox mount -t proc -o nosuid,nodev,noexec proc /proc
# applet links; existing files (the /bin/mount wrapper) are not replaced
/bin/busybox --install -s 2>/dev/null
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

. /etc/t2/lib.sh
# markers in /dev/kmsg must not be lost to the rate limit (10 lines / 5 s)
echo on >/proc/sys/kernel/printk_devkmsg 2>/dev/null

t2_log "init: userspace up ($(cut -d' ' -f1 /proc/uptime)s)"

# Read-only for the UFS: first new devices (hotplug), then the ones already there.
[ -w /proc/sys/kernel/hotplug ] && echo /sbin/t2-hotplug >/proc/sys/kernel/hotplug ||
	t2_log "init: no uevent helper, read-only only by polling"
t2_ro_sweep

hostname -F /etc/hostname
ip link set lo up

# stubs for dropbear (we do not need utmp through utmpd)
mkdir -p /run/dropbear /var/log /var/run /var/lib/udhcpd
: >/var/log/lastlog

# the USB gadget is set up in the background: it waits for the UDC and does not hold up
# getty/dropbear
/etc/t2/usb-gadget </dev/null >/dev/null 2>&1 &

t2_screen "titan2: mainline initramfs up, USB gadget starting (serial $(t2_serial))"
# without t2.root= the initramfs is the system: read-only lock right away (with t2.root= it is
# set by /etc/t2/init after the root is attached: diskroot still has to open the root partition)
t2_cmdline root >/dev/null || t2_ro_lock
: >/run/t2-sysinit-done
exit 0
