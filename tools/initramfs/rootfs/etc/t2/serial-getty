# getty on ttyGS0 (ACM), respawned from inittab; waits until the gadget creates the tty.
while [ ! -c /dev/ttyGS0 ]; do sleep 1; done
exec /sbin/getty -n -l /etc/t2/serial-login 115200 ttyGS0 vt100
