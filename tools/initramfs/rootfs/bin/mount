#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (c) 2026 serlk <22211586+Serlk@users.noreply.github.com>
# mount wrapper (Titan 2 initramfs). SAFETY: block devices are mounted ONLY
# read-only (forced -o ro), rw/remount,rw are refused, partitions listed in T2_PROTECTED
# (nvdata, nvram, persist, userdata, ...) are never mounted. Pseudo filesystems are passed through.
# This is the second line of defence: all block devices are already marked read-only (BLKROSET).
. /etc/t2/lib.sh

die() { echo "mount: $*" >&2; t2_log "mount refused: $*"; exit 1; }

blk=
for a in "$@"; do
	case "$a" in
	/dev/*|UUID=*|LABEL=*|PARTLABEL=*|PARTUUID=*) blk=$a ;;
	esac
	case ",$a," in
	*,rw,*|*,remount,*) [ "$a" = "${a#-}" ] && die "rw/remount is not allowed here ($a)" ;;
	esac
	case "$a" in
	-w|--rw|--read-write) die "rw is not allowed here" ;;
	esac
done
# no arguments (listing) or no block device: plain mount
if [ -z "$blk" ]; then
	case " $* " in
	*" -a "*|*" --all "*) die "mount -a is not allowed here" ;;
	esac
	exec /bin/busybox mount "$@"
fi
case "$blk" in
/dev/*)
	dev=$(readlink -f "$blk")
	n=${dev##*/}
	pn=$(sed -n 's/^PARTNAME=//p' "/sys/class/block/$n/uevent" 2>/dev/null)
	for p in $T2_PROTECTED; do
		[ "$pn" = "$p" ] && die "partition $pn ($dev) is protected"
	done
	blockdev --setro "$dev" 2>/dev/null
	;;
*) die "only /dev/<node> is accepted here ($blk)" ;;
esac
exec /bin/busybox mount -r -o ro "$@"
