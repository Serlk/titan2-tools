#
# ModemManager port tags for the MediaTek MT6878 integrated modem behind the
# mtk_ccci WWAN driver (platform driver "mtk-ccci-md", device d180000.mddriver
# on the Unihertz Titan 2). The driver creates the ports when the modem is
# READY: wwan0at0 (AT), wwan0mipc0..9 (MIPC), and the data links wwan0-N on
# request ("ip link add ... type wwan linkid N", done by the bearer).
#
# do not edit this file, it will be overwritten on update

ACTION!="add|change|move|bind", GOTO="mm_mtk_ccci_end"

# only the wwan ports and the net links of the CCCI modem
SUBSYSTEM=="wwan", DRIVERS=="mtk-ccci-md", GOTO="mm_mtk_ccci_process"
SUBSYSTEM=="net",  DRIVERS=="mtk-ccci-md", GOTO="mm_mtk_ccci_process"
GOTO="mm_mtk_ccci_end"

LABEL="mm_mtk_ccci_process"

# the plugin claims ports with this tag; one physdev for all of them
ENV{ID_MM_MTK_CCCI}="1"
ENV{ID_MM_PHYSDEV_UID}="mtk-ccci"

# the AT port (CCCI UART2) is the primary control port
SUBSYSTEM=="wwan", KERNEL=="wwan*at0", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"

# plugin configuration, read from the AT port:
#   ID_MM_MTK_CCCI_IMS            default enabled; 0 allows a data/CS-only test
#   ID_MM_MTK_CCCI_DATA_APN       optional internet APN before attach; else CGDCONT?
#   ID_MM_MTK_CCCI_IMS_APN        default ims
#   ID_MM_MTK_CCCI_SOS_APN        default sos
# User overrides belong in a later 78-mm/79-mm rule, not in this package file.
#   ID_MM_MTK_CCCI_RADIO_MASK     AT+EFUN=<mask>: 1 SIM1, 2 SIM2, 3 both (default 3)
#   ID_MM_MTK_CCCI_SIM_SLOT       SIM protocol stack on the AT port and MIPC slot, 1 or 2 (default 1)
#   ID_MM_MTK_CCCI_SPEECHD_SOCKET t2-speechd control socket for the voice audio path
#                                 (default /run/t2-speechd.sock; "" disables the trigger)
SUBSYSTEM=="wwan", KERNEL=="wwan*at0", ENV{ID_MM_MTK_CCCI_RADIO_MASK}="3"
SUBSYSTEM=="wwan", KERNEL=="wwan*at0", ENV{ID_MM_MTK_CCCI_SIM_SLOT}="1"
SUBSYSTEM=="wwan", KERNEL=="wwan*at0", ENV{ID_MM_MTK_CCCI_SPEECHD_SOCKET}="/run/t2-speechd.sock"

# the MIPC channel the factory software activates data on; the other MIPC
# channels are not used by ModemManager
SUBSYSTEM=="wwan", KERNEL=="wwan*mipc1", ENV{ID_MM_MTK_CCCI_MIPC_DATA}="1"
SUBSYSTEM=="wwan", KERNEL=="wwan*mipc*", ENV{ID_MM_MTK_CCCI_MIPC_DATA}!="1", ENV{ID_MM_PORT_IGNORE}="1"

# the wwan ports are candidates (80-mm-candidate.rules does the same)
SUBSYSTEM=="wwan", ENV{ID_MM_CANDIDATE}="1"

LABEL="mm_mtk_ccci_end"
