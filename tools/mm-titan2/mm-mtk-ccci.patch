+
+gchar *
+mm_mtk_ccci_clcc_normalize (const gchar *response)
+{
+    g_autoptr(GRegex) regex = NULL;
+    gchar            *out;
+
+    if (!response)
+        return NULL;
+
+    /* +CLCC: <id>,<dir>,<stat>,<mode>, ... with <mode> 20..25; observed on the
+     * phone: "+CLCC: 1,0,2,20,0,"+7...",145" for a dialing VoLTE call */
+    regex = g_regex_new ("(\\+CLCC:\\s*\\d+,\\s*\\d+,\\s*\\d+,\\s*)(2[0-5])(\\s*,)",
+                         G_REGEX_RAW | G_REGEX_MULTILINE, 0, NULL);
+    g_assert (regex);
+    out = g_regex_replace (regex, response, -1, 0, "\\g<1>0\\g<3>", 0, NULL);
+    return out ? out : g_strdup (response);
+}
+
+/* speechd is a stream, not one read per response. */
+gint
+mm_mtk_ccci_speech_reply_feed (gchar **reply, const guint8 *data, gsize len, GError **error)
+{
+    gsize previous = *reply ? strlen (*reply) : 0;
+    if (len > 4096 || previous > 4096 - len || (len && memchr (data, 0, len))) {
+        g_set_error_literal (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT, "Invalid or oversized speechd reply");
+        return -1;
+    }
+    *reply = g_realloc (*reply, previous + len + 1);
+    if (len)
+        memcpy (*reply + previous, data, len);
+    (*reply)[previous + len] = 0;
+    if (len && (g_str_equal (*reply, "ok\n") || g_str_has_suffix (*reply, "\nok\n")))
+        return 1;
+    if (!len || strstr (*reply, "error:")) {
+        g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT,
+                     "speechd: %s", (*reply)[0] ? *reply : "no reply");
+        return -1;
+    }
+    return 0;
+}
+
+guint mm_mtk_ccci_call_index (guint8 slot, guint id)
+{
+    if ((slot != 1 && slot != 2) || id < 1 || id > 7)
+        return 0;
+    return id + (slot == 2 ? 100 : 0);
+}
+
+gboolean mm_mtk_ccci_call_parse (guint8 slot, const guint8 *payload, gsize len, MMCallInfo *info)
+{
+    guint32 id, event, dir;
+    memset (info, 0, sizeof (*info));
+    if (!mm_mipc_tlv_find_uint (payload, len, 0x0100, &id) ||
+        !mm_mipc_tlv_find_uint (payload, len, 0x0109, &event) ||
+        !(info->index = mm_mtk_ccci_call_index (slot, id)))
+        return FALSE;
+    if (mm_mipc_tlv_find_uint (payload, len, 0x0101, &dir) && dir <= 1)
+        info->direction = dir ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+    switch (event) {
+    case 0: info->state = MM_CALL_STATE_RINGING_IN; info->direction = MM_CALL_DIRECTION_INCOMING; break;
+    case 2: info->state = MM_CALL_STATE_RINGING_OUT; info->direction = MM_CALL_DIRECTION_OUTGOING; break;
+    case 6: info->state = MM_CALL_STATE_ACTIVE; break;
+    case 130: info->state = MM_CALL_STATE_DIALING; info->direction = MM_CALL_DIRECTION_OUTGOING; break;
+    case 133: info->state = MM_CALL_STATE_TERMINATED; break;
+    default: return FALSE;
+    }
+    info->number = mm_mipc_tlv_find_str (payload, len, 0x8104);
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* RAT mode */
+
+#define RAT_BIT_GSM  0x01
+#define RAT_BIT_UMTS 0x02
+#define RAT_BIT_LTE  0x04
+#define RAT_BIT_C2K  0x08
+#define RAT_BIT_NR   0x10
+
+#define MODES_2345 (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G | MM_MODEM_MODE_5G)
+
+typedef struct {
+    MMModemMode allowed;
+    MMModemMode preferred;
+    guint8      rat;
+    guint8      prefer;
+} RatMode;
+
+/* offered combinations, most useful first; the rat values follow the mask
+ * rule above. Entries 0 (NR first, 22/128), 1 (LTE first, 6/4) and 4 (LTE
+ * only, 3/0) are the documented pairs for a normal SIM; the LTE-first
+ * pair used to be sent as 6/3, which the modem rejected (result 2). */
+#define RAT_MODE_NR_FIRST  0
+#define RAT_MODE_LTE_FIRST 1
+static const RatMode rat_modes[] = {
+    { MODES_2345, MM_MODEM_MODE_5G, MM_MTK_CCCI_RAT_STOCK_DEFAULT, MM_MTK_CCCI_RAT_PREFER_STOCK },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G, MM_MODEM_MODE_4G,
+      MM_MTK_CCCI_RAT_GSM_UMTS_LTE, MM_MTK_CCCI_RAT_PREFER_LTE },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G, MM_MODEM_MODE_NONE, 6, 0 },
+    { MM_MODEM_MODE_4G | MM_MODEM_MODE_5G, MM_MODEM_MODE_NONE, 19, 0 },
+    { MM_MODEM_MODE_4G,                    MM_MODEM_MODE_NONE,  MM_MTK_CCCI_RAT_LTE_ONLY, 0 },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G, MM_MODEM_MODE_3G,    2, 2 },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G, MM_MODEM_MODE_NONE,  2, 0 },
+    { MM_MODEM_MODE_3G,                    MM_MODEM_MODE_NONE,  1, 0 },
+    { MM_MODEM_MODE_2G,                    MM_MODEM_MODE_NONE,  0, 0 },
+};
+
+static MMModemMode
+rat_mask_normalize (MMModemMode mask)
+{
+    mask &= MODES_2345;
+    /* nothing usable reported: the 2G/3G/4G modem every MT6878 is */
+    return mask ? mask : (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G);
+}
+
+GArray *
+mm_mtk_ccci_rat_build_combinations (MMModemMode mask)
+{
+    GArray *combinations = g_array_new (FALSE, FALSE, sizeof (MMModemModeCombination));
+    guint   i;
+
+    mask = rat_mask_normalize (mask);
+    for (i = 0; i < G_N_ELEMENTS (rat_modes); i++) {
+        MMModemModeCombination mode;
+
+        if ((rat_modes[i].allowed & mask) != rat_modes[i].allowed)
+            continue;
+        mode.allowed = rat_modes[i].allowed;
+        mode.preferred = rat_modes[i].preferred;
+        g_array_append_val (combinations, mode);
+    }
+    return combinations;
+}
+
+void
+mm_mtk_ccci_rat_default (MMModemMode *allowed, MMModemMode *preferred)
+{
+    /* the modem's automatic mode (22/128), whatever the generic probing of
+     * the AT port reported: that probing only finds 5G when +C5GREG=? or an
+     * NR value of +WS46=? answers in time, and an LTE-first default from it
+     * left both slots without NR (2026-11-24) */
+    *allowed = rat_modes[RAT_MODE_NR_FIRST].allowed;
+    *preferred = rat_modes[RAT_MODE_NR_FIRST].preferred;
+}
+
+gboolean
+mm_mtk_ccci_rat_fallback (MMModemMode mask, guint8 rejected_rat, guint8 rejected_prefer,
+                          MMModemMode *allowed, MMModemMode *preferred)
+{
+    static const guint candidates[] = { RAT_MODE_NR_FIRST, RAT_MODE_LTE_FIRST };
+    guint i;
+
+    /* the same mask rule as mm_mtk_ccci_rat_from_modes () */
+    mask = (mask & MODES_2345) ? rat_mask_normalize (mask) : MODES_2345;
+    for (i = 0; i < G_N_ELEMENTS (candidates); i++) {
+        const RatMode *m = &rat_modes[candidates[i]];
+
+        if ((m->allowed & mask) != m->allowed)
+            continue;
+        /* never the rejected pair again under the name of a fallback */
+        if (m->rat == rejected_rat && m->prefer == rejected_prefer)
+            continue;
+        *allowed = m->allowed;
+        *preferred = m->preferred;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+gboolean
+mm_mtk_ccci_rat_from_modes (MMModemMode mask, MMModemMode allowed, MMModemMode preferred,
+                            guint8 *rat, guint8 *prefer)
+{
+    guint i;
+
+    if (allowed == MM_MODEM_MODE_ANY && preferred == MM_MODEM_MODE_NONE) {
+        /* the automatic mode is offered independent of @mask */
+        *rat = rat_modes[RAT_MODE_NR_FIRST].rat;
+        *prefer = rat_modes[RAT_MODE_NR_FIRST].prefer;
+        return TRUE;
+    }
+    if (mask & MODES_2345)
+        mask = rat_mask_normalize (mask);
+    else
+        mask = MODES_2345;   /* not probed yet */
+    for (i = 0; i < G_N_ELEMENTS (rat_modes); i++) {
+        if (rat_modes[i].allowed != allowed || rat_modes[i].preferred != preferred ||
+            (allowed & mask) != allowed)
+            continue;
+        *rat = rat_modes[i].rat;
+        *prefer = rat_modes[i].prefer;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+gboolean
+mm_mtk_ccci_rat_to_modes (guint rat, guint prefer, MMModemMode *allowed, MMModemMode *preferred)
+{
+    guint bits;
+
+    if (rat > 30)
+        return FALSE;
+    bits = (rat + 1) & ~RAT_BIT_C2K;   /* C2K has no MM mode of its own here */
+    *allowed = MM_MODEM_MODE_NONE;
+    if (bits & RAT_BIT_GSM)
+        *allowed |= MM_MODEM_MODE_2G;
+    if (bits & RAT_BIT_UMTS)
+        *allowed |= MM_MODEM_MODE_3G;
+    if (bits & RAT_BIT_LTE)
+        *allowed |= MM_MODEM_MODE_4G;
+    if (bits & RAT_BIT_NR)
+        *allowed |= MM_MODEM_MODE_5G;
+    if (*allowed == MM_MODEM_MODE_NONE)
+        return FALSE;
+
+    /* decoded from the pair alone (no cache): the same values as encoded */
+    switch (prefer) {
+    case 1:  *preferred = MM_MODEM_MODE_2G; break;
+    case 2:  *preferred = MM_MODEM_MODE_3G; break;
+    case MM_MTK_CCCI_RAT_PREFER_LTE: *preferred = MM_MODEM_MODE_4G; break;
+    case MM_MTK_CCCI_RAT_PREFER_STOCK:
+        *preferred = (*allowed & MM_MODEM_MODE_5G) ? MM_MODEM_MODE_5G : MM_MODEM_MODE_4G;
+        break;
+    default: *preferred = MM_MODEM_MODE_NONE; break;
+    }
+    /* a preference outside the allowed set or a lone allowed mode: none */
+    if (!(*preferred & *allowed) || *preferred == *allowed)
+        *preferred = MM_MODEM_MODE_NONE;
+    return TRUE;
+}
+
+gboolean
+mm_mtk_ccci_parse_erat (const gchar *reply, guint *curr_rat, guint *rat, guint *prefer)
+{
+    g_autoptr(GRegex)     regex = NULL;
+    g_autoptr(GMatchInfo) match = NULL;
+
+    if (!reply)
+        return FALSE;
+    regex = g_regex_new ("\\+ERAT:\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)",
+                         G_REGEX_RAW, 0, NULL);
+    g_assert (regex);
+    if (!g_regex_match (regex, reply, 0, &match))
+        return FALSE;
+    return mm_get_uint_from_match_info (match, 1, curr_rat) &&
+           mm_get_uint_from_match_info (match, 3, rat) &&
+           mm_get_uint_from_match_info (match, 4, prefer);
+}
+
+/*****************************************************************************/
+/* LTE loss diagnostics */
+
+gchar *
+mm_mtk_ccci_trace_stamp (void)
+{
+    struct timespec mono = { 0 }, boot = { 0 };
+
+    clock_gettime (CLOCK_MONOTONIC, &mono);
+    clock_gettime (CLOCK_BOOTTIME, &boot);
+    return g_strdup_printf ("mono %ld.%03ld boot %ld.%03ld",
+                            (long) mono.tv_sec, (long) (mono.tv_nsec / 1000000),
+                            (long) boot.tv_sec, (long) (boot.tv_nsec / 1000000));
+}
+
+gchar *
+mm_mtk_ccci_at_one_line (const gchar *text)
+{
+    GString     *s = g_string_new (NULL);
+    gboolean     sep = FALSE;
+    const gchar *c;
+
+    for (c = text ? text : ""; *c; c++) {
+        if (*c == '\r' || *c == '\n') {
+            sep = TRUE;
+            continue;
+        }
+        if (sep && s->len)
+            g_string_append (s, " | ");
+        sep = FALSE;
+        g_string_append_c (s, *c);
+    }
+    return g_string_free (s, FALSE);
+}
+
+/* 3GPP TS 27.007 §7.2 (+CREG), §10.1.20 (+CGREG), §10.1.22 (+CEREG): after
+ * the <n> of the read response, <stat>, two location fields, <AcT>, then
+ * (+CGREG: after <rac>) <cause_type>,<reject_cause> when reporting level 3
+ * or higher gives them */
+static const struct {
+    const gchar *prefix;
+    const gchar *domain;
+    guint        cause_index;   /* of <cause_type>, counted from <stat> */
+} reg_kinds[] = {
+    { "+CREG:",  "CS",  4 },
+    { "+CGREG:", "PS",  5 },
+    { "+CEREG:", "EPS", 4 },
+};
+
+/* comma-separated fields, commas inside quotes kept; spaces trimmed */
+static GPtrArray *
+split_fields (const gchar *s)
+{
+    GPtrArray *fields = g_ptr_array_new_with_free_func (g_free);
+    GString   *cur = g_string_new (NULL);
+    gboolean   quoted = FALSE;
+
+    for (; *s && *s != '\r' && *s != '\n'; s++) {
+        if (*s == '"')
+            quoted = !quoted;
+        if (*s == ',' && !quoted) {
+            g_ptr_array_add (fields, g_strstrip (g_string_free (cur, FALSE)));
+            cur = g_string_new (NULL);
+            continue;
+        }
+        g_string_append_c (cur, *s);
+    }
+    g_ptr_array_add (fields, g_strstrip (g_string_free (cur, FALSE)));
+    return fields;
+}
+
+static gint
+field_uint (GPtrArray *fields, guint i)
+{
+    guint64 v;
+
+    if (i >= fields->len || !*(const gchar *) g_ptr_array_index (fields, i) ||
+        !g_ascii_string_to_unsigned (g_ptr_array_index (fields, i), 10, 0, G_MAXINT, &v, NULL))
+        return -1;
+    return (gint) v;
+}
+
+gboolean
+mm_mtk_ccci_reg_parse (const gchar *line, gboolean solicited, MMMtkCcciReg *reg)
+{
+    g_autoptr(GPtrArray) fields = NULL;
+    guint                i, first;
+
+    memset (reg, 0, sizeof (*reg));
+    if (!line)
+        return FALSE;
+    while (g_ascii_isspace (*line))
+        line++;
+    for (i = 0; i < G_N_ELEMENTS (reg_kinds); i++)
+        if (g_str_has_prefix (line, reg_kinds[i].prefix))
+            break;
+    if (i == G_N_ELEMENTS (reg_kinds))
+        return FALSE;
+    fields = split_fields (line + strlen (reg_kinds[i].prefix));
+    first = solicited ? 1 : 0;
+    reg->domain = reg_kinds[i].domain;
+    reg->n = solicited ? field_uint (fields, 0) : -1;
+    reg->stat = field_uint (fields, first);
+    if (reg->stat < 0 || (solicited && reg->n < 0))
+        return FALSE;
+    reg->act = field_uint (fields, first + 3);
+    reg->cause_type = field_uint (fields, first + reg_kinds[i].cause_index);
+    reg->reject_cause = field_uint (fields, first + reg_kinds[i].cause_index + 1);
+    return TRUE;
+}
+
+static const gchar *
+reg_stat_name (gint stat)
+{
+    static const gchar *names[] = { "not registered", "home", "searching", "denied", "unknown", "roaming" };
+
+    return stat >= 0 && stat < (gint) G_N_ELEMENTS (names) ? names[stat] : "other";
+}
+
+gchar *
+mm_mtk_ccci_reg_describe (const MMMtkCcciReg *reg)
+{
+    GString *s = g_string_new (NULL);
+
+    g_string_append_printf (s, "%s stat %d (%s)", reg->domain, reg->stat, reg_stat_name (reg->stat));
+    if (reg->act >= 0)
+        g_string_append_printf (s, " AcT %d", reg->act);
+    else
+        g_string_append (s, " AcT not reported");
+    if (reg->cause_type >= 0 || reg->reject_cause >= 0)
+        g_string_append_printf (s, ", reject cause type %d code %d", reg->cause_type, reg->reject_cause);
+    else
+        g_string_append (s, ", reject cause not reported");
+    if (reg->n >= 0)
+        g_string_append_printf (s, " (n %d)", reg->n);
+    return g_string_free (s, FALSE);
+}
+
+gchar *
+mm_mtk_ccci_reg_describe_text (const gchar *text, gboolean solicited)
+{
+    g_auto(GStrv) lines = NULL;
+    GString      *s = NULL;
+    guint         i;
+
+    if (!text)
+        return NULL;
+    lines = g_strsplit_set (text, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        MMMtkCcciReg      reg;
+        g_autofree gchar *d = NULL;
+
+        if (!mm_mtk_ccci_reg_parse (lines[i], solicited, &reg))
+            continue;
+        d = mm_mtk_ccci_reg_describe (&reg);
+        if (!s)
+            s = g_string_new (d);
+        else
+            g_string_append_printf (s, "; %s", d);
+    }
+    return s ? g_string_free (s, FALSE) : NULL;
+}
+
+/*****************************************************************************/
+/* Registration lines into ModemManager's 3GPP state: the generic parser and
+ * regular expressions, as the generic code applies them to its own port */
+
+gboolean
+mm_mtk_ccci_reg_update_parse (const gchar *line, gboolean solicited, MMMtkCcciRegUpdate *u)
+{
+    static GPtrArray *regexes[2];
+    g_autofree gchar *text = NULL;
+    guint             i;
+
+    memset (u, 0, sizeof (*u));
+    if (!line)
+        return FALSE;
+    while (g_ascii_isspace (*line))
+        line++;
+    if (!g_str_has_prefix (line, "+CREG:") && !g_str_has_prefix (line, "+CGREG:") &&
+        !g_str_has_prefix (line, "+CEREG:") && !g_str_has_prefix (line, "+C5GREG:"))
+        return FALSE;
+    /* the level 3 form (cause fields) as the generic n <= 2 expressions read it */
+    text = mm_mtk_ccci_reg_strip_cause (line, solicited);
+    if (!text)   /* +C5GREG: as it is */
+        text = g_strndup (line, strcspn (line, "\r\n"));
+    g_strchomp (text);
+    if (!solicited) {
+        /* the unsolicited expressions want the line in its CR LF frame */
+        gchar *framed = g_strdup_printf ("\r\n%s\r\n", text);
+        g_free (text);
+        text = framed;
+    }
+    if (!regexes[solicited ? 1 : 0])
+        regexes[solicited ? 1 : 0] = mm_3gpp_creg_regex_get (solicited);
+    for (i = 0; i < regexes[solicited ? 1 : 0]->len; i++) {
+        g_autoptr(GMatchInfo) match = NULL;
+        gulong                lac = 0, ci = 0;
+
+        if (!g_regex_match (g_ptr_array_index (regexes[solicited ? 1 : 0], i), text, 0, &match))
+            continue;
+        if (!mm_3gpp_parse_creg_response (match, NULL, &u->state, &lac, &ci, &u->act,
+                                          &u->cgreg, &u->cereg, &u->c5greg, NULL))
+            return FALSE;
+        /* TS 27.007: +CEREG/+C5GREG, and +CREG with LTE AcT, carry the TAC */
+        if (u->cereg || u->c5greg || (!u->cgreg && u->act == MM_MODEM_ACCESS_TECHNOLOGY_LTE))
+            u->tac = lac;
+        else
+            u->lac = lac;
+        u->ci = ci;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+gboolean
+mm_mtk_ccci_cops_act (const gchar *reply, MMModemAccessTechnology *act)
+{
+    g_auto(GStrv) lines = NULL;
+    guint         i;
+
+    *act = MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN;
+    if (!reply)
+        return FALSE;
+    lines = g_strsplit_set (reply, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        guint mode = 0, format = 0;
+        g_autofree gchar *op = NULL;
+
+        if (!g_str_has_prefix (g_strstrip (lines[i]), "+COPS:"))
+            continue;
+        if (mm_3gpp_parse_cops_read_response (lines[i], &mode, &format, &op, act, NULL, NULL))
+            return *act != MM_MODEM_ACCESS_TECHNOLOGY_UNKNOWN;
+    }
+    return FALSE;
+}
+
+/*****************************************************************************/
+/* Registration reporting with causes */
+
+gboolean
+mm_mtk_ccci_test_range_has (const gchar *reply, const gchar *prefix, guint n)
+{
+    const gchar *p, *end;
+    g_auto(GStrv) items = NULL;
+    g_autofree gchar *list = NULL;
+    guint         i;
+
+    if (!reply || !prefix || !(p = strstr (reply, prefix)) || !(p = strchr (p, '(')) || !(end = strchr (p, ')')))
+        return FALSE;
+    list = g_strndup (p + 1, end - p - 1);
+    items = g_strsplit (list, ",", -1);
+    for (i = 0; items[i]; i++) {
+        guint64      lo, hi;
+        gchar       *dash = strchr (items[i], '-');
+
+        g_strstrip (items[i]);
+        if (dash) {
+            *dash = 0;
+            if (!g_ascii_string_to_unsigned (g_strstrip (items[i]), 10, 0, G_MAXUINT, &lo, NULL) ||
+                !g_ascii_string_to_unsigned (g_strstrip (dash + 1), 10, 0, G_MAXUINT, &hi, NULL))
+                continue;
+        } else if (g_ascii_string_to_unsigned (items[i], 10, 0, G_MAXUINT, &lo, NULL))
+            hi = lo;
+        else
+            continue;
+        if (n >= lo && n <= hi)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+gchar *
+mm_mtk_ccci_reg_strip_cause (const gchar *line, gboolean solicited)
+{
+    g_autoptr(GPtrArray) fields = NULL;
+    GString             *s;
+    guint                i, keep;
+
+    if (!line)
+        return NULL;
+    while (g_ascii_isspace (*line))
+        line++;
+    for (i = 0; i < G_N_ELEMENTS (reg_kinds); i++)
+        if (g_str_has_prefix (line, reg_kinds[i].prefix))
+            break;
+    if (i == G_N_ELEMENTS (reg_kinds))
+        return NULL;
+    fields = split_fields (line + strlen (reg_kinds[i].prefix));
+    /* <n>, <stat>, two location fields, <AcT> (+CGREG: and <rac>) */
+    keep = (solicited ? 1 : 0) + reg_kinds[i].cause_index;
+    if (fields->len <= keep)
+        return g_strndup (line, strcspn (line, "\r\n"));
+    g_ptr_array_set_size (fields, keep);
+    /* level 3 with nothing registered: empty location/AcT fields */
+    while (fields->len > (solicited ? 2u : 1u) && !*(const gchar *) g_ptr_array_index (fields, fields->len - 1))
+        g_ptr_array_set_size (fields, fields->len - 1);
+    s = g_string_new (reg_kinds[i].prefix);
+    g_string_append_c (s, ' ');
+    for (i = 0; i < fields->len; i++)
+        g_string_append_printf (s, "%s%s", i ? "," : "", (const gchar *) g_ptr_array_index (fields, i));
+    return g_string_free (s, FALSE);
+}
+
+/*****************************************************************************/
+/* Network diagnostics decoders */
+
+gboolean
+mm_mtk_ccci_nw_block_parse (const guint8 *p, gsize len, MMMtkCcciNwBlock *b)
+{
+    memset (b, 0, sizeof (*b));
+    if (!p || len < 24)
+        return FALSE;
+    b->stat = p[0];
+    memcpy (b->plmn, p + 1, 7);
+    b->plmn[7] = 0;
+    b->cell = mm_mipc_get (p + 8, 4);
+    b->earfcn = mm_mipc_get (p + 12, 4);
+    b->pci = mm_mipc_get (p + 16, 4);
+    b->tac = mm_mipc_get (p + 20, 4);
+    return TRUE;
+}
+
+gchar *
+mm_mtk_ccci_nw_block_describe (const MMMtkCcciNwBlock *b)
+{
+    g_autofree gchar *plmn = g_strndup (b->plmn, 7);
+    guint             i;
+
+    /* printable PLMN only */
+    for (i = 0; plmn[i]; i++)
+        if (!g_ascii_isprint (plmn[i]))
+            plmn[i] = '?';
+    return g_strdup_printf ("stat %u, PLMN '%s', cell 0x%08X, TAC 0x%04X, EARFCN %u (inferred offset), PCI %u (inferred offset)",
+                            b->stat, plmn, b->cell, b->tac, b->earfcn, b->pci);
+}
+
+gchar *
+mm_mtk_ccci_cscon_describe (const guint8 *v, gsize len)
+{
+    GString *s = g_string_new (NULL);
+    gsize    i;
+
+    for (i = 0; v && i < len; i++)
+        g_string_append_printf (s, "%s%02x", i ? " " : "", v[i]);
+    if (!v || !len)
+        g_string_append (s, "(absent)");
+    else if (v[0] == 1)
+        g_string_append (s, " (byte 0 = 1: connected, as the documented LTE example 01 07 04 00)");
+    else if (v[0] == 0)
+        g_string_append (s, " (byte 0 = 0: idle, as the documented examples 00 ff ..)");
+    else
+        g_string_append (s, " (byte 0 not in the documented examples)");
+    return g_string_free (s, FALSE);
+}
diff --git a/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h b/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h
new file mode 100644
index 00000000..b2825a6a
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h
@@ -0,0 +1,145 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Response helpers of the mtk-ccci plugin (pure string handling, unit tested).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_MODEM_HELPERS_MTK_CCCI_H
+#define MM_MODEM_HELPERS_MTK_CCCI_H
+
+#include <glib.h>
+#include "mm-modem-helpers.h"
+
+G_BEGIN_DECLS
+
+/* +CLCC <mode> values of IMS (VoLTE) calls on this modem: 20 voice, 21 video, 22/23 conference host, 24/25 participant */
+#define MM_MTK_CCCI_CLCC_MODE_IMS_FIRST 20
+#define MM_MTK_CCCI_CLCC_MODE_IMS_LAST  25
+
+/* Rewrites the <mode> field of every "+CLCC: <id>,<dir>,<stat>,<mode>,..."
+ * line from 20..25 to 0 so that ModemManager's generic +CLCC parser, which
+ * accepts voice calls (mode 0) only, lists the IMS calls too. Everything else
+ * is returned unchanged. Never returns NULL for a non-NULL input. */
+gchar *mm_mtk_ccci_clcc_normalize (const gchar *response);
+
+/* Append one UNIX-stream fragment. 0: wait, 1: final ok, -1: error/EOF/limit. */
+gint mm_mtk_ccci_speech_reply_feed (gchar **reply, const guint8 *data, gsize len, GError **error);
+
+/* Index namespace: SIM1 1..7; SIM2 101..107. Wire ids are never modified. */
+guint mm_mtk_ccci_call_index (guint8 slot, guint id);
+gboolean mm_mtk_ccci_call_parse (guint8 slot, const guint8 *payload, gsize len, MMCallInfo *info);
+
+/* RAT mode: the
+ * <rat>,<prefer_rat> pair of AT+ERAT / MIPC NW_SET_RAT_REQ (one-byte TLVs
+ * 0x0100, 0x0101, addressed to the slot). <rat> is a RAT bit mask minus one
+ * with GSM 1, UMTS 2, LTE 4, C2K 8, NR 16 (22 = GSM|UMTS|LTE|NR, 6 =
+ * GSM|UMTS|LTE, 3 = LTE only). The documented pairs for a normal SIM:
+ *   NR/LTE/WCDMA/GSM (the automatic mode)    22 / 128
+ *   LTE with GSM/WCDMA fallback (LTE first)   6 / 4
+ *   LTE only                                  3 / 0
+ * <prefer_rat> 4 is LTE; it is not the 3 of the <rat> field for LTE only
+ * (the old LTE-first pair 6/3 was rejected by the modem). 128 goes with 22
+ * ("NR first" here, like Android's NR/LTE/WCDMA/GSM mode). The <prefer_rat>
+ * values 1 (GSM) and 2 (UMTS) come from ModemManager's mtk-legacy plugin and
+ * are unverified on this modem, as is 6/0 (no preference). */
+#define MM_MTK_CCCI_RAT_STOCK_DEFAULT     22
+#define MM_MTK_CCCI_RAT_GSM_UMTS_LTE      6
+#define MM_MTK_CCCI_RAT_LTE_ONLY          3
+#define MM_MTK_CCCI_RAT_PREFER_NONE       0
+#define MM_MTK_CCCI_RAT_PREFER_LTE        4
+#define MM_MTK_CCCI_RAT_PREFER_STOCK      128
+
+/* the mode combinations offered for the modes the modem reports (@mask:
+ * the union of 2G/3G/4G/5G from the generic probing) */
+GArray  *mm_mtk_ccci_rat_build_combinations (MMModemMode mask);
+/* the default (start-up, ANY/NONE): always NR first, 22/128, whatever the
+ * generic probing reported; LTE first only as the retry after a refusal */
+void     mm_mtk_ccci_rat_default (MMModemMode *allowed, MMModemMode *preferred);
+/* the one retry after the start-up pair @rejected_rat/@rejected_prefer was
+ * rejected: NR first (when @mask allows 5G or is not known yet), else LTE
+ * first, never the rejected pair itself. FALSE: no other pair to try. */
+gboolean mm_mtk_ccci_rat_fallback (MMModemMode mask, guint8 rejected_rat, guint8 rejected_prefer,
+                                   MMModemMode *allowed, MMModemMode *preferred);
+/* MM combination -> rat/prefer; ANY/NONE gives the default (any @mask); FALSE when
+ * the combination is not one of the offered ones */
+gboolean mm_mtk_ccci_rat_from_modes (MMModemMode mask, MMModemMode allowed, MMModemMode preferred,
+                                     guint8 *rat, guint8 *prefer);
+/* rat/prefer -> MM modes; FALSE for an impossible rat */
+gboolean mm_mtk_ccci_rat_to_modes (guint rat, guint prefer, MMModemMode *allowed, MMModemMode *preferred);
+/* "+ERAT: <curr_rat>,<gprs_status>,<rat>,<prefer_rat>" (anywhere in @reply) */
+gboolean mm_mtk_ccci_parse_erat (const gchar *reply, guint *curr_rat, guint *rat, guint *prefer);
+
+/* LTE loss diagnostics. */
+
+/* "mono <s.ms> boot <s.ms>": CLOCK_MONOTONIC (the kernel log's clock, stops
+ * in suspend) and CLOCK_BOOTTIME (runs on in suspend) */
+gchar *mm_mtk_ccci_trace_stamp (void);
+/* AT text on one log line: CR/LF runs become " | " */
+gchar *mm_mtk_ccci_at_one_line (const gchar *text);
+
+/* one +CREG/+CGREG/+CEREG line (3GPP TS 27.007); @solicited: the read
+ * response (<n> first), else the unsolicited form. -1: field absent. */
+typedef struct {
+    const gchar *domain;        /* "CS" (+CREG), "PS" (+CGREG), "EPS" (+CEREG) */
+    gint         n;             /* reporting level, read response only */
+    gint         stat;
+    gint         act;
+    gint         cause_type;    /* registration reject: only when the modem gives it */
+    gint         reject_cause;
+} MMMtkCcciReg;
+
+gboolean mm_mtk_ccci_reg_parse (const gchar *line, gboolean solicited, MMMtkCcciReg *reg);
+/* "EPS stat 1 (home) AcT 7, reject cause not reported" */
+gchar   *mm_mtk_ccci_reg_describe (const MMMtkCcciReg *reg);
+/* every registration line of @text described, "; "-separated; NULL: none */
+gchar   *mm_mtk_ccci_reg_describe_text (const gchar *text, gboolean solicited);
+
+/* a +CREG/+CGREG/+CEREG/+C5GREG line as ModemManager's generic code reads
+ * it (mm_3gpp_creg_regex_get, mm_3gpp_parse_creg_response): which state
+ * it updates, the state, AcT, LAC or TAC, cell id */
+typedef struct {
+    gboolean                     cgreg, cereg, c5greg;   /* all FALSE: CS (+CREG) */
+    MMModem3gppRegistrationState state;
+    MMModemAccessTechnology      act;
+    gulong                       lac, tac, ci;
+} MMMtkCcciRegUpdate;
+
+gboolean mm_mtk_ccci_reg_update_parse (const gchar *line, gboolean solicited, MMMtkCcciRegUpdate *u);
+/* "+CEREG: (0-5)" style test response: whether @n is offered after @prefix */
+gboolean mm_mtk_ccci_test_range_has (const gchar *reply, const gchar *prefix, guint n);
+/* a registration line without the fields after <AcT> (+CGREG: after <rac>),
+ * i.e. the <n> = 2 form; NULL: not a registration line */
+gchar   *mm_mtk_ccci_reg_strip_cause (const gchar *line, gboolean solicited);
+/* the AcT of a +COPS? read response; FALSE when it has none */
+gboolean mm_mtk_ccci_cops_act (const gchar *reply, MMModemAccessTechnology *act);
+
+/* the registration block of NW_GET_PS_CNF (0x8106), NW_PS_IND (0x8108) and
+ * NW_CS_IND (0x8102): +0 u8 stat, +1 PLMN (7 bytes
+ * ASCII), +8 u32 cell id, +12 u32 EARFCN, +16 u32 PCI, +20 u32 TAC, then
+ * signal words; EARFCN and PCI offsets inferred, not confirmed */
+typedef struct {
+    guint   stat;
+    gchar   plmn[8];
+    guint32 cell, earfcn, pci, tac;
+} MMMtkCcciNwBlock;
+
+gboolean mm_mtk_ccci_nw_block_parse    (const guint8 *p, gsize len, MMMtkCcciNwBlock *b);
+gchar   *mm_mtk_ccci_nw_block_describe (const MMMtkCcciNwBlock *b);
+/* NW_CSCON_IND 0x0100 (4 bytes): hex and the reading of the documented examples */
+gchar   *mm_mtk_ccci_cscon_describe    (const guint8 *v, gsize len);
+
+G_END_DECLS
+
+#endif /* MM_MODEM_HELPERS_MTK_CCCI_H */
diff --git a/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.c b/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.c
new file mode 100644
index 00000000..147b0b3b
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.c
@@ -0,0 +1,689 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MMMtkCcciAtBridge: a per-SIM AT port over the MIPC SYS_AT tunnel (see the
+ * header). Wire format of the tunnel
+ * (SYS_AT_REQ 0x0003, header slot = SIM slot bit, TLV 0x8100 = the AT
+ * command; CNF 0x0004 with result 0x0000 and the response text in 0x8100;
+ * SYS_AT_IND 0x4001 = URC text). Everything else here is the 3GPP/V.250 line
+ * discipline ModemManager's serial AT port expects. No proprietary code.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <config.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <gio/gio.h>
+#include <gio/gunixsocketaddress.h>
+
+#include <ModemManager.h>
+#include <mm-errors-types.h>
+
+#include "mm-log-object.h"
+#include "mm-mtk-ccci-at-bridge.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+
+#define BRIDGE_MAX_INPUT 8192   /* a PDU of 176 octets is 352 hex characters */
+#define MAX_COMMAND      2048   /* mm_port_mipc_at_command's limit too */
+#define DEFAULT_TIMEOUT  30
+
+typedef enum {
+    ITEM_TUNNEL,
+    ITEM_LOCAL_OK,
+    ITEM_LOCAL_ERROR,
+    ITEM_PROMPT,
+} ItemType;
+
+typedef struct {
+    ItemType type;
+    gchar   *text;
+} Item;
+
+struct _MMMtkCcciAtBridge {
+    gint        refs;
+    gboolean    closed;
+    MMPortMipc *port;
+    guint8      slot;
+    gchar      *name;
+    GSocket    *listener;
+    GSource    *accept_source;
+    GSocket    *client;
+    GSource    *client_source;
+    GSource    *write_source;
+    GByteArray *in;
+    GByteArray *out;
+    gboolean    pdu_mode;
+    gchar      *pdu_command;
+    GQueue      items;
+    gboolean    busy;
+    guint       epoch;
+};
+
+static guint bridge_counter;
+
+static void run_queue (MMMtkCcciAtBridge *self);
+static void flush_output (MMMtkCcciAtBridge *self);
+
+static void
+item_free (Item *item)
+{
+    g_free (item->text);
+    g_free (item);
+}
+
+static void
+items_clear (GQueue *items)
+{
+    Item *item;
+
+    while ((item = g_queue_pop_head (items)))
+        item_free (item);
+}
+
+static MMMtkCcciAtBridge *
+bridge_ref (MMMtkCcciAtBridge *self)
+{
+    self->refs++;
+    return self;
+}
+
+static void
+bridge_unref (MMMtkCcciAtBridge *self)
+{
+    if (--self->refs)
+        return;
+    g_byte_array_unref (self->in);
+    g_byte_array_unref (self->out);
+    items_clear (&self->items);
+    g_free (self->pdu_command);
+    g_free (self->name);
+    g_clear_object (&self->port);
+    g_free (self);
+}
+
+/*****************************************************************************/
+/* Pure helpers (unit tested) */
+
+/* Only what has a handler on the port from setup_ports on (MMBroadbandModem
+ * installs +CREG/+CGREG/+CEREG/+C5GREG, +CIEV, +CMTI, +CUSD handlers, the
+ * plugin its vendor ones), so that unsolicited text is never taken into
+ * the reply of the next command. Calls, IMS and the other SMS notices
+ * (+CDSI, SMS indications) are handled from MIPC directly. */
+static const gchar *wanted_urcs[] = {
+    "+CREG:", "+CGREG:", "+CEREG:", "+C5GREG:",
+    "+CMTI:", "+CUSD:", "+CIEV:",
+    "+EIND:", "+EFUN:", "+ESUO:",
+};
+
+gboolean
+mm_mtk_ccci_at_bridge_urc_wanted (const gchar *line)
+{
+    guint i;
+
+    if (!line)
+        return FALSE;
+    while (g_ascii_isspace (*line))
+        line++;
+    for (i = 0; i < G_N_ELEMENTS (wanted_urcs); i++)
+        if (g_str_has_prefix (line, wanted_urcs[i]))
+            return TRUE;
+    return FALSE;
+}
+
+static gboolean
+is_final_result (const gchar *line)
+{
+    return g_str_equal (line, "OK") || g_str_equal (line, "ERROR") ||
+           g_str_has_prefix (line, "+CME ERROR:") || g_str_has_prefix (line, "+CMS ERROR:") ||
+           g_str_equal (line, "NO CARRIER") || g_str_equal (line, "BUSY") ||
+           g_str_equal (line, "NO ANSWER") || g_str_equal (line, "NO DIALTONE") ||
+           g_str_has_prefix (line, "CONNECT");
+}
+
+static GPtrArray *
+split_lines (const gchar *text)
+{
+    GPtrArray     *lines = g_ptr_array_new_with_free_func (g_free);
+    g_auto(GStrv)  parts = NULL;
+    guint          i;
+
+    if (!text)
+        return lines;
+    parts = g_strsplit_set (text, "\r\n", -1);
+    for (i = 0; parts[i]; i++) {
+        gchar *line = g_strstrip (parts[i]);
+        if (line[0])
+            g_ptr_array_add (lines, g_strdup (line));
+    }
+    return lines;
+}
+
+gchar *
+mm_mtk_ccci_at_bridge_frame_reply (const gchar *text, guint32 result)
+{
+    g_autoptr(GPtrArray) lines = split_lines (text);
+    GString             *out = g_string_new (NULL);
+    const gchar         *final = NULL;
+    guint                n = lines->len, i;
+
+    if (n && is_final_result (g_ptr_array_index (lines, n - 1)))
+        final = g_ptr_array_index (lines, --n);
+    for (i = 0; i < n; i++)
+        g_string_append_printf (out, "\r\n%s\r\n", (const gchar *) g_ptr_array_index (lines, i));
+    /* no final result code in the text: the CNF result decides */
+    g_string_append_printf (out, "\r\n%s\r\n", final ? final : (result == 0 ? "OK" : "ERROR"));
+    return g_string_free (out, FALSE);
+}
+
+/* V.250 settings of the serial line itself: answered here. ATZ in
+ * particular would reset the tunnel channel's settings (+EURCRPT, +CNMI,
+ * +CREG ... of this stack) behind ModemManager's back. */
+static gboolean
+is_local_command (const gchar *cmd)
+{
+    const gchar *p;
+
+    if (g_ascii_strcasecmp (cmd, "AT") == 0)
+        return TRUE;
+    p = cmd + 2;
+    if (!*p)
+        return TRUE;
+    /* every element of a basic command line must be one of Z E V X &C &F Q0 */
+    while (*p) {
+        if (*p == ' ') {
+            p++;
+            continue;
+        }
+        if (strchr ("ZzEeVvXxQq", *p)) {
+            p++;
+            while (g_ascii_isdigit (*p))
+                p++;
+            continue;
+        }
+        if (*p == '&' && p[1] && strchr ("CcFfDd", p[1])) {
+            p += 2;
+            while (g_ascii_isdigit (*p))
+                p++;
+            continue;
+        }
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static gboolean
+is_pdu_command (const gchar *cmd)
+{
+    return g_ascii_strncasecmp (cmd, "AT+CMGS=", 8) == 0 || g_ascii_strncasecmp (cmd, "AT+CMGW=", 8) == 0;
+}
+
+static guint
+command_timeout (const gchar *cmd)
+{
+    if (g_ascii_strncasecmp (cmd, "AT+COPS=?", 9) == 0)
+        return 180;
+    if (g_ascii_strncasecmp (cmd, "AT+CMGS=", 8) == 0 || g_ascii_strncasecmp (cmd, "AT+CMSS=", 8) == 0)
+        return 120;
+    if (g_ascii_strncasecmp (cmd, "ATD", 3) == 0 || g_ascii_strncasecmp (cmd, "AT+CUSD", 7) == 0 ||
+        g_ascii_strncasecmp (cmd, "AT+COPS=", 8) == 0)
+        return 60;
+    return DEFAULT_TIMEOUT;
+}
+
+/*****************************************************************************/
+/* Output */
+
+static gboolean
+write_ready (GSocket *socket, GIOCondition condition, MMMtkCcciAtBridge *self)
+{
+    g_clear_pointer (&self->write_source, g_source_unref);
+    flush_output (self);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+flush_output (MMMtkCcciAtBridge *self)
+{
+    while (self->client && self->out->len) {
+        g_autoptr(GError) error = NULL;
+        gssize n = g_socket_send (self->client, (const gchar *) self->out->data, self->out->len, NULL, &error);
+
+        if (n < 0) {
+            if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK)) {
+                if (!self->write_source) {
+                    self->write_source = g_socket_create_source (self->client, G_IO_OUT, NULL);
+                    g_source_set_callback (self->write_source, (GSourceFunc) write_ready, self, NULL);
+                    g_source_attach (self->write_source, g_main_context_get_thread_default ());
+                }
+                return;
+            }
+            mm_obj_dbg (self->port, "AT bridge SIM%u: send: %s", self->slot, error->message);
+            g_byte_array_set_size (self->out, 0);
+            return;
+        }
+        g_byte_array_remove_range (self->out, 0, (guint) n);
+    }
+}
+
+static void
+write_text (MMMtkCcciAtBridge *self, const gchar *text)
+{
+    if (!self->client)
+        return; /* nobody listens: ModemManager has the port closed */
+    g_byte_array_append (self->out, (const guint8 *) text, strlen (text));
+    flush_output (self);
+}
+
+/*****************************************************************************/
+/* Tunnel requests */
+
+typedef struct {
+    MMMtkCcciAtBridge *self;
+    guint              epoch;
+    gchar             *command;
+} Request;
+
+/* a read response with level 3 registration lines, in the <n> = 2 form for
+ * the generic parsers; NULL: nothing to change */
+static gchar *
+bridge_strip_reg_causes (const gchar *text)
+{
+    g_auto(GStrv) lines = NULL;
+    GString      *out;
+    gboolean      changed = FALSE;
+    guint         i;
+
+    if (!text || !strstr (text, "REG:"))
+        return NULL;
+    lines = g_strsplit (text, "\n", -1);
+    out = g_string_new (NULL);
+    for (i = 0; lines[i]; i++) {
+        g_autofree gchar *line = g_strdup (lines[i]);
+        g_autofree gchar *plain = NULL;
+        gboolean          cr = g_str_has_suffix (line, "\r");
+
+        if (cr)
+            line[strlen (line) - 1] = 0;
+        plain = mm_mtk_ccci_reg_strip_cause (line, TRUE);
+        if (i)
+            g_string_append_c (out, '\n');
+        if (plain && strcmp (plain, g_strstrip (line))) {
+            g_string_append_printf (out, "%s%s", plain, cr ? "\r" : "");
+            changed = TRUE;
+        } else
+            g_string_append (out, lines[i]);
+    }
+    if (!changed) {
+        g_string_free (out, TRUE);
+        return NULL;
+    }
+    return g_string_free (out, FALSE);
+}
+
+static void
+tunnel_ready (MMPortMipc *port, GAsyncResult *res, Request *req)
+{
+    MMMtkCcciAtBridge    *self = req->self;
+    g_autoptr(GError)     error = NULL;
+    g_autoptr(MMMipcCnf)  cnf = mm_port_mipc_request_finish (port, res, &error);
+    g_autofree gchar     *text = NULL;
+    g_autofree gchar     *reply = NULL;
+
+    if (self->closed || req->epoch != self->epoch) {
+        /* the client went away: the answer belongs to nobody */
+        bridge_unref (self);
+        g_free (req->command);
+        g_free (req);
+        return;
+    }
+    if (!cnf) {
+        mm_obj_dbg (self->port, "AT bridge SIM%u: tunnel: %s", self->slot, error->message);
+        reply = g_strdup ("\r\nERROR\r\n");
+    } else {
+        g_autofree gchar *reg = NULL;
+
+        g_autofree gchar *plain = NULL;
+
+        text = mm_mipc_tlv_find_at_string (cnf->payload->data, cnf->payload->len);
+        plain = bridge_strip_reg_causes (text);
+        reply = mm_mtk_ccci_at_bridge_frame_reply (plain ? plain : text, cnf->result);
+        /* LTE-loss diagnostics: a registration read response on this port
+         * is logged as a response, so that it is not taken for the URC the
+         * port's unsolicited handlers may turn it into (the AT reply text
+         * can then be empty, e.g. for mmcli --command) */
+        reg = mm_mtk_ccci_reg_describe_text (text, TRUE);
+        if (reg) {
+            g_autofree gchar *stamp = mm_mtk_ccci_trace_stamp ();
+            g_autofree gchar *line = mm_mtk_ccci_at_one_line (text);
+
+            mm_obj_msg (self->port, "rat-trace SIM%u %s: read response to %s on the AT port: %s [%s]",
+                        self->slot, stamp, req->command ? req->command : "?", line, reg);
+        }
+    }
+    self->busy = FALSE;
+    write_text (self, reply);
+    run_queue (self);
+    bridge_unref (self);
+    g_free (req->command);
+    g_free (req);
+}
+
+static void
+run_queue (MMMtkCcciAtBridge *self)
+{
+    while (!self->busy && !self->closed && !g_queue_is_empty (&self->items)) {
+        Item                 *item = g_queue_pop_head (&self->items);
+        g_autoptr(GByteArray) tlvs = NULL;
+        Request              *req;
+
+        switch (item->type) {
+        case ITEM_LOCAL_OK:
+            write_text (self, "\r\nOK\r\n");
+            break;
+        case ITEM_LOCAL_ERROR:
+            write_text (self, "\r\nERROR\r\n");
+            break;
+        case ITEM_PROMPT:
+            /* 27.005 §3.5.1: the TE sends the PDU after "<CR><LF>> " */
+            write_text (self, "\r\n> ");
+            break;
+        case ITEM_TUNNEL:
+            if (!mm_port_mipc_get_session_ready (self->port)) {
+                mm_obj_dbg (self->port, "AT bridge SIM%u: no MIPC session for %s", self->slot, item->text);
+                write_text (self, "\r\nERROR\r\n");
+                break;
+            }
+            tlvs = g_byte_array_new ();
+            mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_AT_STRING, item->text);
+            req = g_new0 (Request, 1);
+            req->self = bridge_ref (self);
+            req->epoch = self->epoch;
+            req->command = g_strdup (item->text);
+            self->busy = TRUE;
+            mm_port_mipc_request (self->port, MM_MIPC_SYS_AT_REQ, self->slot, tlvs,
+                                  command_timeout (item->text), NULL,
+                                  (GAsyncReadyCallback) tunnel_ready, req);
+            break;
+        default:
+            g_assert_not_reached ();
+        }
+        item_free (item);
+    }
+}
+
+static void
+queue_item (MMMtkCcciAtBridge *self, ItemType type, gchar *text)
+{
+    Item *item = g_new0 (Item, 1);
+
+    item->type = type;
+    item->text = text;
+    g_queue_push_tail (&self->items, item);
+}
+
+/*****************************************************************************/
+/* Input */
+
+static void
+process_input (MMMtkCcciAtBridge *self)
+{
+    for (;;) {
+        guint i;
+
+        if (self->pdu_mode) {
+            g_autofree gchar *pdu = NULL;
+            guint8            end = 0;
+
+            for (i = 0; i < self->in->len; i++)
+                if (self->in->data[i] == 0x1a || self->in->data[i] == 0x1b) {
+                    end = self->in->data[i];
+                    break;
+                }
+            if (!end)
+                break;
+            pdu = g_strndup ((const gchar *) self->in->data, i);
+            g_byte_array_remove_range (self->in, 0, i + 1);
+            self->pdu_mode = FALSE;
+            g_strstrip (pdu);
+            if (end == 0x1b) {
+                /* 27.005: ESC cancels the message */
+                g_clear_pointer (&self->pdu_command, g_free);
+                queue_item (self, ITEM_LOCAL_OK, NULL);
+                continue;
+            }
+            if (strspn (pdu, "0123456789ABCDEFabcdef") != strlen (pdu) ||
+                strlen (pdu) + strlen (self->pdu_command) + 2 > MAX_COMMAND) {
+                g_clear_pointer (&self->pdu_command, g_free);
+                queue_item (self, ITEM_LOCAL_ERROR, NULL);
+                continue;
+            }
+            queue_item (self, ITEM_TUNNEL, g_strdup_printf ("%s\r%s\x1a", self->pdu_command, pdu));
+            g_clear_pointer (&self->pdu_command, g_free);
+            continue;
+        }
+
+        for (i = 0; i < self->in->len; i++)
+            if (self->in->data[i] == '\r' || self->in->data[i] == '\n')
+                break;
+        if (i == self->in->len)
+            break;
+        {
+            g_autofree gchar *line = g_strndup ((const gchar *) self->in->data, i);
+
+            g_byte_array_remove_range (self->in, 0, i + 1);
+            g_strstrip (line);
+            if (!line[0])
+                continue;
+            if (g_ascii_strncasecmp (line, "AT", 2) != 0 || strlen (line) > MAX_COMMAND ||
+                strpbrk (line, "\x1a\x1b")) {
+                queue_item (self, ITEM_LOCAL_ERROR, NULL);
+                continue;
+            }
+            if (is_local_command (line)) {
+                queue_item (self, ITEM_LOCAL_OK, NULL);
+                continue;
+            }
+            if (is_pdu_command (line)) {
+                self->pdu_mode = TRUE;
+                g_free (self->pdu_command);
+                self->pdu_command = g_strdup (line);
+                queue_item (self, ITEM_PROMPT, NULL);
+                continue;
+            }
+            queue_item (self, ITEM_TUNNEL, g_steal_pointer (&line));
+        }
+    }
+    if (self->in->len > BRIDGE_MAX_INPUT) {
+        mm_obj_warn (self->port, "AT bridge SIM%u: input overflow, dropped", self->slot);
+        g_byte_array_set_size (self->in, 0);
+        self->pdu_mode = FALSE;
+        queue_item (self, ITEM_LOCAL_ERROR, NULL);
+    }
+    run_queue (self);
+}
+
+static void
+drop_client (MMMtkCcciAtBridge *self)
+{
+    if (self->client_source) {
+        g_source_destroy (self->client_source);
+        g_clear_pointer (&self->client_source, g_source_unref);
+    }
+    if (self->write_source) {
+        g_source_destroy (self->write_source);
+        g_clear_pointer (&self->write_source, g_source_unref);
+    }
+    if (self->client) {
+        g_socket_close (self->client, NULL);
+        g_clear_object (&self->client);
+    }
+    g_byte_array_set_size (self->in, 0);
+    g_byte_array_set_size (self->out, 0);
+    items_clear (&self->items);
+    self->pdu_mode = FALSE;
+    g_clear_pointer (&self->pdu_command, g_free);
+    /* an answer still in flight is for the old client */
+    self->busy = FALSE;
+    self->epoch++;
+}
+
+static gboolean
+client_ready (GSocket *socket, GIOCondition condition, MMMtkCcciAtBridge *self)
+{
+    gchar  buf[1024];
+    gssize n;
+
+    if (condition & G_IO_IN) {
+        g_autoptr(GError) error = NULL;
+
+        n = g_socket_receive (socket, buf, sizeof (buf), NULL, &error);
+        if (n > 0) {
+            g_byte_array_append (self->in, (const guint8 *) buf, (guint) n);
+            process_input (self);
+            return G_SOURCE_CONTINUE;
+        }
+        if (n < 0 && g_error_matches (error, G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK))
+            return G_SOURCE_CONTINUE;
+    }
+    /* EOF, error or hang-up: ModemManager closed the port */
+    mm_obj_dbg (self->port, "AT bridge SIM%u: client closed", self->slot);
+    g_clear_pointer (&self->client_source, g_source_unref);
+    drop_client (self);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean
+accept_ready (GSocket *listener, GIOCondition condition, MMMtkCcciAtBridge *self)
+{
+    g_autoptr(GError)       error = NULL;
+    g_autoptr(GSocket)      client = NULL;
+    g_autoptr(GCredentials) creds = NULL;
+    pid_t                   pid;
+
+    client = g_socket_accept (listener, NULL, &error);
+    if (!client)
+        return G_SOURCE_CONTINUE;
+    creds = g_socket_get_credentials (client, &error);
+    pid = creds ? g_credentials_get_unix_pid (creds, NULL) : -1;
+    if (pid != getpid ()) {
+        /* the abstract namespace is visible to the whole network namespace:
+         * only ModemManager's own port may talk to the modem here */
+        mm_obj_warn (self->port, "AT bridge SIM%u: connection from pid %d refused", self->slot, (gint) pid);
+        g_socket_close (client, NULL);
+        return G_SOURCE_CONTINUE;
+    }
+    drop_client (self);
+    g_socket_set_blocking (client, FALSE);
+    self->client = g_steal_pointer (&client);
+    self->client_source = g_socket_create_source (self->client, G_IO_IN | G_IO_HUP | G_IO_ERR, NULL);
+    g_source_set_callback (self->client_source, (GSourceFunc) client_ready, self, NULL);
+    g_source_attach (self->client_source, g_main_context_get_thread_default ());
+    mm_obj_dbg (self->port, "AT bridge SIM%u: client connected", self->slot);
+    return G_SOURCE_CONTINUE;
+}
+
+/*****************************************************************************/
+
+gboolean
+mm_mtk_ccci_at_bridge_push_urc (MMMtkCcciAtBridge *self, const gchar *text)
+{
+    g_autoptr(GPtrArray) lines = split_lines (text);
+    GString             *out;
+    guint                i;
+
+    if (!lines->len || !mm_mtk_ccci_at_bridge_urc_wanted (g_ptr_array_index (lines, 0)))
+        return FALSE;
+    /* the whole indication: +CMT/+CDS carry the PDU on a second line;
+     * registration lines in the <n> = 2 form the generic parsers read (the
+     * plugin logs the reject causes of level 3 before this) */
+    out = g_string_new (NULL);
+    for (i = 0; i < lines->len; i++) {
+        g_autofree gchar *plain = mm_mtk_ccci_reg_strip_cause (g_ptr_array_index (lines, i), FALSE);
+
+        g_string_append_printf (out, "\r\n%s\r\n", plain ? plain : (const gchar *) g_ptr_array_index (lines, i));
+    }
+    write_text (self, out->str);
+    g_string_free (out, TRUE);
+    return TRUE;
+}
+
+const gchar *
+mm_mtk_ccci_at_bridge_get_name (MMMtkCcciAtBridge *self)
+{
+    return self->name;
+}
+
+guint8
+mm_mtk_ccci_at_bridge_get_slot (MMMtkCcciAtBridge *self)
+{
+    return self->slot;
+}
+
+MMMtkCcciAtBridge *
+mm_mtk_ccci_at_bridge_new (MMPortMipc *port, guint8 slot, GError **error)
+{
+    MMMtkCcciAtBridge        *self;
+    g_autoptr(GSocketAddress) address = NULL;
+
+    g_return_val_if_fail (MM_IS_PORT_MIPC (port), NULL);
+    g_return_val_if_fail (slot == MM_MIPC_SLOT_SIM1 || slot == MM_MIPC_SLOT_SIM2, NULL);
+
+    self = g_new0 (MMMtkCcciAtBridge, 1);
+    self->refs = 1;
+    self->port = g_object_ref (port);
+    self->slot = slot;
+    self->in = g_byte_array_new ();
+    self->out = g_byte_array_new ();
+    g_queue_init (&self->items);
+    /* the same string is the address ModemManager's unix-socket serial port
+     * connects to (mm-port-serial.c: "abstract:" prefix = abstract socket) */
+    self->name = g_strdup_printf ("abstract:mm-mtk-ccci-sim%u-at-%d-%u", slot == MM_MIPC_SLOT_SIM2 ? 2 : 1,
+                                  (gint) getpid (), ++bridge_counter);
+
+    self->listener = g_socket_new (G_SOCKET_FAMILY_UNIX, G_SOCKET_TYPE_STREAM, G_SOCKET_PROTOCOL_DEFAULT, error);
+    if (!self->listener)
+        goto fail;
+    g_socket_set_blocking (self->listener, FALSE);
+    address = g_unix_socket_address_new_with_type (self->name, -1, G_UNIX_SOCKET_ADDRESS_ABSTRACT);
+    if (!g_socket_bind (self->listener, address, FALSE, error) || !g_socket_listen (self->listener, error))
+        goto fail;
+    self->accept_source = g_socket_create_source (self->listener, G_IO_IN, NULL);
+    g_source_set_callback (self->accept_source, (GSourceFunc) accept_ready, self, NULL);
+    g_source_attach (self->accept_source, g_main_context_get_thread_default ());
+    return self;
+
+fail:
+    g_prefix_error (error, "AT bridge for SIM%u: ", slot == MM_MIPC_SLOT_SIM2 ? 2 : 1);
+    mm_mtk_ccci_at_bridge_free (self);
+    return NULL;
+}
+
+void
+mm_mtk_ccci_at_bridge_free (MMMtkCcciAtBridge *self)
+{
+    if (!self)
+        return;
+    drop_client (self);
+    if (self->accept_source) {
+        g_source_destroy (self->accept_source);
+        g_clear_pointer (&self->accept_source, g_source_unref);
+    }
+    if (self->listener) {
+        g_socket_close (self->listener, NULL);
+        g_clear_object (&self->listener);
+    }
+    self->closed = TRUE;
+    bridge_unref (self);
+}
diff --git a/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.h b/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.h
new file mode 100644
index 00000000..43545fa9
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mtk-ccci-at-bridge.h
@@ -0,0 +1,59 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MMMtkCcciAtBridge: an AT command port for one SIM stack, carried by the
+ * slot-addressed MIPC AT tunnel (SYS_AT_REQ 0x0003 / CNF 0x0004 / IND 0x4001).
+ * It listens on an abstract unix socket inside the
+ * ModemManager process; the SIM2 modem object's primary AT port is
+ * ModemManager's own "virtual" AT port (MMPortSerialAt on a unix socket,
+ * mm-base-modem.c) connected to it. Generic ModemManager code (+CPIN, +CSQ,
+ * +CREG/+CEREG, +COPS, SMS in PDU mode ...) thus runs unchanged per stack.
+ *
+ * Line handling (towards ModemManager): commands end with CR (or LF); the
+ * tunnel reply is reframed as "\r\n<line>\r\n"... with a final result code
+ * (the CNF result decides OK/ERROR when the text has none). V.250 settings
+ * that only concern a serial line (ATZ, ATE, ATV1, ATX, AT&C, AT&F, AT) are
+ * answered here and never sent to the modem. AT+CMGS=/AT+CMGW= get the "> "
+ * prompt here; the PDU up to Ctrl-Z is then sent with the command as one
+ * tunnel string "AT+CMGS=<n>\r<pdu>\x1a" (unverified that the tunnel accepts
+ * it; Android's RIL sends SMS through the MIPC SMS group, which is not described).
+ * Unsolicited text of the slot (SYS_AT_IND) is written to the client when
+ * the port always has a handler for it (registration, +CMTI, +CUSD, +CIEV,
+ * the plugin's +EIND/+EFUN/+ESUO); anything else would end up in the reply
+ * of the next command.
+ *
+ * Only a peer in the same process (SO_PEERCRED pid) is accepted.
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_MTK_CCCI_AT_BRIDGE_H
+#define MM_MTK_CCCI_AT_BRIDGE_H
+
+#include <glib.h>
+#include "mm-port-mipc.h"
+
+typedef struct _MMMtkCcciAtBridge MMMtkCcciAtBridge;
+
+/* listens at once; @slot is the MIPC slot bit (0x01/0x02) */
+MMMtkCcciAtBridge *mm_mtk_ccci_at_bridge_new  (MMPortMipc   *port,
+                                               guint8        slot,
+                                               GError      **error);
+void               mm_mtk_ccci_at_bridge_free (MMMtkCcciAtBridge *self);
+
+/* the port name for a "virtual" ModemManager port: "abstract:..." */
+const gchar *mm_mtk_ccci_at_bridge_get_name (MMMtkCcciAtBridge *self);
+guint8       mm_mtk_ccci_at_bridge_get_slot (MMMtkCcciAtBridge *self);
+
+/* a SYS_AT_IND text of this slot; forwarded when it is a wanted URC.
+ * Returns TRUE when (at least one line was) forwarded. */
+gboolean mm_mtk_ccci_at_bridge_push_urc (MMMtkCcciAtBridge *self, const gchar *text);
+
+/* exposed for unit tests: whether a URC line is forwarded */
+gboolean mm_mtk_ccci_at_bridge_urc_wanted (const gchar *line);
+/* exposed for unit tests: the reframed response for a tunnel reply */
+gchar   *mm_mtk_ccci_at_bridge_frame_reply (const gchar *text, guint32 result);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMMtkCcciAtBridge, mm_mtk_ccci_at_bridge_free)
+
+#endif /* MM_MTK_CCCI_AT_BRIDGE_H */
diff --git a/src/plugins/mtk-ccci/mm-mtk-ccci-ims.c b/src/plugins/mtk-ccci/mm-mtk-ccci-ims.c
new file mode 100644
index 00000000..76f30e76
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mtk-ccci-ims.c
@@ -0,0 +1,1009 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ * IMS (VoLTE) set-up over MIPC. Written from a clean-room behavioural description of the protocol; no code of the phone's Android software was used.
+ * Values marked unverified there remain unverified here.
+ */
+#include <config.h>
+#include <stdio.h>
+#include <string.h>
+#include <gio/gio.h>
+#include "mm-mtk-ccci-ims.h"
+#include "mm-base-modem-at.h"
+#include "mm-modem-helpers.h"
+#include "mm-log-object.h"
+#include <mm-errors-types.h>
+#include "mm-wwan-link.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+
+#define MAX_PDNS 32
+#define MAX_SPIS 4096
+
+typedef struct {
+    guint tid;
+    gboolean labelled, up, created;
+    guint mtu;
+    gchar *address, *link;
+} ImsPdn;
+
+struct _MMMtkCcciIms {
+    /* owner: the source object of every result (GTask) and the log object.
+     * The shared context (mm-mtk-ccci-shared.c) in the plugin; never assume
+     * it is a modem in a callback (DESIGN.md §11.2). Without a radio hook the
+     * radio-off step is an AT command of the owner, which then must be an
+     * MMBaseModem (the host tests' owner). */
+    gpointer owner;
+    MMPortMipc *port;
+    guint8 slot;
+    gchar *wwan, *internet_apn, *ims_apn, *sos_apn;
+    gboolean enabled, configured, registered, poll_busy, profiles_complete, radio_owner;
+    gboolean ia_enabled;   /* experiment B: APN_SET_IA_REQ after the profile list */
+    gboolean ia_done;      /* sent and confirmed in this setup epoch */
+    const gchar *internet_source; /* where internet_apn came from (static text) */
+    guint    start_steps;          /* MM_MTK_CCCI_IMS_STEP_* */
+    MMMtkCcciImsProfiles profiles_mode;
+    gboolean profiles_held;        /* the list waits for registration (or a bearer) */
+    guint epoch, timer;
+    gint64 next_poll;
+    GHashTable *pdns, *spis;
+    /* the radio-off step of a cold setup, when the owner provides one
+     * (the shared radio coordinator, mm-mtk-ccci-shared.c) */
+    MMMtkCcciImsRadioHook radio_hook;
+    gpointer radio_hook_data;
+    /* callers of the setup in flight (NULL: none in flight) */
+    GPtrArray *setup_waiters;
+};
+
+static void pdn_free (ImsPdn *p)
+{
+    if (p->created && p->link)
+        mm_wwan_link_del (p->link, NULL);
+    g_free (p->address);
+    g_free (p->link);
+    g_free (p);
+}
+
+static ImsPdn *pdn_get (MMMtkCcciIms *ims, guint tid)
+{
+    ImsPdn *p;
+    if (tid % 100 > 20 || tid > G_MAXINT)
+        return NULL;
+    p = g_hash_table_lookup (ims->pdns, GUINT_TO_POINTER (tid));
+    if (!p && g_hash_table_size (ims->pdns) < MAX_PDNS) {
+        p = g_new0 (ImsPdn, 1);
+        p->tid = tid;
+        p->mtu = 1500;
+        g_hash_table_insert (ims->pdns, GUINT_TO_POINTER (tid), p);
+    }
+    return p;
+}
+
+static void pdn_configure (MMMtkCcciIms *ims, ImsPdn *p)
+{
+    g_autoptr(GError) error = NULL;
+    gboolean existed = FALSE;
+
+    if (!ims->enabled || !p->labelled || !p->up)
+        return;
+    if (!p->link) {
+        p->link = g_strdup_printf ("%s-%u", ims->wwan, p->tid % 100);
+        if (!mm_wwan_link_add (ims->wwan, p->tid % 100, p->link, &existed, &error)) {
+            mm_obj_warn (ims->owner, "IMS link: %s", error->message);
+            g_clear_pointer (&p->link, g_free);
+            return;
+        }
+        if (existed) {
+            /* Ownership cannot be inferred from a reused name. Do not configure
+             * or delete a link that may belong to an internet bearer. */
+            mm_obj_warn (ims->owner, "IMS link %s already exists; leaving it untouched", p->link);
+            g_clear_pointer (&p->link, g_free);
+            return;
+        }
+        p->created = TRUE;
+    }
+    if (!mm_wwan_link_configure (p->link, p->mtu, p->address, &error))
+        mm_obj_warn (ims->owner, "IMS link %s: %s", p->link, error->message);
+    else
+        mm_obj_msg (ims->owner, "IMS SIM%u PDN %u on %s, address %s (no default route or DNS)",
+                    ims->slot, p->tid, p->link, p->address ? p->address : "pending");
+}
+
+/* LTE-loss diagnostics: the profile steps of the slot on the rat-trace
+ * timeline (mm-broadband-modem-mtk-ccci.c) */
+static void ims_trace (MMMtkCcciIms *ims, const gchar *fmt, ...) G_GNUC_PRINTF (2, 3);
+
+static void ims_trace (MMMtkCcciIms *ims, const gchar *fmt, ...)
+{
+    g_autofree gchar *stamp = mm_mtk_ccci_trace_stamp ();
+    g_autofree gchar *what = NULL;
+    va_list ap;
+
+    va_start (ap, fmt);
+    what = g_strdup_vprintf (fmt, ap);
+    va_end (ap);
+    mm_obj_msg (ims->owner, "rat-trace SIM%u %s: %s", ims->slot, stamp, what);
+}
+
+static void trace_cid0 (MMMtkCcciIms *ims, const gchar *reply, const gchar *source)
+{
+    g_autofree gchar *line = mm_mtk_ccci_at_one_line (reply);
+
+    ims_trace (ims, "CID 0 (%s, AT+CGDCONT? read response): %s; internet APN of this SIM: %s%s%s%s%s%s",
+               source, reply ? line : "no reply", ims->internet_apn ? "'" : "",
+               ims->internet_apn ? ims->internet_apn : "none (no CID 0 internet context, no preset)",
+               ims->internet_apn ? "'" : "", ims->internet_apn ? " (from " : "",
+               ims->internet_apn ? ims->internet_source : "", ims->internet_apn ? ")" : "");
+}
+
+static void trace_profiles_request (MMMtkCcciIms *ims, const gchar *internet, const gchar *source)
+{
+    ims_trace (ims, "APN profile list request APN_ADD_PROFILE_LIST_REQ 0x0113 (%s): internet %s%s%s, ims '%s', sos '%s'",
+               source, internet ? "'" : "", internet ? internet : "none", internet ? "'" : "",
+               ims->ims_apn, ims->sos_apn);
+}
+
+static void trace_confirm (MMMtkCcciIms *ims, const gchar *what, MMMipcCnf *cnf, const GError *error)
+{
+    if (!cnf)
+        ims_trace (ims, "%s: no confirm: %s", what, error ? error->message : "unknown error");
+    else
+        ims_trace (ims, "%s: confirm 0x%04x slot 0x%02x txid %u result %u%s", what, cnf->msg_id, cnf->slot,
+                   cnf->txid, cnf->result,
+                   mm_mipc_tlv_find (cnf->payload->data, cnf->payload->len, MM_MIPC_T_RESULT, NULL) ?
+                       "" : " (no result TLV)");
+}
+
+void mm_mtk_ccci_ims_set_initial_attach (MMMtkCcciIms *ims, gboolean enabled)
+{
+    if (ims->ia_enabled != enabled)
+        mm_obj_msg (ims->owner, "SIM%u initial-attach experiment %s", ims->slot,
+                    enabled ? "B: APN_SET_IA_REQ after the profile list" : "A: profile list only");
+    ims->ia_enabled = enabled;
+}
+
+/* experiment B: the slot's internet profile as the initial-attach APN.
+ * Returns FALSE (and logs why) when nothing was sent. */
+static gboolean ia_send (MMMtkCcciIms *ims, const gchar *source, GAsyncReadyCallback callback, gpointer user_data)
+{
+    g_autoptr(GByteArray) tlvs = NULL;
+
+    if (!ims->ia_enabled) {
+        ims_trace (ims, "initial attach (%s): no separate APN_SET_IA_REQ (experiment A)", source);
+        return FALSE;
+    }
+    if (ims->ia_done)
+        return FALSE;
+    tlvs = mm_mipc_build_set_ia (ims->internet_apn, MM_MIPC_APN_INTERNET_PDP, MM_MIPC_APN_INTERNET_PDP,
+                                 MM_MIPC_APN_INTERNET_AUTH, NULL, NULL);
+    if (!tlvs) {
+        ims_trace (ims, "initial attach (%s): APN_SET_IA_REQ not sent: %s", source,
+                   ims->internet_apn ? "APN too long" : "no internet APN of this SIM known");
+        return FALSE;
+    }
+    ims_trace (ims, "initial attach (%s): APN_SET_IA_REQ 0x0101: APN '%s' (from %s), PDP type %u, roaming PDP type %u, "
+               "auth type %u, user empty, password empty", source, ims->internet_apn, ims->internet_source,
+               MM_MIPC_APN_INTERNET_PDP, MM_MIPC_APN_INTERNET_PDP, MM_MIPC_APN_INTERNET_AUTH);
+    mm_port_mipc_request (ims->port, MM_MIPC_APN_SET_IA_REQ, ims->slot, tlvs, 15, NULL, callback, user_data);
+    return TRUE;
+}
+
+/* the IA confirm: only APN_SET_IA_CNF of this slot with result 0 counts
+ * (the port matches the transaction id) */
+static void ia_finish (MMMtkCcciIms *ims, MMPortMipc *port, GAsyncResult *res)
+{
+    g_autoptr(GError) error = NULL;
+    g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, &error);
+
+    trace_confirm (ims, "initial attach APN_SET_IA_REQ", cnf, error);
+    ims->ia_done = cnf && cnf->msg_id == MM_MIPC_APN_SET_IA_CNF && cnf->slot == ims->slot && !cnf->result;
+    if (!ims->ia_done)
+        mm_obj_warn (ims->owner, "SIM%u initial-attach APN not accepted: %s", ims->slot,
+                     error ? error->message : "refused");
+}
+
+static void set_registration (MMMtkCcciIms *ims, guint registered, guint services)
+{
+    gboolean state = registered == 1;
+    if (ims->registered != state)
+        mm_obj_msg (ims->owner, "IMS SIM%u %s, services 0x%x", ims->slot, state ? "registered" : "not registered", services);
+    ims->registered = state;
+}
+
+void mm_mtk_ccci_ims_urc (MMMtkCcciIms *ims, const gchar *line)
+{
+    guint tid, kind, reg, services;
+    gchar state[16], address[64];
+    ImsPdn *p;
+    g_autoptr(GInetAddress) parsed = NULL;
+
+    if (!ims || !ims->enabled)
+        return;
+    if (sscanf (line, "+CIREGU: %u , %x", &reg, &services) == 2) {
+        set_registration (ims, reg, services);
+        return;
+    }
+    if (sscanf (line, "+EIF: %u , %15[^,], %u , %63[^,\r\n]", &tid, state, &kind, address) != 4)
+        return;
+    if (!g_str_equal (g_strstrip (state), "ifup") && !g_str_equal (state, "ipchg"))
+        return;
+    parsed = g_inet_address_new_from_string (g_strstrip (address));
+    if (!parsed || g_inet_address_get_is_any (parsed))
+        return;
+    p = pdn_get (ims, tid);
+    if (!p)
+        return;
+    g_free (p->address);
+    p->address = g_inet_address_to_string (parsed);
+    pdn_configure (ims, p);
+}
+
+static void spi_command (MMMtkCcciIms *ims, guint slot, guint txid, GByteArray *payload)
+{
+    guint32 index = 0, lo = MM_MIPC_SPI_DEFAULT_MIN, hi = MM_MIPC_SPI_DEFAULT_MAX, spi = 0;
+    guint attempts;
+    gboolean ok = FALSE;
+    g_autoptr(GByteArray) reply = g_byte_array_new ();
+    g_autoptr(GError) error = NULL;
+
+    mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_SPI_INDEX, &index);
+    mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_SPI_MIN, &lo);
+    mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_SPI_MAX, &hi);
+    /* SPI 0 is reserved. Bounded search; never reuse an SPI in this session.
+     * Kernel IPsec reservation and the failure value 1 are unverified. */
+    lo = MAX (lo, 0x100);
+    if (lo <= hi && g_hash_table_size (ims->spis) < MAX_SPIS) {
+        guint64 range = (guint64) hi - lo + 1;
+        guint64 limit = (G_GUINT64_CONSTANT (1) << 32) / range * range;
+        for (attempts = 0; attempts < MAX_SPIS * 2; attempts++) {
+            guint32 random = g_random_int ();
+            if ((guint64) random >= limit)
+                continue;
+            spi = lo + random % range;
+            if (!g_hash_table_contains (ims->spis, GUINT_TO_POINTER (spi))) {
+                ok = TRUE;
+                break;
+            }
+        }
+    }
+    if (ok)
+        g_hash_table_add (ims->spis, GUINT_TO_POINTER (spi));
+    mm_mipc_tlv_add_u32 (reply, MM_MIPC_T_SPI_RSP_INDEX, index);
+    mm_mipc_tlv_add_u8 (reply, MM_MIPC_T_SPI_RSP_RESULT, ok ? 0 : 1);
+    mm_mipc_tlv_add_u32 (reply, MM_MIPC_T_SPI_RSP_SPI, ok ? spi : 0);
+    if (!mm_port_mipc_send_response (ims->port, MM_MIPC_INTERNAL_EIPSPI_RSP, txid, slot, reply, &error))
+        mm_obj_warn (ims->owner, "IMS SPI reply: %s", error->message);
+}
+
+static void indication (MMPortMipc *port, guint id, guint slot, guint txid,
+                         GByteArray *payload, MMMtkCcciIms *ims)
+{
+    guint32 tid, command = 0, type = 0, action = 0, mtu;
+    ImsPdn *p;
+    const guint8 *record;
+    gsize length;
+
+    if (!ims->enabled)
+        return;
+    if (id == MM_MIPC_INTERNAL_EIPSPI_CMD) {
+        /* Byte 8 can be 0x11, not the active SIM bit: echo it unchanged. */
+        if ((slot & 3) == ims->slot || ((slot & 3) == 3 && ims->radio_owner))
+            spi_command (ims, slot, txid, payload);
+        return;
+    }
+    if (!(slot & ims->slot))
+        return;
+    if (id == MM_MIPC_SYS_AT_IND) {
+        g_autofree gchar *text = mm_mipc_tlv_find_at_string (payload->data, payload->len);
+        if (text) {
+            g_auto(GStrv) lines = g_strsplit_set (text, "\r\n", -1);
+            guint i;
+            for (i = 0; lines[i]; i++)
+                mm_mtk_ccci_ims_urc (ims, g_strstrip (lines[i]));
+        }
+        return;
+    }
+    if (id == MM_MIPC_IMS_PDN_IND) {
+        if (!mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_IMSPDN_IFACE, &tid))
+            return; /* short bookkeeping reset: no interface is identified */
+        if (!mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_IMSPDN_TYPE, &type) ||
+            !mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_IMSPDN_ACTION, &action))
+            return;
+        if (type != MM_MIPC_IMSPDN_TYPE_IMS)
+            return; /* emergency type coding is not established */
+        if (!action) {
+            g_hash_table_remove (ims->pdns, GUINT_TO_POINTER (tid));
+            return;
+        }
+        p = pdn_get (ims, tid);
+        if (p) { p->labelled = TRUE; pdn_configure (ims, p); }
+        return;
+    }
+    if (id != MM_MIPC_INTERNAL_EIF_IND ||
+        !mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_EIF_TRANS_INTF_ID, &tid) ||
+        !mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_EIF_CMD, &command))
+        return;
+    if (command == MM_MIPC_EIF_DOWN) {
+        g_hash_table_remove (ims->pdns, GUINT_TO_POINTER (tid));
+        return;
+    }
+    if (command != MM_MIPC_EIF_UP && command != MM_MIPC_EIF_CHANGE &&
+        command != MM_MIPC_EIF_HO_ADDR && command != MM_MIPC_EIF_MTU)
+        return;
+    p = pdn_get (ims, tid);
+    if (!p)
+        return;
+    if (command != MM_MIPC_EIF_MTU)
+        p->up = TRUE;
+    if (mm_mipc_tlv_find_uint (payload->data, payload->len, MM_MIPC_T_EIF_MTU, &mtu) && mtu >= 68 && mtu <= 3568)
+        p->mtu = mtu;
+    record = mm_mipc_tlv_find_record (payload->data, payload->len, MM_MIPC_T_EIF_V4_RECORDS, &length);
+    if (record && length >= 4 && (record[0] | record[1] | record[2] | record[3])) {
+        g_free (p->address);
+        p->address = g_strdup_printf ("%u.%u.%u.%u", record[0], record[1], record[2], record[3]);
+    }
+    pdn_configure (ims, p);
+}
+
+/* All per-stack commands use the explicitly addressed tunnel. CFUN=4 is a
+ * physical-radio operation and is issued only by the primary startup owner. */
+static void
+ims_at_command (MMMtkCcciIms *ims, const gchar *command, guint timeout,
+                GAsyncReadyCallback callback, gpointer user_data)
+{
+    g_autofree gchar *full = NULL;
+    if (g_str_equal (command, "+CFUN=4")) {
+        if (ims->radio_hook) {
+            GTask *task = g_task_new (ims->owner, NULL, callback, user_data);
+            g_task_set_source_tag (task, mm_mtk_ccci_ims_set_radio_hook);
+            ims->radio_hook (ims, ims->slot, task, ims->radio_hook_data);
+            return;
+        }
+        mm_base_modem_at_command ((MMBaseModem *) ims->owner, command, timeout, FALSE, callback, user_data);
+        return;
+    }
+    full = g_strdup_printf ("AT%s", command);
+    mm_port_mipc_at_command (ims->port, ims->slot, full, timeout, callback, user_data);
+}
+
+static gchar *
+ims_at_finish (GObject *source, GAsyncResult *res, GError **error)
+{
+    gchar *text;
+    if (g_async_result_is_tagged (res, mm_port_mipc_at_command))
+        text = mm_port_mipc_at_command_finish (MM_PORT_MIPC (source), res, error);
+    else if (g_async_result_is_tagged (res, mm_mtk_ccci_ims_set_radio_hook))
+        text = g_task_propagate_pointer (G_TASK (res), error);
+    else {
+        const gchar *borrowed = mm_base_modem_at_command_finish ((MMBaseModem *) source, res, error);
+        text = borrowed ? g_strdup (borrowed) : NULL;
+    }
+    return text ? g_strstrip (text) : NULL;
+}
+
+/* All startup operations run before the normal MM radio-power-up step. */
+typedef struct {
+    MMMtkCcciIms *ims;
+    guint epoch, step;
+    gboolean warm, fallback;
+} Setup;
+
+static void setup_step (GTask *task);
+
+static void read_apn (MMMtkCcciIms *ims, const gchar *response)
+{
+    g_autoptr(GError) error = NULL;
+    GList *contexts, *l;
+    if (!response || ims->internet_apn)
+        return;
+    contexts = mm_3gpp_parse_cgdcont_read_response (response, &error);
+    for (l = contexts; l; l = l->next) {
+        MM3gppPdpContext *p = l->data;
+        /* On this modem the attach context is CID 0. After data teardown it
+         * may be absent while CID 1 (IMS) remains; that is not an internet APN. */
+        if (p->cid == 0 && p->apn && p->apn[0] &&
+            g_ascii_strcasecmp (p->apn, ims->ims_apn) &&
+            g_ascii_strcasecmp (p->apn, ims->sos_apn)) {
+            g_free (ims->internet_apn);
+            ims->internet_apn = g_strdup (p->apn);
+            ims->internet_source = "CID 0";
+        }
+    }
+    mm_3gpp_pdp_context_list_free (contexts);
+}
+
+static void setup_at_ready (GObject *source, GAsyncResult *res, GTask *task)
+{
+    Setup *ctx = g_task_get_task_data (task);
+    GError *error = NULL;
+    g_autofree gchar *reply = ims_at_finish (source, res, &error);
+    guint n, reg, services;
+
+    if (ctx->epoch != ctx->ims->epoch || !ctx->ims->enabled) {
+        g_clear_error (&error);
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "IMS setup superseded");
+        g_object_unref (task);
+        return;
+    }
+    if (!reply && ctx->step == 7 && !ctx->fallback) {
+        ctx->fallback = TRUE;
+        g_clear_error (&error);
+        ims_at_command (ctx->ims, "+EIMSPDN=\"onoff\",1", 10,
+                        (GAsyncReadyCallback) setup_at_ready, task);
+        return;
+    }
+    if (!reply && ctx->step != 0 && ctx->step != 4) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (ctx->step == 0 && reply && sscanf (reply, "+CIREG: %u , %u , %x", &n, &reg, &services) == 3)
+        ctx->warm = reg == 1;
+    if (ctx->step == 4) {
+        read_apn (ctx->ims, reply);
+        trace_cid0 (ctx->ims, reply, "start-up");
+    }
+    g_clear_error (&error);
+    ctx->step++;
+    setup_step (task);
+}
+
+static void setup_ia_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Setup *ctx = g_task_get_task_data (task);
+
+    if (ctx->epoch != ctx->ims->epoch || !ctx->ims->enabled) {
+        g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, NULL);
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "IMS setup superseded");
+        g_object_unref (task);
+        return;
+    }
+    /* not fatal: the experiment must not stop the start-up */
+    ia_finish (ctx->ims, port, res);
+    ctx->step++;
+    setup_step (task);
+}
+
+static void setup_mipc_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Setup *ctx = g_task_get_task_data (task);
+    g_autoptr(MMMipcCnf) cnf = NULL;
+    GError *error = NULL;
+    g_autofree gchar *reply = NULL;
+
+    cnf = mm_port_mipc_request_finish (port, res, &error);
+    if (ctx->epoch != ctx->ims->epoch || !ctx->ims->enabled) {
+        g_clear_error (&error);
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "IMS setup superseded");
+        g_object_unref (task);
+        return;
+    }
+    if (cnf && ctx->step == 9)
+        reply = mm_mipc_tlv_find_at_string (cnf->payload->data, cnf->payload->len);
+    if (ctx->step == 5)
+        trace_confirm (ctx->ims, "APN profile list (start-up)", cnf, error);
+    if (!cnf || cnf->result || (reply && strstr (reply, "ERROR"))) {
+        if (!error)
+            error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "IMS setup step %u refused: result %u%s%s", ctx->step,
+                                 cnf ? cnf->result : 0, reply ? ": " : "", reply ? reply : "");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    /* the list confirmed: experiment B sends the initial-attach APN now */
+    if (ctx->step == 5 && ia_send (ctx->ims, "start-up", (GAsyncReadyCallback) setup_ia_ready, task))
+        return;
+    ctx->step++;
+    setup_step (task);
+}
+
+typedef struct { MMMtkCcciIms *ims; guint epoch; } Poll;
+static gboolean tick (gpointer user_data);
+
+/* the late IA of experiment B, between the data bearer's profile list and
+ * its activation; not fatal for the bearer */
+static void data_ia_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+
+    if (ctx->epoch == ctx->ims->epoch && ctx->ims->enabled) {
+        ia_finish (ctx->ims, port, res);
+        g_task_return_boolean (task, TRUE);
+    } else {
+        g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, NULL);
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "Data profile update superseded");
+    }
+    g_object_unref (task);
+}
+
+static void data_profiles_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    GError *error = NULL;
+    g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, &error);
+
+    trace_confirm (ctx->ims, "APN profile list (data bearer)", cnf, error);
+    if (ctx->epoch != ctx->ims->epoch || !ctx->ims->enabled) {
+        g_clear_error (&error);
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "Data profile update superseded");
+    } else if (!cnf || cnf->result) {
+        ctx->ims->profiles_complete = FALSE;
+        if (!error)
+            error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "Data APN profiles refused: result %u", cnf->result);
+        g_task_return_error (task, error);
+    } else {
+        ctx->ims->profiles_complete = TRUE;
+        /* experiment B when the start-up had no internet APN: the first
+         * moment it is known is this list */
+        if (ia_send (ctx->ims, "late: the internet APN became known with the data bearer",
+                     (GAsyncReadyCallback) data_ia_ready, task))
+            return;
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+
+void mm_mtk_ccci_ims_prepare_data (MMMtkCcciIms *ims, const gchar *apn,
+                                  GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (ims->owner, NULL, callback, user_data);
+    g_autoptr(GByteArray) tlvs = NULL;
+    Poll *ctx;
+
+    if (!ims->enabled || !ims->configured) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE, "IMS profiles are not ready");
+        g_object_unref (task);
+        return;
+    }
+    tlvs = apn && apn[0] ? mm_mipc_build_apn_profiles (apn, ims->ims_apn, ims->sos_apn) : NULL;
+    if (!tlvs) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid internet APN profiles");
+        g_object_unref (task);
+        return;
+    }
+    /* NM's requested APN is authoritative. Keep it for any background refresh,
+     * which must not replace it with a remaining IMS-only context. Always wait
+     * for this request's confirm before letting the bearer activate data. */
+    if (!ims->internet_apn || g_strcmp0 (ims->internet_apn, apn))
+        ims->internet_source = "the data bearer (NetworkManager's APN)";
+    g_free (ims->internet_apn);
+    ims->internet_apn = g_strdup (apn);
+    ims->profiles_complete = FALSE;
+    ctx = g_new0 (Poll, 1);
+    ctx->ims = ims;
+    ctx->epoch = ims->epoch;
+    g_task_set_task_data (task, ctx, g_free);
+    trace_profiles_request (ims, apn, "data bearer");
+    mm_port_mipc_request (ims->port, MM_MIPC_APN_ADD_PROFILE_LIST_REQ, ims->slot,
+                          tlvs, 15, NULL, (GAsyncReadyCallback) data_profiles_ready, task);
+}
+
+gboolean mm_mtk_ccci_ims_prepare_data_finish (GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static const struct {
+    guint        step;
+    guint        bit;
+    const gchar *what;
+    const gchar *property;
+} start_switches[] = {
+    { 2, MM_MTK_CCCI_IMS_STEP_MIPC_CONFIG, "IMS_SET_CONFIG key form", "ID_MM_MTK_CCCI_IMS_MIPC_CONFIG" },
+    { 3, MM_MTK_CCCI_IMS_STEP_MIPC_CONFIG, "IMS_SET_CONFIG flags form", "ID_MM_MTK_CCCI_IMS_MIPC_CONFIG" },
+    { 6, MM_MTK_CCCI_IMS_STEP_CIREG,       "AT+CIREG=2", "ID_MM_MTK_CCCI_CIREG" },
+    { 7, MM_MTK_CCCI_IMS_STEP_EIMSPDN,     "AT+EIMSPDN", "ID_MM_MTK_CCCI_EIMSPDN" },
+    { 8, MM_MTK_CCCI_IMS_STEP_EIMSCFG,     "AT+EIMSCFG", "ID_MM_MTK_CCCI_EIMSCFG" },
+    { 9, MM_MTK_CCCI_IMS_STEP_EIMSRCS,     "AT+EIMSRCS", "ID_MM_MTK_CCCI_EIMSRCS" },
+};
+
+/* a start-up step switched off: traced and skipped (the order of the
+ * others is unchanged) */
+static gboolean setup_step_off (MMMtkCcciIms *ims, guint step)
+{
+    guint i;
+
+    if (step == 5 && ims->profiles_mode != MM_MTK_CCCI_IMS_PROFILES_BEFORE_RADIO) {
+        ims->profiles_held = TRUE;
+        ims_trace (ims, "start-up step APN profile list: %s (ID_MM_MTK_CCCI_START_PROFILES)",
+                   ims->profiles_mode == MM_MTK_CCCI_IMS_PROFILES_OFF ? "off, only with a data bearer"
+                                                                       : "held until the first registration");
+        return TRUE;
+    }
+    for (i = 0; i < G_N_ELEMENTS (start_switches); i++)
+        if (start_switches[i].step == step && !(ims->start_steps & start_switches[i].bit)) {
+            ims_trace (ims, "start-up step %s: off (%s=0)", start_switches[i].what, start_switches[i].property);
+            return TRUE;
+        }
+    return FALSE;
+}
+
+static void setup_step (GTask *task)
+{
+    Setup *ctx = g_task_get_task_data (task);
+    MMMtkCcciIms *ims = ctx->ims;
+    g_autoptr(GByteArray) tlvs = NULL;
+    const gchar *at = NULL;
+    guint16 id = 0;
+    static const guint8 flags[6] = { 1, 0, 0, 0, 1, 1 };
+
+    if (!ims->enabled || ctx->epoch != ims->epoch) {
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "IMS startup stopped");
+        g_object_unref (task);
+        return;
+    }
+    if (setup_step_off (ims, ctx->step)) {
+        ctx->step++;
+        setup_step (task);
+        return;
+    }
+    switch (ctx->step) {
+    case 0: at = "+CIREG?"; break;
+    case 1:
+        if (ctx->warm || !ims->radio_owner) { ctx->step++; setup_step (task); return; }
+        at = "+CFUN=4"; break;
+    case 2: id = MM_MIPC_IMS_SET_CONFIG_REQ; tlvs = mm_mipc_build_ims_config (TRUE, flags); break;
+    case 3: id = MM_MIPC_IMS_SET_CONFIG_REQ; tlvs = mm_mipc_build_ims_config (FALSE, flags); break;
+    case 4: at = "+CGDCONT?"; break;
+    case 5:
+        id = MM_MIPC_APN_ADD_PROFILE_LIST_REQ;
+        tlvs = mm_mipc_build_apn_profiles (ims->internet_apn, ims->ims_apn, ims->sos_apn);
+        ims->profiles_complete = ims->internet_apn != NULL;
+        trace_profiles_request (ims, ims->internet_apn, "start-up");
+        break;
+    case 6: at = "+CIREG=2"; break;
+    case 7: at = "+EIMSPDN= \"onoff\",1"; break;
+    case 8: at = "+EIMSCFG=1,0,0,0,1,1"; break;
+    case 9:
+        id = MM_MIPC_SYS_AT_REQ;
+        tlvs = g_byte_array_new ();
+        mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_AT_STRING, "AT+EIMSRCS=0,0");
+        break;
+    default:
+        ims->configured = TRUE;
+        ims->next_poll = 0;
+        if (!ims->timer)
+            ims->timer = g_timeout_add_seconds (5, tick, ims);
+        mm_obj_msg (ims->owner, "IMS SIM%u configured before radio-on%s", ims->slot, ctx->warm ? " (already registered, radio kept on)" : "");
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    if (at)
+        ims_at_command (ims, at, 15, (GAsyncReadyCallback) setup_at_ready, task);
+    else if (tlvs)
+        mm_port_mipc_request (ims->port, id, ims->slot, tlvs, 15, NULL, (GAsyncReadyCallback) setup_mipc_ready, task);
+    else {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid IMS APN profiles");
+        g_object_unref (task);
+    }
+}
+
+static void poll_done (GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    if (ctx->epoch == ctx->ims->epoch)
+        ctx->ims->poll_busy = FALSE;
+    g_object_unref (task);
+}
+
+static void refresh_ia_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+
+    if (ctx->epoch == ctx->ims->epoch)
+        ia_finish (ctx->ims, port, res);
+    else {
+        g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, NULL);
+    }
+    poll_done (task);
+}
+
+static void profiles_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, &error);
+    if (ctx->epoch == ctx->ims->epoch) {
+        trace_confirm (ctx->ims, "APN profile list (refresh)", cnf, error);
+        ctx->ims->profiles_complete = cnf && !cnf->result;
+        if (!ctx->ims->profiles_complete)
+            mm_obj_warn (ctx->ims->owner, "IMS APN refresh failed: %s", error ? error->message : "refused");
+        /* experiment B, when the start-up had no internet APN for it */
+        else if (ctx->ims->enabled &&
+                 ia_send (ctx->ims, "refresh", (GAsyncReadyCallback) refresh_ia_ready, task))
+            return;
+    }
+    poll_done (task);
+}
+
+static void apn_ready (GObject *source, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar *reply = ims_at_finish (source, res, &error);
+    if (ctx->epoch == ctx->ims->epoch && ctx->ims->enabled) {
+        g_autoptr(GByteArray) tlvs = NULL;
+        read_apn (ctx->ims, reply);
+        trace_cid0 (ctx->ims, reply, "refresh");
+        if (ctx->ims->internet_apn) {
+            tlvs = mm_mipc_build_apn_profiles (ctx->ims->internet_apn, ctx->ims->ims_apn, ctx->ims->sos_apn);
+            if (tlvs) {
+                trace_profiles_request (ctx->ims, ctx->ims->internet_apn, "refresh");
+                mm_port_mipc_request (ctx->ims->port, MM_MIPC_APN_ADD_PROFILE_LIST_REQ, ctx->ims->slot,
+                                      tlvs, 15, NULL, (GAsyncReadyCallback) profiles_ready, task);
+                return;
+            }
+        }
+    }
+    poll_done (task);
+}
+
+static void registration_ready (GObject *source, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar *reply = ims_at_finish (source, res, &error);
+    guint n, reg, services;
+    if (ctx->epoch == ctx->ims->epoch && ctx->ims->enabled) {
+        if (reply && sscanf (reply, "+CIREG: %u , %u , %x", &n, &reg, &services) == 3)
+            set_registration (ctx->ims, reg, services);
+        ctx->ims->next_poll = g_get_monotonic_time () + (ctx->ims->registered ? 60 : 5) * G_USEC_PER_SEC;
+        if (!ctx->ims->profiles_complete && !ctx->ims->profiles_held) {
+            ims_at_command (ctx->ims, "+CGDCONT?", 5, (GAsyncReadyCallback) apn_ready, task);
+            return;
+        }
+    }
+    poll_done (task);
+}
+
+static gboolean tick (gpointer user_data)
+{
+    MMMtkCcciIms *ims = user_data;
+    GTask *task;
+    Poll *ctx;
+    if (ims->poll_busy || g_get_monotonic_time () < ims->next_poll)
+        return G_SOURCE_CONTINUE;
+    ims->poll_busy = TRUE;
+    task = g_task_new (ims->owner, NULL, NULL, NULL);
+    ctx = g_new0 (Poll, 1);
+    ctx->ims = ims;
+    ctx->epoch = ims->epoch;
+    g_task_set_task_data (task, ctx, g_free);
+    ims_at_command (ims, "+CIREG?", 5, (GAsyncReadyCallback) registration_ready, task);
+    return G_SOURCE_CONTINUE;
+}
+
+static void setup_internal_ready (GObject *source, GAsyncResult *res, MMMtkCcciIms *ims)
+{
+    g_autoptr(GPtrArray) waiters = NULL;
+    g_autoptr(GError) error = NULL;
+    guint i;
+
+    g_task_propagate_boolean (G_TASK (res), &error);
+    waiters = g_steal_pointer (&ims->setup_waiters);
+    for (i = 0; waiters && i < waiters->len; i++) {
+        GTask *task = g_ptr_array_index (waiters, i);
+        if (error)
+            g_task_return_error (task, g_error_copy (error));
+        else
+            g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+    }
+}
+
+void mm_mtk_ccci_ims_setup (MMMtkCcciIms *ims, GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (ims->owner, NULL, callback, user_data);
+    GTask *internal;
+    Setup *ctx;
+    if (ims->enabled && ims->configured) {
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+    }
+    /* Two modem objects (one per SIM) and the radio coordinator may ask for
+     * the same stack's setup at once: one sequence runs, all get its result. */
+    if (ims->setup_waiters) {
+        g_ptr_array_add (ims->setup_waiters, task);
+        return;
+    }
+    ims->setup_waiters = g_ptr_array_new ();
+    g_ptr_array_add (ims->setup_waiters, task);
+    internal = g_task_new (ims->owner, NULL, (GAsyncReadyCallback) setup_internal_ready, ims);
+    ctx = g_new0 (Setup, 1);
+    ims->enabled = TRUE;
+    ctx->ims = ims;
+    ctx->epoch = ims->epoch;
+    g_task_set_task_data (internal, ctx, g_free);
+    setup_step (internal);
+}
+
+gboolean mm_mtk_ccci_ims_setup_finish (GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+gboolean mm_mtk_ccci_ims_owns_link (MMMtkCcciIms *ims, guint link_id)
+{
+    GHashTableIter iter;
+    gpointer value;
+    if (!ims)
+        return FALSE;
+    g_hash_table_iter_init (&iter, ims->pdns);
+    while (g_hash_table_iter_next (&iter, NULL, &value)) {
+        ImsPdn *p = value;
+        if (p->labelled && p->tid % 100 == link_id)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+void mm_mtk_ccci_ims_stop (MMMtkCcciIms *ims)
+{
+    if (!ims)
+        return;
+    ims->epoch++;
+    ims->enabled = ims->configured = ims->registered = ims->poll_busy = FALSE;
+    ims->ia_done = FALSE;
+    ims->profiles_held = FALSE;
+    if (ims->timer) { g_source_remove (ims->timer); ims->timer = 0; }
+    g_hash_table_remove_all (ims->pdns);
+    g_hash_table_remove_all (ims->spis);
+}
+
+static void port_lost (MMPortMipc *port, MMMtkCcciIms *ims)
+{
+    mm_mtk_ccci_ims_stop (ims);
+}
+
+MMMtkCcciIms *mm_mtk_ccci_ims_new (gpointer owner, MMPortMipc *port, guint8 slot, const gchar *wwan)
+{
+    MMMtkCcciIms *ims = g_new0 (MMMtkCcciIms, 1);
+    ims->radio_owner = TRUE;
+    ims->start_steps = MM_MTK_CCCI_IMS_STEPS_ALL;
+    ims->owner = owner;
+    ims->port = g_object_ref (port);
+    ims->slot = slot;
+    ims->wwan = g_strdup (wwan);
+    ims->ims_apn = g_strdup ("ims");
+    ims->sos_apn = g_strdup ("sos");
+    ims->pdns = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL, (GDestroyNotify) pdn_free);
+    ims->spis = g_hash_table_new (g_direct_hash, g_direct_equal);
+    g_signal_connect (port, MM_PORT_MIPC_SIGNAL_INDICATION, G_CALLBACK (indication), ims);
+    g_signal_connect (port, "forced-close", G_CALLBACK (port_lost), ims);
+    return ims;
+}
+
+void mm_mtk_ccci_ims_free (MMMtkCcciIms *ims)
+{
+    if (!ims)
+        return;
+    mm_mtk_ccci_ims_stop (ims);
+    g_signal_handlers_disconnect_by_data (ims->port, ims);
+    g_object_unref (ims->port);
+    g_hash_table_unref (ims->pdns);
+    g_hash_table_unref (ims->spis);
+    g_free (ims->wwan);
+    g_free (ims->internet_apn);
+    g_free (ims->ims_apn);
+    g_free (ims->sos_apn);
+    g_free (ims);
+}
+
+void mm_mtk_ccci_ims_set_profiles (MMMtkCcciIms *ims, const gchar *internet, const gchar *internet_source,
+                                   const gchar *ims_apn, const gchar *sos)
+{
+    if (internet && internet[0]) {
+        g_free (ims->internet_apn);
+        ims->internet_apn = g_strdup (internet);
+        ims->internet_source = internet_source ? internet_source : "configuration";
+    }
+    if (ims_apn) { g_free (ims->ims_apn); ims->ims_apn = g_strdup (ims_apn); }
+    if (sos) { g_free (ims->sos_apn); ims->sos_apn = g_strdup (sos); }
+}
+
+void mm_mtk_ccci_ims_set_radio_owner (MMMtkCcciIms *ims, gboolean owner)
+{
+    ims->radio_owner = owner;
+}
+
+void mm_mtk_ccci_ims_set_radio_hook (MMMtkCcciIms *ims, MMMtkCcciImsRadioHook hook, gpointer data)
+{
+    ims->radio_hook = hook;
+    ims->radio_hook_data = data;
+}
+
+guint8 mm_mtk_ccci_ims_get_slot (MMMtkCcciIms *ims)
+{
+    return ims->slot;
+}
+
+gboolean mm_mtk_ccci_ims_is_configured (MMMtkCcciIms *ims)
+{
+    return ims && ims->enabled && ims->configured;
+}
+
+gboolean mm_mtk_ccci_ims_is_registered (MMMtkCcciIms *ims)
+{
+    return ims && ims->registered;
+}
+
+void mm_mtk_ccci_ims_set_start_steps (MMMtkCcciIms *ims, guint steps, MMMtkCcciImsProfiles profiles)
+{
+    if (ims->start_steps != steps || ims->profiles_mode != profiles)
+        mm_obj_msg (ims->owner, "SIM%u start-up steps: IMS MIPC config %s, CIREG=2 %s, EIMSPDN %s, EIMSCFG %s, "
+                    "EIMSRCS %s, APN profile list %s", ims->slot,
+                    steps & MM_MTK_CCCI_IMS_STEP_MIPC_CONFIG ? "on" : "off",
+                    steps & MM_MTK_CCCI_IMS_STEP_CIREG ? "on" : "off",
+                    steps & MM_MTK_CCCI_IMS_STEP_EIMSPDN ? "on" : "off",
+                    steps & MM_MTK_CCCI_IMS_STEP_EIMSCFG ? "on" : "off",
+                    steps & MM_MTK_CCCI_IMS_STEP_EIMSRCS ? "on" : "off",
+                    profiles == MM_MTK_CCCI_IMS_PROFILES_BEFORE_RADIO ? "before radio-on" :
+                    profiles == MM_MTK_CCCI_IMS_PROFILES_AFTER_REGISTRATION ? "after the first registration" : "off");
+    ims->start_steps = steps;
+    ims->profiles_mode = profiles;
+}
+
+/* the held list: sent like the start-up one (IMS and SOS records even
+ * without an internet APN), then experiment B's IA */
+static void held_profiles_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (port, res, &error);
+
+    if (ctx->epoch == ctx->ims->epoch && ctx->ims->enabled) {
+        trace_confirm (ctx->ims, "APN profile list (after the first registration)", cnf, error);
+        ctx->ims->profiles_complete = cnf && !cnf->result && ctx->ims->internet_apn;
+        if (cnf && !cnf->result &&
+            ia_send (ctx->ims, "after the first registration", (GAsyncReadyCallback) refresh_ia_ready, task))
+            return;
+    }
+    poll_done (task);
+}
+
+static void held_apn_ready (GObject *source, GAsyncResult *res, GTask *task)
+{
+    Poll *ctx = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar *reply = ims_at_finish (source, res, &error);
+    g_autoptr(GByteArray) tlvs = NULL;
+
+    if (ctx->epoch == ctx->ims->epoch && ctx->ims->enabled) {
+        read_apn (ctx->ims, reply);
+        trace_cid0 (ctx->ims, reply, "after the first registration");
+        tlvs = mm_mipc_build_apn_profiles (ctx->ims->internet_apn, ctx->ims->ims_apn, ctx->ims->sos_apn);
+        if (tlvs) {
+            trace_profiles_request (ctx->ims, ctx->ims->internet_apn, "after the first registration");
+            mm_port_mipc_request (ctx->ims->port, MM_MIPC_APN_ADD_PROFILE_LIST_REQ, ctx->ims->slot,
+                                  tlvs, 15, NULL, (GAsyncReadyCallback) held_profiles_ready, task);
+            return;
+        }
+    }
+    poll_done (task);
+}
+
+void mm_mtk_ccci_ims_registered (MMMtkCcciIms *ims)
+{
+    GTask *task;
+    Poll *ctx;
+
+    if (!ims || !ims->enabled || !ims->profiles_held ||
+        ims->profiles_mode != MM_MTK_CCCI_IMS_PROFILES_AFTER_REGISTRATION)
+        return;
+    ims->profiles_held = FALSE;
+    ims_trace (ims, "first registration: the held APN profile list now");
+    if (ims->poll_busy) {
+        /* the poll in flight reads CGDCONT? and sends the list itself */
+        ims->next_poll = 0;
+        return;
+    }
+    ims->poll_busy = TRUE;
+    task = g_task_new (ims->owner, NULL, NULL, NULL);
+    ctx = g_new0 (Poll, 1);
+    ctx->ims = ims;
+    ctx->epoch = ims->epoch;
+    g_task_set_task_data (task, ctx, g_free);
+    ims_at_command (ims, "+CGDCONT?", 5, (GAsyncReadyCallback) held_apn_ready, task);
+}
diff --git a/src/plugins/mtk-ccci/mm-mtk-ccci-ims.h b/src/plugins/mtk-ccci/mm-mtk-ccci-ims.h
new file mode 100644
index 00000000..2234e930
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mtk-ccci-ims.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com> */
+#ifndef MM_MTK_CCCI_IMS_H
+#define MM_MTK_CCCI_IMS_H
+#include "mm-base-modem.h"
+#include "mm-port-mipc.h"
+typedef struct _MMMtkCcciIms MMMtkCcciIms;
+/* @owner (a GObject and MMLogObject) is the source object of every result
+ * of the controller, also of mm_mtk_ccci_ims_setup/prepare_data: a caller's
+ * callback must take its own object from its own task, not from @source. */
+MMMtkCcciIms *mm_mtk_ccci_ims_new (gpointer owner, MMPortMipc *port, guint8 slot, const gchar *wwan);
+void mm_mtk_ccci_ims_set_radio_owner (MMMtkCcciIms *ims, gboolean owner);
+/* The radio-off step (CFUN=4) of a cold setup of a radio owner goes through
+ * @hook instead of the owner modem's AT port when set: the hook completes
+ * @task (source tag mm_mtk_ccci_ims_set_radio_hook) with a gchar * reply
+ * (g_task_return_pointer, g_free) or an error. */
+typedef void (*MMMtkCcciImsRadioHook) (MMMtkCcciIms *ims, guint8 slot, GTask *task, gpointer data);
+void mm_mtk_ccci_ims_set_radio_hook (MMMtkCcciIms *ims, MMMtkCcciImsRadioHook hook, gpointer data);
+guint8 mm_mtk_ccci_ims_get_slot (MMMtkCcciIms *ims);
+gboolean mm_mtk_ccci_ims_is_configured (MMMtkCcciIms *ims);
+gboolean mm_mtk_ccci_ims_is_registered (MMMtkCcciIms *ims);
+/* @internet_source: where @internet comes from, for the trace (static text) */
+void mm_mtk_ccci_ims_set_profiles (MMMtkCcciIms *ims, const gchar *internet, const gchar *internet_source,
+                                   const gchar *ims_apn, const gchar *sos);
+/* the initial-attach experiment: FALSE (A, default) sends the profile list only;
+ * TRUE (B) also sends APN_SET_IA_REQ with the slot's internet profile once
+ * the list is confirmed */
+void mm_mtk_ccci_ims_set_initial_attach (MMMtkCcciIms *ims, gboolean enabled);
+
+/* the start-up steps before radio-on, each switchable; all on and the profile list before radio-on by default */
+#define MM_MTK_CCCI_IMS_STEP_MIPC_CONFIG 0x01   /* IMS_SET_CONFIG key and flags forms */
+#define MM_MTK_CCCI_IMS_STEP_CIREG       0x02   /* AT+CIREG=2 */
+#define MM_MTK_CCCI_IMS_STEP_EIMSPDN     0x04   /* AT+EIMSPDN= "onoff",1 */
+#define MM_MTK_CCCI_IMS_STEP_EIMSCFG     0x08   /* AT+EIMSCFG=1,0,0,0,1,1 */
+#define MM_MTK_CCCI_IMS_STEP_EIMSRCS     0x10   /* AT+EIMSRCS=0,0 */
+#define MM_MTK_CCCI_IMS_STEPS_ALL        0x1f
+typedef enum {
+    MM_MTK_CCCI_IMS_PROFILES_BEFORE_RADIO,   /* in the start-up sequence (default) */
+    MM_MTK_CCCI_IMS_PROFILES_AFTER_REGISTRATION, /* after the slot's first registration */
+    MM_MTK_CCCI_IMS_PROFILES_OFF,            /* only with a data bearer */
+} MMMtkCcciImsProfiles;
+void mm_mtk_ccci_ims_set_start_steps (MMMtkCcciIms *ims, guint steps, MMMtkCcciImsProfiles profiles);
+/* the slot's first registration result (stat 1 or 5): a profile list held
+ * back (AFTER_REGISTRATION) is sent now */
+void mm_mtk_ccci_ims_registered (MMMtkCcciIms *ims);
+void mm_mtk_ccci_ims_free (MMMtkCcciIms *ims);
+void mm_mtk_ccci_ims_stop (MMMtkCcciIms *ims);
+void mm_mtk_ccci_ims_setup (MMMtkCcciIms *ims, GAsyncReadyCallback callback, gpointer user_data);
+gboolean mm_mtk_ccci_ims_setup_finish (GAsyncResult *res, GError **error);
+void mm_mtk_ccci_ims_prepare_data (MMMtkCcciIms *ims, const gchar *apn,
+                                  GAsyncReadyCallback callback, gpointer user_data);
+gboolean mm_mtk_ccci_ims_prepare_data_finish (GAsyncResult *res, GError **error);
+void mm_mtk_ccci_ims_urc (MMMtkCcciIms *ims, const gchar *line);
+gboolean mm_mtk_ccci_ims_owns_link (MMMtkCcciIms *ims, guint link_id);
+#endif
