+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+static gboolean supported_finish (MMIfaceModemMessaging *modem, GAsyncResult *res,
+                                  GArray **mem1, GArray **mem2, GArray **mem3, GError **error)
+{
+    MMSmsStorage values[] = { MM_SMS_STORAGE_SM, MM_SMS_STORAGE_ME };
+    GArray **arrays[] = { mem1, mem2, mem3 };
+    guint i;
+    if (!success_finish (modem, res, error))
+        return FALSE;
+    for (i = 0; i < G_N_ELEMENTS (arrays); i++) {
+        *arrays[i] = g_array_new (FALSE, FALSE, sizeof (MMSmsStorage));
+        g_array_append_vals (*arrays[i], values, t.only_sm ? 1 : 2);
+    }
+    return TRUE;
+}
+static gboolean current_finish (MMIfaceModemMessaging *modem, GAsyncResult *res,
+                                MMSmsStorage *storage, GError **error)
+{
+    *storage = MM_SMS_STORAGE_SM;
+    return success_finish (modem, res, error);
+}
+
+/* The storage boundary substitutes a received PDU; MM's actual SMS objects,
+ * list and duplicate detection remain real. Nothing is sent to a phone. */
+static void scan (MMIfaceModemMessaging *modem, MMSmsStorage storage,
+                  GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (modem, NULL, callback, user_data);
+    t.scans++;
+    if (t.pause_first && t.scans == 1) {
+        t.pending = task;
+        return;
+    }
+    if (t.fail_first && t.scans == 1) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_RETRY, "Injected busy SMS storage");
+    } else {
+        if (storage == MM_SMS_STORAGE_SM) {
+            GError *error = NULL;
+            MMSmsPart *part = mm_sms_part_3gpp_new_from_pdu (1, "0004049121430000620103000000000141", modem, &error);
+            g_assert_no_error (error);
+            g_assert_nonnull (part);
+            if (!mm_iface_modem_messaging_take_part (modem,
+                    mm_broadband_modem_create_sms (MM_BROADBAND_MODEM (modem)),
+                    part, MM_SMS_STATE_RECEIVED, storage, &error)) {
+                g_assert_nonnull (error);
+                g_assert_nonnull (strstr (error->message, "already taken"));
+                g_clear_error (&error);
+            }
+        }
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+
+static void messaging_init (MMIfaceModemMessagingInterface *iface)
+{
+    iface->check_support = success;
+    iface->check_support_finish = success_finish;
+    iface->load_supported_storages = success;
+    iface->load_supported_storages_finish = supported_finish;
+    iface->init_current_storages = success;
+    iface->init_current_storages_finish = current_finish;
+    iface->load_initial_sms_parts = scan;
+    iface->load_initial_sms_parts_finish = success_finish;
+}
+static void sms_test_modem_init (SmsTestModem *self) { }
+static void sms_test_modem_class_init (SmsTestModemClass *klass) { }
+
+static void drain (void)
+{
+    while (g_main_context_pending (NULL))
+        g_main_context_iteration (NULL, FALSE);
+}
+
+static void test_poll (gconstpointer scenario)
+{
+    guint which = GPOINTER_TO_UINT (scenario);
+    MMBaseModem *modem;
+    MMSmsList *list;
+    MmGdbusModem *skeleton;
+    memset (&t, 0, sizeof (t));
+    t.fail_first = which == 1;
+    t.pause_first = which == 2;
+    t.only_sm = which == 4;
+    t.loop = g_main_loop_new (NULL, FALSE);
+    modem = g_object_new (sms_test_modem_get_type (), MM_BASE_MODEM_DEVICE, "/sys/test",
+                          MM_BASE_MODEM_PLUGIN, "sms-test", NULL);
+    skeleton = mm_gdbus_modem_skeleton_new ();
+    mm_gdbus_modem_set_current_capabilities (skeleton, MM_MODEM_CAPABILITY_GSM_UMTS);
+    g_object_set (modem, MM_IFACE_MODEM_DBUS_SKELETON, skeleton, NULL);
+    g_object_unref (skeleton);
+    mm_iface_modem_messaging_initialize (MM_IFACE_MODEM_MESSAGING (modem), NULL, completed, NULL);
+    g_main_loop_run (t.loop);
+    list = mm_sms_list_new (G_OBJECT (modem));
+    g_object_set (modem, MM_IFACE_MODEM_MESSAGING_SMS_LIST, list,
+                  MM_IFACE_MODEM_MESSAGING_SMS_PDU_MODE, TRUE,
+                  MM_IFACE_MODEM_STATE, MM_MODEM_STATE_REGISTERED, NULL);
+    mm_mtk_ccci_sms_poll_start (modem);
+
+    if (which == 3) {
+        g_object_set (modem, MM_IFACE_MODEM_MESSAGING_SMS_DEFAULT_STORAGE, MM_SMS_STORAGE_UNKNOWN, NULL);
+        mm_mtk_ccci_sms_poll_now (modem);
+        drain ();
+        g_assert_cmpuint (t.scans, ==, 0);
+        g_object_set (modem, MM_IFACE_MODEM_MESSAGING_SMS_DEFAULT_STORAGE, MM_SMS_STORAGE_SM,
+                      MM_IFACE_MODEM_STATE, MM_MODEM_STATE_DISABLED, NULL);
+        mm_mtk_ccci_sms_poll_now (modem);
+        drain ();
+        g_assert_cmpuint (t.scans, ==, 0);
+    } else {
+        mm_mtk_ccci_sms_poll_now (modem);
+        mm_mtk_ccci_sms_poll_now (modem); /* during a scan: exactly one more after it */
+        mm_mtk_ccci_sms_poll_notify (modem, "test notice");
+        if (t.pause_first) {
+            g_assert_cmpuint (t.scans, ==, 1);
+            mm_mtk_ccci_sms_poll_stop (modem);
+            g_task_return_boolean (t.pending, TRUE);
+            g_object_unref (t.pending);
+            drain ();
+            g_assert_cmpuint (t.scans, ==, 1); /* no ME scan and no follow-up after stopping */
+            mm_mtk_ccci_sms_poll_start (modem);
+        } else {
+            drain ();
+            g_assert_cmpuint (t.scans, ==, (t.only_sm ? 1 : 2) * 2);
+        }
+        mm_mtk_ccci_sms_poll_now (modem);
+        drain ();
+        g_assert_cmpuint (mm_sms_list_get_count (list), ==, 1);
+        /* Another scan must retain the stored message without duplicating it. */
+        mm_mtk_ccci_sms_poll_now (modem);
+        drain ();
+        g_assert_cmpuint (mm_sms_list_get_count (list), ==, 1);
+        /* no suspend happened: activity does not start a scan */
+        {
+            guint before = t.scans;
+            mm_mtk_ccci_sms_poll_check_resume (modem);
+            drain ();
+            g_assert_cmpuint (t.scans, ==, before);
+        }
+    }
+    mm_mtk_ccci_sms_poll_stop (modem);
+    g_object_set (modem, MM_IFACE_MODEM_MESSAGING_SMS_LIST, NULL, NULL);
+    mm_iface_modem_messaging_shutdown (MM_IFACE_MODEM_MESSAGING (modem));
+    g_object_unref (list);
+    g_object_unref (modem);
+    g_main_loop_unref (t.loop);
+}
+
+int main (int argc, char **argv)
+{
+    GError *error = NULL;
+    gint result;
+    g_test_init (&argc, &argv, NULL);
+    g_assert_true (mm_log_setup ("ERR", NULL, FALSE, FALSE, FALSE, FALSE, &error));
+    g_assert_no_error (error);
+    g_test_add_data_func ("/MM/mtk-ccci/sms-poll/recover-and-deduplicate", GUINT_TO_POINTER (0), test_poll);
+    g_test_add_data_func ("/MM/mtk-ccci/sms-poll/storage-busy", GUINT_TO_POINTER (1), test_poll);
+    g_test_add_data_func ("/MM/mtk-ccci/sms-poll/stop-pending", GUINT_TO_POINTER (2), test_poll);
+    g_test_add_data_func ("/MM/mtk-ccci/sms-poll/not-ready", GUINT_TO_POINTER (3), test_poll);
+    g_test_add_data_func ("/MM/mtk-ccci/sms-poll/sm-only", GUINT_TO_POINTER (4), test_poll);
+    result = g_test_run ();
+    mm_log_shutdown ();
+    return result;
+}
diff --git a/src/plugins/mtk-ccci/tests/test-sms-ready.c b/src/plugins/mtk-ccci/tests/test-sms-ready.c
new file mode 100644
index 00000000..59283eab
--- /dev/null
+++ b/src/plugins/mtk-ccci/tests/test-sms-ready.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com> */
+#include <config.h>
+#include <string.h>
+#include <mm-errors-types.h>
+#include "mm-mtk-ccci-sms-ready.h"
+#include "mm-base-modem-at.h"
+#include "mm-port-mipc.h"
+#include "mm-log-test.h"
+
+typedef enum { READY, DELAYED, PERMANENT, NEVER_READY, CANCELLED, MALFORMED, EMPTY_STORAGES } Scenario;
+typedef struct { const gchar *command, *reply; gint code; } Response;
+#define STORAGES "+CPMS: (\"SM\",\"ME\"),(\"SM\",\"ME\"),(\"SM\",\"ME\")"
+#define CURRENT "+CPMS: \"SM\",1,10,\"SM\",1,10,\"SM\",1,10"
+static const Response delayed[] = {
+    { "+CPMS=?", NULL, MM_MESSAGE_ERROR_UNKNOWN },
+    { "+CPMS=?", STORAGES, 0 },
+    { "+CPMS?", NULL, MM_MESSAGE_ERROR_ME_FAILURE },
+    { "+CPMS=?", STORAGES, 0 },
+    { "+CPMS?", CURRENT, 0 },
+    { "+CMGF=0", NULL, MM_MESSAGE_ERROR_UNKNOWN },
+    { "+CPMS=?", STORAGES, 0 },
+    { "+CPMS?", CURRENT, 0 },
+    { "+CMGF=0", "", 0 },
+};
+static struct {
+    GMainLoop *loop;
+    GCancellable *cancel;
+    Scenario scenario;
+    guint calls;
+    gboolean ok;
+    GError *error;
+} t;
+
+/* Only AT is mocked. The actual readiness state machine, parsers, retry
+ * timer and cancellation path run normally; no modem/SMS is touched. */
+void mm_base_modem_at_command (MMBaseModem *modem, const gchar *cmd, guint timeout,
+                               gboolean cached, GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (modem, NULL, callback, user_data);
+    const gchar *reply = "";
+    gint code = 0;
+    guint call = t.calls++;
+
+    g_assert_false (cached);
+    g_assert_cmpuint (timeout, <=, 3);
+    if (t.scenario == DELAYED) {
+        g_assert_cmpuint (call, <, G_N_ELEMENTS (delayed));
+        g_assert_cmpstr (cmd, ==, delayed[call].command);
+        reply = delayed[call].reply;
+        code = delayed[call].code;
+    } else if (t.scenario == PERMANENT || t.scenario == NEVER_READY) {
+        g_assert_cmpstr (cmd, ==, "+CPMS=?");
+        code = t.scenario == PERMANENT ? MM_MESSAGE_ERROR_NOT_SUPPORTED : MM_MESSAGE_ERROR_UNKNOWN;
+    } else if (t.scenario == MALFORMED) {
+        g_assert_cmpstr (cmd, ==, "+CPMS=?");
+        reply = "not a storage list";
+    } else if (t.scenario == EMPTY_STORAGES) {
+        g_assert_cmpstr (cmd, ==, "+CPMS=?");
+        reply = "+CPMS: (\"SM\"),(\"SR\"),(\"SR\")";
+    } else {
+        static const gchar *commands[] = { "+CPMS=?", "+CPMS?", "+CMGF=0" };
+        if (call >= G_N_ELEMENTS (commands)) {
+            g_assert_not_reached ();
+            return;
+        }
+        g_assert_cmpstr (cmd, ==, commands[call]);
+        reply = call == 0 ? STORAGES : (call == 1 ? CURRENT : "");
+    }
+    if (t.scenario == CANCELLED)
+        g_cancellable_cancel (t.cancel);
+    if (code)
+        g_task_return_new_error (task, MM_MESSAGE_ERROR, code, "Injected SMS service error");
+    else
+        g_task_return_pointer (task, g_strdup (reply), g_free);
+    g_object_unref (task);
+}
+
+const gchar *mm_base_modem_at_command_finish (MMBaseModem *modem, GAsyncResult *res, GError **error)
+{
+    /* Return a borrowed response, just like MM's AT command API. */
+    GTask *task = G_TASK (res);
+    gchar *reply = g_task_propagate_pointer (task, error);
+    g_task_set_task_data (task, reply, g_free);
+    return reply;
+}
+
+static void completed (GObject *owner, GAsyncResult *res, gpointer unused)
+{
+    t.ok = mm_mtk_ccci_sms_wait_ready_finish (res, &t.error);
+    g_main_loop_quit (t.loop);
+}
+
+static void test_ready (gconstpointer scenario)
+{
+    g_autoptr(MMPortMipc) owner = mm_port_mipc_new ("fake-sms-owner");
+    memset (&t, 0, sizeof (t));
+    t.scenario = GPOINTER_TO_UINT (scenario);
+    t.loop = g_main_loop_new (NULL, FALSE);
+    t.cancel = g_cancellable_new ();
+    mm_mtk_ccci_sms_wait_ready ((MMBaseModem *) owner, t.cancel, completed, NULL);
+    g_main_loop_run (t.loop);
+    if (t.scenario == READY || t.scenario == DELAYED) {
+        g_assert_true (t.ok);
+        g_assert_no_error (t.error);
+        g_assert_cmpuint (t.calls, ==, t.scenario == READY ? 3 : G_N_ELEMENTS (delayed));
+    } else {
+        g_assert_false (t.ok);
+        g_assert_nonnull (t.error);
+        if (t.scenario == CANCELLED)
+            g_assert_error (t.error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+        if (t.scenario == PERMANENT)
+            g_assert_error (t.error, MM_MESSAGE_ERROR, MM_MESSAGE_ERROR_NOT_SUPPORTED);
+        g_assert_cmpuint (t.calls, ==, (t.scenario == NEVER_READY || t.scenario == EMPTY_STORAGES) ? 30 : 1);
+    }
+    g_clear_error (&t.error);
+    g_object_unref (t.cancel);
+    g_main_loop_unref (t.loop);
+}
+
+int main (int argc, char **argv)
+{
+    g_test_init (&argc, &argv, NULL);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/ready", GUINT_TO_POINTER (READY), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/cold-delayed", GUINT_TO_POINTER (DELAYED), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/not-supported", GUINT_TO_POINTER (PERMANENT), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/bounded-retries", GUINT_TO_POINTER (NEVER_READY), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/cancelled", GUINT_TO_POINTER (CANCELLED), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/malformed", GUINT_TO_POINTER (MALFORMED), test_ready);
+    g_test_add_data_func ("/MM/mtk-ccci/sms/no-common-storage", GUINT_TO_POINTER (EMPTY_STORAGES), test_ready);
+    return g_test_run ();
+}
