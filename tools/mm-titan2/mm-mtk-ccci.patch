@@ -0,0 +1,47 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * WWAN link creation over rtnetlink: the equivalent of
+ *   ip link add dev <ifname> parentdev <wwan device> type wwan linkid <N>
+ *   ip link del dev <ifname>
+ * for drivers that register wwan_ops (here the mtk_ccci driver of the MT6878
+ * modem, which creates no default link: every data interface is a link).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_WWAN_LINK_H
+#define MM_WWAN_LINK_H
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* Creates the link; a link with that name that already exists is accepted
+ * (returns TRUE with *out_existed = TRUE) because a crashed daemon may have
+ * left it behind. Synchronous: one request and its acknowledgement. */
+gboolean mm_wwan_link_add (const gchar  *parent_dev,
+                           guint         link_id,
+                           const gchar  *ifname,
+                           gboolean     *out_existed,
+                           GError      **error);
+
+gboolean mm_wwan_link_del (const gchar  *ifname,
+                           GError      **error);
+
+/* IMS links: set MTU/up and an optional address; never routes or DNS. */
+gboolean mm_wwan_link_configure (const gchar *ifname, guint mtu, const gchar *address, GError **error);
+
+G_END_DECLS
+
+#endif /* MM_WWAN_LINK_H */
diff --git a/src/plugins/mtk-ccci/tests/test-bearer-mipc.c b/src/plugins/mtk-ccci/tests/test-bearer-mipc.c
new file mode 100644
index 00000000..941d9bfd
--- /dev/null
+++ b/src/plugins/mtk-ccci/tests/test-bearer-mipc.c
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com> */
+#include <config.h>
+#include <pty.h>
+#include <termios.h>
+#include <unistd.h>
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+#include "mm-bearer-mtk-ccci.h"
+#include "mm-broadband-modem-mtk-ccci.h"
+#include "mm-wwan-link.h"
+#include "mm-log.h"
+
+/* Optional backends are not instantiated, as in upstream test-base-call.c. */
+#if defined WITH_MBIM
+typedef struct MMBroadbandModemMbim MMBroadbandModemMbim;
+GType mm_broadband_modem_mbim_get_type (void);
+MMPortMbim *mm_broadband_modem_mbim_peek_port_mbim (MMBroadbandModemMbim *self);
+GType mm_broadband_modem_mbim_get_type (void) { return G_TYPE_INVALID; }
+MMPortMbim *mm_broadband_modem_mbim_peek_port_mbim (MMBroadbandModemMbim *self) { return NULL; }
+#endif
+#if defined WITH_QMI
+typedef struct MMBroadbandModemQmi MMBroadbandModemQmi;
+GType mm_broadband_modem_qmi_get_type (void);
+MMPortQmi *mm_broadband_modem_qmi_peek_port_qmi (MMBroadbandModemQmi *self);
+GType mm_broadband_modem_qmi_get_type (void) { return G_TYPE_INVALID; }
+MMPortQmi *mm_broadband_modem_qmi_peek_port_qmi (MMBroadbandModemQmi *self) { return NULL; }
+#endif
+
+typedef enum { CANCEL, LINK_ERROR, LINK_EXISTS, LINK_TIMEOUT, IMS_CONFLICT, MISSING_INTERFACE, STALE_LINK,
+               PROFILE_ERROR, CANCEL_PROFILES } Scenario;
+typedef struct {
+    GMainLoop *loop;
+    MMPortMipc *port;
+    GCancellable *cancel;
+    GByteArray *rx;
+    GIOChannel *channel;
+    gint master, slave;
+    guint watch, profiles, activations, deactivations, adds, deletes;
+    Scenario scenario;
+    GError *error;
+    MMBaseModem *modem;
+    MMKernelDevice *kernel;
+    MMPort *old_link;
+    gboolean old_released, replacement_announced;
+} Test;
+static Test *current;
+
+typedef struct { MMKernelDevice parent; } TestLinkDevice;
+typedef struct { MMKernelDeviceClass parent; } TestLinkDeviceClass;
+GType test_link_device_get_type (void);
+G_DEFINE_TYPE (TestLinkDevice, test_link_device, MM_TYPE_KERNEL_DEVICE)
+static const gchar *test_link_subsystem (MMKernelDevice *self) { return "net"; }
+static const gchar *test_link_name (MMKernelDevice *self) { return "wwan-test-2"; }
+static void test_link_device_init (TestLinkDevice *self) { }
+static void test_link_device_class_init (TestLinkDeviceClass *klass)
+{
+    MM_KERNEL_DEVICE_CLASS (klass)->get_subsystem = test_link_subsystem;
+    MM_KERNEL_DEVICE_CLASS (klass)->get_name = test_link_name;
+}
+
+static void link_grabbed (MMBaseModem *modem, MMPort *port, Test *t)
+{
+    if (!t->old_link)
+        t->old_link = g_object_ref (port);
+    else {
+        g_assert_true (port != t->old_link);
+        t->replacement_announced = TRUE;
+    }
+}
+static void link_released (MMBaseModem *modem, MMPort *port, Test *t)
+{
+    if (port == t->old_link)
+        t->old_released = TRUE;
+}
+static gboolean announce_replacement (gpointer data)
+{
+    Test *t = data;
+    g_assert_true (t->old_released);
+    g_assert_true (mm_base_modem_grab_link_port (t->modem, t->kernel, &t->error));
+    g_assert_no_error (t->error);
+    return G_SOURCE_REMOVE;
+}
+
+/* Keep the real broadband/base modem object, but stub the plugin's modem
+ * accessors and rtnetlink boundary. Bearer and MIPC transport are real. */
+G_DEFINE_TYPE (MMBroadbandModemMtkCcci, mm_broadband_modem_mtk_ccci, MM_TYPE_BROADBAND_MODEM)
+static void mm_broadband_modem_mtk_ccci_init (MMBroadbandModemMtkCcci *self) { }
+static void mm_broadband_modem_mtk_ccci_class_init (MMBroadbandModemMtkCcciClass *klass) { }
+MMPortMipc *mm_broadband_modem_mtk_ccci_peek_port_mipc (MMBroadbandModemMtkCcci *self) { return current->port; }
+guint8 mm_broadband_modem_mtk_ccci_get_mipc_slot (MMBroadbandModemMtkCcci *self) { return MM_MIPC_SLOT_SIM2; }
+void mm_broadband_modem_mtk_ccci_trace_event (MMBroadbandModemMtkCcci *self, guint8 slot, const gchar *what) { }
+const gchar *mm_broadband_modem_mtk_ccci_get_wwan_device (MMBroadbandModemMtkCcci *self) { return "wwan-test"; }
+void mm_broadband_modem_mtk_ccci_prepare_data (MMBroadbandModemMtkCcci *self, const gchar *apn,
+                                             GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+    g_assert_cmpstr (apn, ==, "internet.example");
+    g_assert_cmpuint (current->activations, ==, 0);
+    current->profiles++;
+    if (current->scenario == PROFILE_ERROR)
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED, "Injected APN profile refusal");
+    else {
+        if (current->scenario == CANCEL_PROFILES)
+            g_cancellable_cancel (current->cancel);
+        g_task_return_boolean (task, TRUE);
+    }
+    g_object_unref (task);
+}
+gboolean mm_broadband_modem_mtk_ccci_prepare_data_finish (MMBroadbandModemMtkCcci *self,
+                                                        GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+gboolean mm_broadband_modem_mtk_ccci_ims_owns_link (MMBroadbandModemMtkCcci *self, guint id)
+{
+    g_assert_cmpuint (id, ==, 2);
+    return current->scenario == IMS_CONFLICT;
+}
+gboolean mm_wwan_link_add (const gchar *parent, guint id, const gchar *name, gboolean *existed, GError **error)
+{
+    current->adds++;
+    g_assert_cmpstr (parent, ==, "wwan-test");
+    g_assert_cmpuint (id, ==, 2);
+    g_assert_cmpstr (name, ==, "wwan-test-2");
+    *existed = current->scenario == LINK_EXISTS;
+    if (current->scenario == LINK_ERROR) {
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Injected link creation failure");
+        return FALSE;
+    }
+    if (current->scenario == STALE_LINK)
+        g_idle_add (announce_replacement, current);
+    return TRUE;
+}
+gboolean mm_wwan_link_del (const gchar *name, GError **error)
+{
+    g_assert_cmpstr (name, ==, "wwan-test-2");
+    current->deletes++;
+    return TRUE;
+}
+
+static gboolean peer_read (GIOChannel *channel, GIOCondition cond, gpointer data)
+{
+    Test *t = data;
+    guint8 bytes[4096];
+    gsize n = 0, used;
+    MMMipcMsg msg;
+    gint parsed;
+    if (g_io_channel_read_chars (channel, (gchar *) bytes, sizeof (bytes), &n, NULL) != G_IO_STATUS_NORMAL)
+        return G_SOURCE_CONTINUE;
+    g_byte_array_append (t->rx, bytes, n);
+    while ((parsed = mm_mipc_frame_parse (t->rx->data, t->rx->len, &msg, &used)) == 1) {
+        g_autoptr(GByteArray) tlvs = g_byte_array_new ();
+        g_autoptr(GByteArray) frame = NULL;
+        guint32 aid;
+        static const guint8 address[] = { 10, 1, 2, 3 }, dns[] = { 1, 1, 1, 1 };
+        mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_RESULT, 0);
+        switch (msg.msg_id) {
+        case MM_MIPC_INTERNAL_TEST_REQ:
+        case MM_MIPC_INTERNAL_OPEN_REQ:
+            break;
+        case MM_MIPC_DATA_ACT_CALL_REQ:
+            g_assert_cmpuint (t->profiles, ==, 1);
+            g_assert_cmpuint (msg.slot, ==, MM_MIPC_SLOT_SIM2);
+            t->activations++;
+            mm_mipc_tlv_add_u8 (tlvs, MM_MIPC_T_CNF_AID, 7);
+            if (t->scenario != MISSING_INTERFACE)
+                mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_CNF_TRANS_INTF_ID, 202);
+            mm_mipc_tlv_add (tlvs, MM_MIPC_T_CNF_V4_ADDRS, address, sizeof (address));
+            mm_mipc_tlv_add (tlvs, MM_MIPC_T_CNF_V4_DNS, dns, sizeof (dns));
+            if (t->scenario == CANCEL)
+                g_cancellable_cancel (t->cancel);
+            break;
+        case MM_MIPC_DATA_DEACT_CALL_REQ:
+            g_assert_cmpuint (msg.slot, ==, MM_MIPC_SLOT_SIM2);
+            g_assert_true (mm_mipc_tlv_find_uint (msg.payload, msg.len, MM_MIPC_T_DEACT_AID, &aid));
+            g_assert_cmpuint (aid, ==, 7);
+            t->deactivations++;
+            break;
+        default:
+            g_assert_not_reached ();
+        }
+        frame = mm_mipc_frame_build (MM_MIPC_CNF_OF (msg.msg_id), msg.txid, msg.slot, tlvs->data, tlvs->len);
+        g_assert_cmpint (write (t->master, frame->data, frame->len), ==, (gssize) frame->len);
+        g_byte_array_remove_range (t->rx, 0, used);
+    }
+    g_assert_cmpint (parsed, ==, 0);
+    return G_SOURCE_CONTINUE;
+}
+
+static void session_ready (MMPortMipc *port, GAsyncResult *res, Test *t)
+{
+    g_assert_true (mm_port_mipc_open_session_finish (port, res, &t->error));
+    g_assert_no_error (t->error);
+    g_main_loop_quit (t->loop);
+}
+static void connected (MMBaseBearer *bearer, GAsyncResult *res, Test *t)
+{
+    MMBearerConnectResult *result = MM_BASE_BEARER_GET_CLASS (bearer)->connect_finish (bearer, res, &t->error);
+    g_assert_null (result);
+    /* The failure is delivered only after rollback has been confirmed. */
+    g_assert_cmpuint (t->deactivations, ==, (t->scenario == PROFILE_ERROR || t->scenario == CANCEL_PROFILES) ? 0 : 1);
+    if (t->scenario == STALE_LINK) {
+        g_assert_true (t->old_released);
+        g_assert_true (t->replacement_announced);
+    }
+    g_main_loop_quit (t->loop);
+}
+static void test_rollback (gconstpointer data)
+{
+    Test t = { 0 };
+    gchar name[128];
+    struct termios term;
+    g_autoptr(MMBaseModem) modem = NULL;
+    g_autoptr(MMBaseBearer) bearer = NULL;
+    g_autoptr(MMKernelDevice) kernel = NULL;
+    g_autoptr(MMBearerProperties) config = mm_bearer_properties_new ();
+
+    current = &t;
+    t.scenario = GPOINTER_TO_INT (data);
+    t.loop = g_main_loop_new (NULL, FALSE);
+    t.cancel = g_cancellable_new ();
+    t.rx = g_byte_array_new ();
+    g_assert_cmpint (openpty (&t.master, &t.slave, name, NULL, NULL), ==, 0);
+    g_assert_cmpint (tcgetattr (t.slave, &term), ==, 0);
+    cfmakeraw (&term);
+    g_assert_cmpint (tcsetattr (t.slave, TCSANOW, &term), ==, 0);
+    t.channel = g_io_channel_unix_new (t.master);
+    g_io_channel_set_encoding (t.channel, NULL, NULL);
+    g_io_channel_set_buffered (t.channel, FALSE);
+    t.watch = g_io_add_watch (t.channel, G_IO_IN, peer_read, &t);
+    t.port = mm_port_mipc_new (name + 5);
+    g_assert_true (mm_port_mipc_open (t.port, &t.error));
+    g_assert_no_error (t.error);
+    mm_port_mipc_open_session (t.port, MM_MIPC_SLOT_SIM2, NULL, 0, "rollback-test", NULL,
+                               (GAsyncReadyCallback) session_ready, &t);
+    g_main_loop_run (t.loop);
+    modem = g_object_new (MM_TYPE_BROADBAND_MODEM_MTK_CCCI, MM_BASE_MODEM_DEVICE, "/sys/test",
+                          MM_BASE_MODEM_PLUGIN, "mtk-ccci", NULL);
+    if (t.scenario == STALE_LINK) {
+        kernel = g_object_new (test_link_device_get_type (), NULL);
+        t.modem = modem;
+        t.kernel = kernel;
+        g_signal_connect (modem, MM_BASE_MODEM_SIGNAL_LINK_PORT_GRABBED, G_CALLBACK (link_grabbed), &t);
+        g_signal_connect (modem, MM_BASE_MODEM_SIGNAL_LINK_PORT_RELEASED, G_CALLBACK (link_released), &t);
+        g_assert_true (mm_base_modem_grab_link_port (modem, kernel, &t.error));
+        g_assert_no_error (t.error);
+        g_assert_nonnull (t.old_link);
+    }
+    mm_bearer_properties_set_apn (config, "internet.example");
+    mm_bearer_properties_set_ip_type (config, MM_BEARER_IP_FAMILY_IPV4);
+    bearer = mm_bearer_mtk_ccci_new (MM_BROADBAND_MODEM_MTK_CCCI (modem), config);
+    MM_BASE_BEARER_GET_CLASS (bearer)->connect (bearer, t.cancel, (GAsyncReadyCallback) connected, &t);
+    g_main_loop_run (t.loop);
+    g_assert_nonnull (t.error);
+    if (t.scenario == CANCEL || t.scenario == CANCEL_PROFILES)
+        g_assert_error (t.error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+    g_assert_cmpuint (t.profiles, ==, 1);
+    g_assert_cmpuint (t.activations, ==, (t.scenario == PROFILE_ERROR || t.scenario == CANCEL_PROFILES) ? 0 : 1);
+    g_assert_cmpuint (t.adds, ==, (t.scenario == LINK_ERROR || t.scenario == LINK_EXISTS || t.scenario == LINK_TIMEOUT || t.scenario == STALE_LINK) ? 1 : 0);
+    g_assert_cmpuint (t.deletes, ==, (t.scenario == LINK_TIMEOUT || t.scenario == STALE_LINK) ? 1 : 0);
+    g_clear_error (&t.error);
+    g_clear_object (&bearer);
+    g_assert_cmpuint (t.deletes, ==, (t.scenario == LINK_TIMEOUT || t.scenario == STALE_LINK) ? 1 : 0);
+    g_clear_object (&modem);
+    g_clear_object (&t.old_link);
+    mm_port_mipc_close (t.port);
+    g_clear_object (&t.port);
+    g_source_remove (t.watch);
+    g_io_channel_unref (t.channel);
+    g_byte_array_unref (t.rx);
+    g_object_unref (t.cancel);
+    g_main_loop_unref (t.loop);
+    close (t.master);
+    close (t.slave);
+    current = NULL;
+}
+int main (int argc, char **argv)
+{
+    GError *error = NULL;
+    gint result;
+    g_test_init (&argc, &argv, NULL);
+    g_assert_true (mm_log_setup ("ERR", NULL, FALSE, FALSE, FALSE, FALSE, &error));
+    g_assert_no_error (error);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/cancel-after-activation", GINT_TO_POINTER (CANCEL), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/link-error", GINT_TO_POINTER (LINK_ERROR), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/link-exists", GINT_TO_POINTER (LINK_EXISTS), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/link-timeout", GINT_TO_POINTER (LINK_TIMEOUT), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/ims-conflict", GINT_TO_POINTER (IMS_CONFLICT), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/missing-interface", GINT_TO_POINTER (MISSING_INTERFACE), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/stale-link-cache", GINT_TO_POINTER (STALE_LINK), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/profile-error", GINT_TO_POINTER (PROFILE_ERROR), test_rollback);
+    g_test_add_data_func ("/MM/mtk-ccci/bearer/cancel-before-activation", GINT_TO_POINTER (CANCEL_PROFILES), test_rollback);
+    result = g_test_run ();
+    mm_log_shutdown ();
+    return result;
+}
diff --git a/src/plugins/mtk-ccci/tests/test-dual-modem.c b/src/plugins/mtk-ccci/tests/test-dual-modem.c
new file mode 100644
index 00000000..a91cfc0c
--- /dev/null
+++ b/src/plugins/mtk-ccci/tests/test-dual-modem.c
@@ -0,0 +1,1386 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * The dual-modem mode parts of the mtk-ccci plugin against a fake modem on a
+ * pseudo-terminal (the real MMPortMipc transport):
+ *  - the shared context: one MMPortMipc per MIPC channel, kept while any
+ *    modem object holds it (reprobe of either object), session start joined
+ *    (one TEST/OPEN on the wire), one incoming-call approval per command;
+ *  - the DSDS approval policy: reject (cause 21) while the other slot has a
+ *    call, the RSP bytes, the switch, the voice clients;
+ *  - the radio coordinator: the AT+EFUN mask of both stacks, IMS before
+ *    radio-on, serialised requests, SIM-busy retry, the IMS radio-off hook in
+ *    the dual and the single-object mode;
+ *  - the speech path reference count;
+ *  - the AT bridge: ModemManager's own unix-socket AT port (MMPortSerialAt,
+ *    v1 parser) against the bridge, commands as SYS_AT on slot 2, framing,
+ *    local V.250 commands, CME errors, URC forwarding, the CMGS prompt.
+ * Messages: the MIPC session start, the SYS_AT tunnel and the incoming-call approval.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <config.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <termios.h>
+#include <pty.h>
+
+#include <glib.h>
+#include <gio/gio.h>
+
+#include <ModemManager.h>
+#include <mm-errors-types.h>
+#include "mm-port-mipc.h"
+#include "mm-mipc-proto.h"
+#include "mm-log-test.h"
+#include "mm-mtk-ccci-ims.h"
+#include "mm-mtk-ccci-shared.h"
+#include "mm-mtk-ccci-at-bridge.h"
+#include "mm-base-modem-at.h"
+#include "mm-wwan-link.h"
+#include "mm-port-serial-at.h"
+#include "mm-serial-parsers.h"
+#include <gio/gunixsocketaddress.h>
+
+/*****************************************************************************/
+/* boundaries of the IMS controller that these tests never reach */
+
+static guint owner_port_commands;
+
+void
+mm_base_modem_at_command (MMBaseModem *self, const gchar *cmd, guint timeout,
+                          gboolean cached, GAsyncReadyCallback callback, gpointer user_data)
+{
+    /* the shared controllers have the radio hook: never the owner's port */
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+
+    owner_port_commands++;
+    g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "unexpected owner AT command %s", cmd);
+    g_object_unref (task);
+}
+
+const gchar *
+mm_base_modem_at_command_finish (MMBaseModem *self, GAsyncResult *res, GError **error)
+{
+    g_task_propagate_boolean (G_TASK (res), error);
+    return NULL;
+}
+
+gboolean
+mm_wwan_link_add (const gchar *parent, guint id, const gchar *name, gboolean *existed, GError **error)
+{
+    *existed = FALSE;
+    return TRUE;
+}
+
+gboolean
+mm_wwan_link_del (const gchar *name, GError **error)
+{
+    return TRUE;
+}
+
+gboolean
+mm_wwan_link_configure (const gchar *name, guint mtu, const gchar *address, GError **error)
+{
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* the fake modem */
+
+typedef struct {
+    gint        fd, slave;
+    GIOChannel *channel;
+    guint       watch_id;
+    GByteArray *rx;
+    guint       n_test, n_open, n_register;
+    guint       n_approve_rsp;
+    guint16     approve_txid;
+    guint8      approve_slot;
+    GByteArray *approve_payload; /* the last RSP's TLVs */
+    guint       busy_efun;      /* answer this many EFUN with SIM busy */
+    gboolean    hold_sys_at;    /* keep SYS_AT CNFs until released */
+    GPtrArray  *held;           /* GByteArray frames */
+    GPtrArray  *history;        /* "<slot>:<text>" of SYS_AT, "<slot>:ims-cfg" ... */
+} Peer;
+
+static Peer peer;
+
+static void
+peer_write (const guint8 *data, gsize len)
+{
+    gsize off = 0;
+
+    while (off < len) {
+        gssize n = write (peer.fd, data + off, len - off);
+        g_assert_cmpint (n, >, 0);
+        off += n;
+    }
+}
+
+static void
+peer_send (guint16 id, guint16 txid, guint8 slot, GByteArray *tlvs)
+{
+    g_autoptr(GByteArray) frame = mm_mipc_frame_build (id, txid, slot, tlvs ? tlvs->data : NULL, tlvs ? tlvs->len : 0);
+
+    g_assert_nonnull (frame);
+    if (peer.hold_sys_at && id == MM_MIPC_SYS_AT_CNF) {
+        g_ptr_array_add (peer.held, g_byte_array_ref (frame));
+        return;
+    }
+    peer_write (frame->data, frame->len);
+}
+
+static void
+peer_release_held (void)
+{
+    guint i;
+
+    for (i = 0; i < peer.held->len; i++) {
+        GByteArray *frame = g_ptr_array_index (peer.held, i);
+        peer_write (frame->data, frame->len);
+    }
+    g_ptr_array_set_size (peer.held, 0);
+}
+
+static GByteArray *
+cnf (guint32 result)
+{
+    GByteArray *tlvs = g_byte_array_new ();
+
+    mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_RESULT, result);
+    return tlvs;
+}
+
+/* the text the fake modem's AT engine answers on the tunnel */
+static void
+peer_sys_at (const MMMipcMsg *msg)
+{
+    g_autofree gchar     *text = NULL;
+    g_autoptr(GByteArray) tlvs = NULL;
+    const gchar          *reply = "OK";
+    guint32               result = 0;
+    const guint8         *raw;
+    gsize                 vlen = 0;
+
+    /* the raw string: an SMS submit carries CR and Ctrl-Z */
+    raw = mm_mipc_tlv_find (msg->payload, msg->len, MM_MIPC_T_AT_STRING, &vlen);
+    g_assert_nonnull (raw);
+    text = g_strndup ((const gchar *) raw, strnlen ((const gchar *) raw, vlen));
+    g_ptr_array_add (peer.history, g_strdup_printf ("%u:%s", msg->slot, text));
+    if (g_str_has_prefix (text, "AT+EFUN=") && peer.busy_efun) {
+        peer.busy_efun--;
+        reply = "+CME ERROR: 14";
+    } else if (g_str_equal (text, "AT+CIREG?"))
+        reply = "+CIREG: 2,0,0\r\nOK";
+    else if (g_str_equal (text, "AT+CGDCONT?"))
+        reply = "+CGDCONT: 0,\"IP\",\"internet.example\",\"0.0.0.0\",0,0\r\nOK";
+    else if (g_str_equal (text, "AT+CFUN?"))
+        reply = "+CFUN: 4\r\nOK";
+    else if (g_str_equal (text, "AT+CEREG=?"))
+        /* level 3 offered on slot 1 only */
+        reply = msg->slot == 1 ? "+CEREG: (0-5)\r\nOK" : "+CEREG: (0-2)\r\nOK";
+    else if (g_str_equal (text, "AT+CEREG?"))
+        reply = "+CEREG: 3,3,\"1262\",\"0A1B2C3D\",7,0,15\r\nOK";
+    else if (g_str_equal (text, "AT+CPIN?"))
+        reply = "+CPIN: READY\r\n\r\nOK";
+    else if (g_str_equal (text, "AT+CPMS?"))
+        reply = "+CPMS: \"SM\",1,10,\"SM\",1,10,\"SM\",1,10";      /* no final code */
+    else if (g_str_equal (text, "AT+CMGR=9"))
+        reply = "+CME ERROR: 10";
+    else if (g_str_equal (text, "AT+EMPTY")) {
+        reply = "";
+        result = 5;
+    } else if (g_str_has_prefix (text, "AT+CMGS=10\r"))
+        reply = "+CMGS: 5\r\nOK";
+    tlvs = cnf (result);
+    mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_AT_STRING, reply);
+    peer_send (MM_MIPC_SYS_AT_CNF, msg->txid, msg->slot, tlvs);
+}
+
+static void
+peer_handle (const MMMipcMsg *msg)
+{
+    g_autoptr(GByteArray) tlvs = NULL;
+    guint32               v;
+
+    switch (msg->msg_id) {
+    case MM_MIPC_INTERNAL_TEST_REQ:
+        peer.n_test++;
+        peer_send (MM_MIPC_INTERNAL_TEST_CNF, msg->txid, msg->slot, NULL);
+        return;
+    case MM_MIPC_INTERNAL_OPEN_REQ:
+        peer.n_open++;
+        tlvs = cnf (0);
+        mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_OPEN_VERSION, 1);
+        peer_send (MM_MIPC_INTERNAL_OPEN_CNF, msg->txid, msg->slot, tlvs);
+        return;
+    case MM_MIPC_INTERNAL_REGISTER_IND_REQ:
+    case MM_MIPC_INTERNAL_REGISTER_CMD_REQ:
+        peer.n_register++;
+        tlvs = cnf (0);
+        peer_send (MM_MIPC_CNF_OF (msg->msg_id), msg->txid, msg->slot, tlvs);
+        return;
+    case MM_MIPC_IMS_SET_CONFIG_REQ:
+        g_assert_true (mm_mipc_tlv_find_uint (msg->payload, msg->len, MM_MIPC_T_IMSCFG_FORM, &v));
+        g_ptr_array_add (peer.history, g_strdup_printf ("%u:%s", msg->slot, v ? "ims-key" : "ims-flags"));
+        tlvs = cnf (0);
+        peer_send (MM_MIPC_IMS_SET_CONFIG_CNF, msg->txid, msg->slot, tlvs);
+        return;
+    case MM_MIPC_APN_ADD_PROFILE_LIST_REQ:
+        g_ptr_array_add (peer.history, g_strdup_printf ("%u:profiles", msg->slot));
+        tlvs = cnf (0);
+        peer_send (MM_MIPC_APN_ADD_PROFILE_LIST_CNF, msg->txid, msg->slot, tlvs);
+        return;
+    case MM_MIPC_SYS_AT_REQ:
+        peer_sys_at (msg);
+        return;
+    case MM_MIPC_DATA_SET_DATA_ALLOW_REQ:
+    case MM_MIPC_CALL_DATA_PREFER_SET_REQ:
+    case MM_MIPC_NW_SET_RADIO_CAPABILITY_REQ:
+    case MM_MIPC_SYS_MULTI_SIM_CONFIG_REQ:
+    case MM_MIPC_SYS_SET_DSBP_REQ: {
+        const gchar *name = msg->msg_id == MM_MIPC_DATA_SET_DATA_ALLOW_REQ ? "allow" :
+                            msg->msg_id == MM_MIPC_CALL_DATA_PREFER_SET_REQ ? "prefer" :
+                            msg->msg_id == MM_MIPC_NW_SET_RADIO_CAPABILITY_REQ ? "radio-cap" :
+                            msg->msg_id == MM_MIPC_SYS_MULTI_SIM_CONFIG_REQ ? "msim" : "dsbp";
+        g_autofree gchar *dump = mm_mipc_tlv_dump (msg->payload, msg->len, 8);
+
+        g_ptr_array_add (peer.history, g_strdup_printf ("%u:%s(%s)", msg->slot, name, dump));
+        /* the multi-SIM config answers 1, as observed on the phone */
+        tlvs = cnf (msg->msg_id == MM_MIPC_SYS_MULTI_SIM_CONFIG_REQ ? 1 : 0);
+        mm_mipc_tlv_add_u8 (tlvs, 0x0101, 7);   /* an undescribed CNF TLV */
+        peer_send (MM_MIPC_CNF_OF (msg->msg_id), msg->txid, msg->slot, tlvs);
+        return;
+    }
+    case MM_MIPC_NW_SET_RADIO_STATE_REQ: {
+        g_autofree gchar *dump = mm_mipc_tlv_dump (msg->payload, msg->len, 8);
+
+        g_ptr_array_add (peer.history, g_strdup_printf ("%u:radio-state(%s)", msg->slot, dump));
+        tlvs = cnf (0);
+        peer_send (MM_MIPC_NW_SET_RADIO_STATE_CNF, msg->txid, msg->slot, tlvs);
+        return;
+    }
+    case MM_MIPC_NW_GET_PS_REQ: {
+        /* the registration block: searching on the first poll of a slot, then home */
+        static guint polls[3];
+        guint8       block[28] = { 0 };
+
+        g_ptr_array_add (peer.history, g_strdup_printf ("%u:get-ps", msg->slot));
+        block[0] = polls[msg->slot & 3]++ ? 1 : 2;
+        memcpy (block + 1, "00101", 5);
+        mm_mipc_put (block + 8, 4, 0x01234516);
+        mm_mipc_put (block + 12, 4, 100);
+        mm_mipc_put (block + 20, 4, 0x1A2B);
+        tlvs = cnf (0);
+        mm_mipc_tlv_add (tlvs, 0x8106, block, sizeof (block));
+        peer_send (MM_MIPC_NW_GET_PS_CNF, msg->txid, msg->slot, tlvs);
+        return;
+    }
+    case MM_MIPC_CALL_APPROVE_RSP:
+        peer.n_approve_rsp++;
+        peer.approve_txid = msg->txid;
+        peer.approve_slot = msg->slot;
+        g_byte_array_set_size (peer.approve_payload, 0);
+        g_byte_array_append (peer.approve_payload, msg->payload, msg->len);
+        return;
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+static gboolean
+peer_input (GIOChannel *channel, GIOCondition cond, gpointer user_data)
+{
+    guint8 buf[4096];
+    gssize n = read (peer.fd, buf, sizeof (buf));
+
+    if (n <= 0)
+        return G_SOURCE_CONTINUE;
+    g_byte_array_append (peer.rx, buf, n);
+    for (;;) {
+        MMMipcMsg msg;
+        gsize     used = 0;
+        gint      r = mm_mipc_frame_parse (peer.rx->data, peer.rx->len, &msg, &used);
+        g_autoptr(GByteArray) copy = NULL;
+
+        if (r == 0)
+            break;
+        g_assert_cmpint (r, >, 0);
+        copy = g_byte_array_new ();
+        g_byte_array_append (copy, msg.payload, msg.len);
+        msg.payload = copy->data;
+        g_byte_array_remove_range (peer.rx, 0, used);
+        peer_handle (&msg);
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+static gchar *
+peer_setup (void)
+{
+    gchar          path[128];
+    struct termios tio;
+
+    memset (&peer, 0, sizeof (peer));
+    g_assert_cmpint (openpty (&peer.fd, &peer.slave, path, NULL, NULL), ==, 0);
+    g_assert_cmpint (tcgetattr (peer.slave, &tio), ==, 0);
+    cfmakeraw (&tio);
+    g_assert_cmpint (tcsetattr (peer.slave, TCSANOW, &tio), ==, 0);
+    g_assert_cmpint (tcgetattr (peer.fd, &tio), ==, 0);
+    cfmakeraw (&tio);
+    g_assert_cmpint (tcsetattr (peer.fd, TCSANOW, &tio), ==, 0);
+    peer.rx = g_byte_array_new ();
+    peer.held = g_ptr_array_new_with_free_func ((GDestroyNotify) g_byte_array_unref);
+    peer.history = g_ptr_array_new_with_free_func (g_free);
+    peer.approve_payload = g_byte_array_new ();
+    peer.channel = g_io_channel_unix_new (peer.fd);
+    g_io_channel_set_encoding (peer.channel, NULL, NULL);
+    g_io_channel_set_buffered (peer.channel, FALSE);
+    peer.watch_id = g_io_add_watch (peer.channel, G_IO_IN, peer_input, NULL);
+    g_assert_true (g_str_has_prefix (path, "/dev/"));
+    return g_strdup (path + 5);
+}
+
+static void
+peer_teardown (void)
+{
+    g_source_remove (peer.watch_id);
+    g_io_channel_unref (peer.channel);
+    g_byte_array_unref (peer.rx);
+    g_ptr_array_unref (peer.held);
+    g_ptr_array_unref (peer.history);
+    g_byte_array_unref (peer.approve_payload);
+    close (peer.fd);
+    close (peer.slave);
+}
+
+/* the SYS_AT/IMS history from index @from as one string "a|b|c" */
+static gchar *
+history_from (guint from)
+{
+    GString *s = g_string_new (NULL);
+    guint    i;
+
+    for (i = from; i < peer.history->len; i++)
+        g_string_append_printf (s, "%s%s", s->len ? "|" : "", (const gchar *) g_ptr_array_index (peer.history, i));
+    return g_string_free (s, FALSE);
+}
+
+/*****************************************************************************/
+/* async helpers */
+
+typedef struct {
+    guint    done;
+    gboolean ok;
+    GError  *error;
+    gchar   *reply;
+} Wait;
+
+static void
+wait_for (Wait *w, guint n)
+{
+    while (w->done < n)
+        g_main_context_iteration (NULL, TRUE);
+}
+
+static void
+session_ready (MMPortMipc *port, GAsyncResult *res, Wait *w)
+{
+    w->ok = mm_port_mipc_open_session_finish (port, res, &w->error);
+    w->done++;
+}
+
+static void
+open_session (MMPortMipc *port, Wait *w)
+{
+    static const guint16 inds[] = { MM_MIPC_SYS_AT_IND, MM_MIPC_INTERNAL_EIPSPI_CMD };
+
+    mm_port_mipc_open_session (port, MM_MIPC_SLOT_SIM1 | MM_MIPC_SLOT_SIM2, inds, G_N_ELEMENTS (inds),
+                               "test", NULL, (GAsyncReadyCallback) session_ready, w);
+}
+
+static void
+radio_ready (MMMtkCcciShared *shared, GAsyncResult *res, Wait *w)
+{
+    w->ok = mm_mtk_ccci_shared_radio_set_finish (shared, res, &w->error);
+    w->done++;
+}
+
+static void
+prepare_ready (MMMtkCcciShared *shared, GAsyncResult *res, Wait *w)
+{
+    w->ok = mm_mtk_ccci_shared_radio_prepare_finish (shared, res, &w->error);
+    w->done++;
+}
+
+static void
+ims_ready (GObject *source, GAsyncResult *res, Wait *w)
+{
+    w->ok = mm_mtk_ccci_ims_setup_finish (res, &w->error);
+    w->done++;
+}
+
+static void
+at_ready (MMPortSerialAt *port, GAsyncResult *res, Wait *w)
+{
+    g_clear_pointer (&w->reply, g_free);
+    g_clear_error (&w->error);
+    w->reply = mm_port_serial_at_command_finish (port, res, &w->error);
+    w->done++;
+}
+
+/* a shared context with an open MIPC session on a fresh fake modem */
+static MMMtkCcciShared *
+shared_setup (gchar **name)
+{
+    MMMtkCcciShared  *shared;
+    g_autoptr(GError) error = NULL;
+    Wait              w = { 0 };
+
+    *name = peer_setup ();
+    shared = mm_mtk_ccci_shared_acquire (*name);
+    g_assert_true (mm_port_mipc_open (mm_mtk_ccci_shared_peek_mipc (shared), &error));
+    g_assert_no_error (error);
+    open_session (mm_mtk_ccci_shared_peek_mipc (shared), &w);
+    wait_for (&w, 1);
+    g_assert_no_error (w.error);
+    g_assert_true (w.ok);
+    return shared;
+}
+
+static void
+shared_teardown (MMMtkCcciShared *shared, const gchar *name)
+{
+    mm_port_mipc_close (mm_mtk_ccci_shared_peek_mipc (shared));
+    g_object_unref (shared);
+    g_assert_null (mm_mtk_ccci_shared_peek (name));
+    peer_teardown ();
+}
+
+/*****************************************************************************/
+/* pure helpers */
+
+static void
+test_bridge_helpers (void)
+{
+    g_autofree gchar *a = NULL, *b = NULL, *c = NULL, *d = NULL, *e = NULL;
+
+    g_assert_true (mm_mtk_ccci_at_bridge_urc_wanted ("+CEREG: 1,\"1A2B\",\"01A2B3C\",7"));
+    g_assert_true (mm_mtk_ccci_at_bridge_urc_wanted ("  +CMTI: \"SM\",3"));
+    g_assert_true (mm_mtk_ccci_at_bridge_urc_wanted ("+CUSD: 0,\"x\",15"));
+    /* handled over MIPC directly (calls, IMS): never as port text */
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted ("+ECPI: 1,130,0,0,0,20,\"1\",129,\"\""));
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted ("+CIREGU: 1,1"));
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted ("RING"));
+    /* no handler on the port before messaging setup: would pollute replies */
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted ("+CDSI: \"SM\",4"));
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted ("+CGEV: ME PDN ACT 1"));
+    g_assert_false (mm_mtk_ccci_at_bridge_urc_wanted (NULL));
+
+    a = mm_mtk_ccci_at_bridge_frame_reply ("+CPIN: READY\r\n\r\nOK", 0);
+    g_assert_cmpstr (a, ==, "\r\n+CPIN: READY\r\n\r\nOK\r\n");
+    b = mm_mtk_ccci_at_bridge_frame_reply ("+CSQ: 20,99", 0);
+    g_assert_cmpstr (b, ==, "\r\n+CSQ: 20,99\r\n\r\nOK\r\n");
+    c = mm_mtk_ccci_at_bridge_frame_reply ("", 7);
+    g_assert_cmpstr (c, ==, "\r\nERROR\r\n");
+    d = mm_mtk_ccci_at_bridge_frame_reply ("\r\n+CME ERROR: 10\r\n", 0);
+    g_assert_cmpstr (d, ==, "\r\n+CME ERROR: 10\r\n");
+    e = mm_mtk_ccci_at_bridge_frame_reply ("+CMGL: 1,1,,23\r\n0791AB\r\nOK", 0);
+    g_assert_cmpstr (e, ==, "\r\n+CMGL: 1,1,,23\r\n\r\n0791AB\r\n\r\nOK\r\n");
+}
+
+static void
+test_speech_refcount (void)
+{
+    g_autofree gchar *name = peer_setup ();
+    MMMtkCcciShared  *shared = mm_mtk_ccci_shared_acquire (name);
+
+    /* SIM1 call starts the path, a SIM2 call meanwhile keeps it, the path
+     * goes off with the last call of either SIM */
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 1, TRUE), ==, 1);
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 2, TRUE), ==, 0);
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 1, FALSE), ==, 0);
+    g_assert_cmpuint (mm_mtk_ccci_shared_speech_get (shared), ==, 2);
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 2, FALSE), ==, -1);
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 2, FALSE), ==, 0);
+    /* the single-object mode: both bits at once */
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 3, TRUE), ==, 1);
+    g_assert_cmpint (mm_mtk_ccci_shared_speech_update (shared, 3, FALSE), ==, -1);
+    g_object_unref (shared);
+    peer_teardown ();
+}
+
+/* the last CALL_APPROVE_INCOMING_RSP, byte for byte: 0x0100 u8 approve,
+ * 0x0102 u32 call id, 0x0103 u32 seq, on rejection 0x0101 u32 cause 21
+ * */
+static void
+approve_rsp_check (guint8 approve, guint32 call_id, guint32 seq)
+{
+    g_autoptr(GByteArray) expected = g_byte_array_new ();
+
+    mm_mipc_tlv_add_u8 (expected, 0x0100, approve);
+    mm_mipc_tlv_add_u32 (expected, 0x0102, call_id);
+    mm_mipc_tlv_add_u32 (expected, 0x0103, seq);
+    if (!approve)
+        mm_mipc_tlv_add_u32 (expected, 0x0101, 21);
+    g_assert_cmpmem (peer.approve_payload->data, peer.approve_payload->len, expected->data, expected->len);
+}
