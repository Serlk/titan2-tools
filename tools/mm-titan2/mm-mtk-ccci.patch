diff --git a/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c b/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c
new file mode 100644
index 00000000..a084fbbd
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-plugin-mtk-ccci.c
@@ -0,0 +1,231 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * ModemManager plugin "mtk-ccci": the MediaTek MT6878 integrated modem behind
+ * the mtk_ccci WWAN driver (Unihertz Titan 2, mainline Linux).
+ *
+ * Ports (all in the "wwan" subsystem, created by the driver when the modem is
+ * READY; the udev rules file tags them ID_MM_MTK_CCCI):
+ *   wwan0at0        AT, the primary port (3GPP control, voice, SMS)
+ *   wwan0mipc1      the MIPC data port (ID_MM_MTK_CCCI_MIPC_DATA): not AT,
+ *                   grabbed with an unknown type and turned into MMPortMipc
+ *   wwan0mipc2      ignored, and in the dual-modem mode the anchor of a
+ *                   second device (ID_MM_PHYSDEV_UID mtk-ccci-sim2,
+ *                   ID_MM_MTK_CCCI_SIM_ANCHOR=2): never opened; its modem
+ *                   object is the SIM2 stack, with a virtual AT port over
+ *                   the slot-2 MIPC AT tunnel of wwan0mipc1 (DESIGN.md §11)
+ *   wwan0mipc0,3-9  other MIPC channels: ignored
+ *   wwan0-N         the data links (net), created by the bearer at connect time
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <string.h>
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem-mtk-ccci.h"
+#include "mm-log-object.h"
+
+#define MM_TYPE_PLUGIN_MTK_CCCI mm_plugin_mtk_ccci_get_type ()
+MM_DEFINE_PLUGIN (MTK_CCCI, mtk_ccci, MtkCcci)
+
+/*****************************************************************************/
+
+static gboolean
+is_mipc_port (MMKernelDevice *port)
+{
+    const gchar *name;
+
+    if (g_strcmp0 (mm_kernel_device_get_subsystem (port), "wwan") != 0)
+        return FALSE;
+    /* the kernel names them wwan<D>mipc<N>; Linux >= 6.9 also reports type "MIPC" */
+    name = mm_kernel_device_get_name (port);
+    return name && strstr (name, "mipc") != NULL;
+}
+
+static gboolean
+is_mipc_data_port (MMKernelDevice *port)
+{
+    const gchar *name;
+
+    if (!is_mipc_port (port))
+        return FALSE;
+    if (mm_kernel_device_has_property (port, ID_MM_MTK_CCCI_MIPC_DATA))
+        return mm_kernel_device_get_property_as_boolean (port, ID_MM_MTK_CCCI_MIPC_DATA);
+    /* without the udev rules: the data channel Android uses is mipc1 */
+    name = mm_kernel_device_get_name (port);
+    return g_str_has_suffix (name, "mipc1");
+}
+
+static gboolean
+is_sim2_anchor (MMKernelDevice *port)
+{
+    return g_strcmp0 (mm_kernel_device_get_subsystem (port), "wwan") == 0 &&
+           mm_kernel_device_has_property (port, ID_MM_MTK_CCCI_SIM_ANCHOR) &&
+           mm_kernel_device_get_property_as_int (port, ID_MM_MTK_CCCI_SIM_ANCHOR) == 2;
+}
+
+/*****************************************************************************/
+/* Custom init: keep the AT probing away from the MIPC ports */
+
+static gboolean
+mtk_ccci_custom_init_finish (MMPortProbe   *probe,
+                             GAsyncResult  *result,
+                             GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (result), error);
+}
+
+static void
+mtk_ccci_custom_init (MMPortProbe         *probe,
+                      MMPortSerialAt      *port,
+                      GCancellable        *cancellable,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (probe, cancellable, callback, user_data);
+
+    if (is_mipc_port (mm_port_probe_peek_port (probe))) {
+        /* a binary protocol port: never send AT to it; the probe ends with no
+         * type and the plugin's grab_port() decides */
+        mm_obj_dbg (probe, "MIPC port: AT probing skipped");
+        mm_port_probe_set_result_at (probe, FALSE);
+        mm_port_probe_set_result_qcdm (probe, FALSE);
+    }
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+
+static gboolean
+grab_port (MMPlugin     *self,
+           MMBaseModem  *modem,
+           MMPortProbe  *probe,
+           GError      **error)
+{
+    MMKernelDevice     *port;
+    MMPortGroup         port_group;
+    MMPortType          port_type;
+    MMPortSerialAtFlag  pflags = MM_PORT_SERIAL_AT_FLAG_NONE;
+
+    port       = mm_port_probe_peek_port (probe);
+    port_group = mm_port_probe_get_port_group (probe);
+    port_type  = mm_port_probe_get_port_type (probe);
+
+    if (is_mipc_port (port)) {
+        if (is_mipc_data_port (port)) {
+            mm_obj_dbg (self, "%s is the MIPC data port", mm_kernel_device_get_name (port));
+            port_group = MM_PORT_GROUP_USED;
+            port_type  = MM_PORT_TYPE_UNKNOWN; /* the modem's create_wwan_port() makes it a MMPortMipc */
+        } else {
+            mm_obj_dbg (self, "%s is an unused MIPC port, ignored", mm_kernel_device_get_name (port));
+            port_group = MM_PORT_GROUP_IGNORED;
+        }
+    } else if (port_type == MM_PORT_TYPE_AT) {
+        /* the one AT port is the primary one; the rules file says so too */
+        pflags = MM_PORT_SERIAL_AT_FLAG_PRIMARY;
+    }
+
+    return mm_base_modem_grab_port (modem, port, port_group, port_type, pflags, error);
+}
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    GList *l;
+
+    if (!mm_port_probe_list_has_at_port (probes)) {
+        /* the dual-modem mode's SIM2 device: only the anchor port */
+        for (l = probes; l; l = g_list_next (l)) {
+            MMKernelDevice *port = mm_port_probe_peek_port (MM_PORT_PROBE (l->data));
+
+            if (!is_sim2_anchor (port))
+                continue;
+            if (mm_kernel_device_has_property (port, ID_MM_MTK_CCCI_DUAL_MODEM) &&
+                !mm_kernel_device_get_property_as_boolean (port, ID_MM_MTK_CCCI_DUAL_MODEM)) {
+                g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                             "single-modem mode (" ID_MM_MTK_CCCI_DUAL_MODEM "=0): SIM2 is served by the SIM1 modem object");
+                return NULL;
+            }
+            mm_obj_dbg (self, "MediaTek CCCI integrated modem, SIM2 stack (anchor %s)...",
+                        mm_kernel_device_get_name (port));
+            return MM_BASE_MODEM (mm_broadband_modem_mtk_ccci_new_sim2 (uid, physdev, drivers,
+                                                                        mm_plugin_get_name (self),
+                                                                        port, error));
+        }
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Unsupported device: the AT port is required");
+        return NULL;
+    }
+
+    mm_obj_dbg (self, "MediaTek CCCI integrated modem found...");
+    return MM_BASE_MODEM (mm_broadband_modem_mtk_ccci_new (uid,
+                                                           physdev,
+                                                           drivers,
+                                                           mm_plugin_get_name (self),
+                                                           vendor,
+                                                           product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_mtk_ccci (void)
+{
+    static const gchar *subsystems[] = { "wwan", "net", NULL };
+    static const gchar *udev_tags[] = { "ID_MM_MTK_CCCI", NULL };
+    static const MMAsyncMethod custom_init = {
+        .async  = G_CALLBACK (mtk_ccci_custom_init),
+        .finish = G_CALLBACK (mtk_ccci_custom_init_finish),
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_MTK_CCCI,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_UDEV_TAGS,  udev_tags,
+                      MM_PLUGIN_ALLOWED_AT,         TRUE,
+                      MM_PLUGIN_CUSTOM_INIT,        &custom_init,
+                      NULL));
+}
+
+static void
+mm_plugin_mtk_ccci_init (MMPluginMtkCcci *self)
+{
+}
+
+static void
+mm_plugin_mtk_ccci_class_init (MMPluginMtkCcciClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+    plugin_class->grab_port    = grab_port;
+}
diff --git a/src/plugins/mtk-ccci/mm-port-mipc.c b/src/plugins/mtk-ccci/mm-port-mipc.c
new file mode 100644
index 00000000..d642da5e
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-port-mipc.c
@@ -0,0 +1,788 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MMPortMipc: MIPC control port with independent request and modem-response queues.
+ *
+ * Written from a clean-room behavioural description of the protocol; no code of the phone's Android software was used.
+ * A modem command may arrive while a request awaits its confirm; its response
+ * must be written without completing or waiting for that request.
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <config.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <glib-unix.h>
+#include <ModemManager.h>
+#include <mm-errors-types.h>
+#include "mm-port-mipc.h"
+#include "mm-log-object.h"
+#include "mm-error-helpers.h"
+
+#define SESSION_TEST_TRIES 10
+#define SESSION_TEST_TIMEOUT 1
+#define SESSION_OPEN_TIMEOUT 5
+#define SESSION_REG_TIMEOUT 5
+#define MAX_PENDING 64
+
+G_DEFINE_TYPE (MMPortMipc, mm_port_mipc, MM_TYPE_PORT)
+enum { SIGNAL_INDICATION, SIGNAL_FORCED_CLOSE, SIGNAL_LAST };
+static guint signals[SIGNAL_LAST];
+
+typedef struct {
+    GTask *task;
+    guint16 id, txid;
+    guint8 slot;
+    guint timeout, timeout_seconds;
+} Pending;
+
+typedef struct {
+    GByteArray *frame;
+    gsize offset;
+    guint16 txid;
+    gboolean response;
+} Output;
+
+struct _MMPortMipcPrivate {
+    gint fd;
+    guint opens, read_id, write_id, send_timeout;
+    guint16 next_txid;
+    gboolean session_ready;
+    guint modem_timeout_ms, consecutive_timeouts;
+    GByteArray *rx;
+    GHashTable *pending;
+    GQueue output;
+    /* callers waiting for the session start in flight (NULL: none in flight);
+     * two modem objects (one per SIM, DESIGN.md §11) share this port and may
+     * both ask for the session while it starts */
+    GPtrArray *session_waiters;
+};
+
+static void pending_disarm (Pending *p)
+{
+    if (p->timeout) {
+        g_source_remove (p->timeout);
+        p->timeout = 0;
+    }
+}
+
+static void pending_free (Pending *p)
+{
+    pending_disarm (p);
+    g_object_unref (p->task);
+    g_free (p);
+}
+
+static void output_free (Output *o)
+{
+    g_byte_array_unref (o->frame);
+    g_free (o);
+}
+
+void mm_mipc_cnf_free (MMMipcCnf *cnf)
+{
+    if (cnf) {
+        g_byte_array_unref (cnf->payload);
+        g_slice_free (MMMipcCnf, cnf);
+    }
+}
+
+gboolean mm_port_mipc_is_open (MMPortMipc *self)
+{
+    return self->priv->fd >= 0;
+}
+
+gboolean mm_port_mipc_get_session_ready (MMPortMipc *self)
+{
+    return self->priv->session_ready && mm_port_mipc_is_open (self);
+}
+
+guint mm_port_mipc_get_modem_timeout_ms (MMPortMipc *self)
+{
+    return self->priv->modem_timeout_ms;
+}
+
+static void port_close (MMPortMipc *self, gboolean forced)
+{
+    GHashTableIter iter;
+    gpointer value;
+    MMPortMipcPrivate *p = self->priv;
+    g_autoptr(GPtrArray) pending_tasks = g_ptr_array_new_with_free_func ((GDestroyNotify) pending_free);
+    guint i;
+
+    if (p->read_id) { g_source_remove (p->read_id); p->read_id = 0; }
+    if (p->write_id) { g_source_remove (p->write_id); p->write_id = 0; }
+    if (p->send_timeout) { g_source_remove (p->send_timeout); p->send_timeout = 0; }
+    if (p->fd >= 0) { close (p->fd); p->fd = -1; }
+    p->opens = 0;
+    p->session_ready = FALSE;
+    p->modem_timeout_ms = 0;
+    g_byte_array_set_size (p->rx, 0);
+    while (!g_queue_is_empty (&p->output))
+        output_free (g_queue_pop_head (&p->output));
+    g_hash_table_iter_init (&iter, p->pending);
+    while (g_hash_table_iter_next (&iter, NULL, &value)) {
+        Pending *pending = value;
+        pending_disarm (pending);
+        g_ptr_array_add (pending_tasks, pending);
+        g_hash_table_iter_steal (&iter);
+    }
+    /* GTask callbacks may run immediately and reopen/close the port. Detach
+     * every old request before completing any of them. */
+    for (i = 0; i < pending_tasks->len; i++) {
+        Pending *pending = g_ptr_array_index (pending_tasks, i);
+        g_task_return_new_error (pending->task, MM_SERIAL_ERROR, MM_SERIAL_ERROR_SEND_FAILED,
+                                 "MIPC port closed");
+    }
+    if (forced)
+        g_signal_emit (self, signals[SIGNAL_FORCED_CLOSE], 0);
+}
+
+void mm_port_mipc_close (MMPortMipc *self)
+{
+    if (self->priv->opens && --self->priv->opens == 0)
+        port_close (self, FALSE);
+}
+
+static gboolean request_timeout (gpointer user_data)
+{
+    Pending *pending = user_data;
+    g_autoptr(MMPortMipc) self = g_object_ref (g_task_get_source_object (pending->task));
+    guint16 txid = pending->txid;
+
+    pending->timeout = 0;
+    g_hash_table_steal (self->priv->pending, GUINT_TO_POINTER ((guint) txid + 1));
+    g_task_return_new_error (pending->task, MM_SERIAL_ERROR, MM_SERIAL_ERROR_RESPONSE_TIMEOUT,
+                             "MIPC request 0x%04x txid %u timed out", pending->id, txid);
+    pending_free (pending);
+    g_signal_emit_by_name (self, MM_PORT_SIGNAL_TIMED_OUT, ++self->priv->consecutive_timeouts);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean send_timeout (gpointer user_data)
+{
+    g_autoptr(MMPortMipc) self = g_object_ref (user_data);
+    self->priv->send_timeout = 0;
+    mm_obj_warn (self, "MIPC transmit queue stalled");
+    port_close (self, TRUE);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean write_ready (gint fd, GIOCondition cond, gpointer user_data)
+{
+    g_autoptr(MMPortMipc) self = g_object_ref (user_data);
+    MMPortMipcPrivate *p = self->priv;
+
+    if (cond & (G_IO_ERR | G_IO_HUP | G_IO_NVAL)) {
+        p->write_id = 0;
+        port_close (self, TRUE);
+        return G_SOURCE_REMOVE;
+    }
+    while (!g_queue_is_empty (&p->output)) {
+        Output *o = g_queue_peek_head (&p->output);
+        gssize n = write (fd, o->frame->data + o->offset, o->frame->len - o->offset);
+
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n < 0 && (errno == EAGAIN))
+            return G_SOURCE_CONTINUE;
+        if (n <= 0) {
+            p->write_id = 0;
+            port_close (self, TRUE);
+            return G_SOURCE_REMOVE;
+        }
+        o->offset += n;
+        if (o->offset != o->frame->len)
+            return G_SOURCE_CONTINUE;
+        if (!o->response) {
+            Pending *pending = g_hash_table_lookup (p->pending, GUINT_TO_POINTER ((guint) o->txid + 1));
+            if (pending)
+                pending->timeout = g_timeout_add_seconds (pending->timeout_seconds,
+                                                          request_timeout, pending);
+        }
+        output_free (g_queue_pop_head (&p->output));
+    }
+    p->write_id = 0;
+    if (p->send_timeout) { g_source_remove (p->send_timeout); p->send_timeout = 0; }
+    return G_SOURCE_REMOVE;
+}
+
+static void queue_output (MMPortMipc *self, GByteArray *frame, guint16 txid, gboolean response)
+{
+    Output *o = g_new0 (Output, 1);
+    o->frame = g_byte_array_ref (frame);
+    o->txid = txid;
+    o->response = response;
+    /* Never insert in the middle of a partially written frame. */
+    if (response && !g_queue_is_empty (&self->priv->output))
+        g_queue_insert_after (&self->priv->output, self->priv->output.head, o);
+    else
+        g_queue_push_tail (&self->priv->output, o);
+    if (!self->priv->write_id)
+        self->priv->write_id = g_unix_fd_add (self->priv->fd, G_IO_OUT | G_IO_ERR | G_IO_HUP,
+                                             write_ready, self);
+    if (!self->priv->send_timeout)
+        self->priv->send_timeout = g_timeout_add_seconds (5, send_timeout, self);
+}
+
+static void dispatch (MMPortMipc *self, const MMMipcMsg *msg)
+{
+    Pending *pending;
+    MMMipcCnf *cnf;
+
+    mm_obj_dbg (self, "<-- MIPC id 0x%04x slot 0x%02x txid %u payload %" G_GSIZE_FORMAT,
+                msg->msg_id, msg->slot, msg->txid, msg->len);
+    if (MM_MIPC_CLASS (msg->msg_id) != MM_MIPC_CLASS_REQCNF) {
+        g_autoptr(GByteArray) payload = g_byte_array_new ();
+        g_byte_array_append (payload, msg->payload, msg->len);
+        g_signal_emit (self, signals[SIGNAL_INDICATION], 0,
+                       (guint) msg->msg_id, (guint) msg->slot, (guint) msg->txid, payload);
+        return;
+    }
+    pending = g_hash_table_lookup (self->priv->pending, GUINT_TO_POINTER ((guint) msg->txid + 1));
+    if (!pending || msg->msg_id != MM_MIPC_CNF_OF (pending->id) ||
+        (pending->slot != MM_MIPC_SLOT_ANY && pending->slot != msg->slot)) {
+        mm_obj_dbg (self, "unmatched MIPC confirm ignored");
+        return;
+    }
+    self->priv->consecutive_timeouts = 0;
+    cnf = g_slice_new0 (MMMipcCnf);
+    cnf->msg_id = msg->msg_id;
+    cnf->txid = msg->txid;
+    cnf->slot = msg->slot;
+    cnf->payload = g_byte_array_new ();
+    g_byte_array_append (cnf->payload, msg->payload, msg->len);
+    cnf->result = mm_mipc_tlv_result (msg->payload, msg->len);
+    /* Completion may synchronously close the port or queue another request. */
+    g_hash_table_steal (self->priv->pending, GUINT_TO_POINTER ((guint) msg->txid + 1));
+    pending_disarm (pending);
+    g_task_return_pointer (pending->task, cnf, (GDestroyNotify) mm_mipc_cnf_free);
+    pending_free (pending);
+}
+
+static gboolean read_ready (gint fd, GIOCondition cond, gpointer user_data)
+{
+    g_autoptr(MMPortMipc) self = g_object_ref (user_data);
+    MMPortMipcPrivate *p = self->priv;
+    guint8 buf[4096];
+    gssize n;
+
+    do { n = read (fd, buf, sizeof (buf)); } while (n < 0 && errno == EINTR);
+    if (n > 0) {
+        g_byte_array_append (p->rx, buf, n);
+        while (p->rx->len) {
+            MMMipcMsg msg;
+            gsize used = 0;
+            gint result = mm_mipc_frame_parse (p->rx->data, p->rx->len, &msg, &used);
+            g_autoptr(GByteArray) payload = NULL;
+
+            if (result == 0)
+                break;
+            if (result < 0) {
+                mm_obj_warn (self, "malformed MIPC stream dropped");
+                g_byte_array_set_size (p->rx, 0);
+                break;
+            }
+            /* Handlers may close the port, so remove the frame before emitting. */
+            payload = g_byte_array_new ();
+            g_byte_array_append (payload, msg.payload, msg.len);
+            msg.payload = payload->data;
+            g_byte_array_remove_range (p->rx, 0, used);
+            dispatch (self, &msg);
+            if (p->fd < 0)
+                return G_SOURCE_REMOVE;
+        }
+    }
+    if (n == 0 || (n < 0 && errno != EAGAIN) ||
+        (cond & (G_IO_HUP | G_IO_ERR | G_IO_NVAL))) {
+        p->read_id = 0;
+        port_close (self, TRUE);
+        return G_SOURCE_REMOVE;
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+gboolean mm_port_mipc_open (MMPortMipc *self, GError **error)
+{
+    g_autofree gchar *path = NULL;
+    struct stat st;
+    gint fd;
+
+    if (self->priv->opens) { self->priv->opens++; return TRUE; }
+    path = g_build_filename ("/dev", mm_port_get_device (MM_PORT (self)), NULL);
+    fd = open (path, O_RDWR | O_NONBLOCK | O_CLOEXEC | O_NOCTTY);
+    if (fd < 0) {
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno), "open %s: %s", path, g_strerror (errno));
+        return FALSE;
+    }
+    if (fstat (fd, &st) || !S_ISCHR (st.st_mode)) {
+        close (fd);
+        g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT, "MIPC port is not a character device");
+        return FALSE;
+    }
+    self->priv->fd = fd;
+    self->priv->opens = 1;
+    self->priv->read_id = g_unix_fd_add (fd, G_IO_IN | G_IO_ERR | G_IO_HUP, read_ready, self);
+    return TRUE;
+}
+
+MMMipcCnf *mm_port_mipc_request_finish (MMPortMipc *self, GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+void mm_port_mipc_request (MMPortMipc *self, guint16 msg_id, guint8 slot, GByteArray *tlvs,
+                           guint timeout_seconds, GCancellable *cancellable,
+                           GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (self, cancellable, callback, user_data);
+    Pending *pending;
+    guint16 txid;
+    g_autoptr(GByteArray) frame = NULL;
+
+    if (!mm_mipc_request_is_valid (msg_id)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid MIPC request 0x%04x", msg_id);
+        g_object_unref (task);
+        return;
+    }
+    if (!mm_port_mipc_is_open (self) || g_hash_table_size (self->priv->pending) >= MAX_PENDING) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE, "MIPC port closed or request queue full");
+        g_object_unref (task);
+        return;
+    }
+    if (g_task_return_error_if_cancelled (task)) { g_object_unref (task); return; }
+    do {
+        txid = self->priv->next_txid++;
+    } while (txid == MM_MIPC_TXID_NONE || g_hash_table_contains (self->priv->pending, GUINT_TO_POINTER ((guint) txid + 1)));
+    frame = mm_mipc_frame_build (msg_id, txid, slot, tlvs ? tlvs->data : NULL, tlvs ? tlvs->len : 0);
+    if (!frame) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_TOO_MANY, "MIPC payload too long");
+        g_object_unref (task);
+        return;
+    }
+    pending = g_new0 (Pending, 1);
+    pending->task = task;
+    pending->id = msg_id;
+    pending->txid = txid;
+    pending->slot = slot;
+    pending->timeout_seconds = MAX (timeout_seconds, 1);
+    g_hash_table_insert (self->priv->pending, GUINT_TO_POINTER ((guint) txid + 1), pending);
+    mm_obj_dbg (self, "--> MIPC id 0x%04x slot 0x%02x txid %u payload %u", msg_id, slot, txid, tlvs ? tlvs->len : 0);
+    queue_output (self, frame, txid, FALSE);
+}
+
+gboolean mm_port_mipc_send_response (MMPortMipc *self, guint16 id, guint16 txid, guint8 slot,
+                                      GByteArray *tlvs, GError **error)
+{
+    g_autoptr(GByteArray) frame = NULL;
+    if (!mm_port_mipc_is_open (self) || (id != MM_MIPC_INTERNAL_EIPSPI_RSP && id != MM_MIPC_CALL_APPROVE_RSP) ||
+        txid == MM_MIPC_TXID_NONE || g_queue_get_length (&self->priv->output) >= MAX_PENDING) {
+        g_set_error_literal (error, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE, "Cannot queue MIPC response");
+        return FALSE;
+    }
+    frame = mm_mipc_frame_build (id, txid, slot, tlvs ? tlvs->data : NULL, tlvs ? tlvs->len : 0);
+    if (!frame) {
+        g_set_error_literal (error, MM_CORE_ERROR, MM_CORE_ERROR_TOO_MANY, "MIPC response too long");
+        return FALSE;
+    }
+    queue_output (self, frame, txid, TRUE);
+    return TRUE;
+}
+
+typedef enum {
+    SESSION_STEP_FIRST,
+    SESSION_STEP_TEST,
+    SESSION_STEP_OPEN,
+    SESSION_STEP_REGISTER,
+    SESSION_STEP_LAST,
+} SessionStep;
+
+typedef struct {
+    SessionStep  step;
+    guint8       slot;
+    guint16     *indications;
+    guint8      *registration_slots;
+    guint        n_indications;
+    guint        reg_index;
+    guint        test_tries;
+    gchar       *client_name;
+} SessionContext;
+
+static void
+session_context_free (SessionContext *ctx)
+{
+    g_free (ctx->indications);
+    g_free (ctx->registration_slots);
+    g_free (ctx->client_name);
+    g_slice_free (SessionContext, ctx);
+}
+
+gboolean
+mm_port_mipc_open_session_finish (MMPortMipc    *self,
+                                  GAsyncResult  *res,
+                                  GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void session_step (GTask *task);
+
+static void
+session_test_ready (MMPortMipc   *self,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    SessionContext       *ctx;
+    g_autoptr(MMMipcCnf)  cnf = NULL;
+    GError               *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    cnf = mm_port_mipc_request_finish (self, res, &error);
+    if (!cnf) {
+        if (g_error_matches (error, MM_SERIAL_ERROR, MM_SERIAL_ERROR_RESPONSE_TIMEOUT) &&
+            ctx->test_tries < SESSION_TEST_TRIES) {
+            /* the first message after modem boot may be lost */
+            mm_obj_dbg (self, "INTERNAL_TEST not answered (try %u), retrying", ctx->test_tries);
+            g_clear_error (&error);
+            session_step (task);
+            return;
+        }
+        g_prefix_error (&error, "MIPC session: test failed: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    mm_obj_dbg (self, "INTERNAL_TEST answered after %u tries", ctx->test_tries);
+    ctx->step++;
+    session_step (task);
+}
+
+static void
+session_open_ready (MMPortMipc   *self,
+                    GAsyncResult *res,
+                    GTask        *task)
+{
+    SessionContext       *ctx;
+    g_autoptr(MMMipcCnf)  cnf = NULL;
+    GError               *error = NULL;
+    guint32               v;
+
+    ctx = g_task_get_task_data (task);
+    cnf = mm_port_mipc_request_finish (self, res, &error);
+    if (!cnf) {
+        g_prefix_error (&error, "MIPC session: open failed: ");
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (mm_mipc_tlv_find_uint (cnf->payload->data, cnf->payload->len, MM_MIPC_T_OPEN_CNF_TIMEOUT, &v) && v)
+        self->priv->modem_timeout_ms = v;
+    if (mm_mipc_tlv_find_uint (cnf->payload->data, cnf->payload->len, MM_MIPC_T_OPEN_VERSION, &v))
+        mm_obj_msg (self, "MIPC session open: result %u, target version %u, default timeout %u ms",
+                    cnf->result, v, self->priv->modem_timeout_ms);
+    else
+        mm_obj_msg (self, "MIPC session open: result %u, default timeout %u ms",
+                    cnf->result, self->priv->modem_timeout_ms);
+    if (cnf->result) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "MIPC OPEN refused: result %u", cnf->result);
+        g_object_unref (task);
+        return;
+    }
+    ctx->step++;
+    session_step (task);
+}
+
+static void
+session_register_ready (MMPortMipc   *self,
+                        GAsyncResult *res,
+                        GTask        *task)
+{
+    SessionContext       *ctx;
+    g_autoptr(MMMipcCnf)  cnf = NULL;
+    g_autoptr(GError)     error = NULL;
+
+    ctx = g_task_get_task_data (task);
+    cnf = mm_port_mipc_request_finish (self, res, &error);
+    if (!cnf || cnf->result) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "MIPC registration 0x%04x failed: %s (result %u)",
+                                 ctx->indications[ctx->reg_index],
+                                 error ? error->message : "refused", cnf ? cnf->result : 0);
+        g_object_unref (task);
+        return;
+    }
+    ctx->reg_index++;
+    session_step (task);
+}
+
+static void
+session_step (GTask *task)
+{
+    MMPortMipc     *self;
+    SessionContext *ctx;
+
+    self = g_task_get_source_object (task);
+    ctx  = g_task_get_task_data (task);
+
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+
+    switch (ctx->step) {
+    case SESSION_STEP_FIRST:
+        ctx->step++;
+        /* fall through */
+
+    case SESSION_STEP_TEST:
+        ctx->test_tries++;
+        mm_port_mipc_request (self, MM_MIPC_INTERNAL_TEST_REQ, MM_MIPC_SLOT_ANY, NULL,
+                              SESSION_TEST_TIMEOUT, g_task_get_cancellable (task),
+                              (GAsyncReadyCallback) session_test_ready, task);
+        return;
+
+    case SESSION_STEP_OPEN: {
+        g_autoptr(GByteArray) tlvs = g_byte_array_new ();
+
+        mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_OPEN_VERSION, MM_MIPC_OPEN_VERSION);
+        mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_OPEN_CLIENT_NAME, ctx->client_name);
+        mm_mipc_tlv_add_u8  (tlvs, MM_MIPC_T_OPEN_FLAG, 1);
+        mm_port_mipc_request (self, MM_MIPC_INTERNAL_OPEN_REQ, MM_MIPC_SLOT_ANY, tlvs,
+                              SESSION_OPEN_TIMEOUT, g_task_get_cancellable (task),
+                              (GAsyncReadyCallback) session_open_ready, task);
+        return;
+    }
+
+    case SESSION_STEP_REGISTER:
+        if (ctx->reg_index < ctx->n_indications) {
+            g_autoptr(GByteArray) tlvs = g_byte_array_new ();
+
+            mm_mipc_tlv_add_u16 (tlvs, MM_MIPC_T_REGISTER_IND_ID, ctx->indications[ctx->reg_index]);
+            mm_port_mipc_request (self,
+                                  MM_MIPC_IS_CMD (ctx->indications[ctx->reg_index]) ?
+                                  MM_MIPC_INTERNAL_REGISTER_CMD_REQ : MM_MIPC_INTERNAL_REGISTER_IND_REQ,
+                                  ctx->registration_slots[ctx->reg_index], tlvs,
+                                  SESSION_REG_TIMEOUT, g_task_get_cancellable (task),
+                                  (GAsyncReadyCallback) session_register_ready, task);
+            return;
+        }
+        ctx->step++;
+        /* fall through */
+
+    case SESSION_STEP_LAST:
+        self->priv->session_ready = TRUE;
+        mm_obj_msg (self, "MIPC session ready (slot 0x%02x)", ctx->slot);
+        g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+        return;
+
+    default:
+        g_assert_not_reached ();
+    }
+}
+
+static void
+session_internal_ready (MMPortMipc   *self,
+                        GAsyncResult *res,
+                        gpointer      user_data)
+{
+    g_autoptr(GPtrArray) waiters = NULL;
+    g_autoptr(GError)    error = NULL;
+    guint                i;
+
+    g_task_propagate_boolean (G_TASK (res), &error);
+    /* a completion callback may start the next session: detach first */
+    waiters = g_steal_pointer (&self->priv->session_waiters);
+    for (i = 0; waiters && i < waiters->len; i++) {
+        GTask *task = g_ptr_array_index (waiters, i);
+
+        if (error)
+            g_task_return_error (task, g_error_copy (error));
+        else
+            g_task_return_boolean (task, TRUE);
+        g_object_unref (task);
+    }
+}
+
+void
+mm_port_mipc_open_session (MMPortMipc          *self,
+                           guint8               slot,
+                           const guint16       *indications,
+                           guint                n_indications,
+                           const gchar         *client_name,
+                           GCancellable        *cancellable,
+                           GAsyncReadyCallback  callback,
+                           gpointer             user_data)
+{
+    GTask          *task;
+    GTask          *internal;
+    SessionContext *ctx;
+
+    g_return_if_fail (MM_IS_PORT_MIPC (self));
+
+    task = g_task_new (self, cancellable, callback, user_data);
+
+    if (!mm_port_mipc_is_open (self)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_WRONG_STATE,
+                                 "MIPC port is not open");
+        g_object_unref (task);
+        return;
+    }
+
+    /* One session start at a time on the shared port: a second caller
+     * joins the one in flight and gets its result (the indication list and
+     * slot mask are the plugin's constants, the same for every caller). */
+    if (self->priv->session_waiters) {
+        mm_obj_dbg (self, "MIPC session start in progress: joining it");
+        g_ptr_array_add (self->priv->session_waiters, task);
+        return;
+    }
+    self->priv->session_waiters = g_ptr_array_new ();
+    g_ptr_array_add (self->priv->session_waiters, task);
+
+    internal = g_task_new (self, cancellable, (GAsyncReadyCallback) session_internal_ready, NULL);
+    ctx = g_slice_new0 (SessionContext);
+    ctx->step          = SESSION_STEP_FIRST;
+    ctx->slot          = slot;
+    {
+        guint i, bit;
+        ctx->indications = g_new0 (guint16, n_indications * 8 + 1);
+        ctx->registration_slots = g_new0 (guint8, n_indications * 8 + 1);
+        for (i = 0; indications && i < n_indications; i++) {
+            if (MM_MIPC_IS_CMD (indications[i])) {
+                ctx->indications[ctx->n_indications] = indications[i];
+                ctx->registration_slots[ctx->n_indications++] = MM_MIPC_SLOT_ANY;
+            } else {
+                for (bit = 1; bit <= 0x80; bit <<= 1) {
+                    if (!(slot & bit))
+                        continue;
+                    ctx->indications[ctx->n_indications] = indications[i];
+                    ctx->registration_slots[ctx->n_indications++] = bit;
+                }
+            }
+        }
+    }
+    ctx->client_name   = g_strdup (client_name ? client_name : "ModemManager");
+    g_task_set_task_data (internal, ctx, (GDestroyNotify) session_context_free);
+
+    self->priv->session_ready = FALSE;
+    session_step (internal);
+}
+
+gboolean
+mm_port_mipc_session_starting (MMPortMipc *self)
+{
+    return self->priv->session_waiters != NULL;
+}
+
+static void removed_cb (MMPort *port, MMPortMipc *self)
+{
+    port_close (self, TRUE);
+}
+
+MMPortMipc *mm_port_mipc_new (const gchar *name)
+{
+    return g_object_new (MM_TYPE_PORT_MIPC, MM_PORT_DEVICE, name,
+                         MM_PORT_SUBSYS, MM_PORT_SUBSYS_WWAN,
+                         MM_PORT_GROUP, MM_PORT_GROUP_USED, MM_PORT_TYPE, MM_PORT_TYPE_UNKNOWN, NULL);
+}
+
+static void mm_port_mipc_init (MMPortMipc *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self, MM_TYPE_PORT_MIPC, MMPortMipcPrivate);
+    self->priv->fd = -1;
+    self->priv->rx = g_byte_array_new ();
+    self->priv->pending = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL, (GDestroyNotify) pending_free);
+    g_signal_connect (self, MM_PORT_SIGNAL_REMOVED, G_CALLBACK (removed_cb), self);
+}
+
+static void dispose (GObject *object)
+{
+    port_close (MM_PORT_MIPC (object), FALSE);
+    G_OBJECT_CLASS (mm_port_mipc_parent_class)->dispose (object);
+}
+
+static void finalize (GObject *object)
+{
+    MMPortMipc *self = MM_PORT_MIPC (object);
+    g_byte_array_unref (self->priv->rx);
+    g_hash_table_unref (self->priv->pending);
+    G_OBJECT_CLASS (mm_port_mipc_parent_class)->finalize (object);
+}
+
+static void mm_port_mipc_class_init (MMPortMipcClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    g_type_class_add_private (klass, sizeof (MMPortMipcPrivate));
+    object_class->dispose = dispose;
+    object_class->finalize = finalize;
+    signals[SIGNAL_INDICATION] = g_signal_new (MM_PORT_MIPC_SIGNAL_INDICATION,
+        G_OBJECT_CLASS_TYPE (klass), G_SIGNAL_RUN_FIRST,
+        G_STRUCT_OFFSET (MMPortMipcClass, indication), NULL, NULL, NULL,
+        G_TYPE_NONE, 4, G_TYPE_UINT, G_TYPE_UINT, G_TYPE_UINT, G_TYPE_BYTE_ARRAY);
+    signals[SIGNAL_FORCED_CLOSE] = g_signal_new ("forced-close", G_OBJECT_CLASS_TYPE (klass),
+        G_SIGNAL_RUN_FIRST, 0, NULL, NULL, NULL, G_TYPE_NONE, 0);
+}
+
+static void
+at_command_ready (MMPortMipc *self, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    g_autoptr(MMMipcCnf) cnf = mm_port_mipc_request_finish (self, res, &error);
+    gchar *text = cnf ? mm_mipc_tlv_find_at_string (cnf->payload->data, cnf->payload->len) : NULL;
+    if (text && !error) {
+        g_auto(GStrv) lines = g_strsplit_set (text, "\r\n", -1);
+        guint i;
+        for (i = 0; lines[i]; i++) {
+            gchar *line = g_strstrip (lines[i]);
+            gchar *end;
+            guint64 code;
+            if (!g_str_has_prefix (line, "+CME ERROR:"))
+                continue;
+            line += strlen ("+CME ERROR:");
+            while (g_ascii_isspace (*line))
+                line++;
+            code = g_ascii_strtoull (line, &end, 10);
+            if (end != line && !*end && code <= G_MAXINT)
+                error = mm_mobile_equipment_error_for_code ((MMMobileEquipmentError) code, self);
+            break;
+        }
+    }
+    if (error || !cnf || cnf->result || !text || strstr (text, "ERROR")) {
+        if (!error)
+            error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "SYS_AT failed: result %u%s%s",
+                                 cnf ? cnf->result : 0, text ? ": " : "", text ? text : "");
+        g_free (text);
+        g_task_return_error (task, error);
+    } else
+        g_task_return_pointer (task, text, g_free);
+    g_object_unref (task);
+}
+
+void
+mm_port_mipc_at_command (MMPortMipc *self, guint8 slot, const gchar *command, guint timeout,
+                          GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (self, NULL, callback, user_data);
+    g_autoptr(GByteArray) tlvs = g_byte_array_new ();
+    g_task_set_source_tag (task, mm_port_mipc_at_command);
+    if ((slot != MM_MIPC_SLOT_SIM1 && slot != MM_MIPC_SLOT_SIM2) ||
+        !command || !g_str_has_prefix (command, "AT") || strpbrk (command, "\r\n") || strlen (command) > 2048) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid slot-addressed AT command");
+        g_object_unref (task);
+        return;
+    }
+    mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_AT_STRING, command);
+    mm_port_mipc_request (self, MM_MIPC_SYS_AT_REQ, slot, tlvs, timeout, NULL,
+                          (GAsyncReadyCallback) at_command_ready, task);
+}
+
+gchar *
+mm_port_mipc_at_command_finish (MMPortMipc *self, GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
diff --git a/src/plugins/mtk-ccci/mm-port-mipc.h b/src/plugins/mtk-ccci/mm-port-mipc.h
new file mode 100644
index 00000000..3e737e57
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-port-mipc.h
@@ -0,0 +1,133 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MMPortMipc: a MIPC control port (/dev/wwan0mipcN) of the MediaTek MT6878
+ * integrated modem, driven by the mtk_ccci WWAN driver. Built on MMPort with nonblocking I/O and independent
+ * transmit/request queues. This class pairs requests with confirms by
+ * transaction id, dispatches indications with their original headers and runs
+ * the session start.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_PORT_MIPC_H
+#define MM_PORT_MIPC_H
+
+#include <glib.h>
+#include <glib-object.h>
+#include <gio/gio.h>
+
+#include "mm-port.h"
+#include "mm-mipc-proto.h"
+
+#define MM_TYPE_PORT_MIPC            (mm_port_mipc_get_type ())
+#define MM_PORT_MIPC(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_PORT_MIPC, MMPortMipc))
+#define MM_PORT_MIPC_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_PORT_MIPC, MMPortMipcClass))
+#define MM_IS_PORT_MIPC(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_PORT_MIPC))
+#define MM_IS_PORT_MIPC_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_PORT_MIPC))
+#define MM_PORT_MIPC_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_PORT_MIPC, MMPortMipcClass))
+
+/* signal: an indication (0x4xxx) or a modem->AP command (0x8xxx, odd) arrived.
+ * Arguments: guint msg_id, guint slot, guint txid, GByteArray *payload. */
+#define MM_PORT_MIPC_SIGNAL_INDICATION "indication"
+
+typedef struct _MMPortMipc MMPortMipc;
+typedef struct _MMPortMipcClass MMPortMipcClass;
+typedef struct _MMPortMipcPrivate MMPortMipcPrivate;
+
+struct _MMPortMipc {
+    MMPort parent;
+    MMPortMipcPrivate *priv;
+};
+
+struct _MMPortMipcClass {
+    MMPortClass parent;
+
+    /* signals */
+    void (* indication) (MMPortMipc *self, guint msg_id, guint slot, guint txid, GByteArray *payload);
+};
+
+/* a confirm, as returned by mm_port_mipc_request_finish() */
+typedef struct {
+    guint16     msg_id;
+    guint16     txid;
+    guint8      slot;
+    guint32     result;   /* TLV 0x0000, MM_MIPC_RESULT_MISSING when absent */
+    GByteArray *payload;  /* the TLVs */
+} MMMipcCnf;
+
+void mm_mipc_cnf_free (MMMipcCnf *cnf);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMMipcCnf, mm_mipc_cnf_free)
+
+GType mm_port_mipc_get_type (void);
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (MMPortMipc, g_object_unref)
+
+MMPortMipc *mm_port_mipc_new (const gchar *name);
+gboolean mm_port_mipc_open (MMPortMipc *self, GError **error);
+void mm_port_mipc_close (MMPortMipc *self);
+gboolean mm_port_mipc_is_open (MMPortMipc *self);
+gboolean mm_port_mipc_send_response (MMPortMipc *self, guint16 id, guint16 txid,
+                                     guint8 slot, GByteArray *tlvs, GError **error);
+
+/* One request (REQ class): the frame is built here with the next
+ * transaction id; the confirm with the same txid completes the operation.
+ * Multiple requests may await confirms; their replies may arrive in any order.
+ * Cancellation before submission sends nothing. After submission the confirm
+ * is drained (or times out) before cancellation is propagated.
+ * @tlvs may be NULL for an empty payload. The confirm's result TLV is NOT
+ * checked here: callers decide what a non-zero result means. */
+void       mm_port_mipc_request        (MMPortMipc          *self,
+                                        guint16              msg_id,
+                                        guint8               slot,
+                                        GByteArray          *tlvs,
+                                        guint                timeout_seconds,
+                                        GCancellable        *cancellable,
+                                        GAsyncReadyCallback  callback,
+                                        gpointer             user_data);
+MMMipcCnf *mm_port_mipc_request_finish (MMPortMipc          *self,
+                                        GAsyncResult        *res,
+                                        GError             **error);
+
+/* Slot-addressed, noninteractive AT command over SYS_AT. Result text is owned
+ * by the caller. No global ESUO switch is performed. */
+void mm_port_mipc_at_command (MMPortMipc *self, guint8 slot, const gchar *command,
+                              guint timeout, GAsyncReadyCallback callback, gpointer user_data);
+gchar *mm_port_mipc_at_command_finish (MMPortMipc *self, GAsyncResult *res, GError **error);
+
+/* Session start: INTERNAL_TEST_REQ until answered, INTERNAL_OPEN_REQ,
+ * then REGISTER_IND on @slot or REGISTER_CMD on slot 0xff for each id.
+ * The port must be open. OPEN and all registrations must succeed. A call
+ * while a session start is in flight joins it (one TEST/OPEN on the wire)
+ * and completes with its result. */
+void     mm_port_mipc_open_session        (MMPortMipc          *self,
+                                           guint8               slot,
+                                           const guint16       *indications,
+                                           guint                n_indications,
+                                           const gchar         *client_name,
+                                           GCancellable        *cancellable,
+                                           GAsyncReadyCallback  callback,
+                                           gpointer             user_data);
+gboolean mm_port_mipc_open_session_finish (MMPortMipc          *self,
+                                           GAsyncResult        *res,
+                                           GError             **error);
+
+/* TRUE while a session start is in flight (a new caller joins it) */
+gboolean mm_port_mipc_session_starting (MMPortMipc *self);
+
+/* TRUE between a successful session start and the port being closed */
+gboolean mm_port_mipc_get_session_ready (MMPortMipc *self);
+
+/* the default request timeout the modem announced in the open confirm (ms), 0 if none */
+guint    mm_port_mipc_get_modem_timeout_ms (MMPortMipc *self);
+
+#endif /* MM_PORT_MIPC_H */
diff --git a/src/plugins/mtk-ccci/mm-sim-mtk-ccci.c b/src/plugins/mtk-ccci/mm-sim-mtk-ccci.c
new file mode 100644
index 00000000..fd1c7087
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-sim-mtk-ccci.c
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ * Public 3GPP AT SIM reads over the slot-addressed SYS_AT tunnel of the modem.
+ * No ESUO switch is performed.
+ */
+#include <config.h>
+#include <string.h>
+#include <mm-errors-types.h>
+#include "mm-sim-mtk-ccci.h"
+#include "mm-modem-helpers.h"
+#include "mm-bind.h"
+
+typedef struct { MMBaseSim parent; MMPortMipc *port; guint8 slot; } MMSimMtkCcci;
+typedef struct { MMBaseSimClass parent; } MMSimMtkCcciClass;
+GType mm_sim_mtk_ccci_get_type (void);
+G_DEFINE_TYPE (MMSimMtkCcci, mm_sim_mtk_ccci, MM_TYPE_BASE_SIM)
+
+static gchar *parse_iccid (const gchar *text, GError **error)
+{
+    guint sw1, sw2;
+    g_autofree gchar *hex = NULL;
+    if (!mm_3gpp_parse_crsm_response (text, &sw1, &sw2, &hex, error))
+        return NULL;
+    if ((sw1 == 0x90 && sw2 == 0) || sw1 == 0x91 || sw1 == 0x92 || sw1 == 0x9f)
+        return mm_3gpp_parse_iccid (hex, error);
+    g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "SIM CRSM status %02x/%02x", sw1, sw2);
+    return NULL;
+}
+
+static gchar *parse_imsi (const gchar *text, GError **error)
+{
+    g_auto(GStrv) lines = g_strsplit_set (text, "\r\n", -1);
+    guint i;
+    for (i = 0; lines[i]; i++) {
+        const gchar *line = mm_strip_tag (g_strstrip (lines[i]), "+CIMI:");
+        gsize len = strlen (line);
+        if (len >= 5 && len <= 15 && strspn (line, "0123456789") == len)
+            return g_strdup (line);
+    }
+    g_set_error_literal (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Invalid SIM IMSI response");
+    return NULL;
+}
+
+static gchar *string_finish (MMBaseSim *self, GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void read_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    g_autofree gchar *text = mm_port_mipc_at_command_finish (port, res, &error);
+    gchar *value;
+    if (text)
+        g_strstrip (text);
+    value = text ? (g_task_get_task_data (task) ? parse_imsi (text, &error) : parse_iccid (text, &error)) : NULL;
+    if (value)
+        g_task_return_pointer (task, value, g_free);
+    else
+        g_task_return_error (task, error);
+    g_object_unref (task);
+}
+
+static void read_sim_identifier (MMBaseSim *base, GAsyncReadyCallback cb, gpointer data)
+{
+    MMSimMtkCcci *self = (MMSimMtkCcci *) base;
+    mm_port_mipc_at_command (self->port, self->slot, "AT+CRSM=176,12258,0,0,10", 20,
+                              (GAsyncReadyCallback) read_ready, g_task_new (self, NULL, cb, data));
+}
+
+static void read_imsi (MMBaseSim *base, GAsyncReadyCallback cb, gpointer data)
+{
+    MMSimMtkCcci *self = (MMSimMtkCcci *) base;
+    GTask *task = g_task_new (self, NULL, cb, data);
+    g_task_set_task_data (task, GUINT_TO_POINTER (1), NULL);
+    mm_port_mipc_at_command (self->port, self->slot, "AT+CIMI", 10,
+                              (GAsyncReadyCallback) read_ready, task);
+}
+
+static void dispose (GObject *object)
+{
+    g_clear_object (&((MMSimMtkCcci *) object)->port);
+    G_OBJECT_CLASS (mm_sim_mtk_ccci_parent_class)->dispose (object);
+}
+
+static void mm_sim_mtk_ccci_init (MMSimMtkCcci *self) { }
+static void mm_sim_mtk_ccci_class_init (MMSimMtkCcciClass *klass)
+{
+    MMBaseSimClass *base = MM_BASE_SIM_CLASS (klass);
+    G_OBJECT_CLASS (klass)->dispose = dispose;
+    base->load_sim_identifier = read_sim_identifier;
+    base->load_sim_identifier_finish = string_finish;
+    base->load_imsi = read_imsi;
+    base->load_imsi_finish = string_finish;
+    /* Inherited generic hooks use the physical AT port and therefore the
+     * primary SIM. Never let an operation on this object target that SIM. */
+    base->load_operator_identifier = NULL;
+    base->load_operator_identifier_finish = NULL;
+    base->load_operator_name = NULL;
+    base->load_operator_name_finish = NULL;
+    base->load_emergency_numbers = NULL;
+    base->load_emergency_numbers_finish = NULL;
+    base->load_preferred_networks = NULL;
+    base->load_preferred_networks_finish = NULL;
+    base->load_gid1 = NULL; base->load_gid1_finish = NULL;
+    base->load_gid2 = NULL; base->load_gid2_finish = NULL;
+    base->set_preferred_networks = NULL; base->set_preferred_networks_finish = NULL;
+    base->send_pin = NULL; base->send_pin_finish = NULL;
+    base->send_puk = NULL; base->send_puk_finish = NULL;
+    base->change_pin = NULL; base->change_pin_finish = NULL;
+    base->enable_pin = NULL; base->enable_pin_finish = NULL;
+}
+
+typedef struct { MMPortMipc *port; guint8 slot; MMBaseSim *sim; } NewContext;
+static void new_context_free (NewContext *ctx)
+{
+    g_clear_object (&ctx->port);
+    g_clear_object (&ctx->sim);
+    g_free (ctx);
+}
+
+static void sim_initialized (MMBaseSim *sim, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    if (!mm_base_sim_initialize_finish (sim, res, &error))
+        g_task_return_error (task, error);
+    else {
+        mm_base_sim_export (sim);
+        g_task_return_pointer (task, g_object_ref (sim), g_object_unref);
+    }
+    g_object_unref (task);
+}
+
+static void pin_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    NewContext *ctx = g_task_get_task_data (task);
+    MMBaseModem *modem = g_task_get_source_object (task);
+    GError *error = NULL;
+    g_autofree gchar *text = mm_port_mipc_at_command_finish (port, res, &error);
+    if (g_error_matches (error, MM_MOBILE_EQUIPMENT_ERROR, MM_MOBILE_EQUIPMENT_ERROR_SIM_NOT_INSERTED)) {
+        g_clear_error (&error);
+        g_task_return_pointer (task, NULL, NULL);
+        g_object_unref (task);
+        return;
+    }
+    if (!text || mm_parse_cpin_response (text, TRUE) == MM_MODEM_LOCK_UNKNOWN) {
+        if (!error)
+            error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "SIM%u state is unknown", ctx->slot);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    ctx->sim = g_object_new (mm_sim_mtk_ccci_get_type (), MM_BASE_SIM_MODEM, modem,
+                             MM_BIND_TO, modem, MM_BASE_SIM_SLOT_NUMBER, ctx->slot,
+                             "active", TRUE, NULL);
+    ((MMSimMtkCcci *) ctx->sim)->port = g_object_ref (port);
+    ((MMSimMtkCcci *) ctx->sim)->slot = ctx->slot;
+    mm_base_sim_initialize (ctx->sim, NULL, (GAsyncReadyCallback) sim_initialized, task);
+}
+
+void mm_sim_mtk_ccci_new (MMBaseModem *modem, MMPortMipc *port, guint8 slot,
+                          GAsyncReadyCallback cb, gpointer data)
+{
+    GTask *task = g_task_new (modem, NULL, cb, data);
+    NewContext *ctx = g_new0 (NewContext, 1);
+    ctx->port = g_object_ref (port);
+    ctx->slot = slot;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) new_context_free);
+    mm_port_mipc_at_command (port, slot, "AT+CPIN?", 10, (GAsyncReadyCallback) pin_ready, task);
+}
+
+MMBaseSim *mm_sim_mtk_ccci_new_finish (GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
