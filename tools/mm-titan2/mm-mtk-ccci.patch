+#ifndef MM_CALL_MTK_CCCI_H
+#define MM_CALL_MTK_CCCI_H
+#include "mm-base-call.h"
+#include "mm-base-modem.h"
+#include "mm-port-mipc.h"
+#include "mm-iface-modem-voice.h"
+#include "mm-modem-helpers.h"
+MMBaseCall *mm_call_mtk_ccci_new (MMBaseModem *modem, MMPortMipc *port, guint8 slot,
+                                 MMCallDirection direction, const gchar *number, guint dtmf_duration);
+void mm_call_mtk_ccci_report (MMIfaceModemVoice *modem, MMPortMipc *port, guint8 slot, const MMCallInfo *info);
+#endif
diff --git a/src/plugins/mtk-ccci/mm-mipc-proto.c b/src/plugins/mtk-ccci/mm-mipc-proto.c
new file mode 100644
index 00000000..b405af39
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mipc-proto.c
@@ -0,0 +1,408 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MIPC framing and TLV coding. Written from a clean-room behavioural description of the protocol; no code of the factory firmware was used.
+ * Ported to GLib from tools/modemd/src/mipc.c.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <string.h>
+
+#include "mm-mipc-proto.h"
+
+/*****************************************************************************/
+/* bytes (little-endian) */
+
+void
+mm_mipc_put (guint8 *p, gsize size, guint32 v)
+{
+    gsize i;
+
+    for (i = 0; i < size; i++)
+        p[i] = (guint8) (i < 4 ? v >> (8 * i) : 0);
+}
+
+guint32
+mm_mipc_get (const guint8 *p, gsize size)
+{
+    guint32 v = 0;
+    gsize   i;
+
+    for (i = 0; i < size && i < 4; i++)
+        v |= (guint32) p[i] << (8 * i);
+    return v;
+}
+
+/*****************************************************************************/
+/* TLV builder */
+
+gboolean
+mm_mipc_tlv_add (GByteArray *b, guint16 id, gconstpointer val, gsize len)
+{
+    gsize  need;
+    guint  old_len;
+    guint8 hdr[MM_MIPC_TLV_HDR];
+
+    g_return_val_if_fail (b != NULL, FALSE);
+    g_return_val_if_fail (val != NULL, FALSE);
+
+    /* len 0 is an array descriptor: not built here */
+    if (len == 0 || len > 0xFFFF)
+        return FALSE;
+    need = MM_MIPC_TLV_SIZE (len);
+    if (b->len + need > MM_MIPC_PAYLOAD_MAX)
+        return FALSE;
+
+    old_len = b->len;
+    mm_mipc_put (hdr, 2, id);
+    mm_mipc_put (hdr + 2, 2, (guint32) len);
+    g_byte_array_append (b, hdr, MM_MIPC_TLV_HDR);
+    g_byte_array_append (b, val, len);
+    /* zero padding to the 8-byte boundary */
+    g_byte_array_set_size (b, old_len + need);
+    memset (b->data + old_len + MM_MIPC_TLV_HDR + len, 0, need - MM_MIPC_TLV_HDR - len);
+    return TRUE;
+}
+
+gboolean
+mm_mipc_tlv_add_u8 (GByteArray *b, guint16 id, guint8 v)
+{
+    return mm_mipc_tlv_add (b, id, &v, 1);
+}
+
+gboolean
+mm_mipc_tlv_add_u16 (GByteArray *b, guint16 id, guint16 v)
+{
+    guint8 t[2];
+
+    mm_mipc_put (t, 2, v);
+    return mm_mipc_tlv_add (b, id, t, 2);
+}
+
+gboolean
+mm_mipc_tlv_add_u32 (GByteArray *b, guint16 id, guint32 v)
+{
+    guint8 t[4];
+
+    mm_mipc_put (t, 4, v);
+    return mm_mipc_tlv_add (b, id, t, 4);
+}
+
+gboolean
+mm_mipc_tlv_add_str (GByteArray *b, guint16 id, const gchar *s)
+{
+    g_return_val_if_fail (s != NULL, FALSE);
+    return mm_mipc_tlv_add (b, id, s, strlen (s) + 1);
+}
+
+/*****************************************************************************/
+/* TLV parser */
+
+gint
+mm_mipc_tlv_next (const guint8 *p, gsize len, gsize *off, MMMipcTlv *t)
+{
+    gsize o = *off, vlen, size;
+
+    if (o == len)
+        return 0;
+    if (o > len || len - o < MM_MIPC_TLV_HDR)
+        return -1;
+    t->raw_id = (guint16) mm_mipc_get (p + o, 2);
+    t->id = t->raw_id & MM_MIPC_TLV_ID_MASK;
+    vlen = mm_mipc_get (p + o + 2, 2);
+    size = MM_MIPC_TLV_SIZE (vlen);
+    if (size > len - o) {
+        /* the last element may be unpadded */
+        if (vlen && MM_MIPC_TLV_HDR + vlen <= len - o)
+            size = len - o;
+        else
+            return -1;
+    }
+    t->val = p + o + MM_MIPC_TLV_HDR;
+    t->len = vlen;
+    *off = o + size;
+    return 1;
+}
+
+const guint8 *
+mm_mipc_tlv_find (const guint8 *p, gsize len, guint16 id, gsize *vlen)
+{
+    MMMipcTlv t;
+    gsize     off = 0;
+
+    id &= MM_MIPC_TLV_ID_MASK;
+    while (mm_mipc_tlv_next (p, len, &off, &t) == 1) {
+        if (t.id == id && t.len) {
+            if (vlen)
+                *vlen = t.len;
+            return t.val;
+        }
+    }
+    return NULL;
+}
+
+gboolean
+mm_mipc_tlv_find_uint (const guint8 *p, gsize len, guint16 id, guint32 *v)
+{
+    gsize         vlen;
+    const guint8 *val;
+
+    val = mm_mipc_tlv_find (p, len, id, &vlen);
+    if (!val || vlen > 4)
+        return FALSE;
+    *v = mm_mipc_get (val, vlen);
+    return TRUE;
+}
+
+static gchar *
+tlv_find_string (const guint8 *p, gsize len, guint16 id, gboolean at_text)
+{
+    gsize         vlen, l, i;
+    const guint8 *val;
+    gchar        *out;
+
+    val = mm_mipc_tlv_find (p, len, id, &vlen);
+    if (!val)
+        return NULL;
+    l = strnlen ((const gchar *) val, vlen);
+    out = g_strndup ((const gchar *) val, l);
+    /* AT replies need line boundaries and horizontal whitespace for parsing.
+     * Other strings retain the single-line representation used in logs. */
+    for (i = 0; i < l; i++)
+        if (((guchar) out[i] < 0x20 || out[i] == 0x7F) &&
+            !(at_text && (out[i] == '\r' || out[i] == '\n' || out[i] == '\t')))
+            out[i] = '?';
+    return out;
+}
+
+gchar *
+mm_mipc_tlv_find_str (const guint8 *p, gsize len, guint16 id)
+{
+    return tlv_find_string (p, len, id, FALSE);
+}
+
+gchar *
+mm_mipc_tlv_find_at_string (const guint8 *p, gsize len)
+{
+    return tlv_find_string (p, len, MM_MIPC_T_AT_STRING, TRUE);
+}
+
+guint32
+mm_mipc_tlv_result (const guint8 *p, gsize len)
+{
+    guint32 result;
+
+    if (!mm_mipc_tlv_find_uint (p, len, MM_MIPC_T_RESULT, &result))
+        return MM_MIPC_RESULT_MISSING;
+    return result;
+}
+
+/*****************************************************************************/
+/* framing */
+
+GByteArray *
+mm_mipc_frame_build (guint16       msg_id,
+                     guint16       txid,
+                     guint8        slot,
+                     const guint8 *payload,
+                     gsize         len)
+{
+    GByteArray *out;
+    guint8      hdr[MM_MIPC_HDR_SIZE];
+
+    if (len >= MM_MIPC_PAYLOAD_MAX || (len && !payload))
+        return NULL;
+    memset (hdr, 0, sizeof (hdr));
+    mm_mipc_put (hdr + MM_MIPC_HDR_MAGIC_OFF, 4, MM_MIPC_MAGIC);
+    hdr[MM_MIPC_HDR_SLOT_OFF] = slot;
+    mm_mipc_put (hdr + MM_MIPC_HDR_MSGID_OFF, 2, msg_id);
+    mm_mipc_put (hdr + MM_MIPC_HDR_TXID_OFF, 2, txid);
+    mm_mipc_put (hdr + MM_MIPC_HDR_LEN_OFF, 2, (guint32) len);
+    out = g_byte_array_sized_new (MM_MIPC_HDR_SIZE + len);
+    g_byte_array_append (out, hdr, MM_MIPC_HDR_SIZE);
+    if (len)
+        g_byte_array_append (out, payload, len);
+    return out;
+}
+
+gint
+mm_mipc_frame_parse (const guint8 *buf,
+                     gsize         len,
+                     MMMipcMsg    *msg,
+                     gsize        *consumed)
+{
+    gsize plen;
+
+    if (len < MM_MIPC_HDR_SIZE)
+        return 0;
+    if (mm_mipc_get (buf + MM_MIPC_HDR_MAGIC_OFF, 4) != MM_MIPC_MAGIC)
+        return -1;
+    plen = mm_mipc_get (buf + MM_MIPC_HDR_LEN_OFF, 2);
+    if (plen > MM_MIPC_MSG_MAX - MM_MIPC_HDR_SIZE)
+        return -1;
+    if (len < MM_MIPC_HDR_SIZE + plen)
+        return 0;
+    msg->slot    = buf[MM_MIPC_HDR_SLOT_OFF];
+    msg->msg_id  = (guint16) mm_mipc_get (buf + MM_MIPC_HDR_MSGID_OFF, 2);
+    msg->txid    = (guint16) mm_mipc_get (buf + MM_MIPC_HDR_TXID_OFF, 2);
+    msg->payload = buf + MM_MIPC_HDR_SIZE;
+    msg->len     = plen;
+    *consumed    = MM_MIPC_HDR_SIZE + plen;
+    return 1;
+}
+
+/*****************************************************************************/
+
+const gchar *
+mm_mipc_msg_id_get_string (guint16 msg_id)
+{
+    switch (msg_id) {
+    case MM_MIPC_INTERNAL_OPEN_REQ:           return "INTERNAL_OPEN_REQ";
+    case MM_MIPC_INTERNAL_OPEN_CNF:           return "INTERNAL_OPEN_CNF";
+    case MM_MIPC_INTERNAL_CLOSE_REQ:          return "INTERNAL_CLOSE_REQ";
+    case MM_MIPC_INTERNAL_CLOSE_CNF:          return "INTERNAL_CLOSE_CNF";
+    case MM_MIPC_INTERNAL_TEST_REQ:           return "INTERNAL_TEST_REQ";
+    case MM_MIPC_INTERNAL_TEST_CNF:           return "INTERNAL_TEST_CNF";
+    case MM_MIPC_INTERNAL_REGISTER_IND_REQ:   return "INTERNAL_REGISTER_IND_REQ";
+    case MM_MIPC_INTERNAL_REGISTER_IND_CNF:   return "INTERNAL_REGISTER_IND_CNF";
+    case MM_MIPC_INTERNAL_UNREGISTER_IND_REQ: return "INTERNAL_UNREGISTER_IND_REQ";
+    case MM_MIPC_INTERNAL_EIF_IND:            return "INTERNAL_EIF_IND";
+    case MM_MIPC_SYS_AT_REQ:                  return "SYS_AT_REQ";
+    case MM_MIPC_SYS_AT_CNF:                  return "SYS_AT_CNF";
+    case MM_MIPC_SYS_AT_IND:                  return "SYS_AT_IND";
+    case MM_MIPC_DATA_ACT_CALL_REQ:           return "DATA_ACT_CALL_REQ";
+    case MM_MIPC_DATA_ACT_CALL_CNF:           return "DATA_ACT_CALL_CNF";
+    case MM_MIPC_DATA_DEACT_CALL_REQ:         return "DATA_DEACT_CALL_REQ";
+    case MM_MIPC_DATA_DEACT_CALL_CNF:         return "DATA_DEACT_CALL_CNF";
+    case MM_MIPC_DATA_ACT_CALL_IND:           return "DATA_ACT_CALL_IND";
+    case MM_MIPC_DATA_DEACT_CALL_IND:         return "DATA_DEACT_CALL_IND";
+    case MM_MIPC_SMS_CFG_IND:                 return "SMS_CFG_IND";
+    case MM_MIPC_SMS_NEW_SMS_IND:             return "SMS_NEW_SMS_IND";
+    case MM_MIPC_SMS_STORE_STATUS_IND:        return "SMS_STORE_STATUS_IND";
+    case MM_MIPC_SMS_NEW_STATUS_REPORT_IND:   return "SMS_NEW_STATUS_REPORT_IND";
+    case MM_MIPC_NW_SET_RAT_REQ:              return "NW_SET_RAT_REQ";
+    case MM_MIPC_NW_SET_RAT_CNF:              return "NW_SET_RAT_CNF";
+    case MM_MIPC_NW_CURRENT_RAT_IND:          return "NW_CURRENT_RAT_IND";
+    default:                                  return NULL;
+    }
+}
+
+
+/* Explicit pairs: IMS_SET_CONFIG starts at the even id 0x0a00. */
+gboolean
+mm_mipc_request_is_valid (guint16 id)
+{
+    switch (id) {
+    case MM_MIPC_INTERNAL_TEST_REQ:
+    case MM_MIPC_INTERNAL_OPEN_REQ:
+    case MM_MIPC_INTERNAL_CLOSE_REQ:
+    case MM_MIPC_INTERNAL_REGISTER_IND_REQ:
+    case MM_MIPC_INTERNAL_UNREGISTER_IND_REQ:
+    case MM_MIPC_INTERNAL_REGISTER_CMD_REQ:
+    case MM_MIPC_SYS_AT_REQ:
+    case MM_MIPC_DATA_ACT_CALL_REQ:
+    case MM_MIPC_DATA_DEACT_CALL_REQ:
+    case MM_MIPC_IMS_SET_CONFIG_REQ:
+    case MM_MIPC_APN_ADD_PROFILE_LIST_REQ:
+    case MM_MIPC_NW_SET_RAT_REQ:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+const guint8 *
+mm_mipc_tlv_find_record (const guint8 *p, gsize len, guint16 id, gsize *vlen)
+{
+    const guint8 *value = mm_mipc_tlv_find (p, len, id, vlen);
+    MMMipcTlv tlv;
+    gsize off = 0;
+
+    if (value)
+        return value;
+    while (mm_mipc_tlv_next (p, len, &off, &tlv) == 1) {
+        if (tlv.id == (id & MM_MIPC_TLV_ID_MASK) && !tlv.len) {
+            guint16 first = mm_mipc_get (tlv.val + 8, 2);
+            if (mm_mipc_get (tlv.val + 10, 2))
+                return mm_mipc_tlv_find (p, len, first, vlen);
+            break;
+        }
+    }
+    return NULL;
+}
+
+GByteArray *
+mm_mipc_build_ims_config (gboolean key_form, const guint8 flags[6])
+{
+    GByteArray *tlvs = g_byte_array_new ();
+    mm_mipc_tlv_add_u32 (tlvs, MM_MIPC_T_IMSCFG_FORM, key_form ? MM_MIPC_IMSCFG_FORM_KEY : MM_MIPC_IMSCFG_FORM_FLAGS);
+    if (key_form) {
+        mm_mipc_tlv_add_str (tlvs, MM_MIPC_T_IMSCFG_KEY, MM_MIPC_IMSCFG_KEY_VOLTE);
+        mm_mipc_tlv_add_u8 (tlvs, MM_MIPC_T_IMSCFG_VALUE, MM_MIPC_IMSCFG_KEY_VOLTE_VALUE);
+    } else
+        mm_mipc_tlv_add (tlvs, MM_MIPC_T_IMSCFG_VALUE, flags, MM_MIPC_IMSCFG_FLAGS);
+    return tlvs;
+}
+
+GByteArray *
+mm_mipc_build_apn_profiles (const gchar *internet, const gchar *ims, const gchar *sos)
+{
+    const gchar *names[] = { internet, ims, sos };
+    const guint32 types[] = { MM_MIPC_APN_REC_TYPE_DEFAULT, MM_MIPC_APN_REC_TYPE_IMS, MM_MIPC_APN_REC_TYPE_EMERGENCY };
+    guint count = 0, index = 0, i;
+    guint8 descriptor[16] = { 0 };
+    GByteArray *tlvs;
+
+    for (i = 0; i < G_N_ELEMENTS (names); i++) {
+        if (names[i] && names[i][0]) {
+            if (strlen (names[i]) >= MM_MIPC_APN_REC_APN_MAX)
+                return NULL;
+            count++;
+        }
+    }
+    if (!count)
+        return NULL;
+    tlvs = g_byte_array_new ();
+    mm_mipc_tlv_add_u8 (tlvs, MM_MIPC_T_APNLIST_COUNT, count);
+    mm_mipc_put (descriptor, 2, MM_MIPC_T_APNLIST_ARRAY);
+    mm_mipc_put (descriptor + 12, 2, 0x10000u - count);
+    mm_mipc_put (descriptor + 14, 2, count);
+    g_byte_array_append (tlvs, descriptor, sizeof (descriptor));
+    for (i = 0; i < G_N_ELEMENTS (names); i++) {
+        guint8 record[MM_MIPC_APN_REC_SIZE] = { 0 };
+        if (!names[i] || !names[i][0])
+            continue;
+        mm_mipc_put (record + MM_MIPC_APN_REC_ID_OFF, 4, G_MAXUINT32);
+        memcpy (record + MM_MIPC_APN_REC_APN_OFF, names[i], strlen (names[i]));
+        mm_mipc_put (record + MM_MIPC_APN_REC_BEARER_OFF, 4, MM_MIPC_APN_REC_BEARER_ALL);
+        mm_mipc_put (record + MM_MIPC_APN_REC_TYPE_OFF, 4, types[i]);
+        record[MM_MIPC_APN_REC_PDP_OFF] = i ? MM_MIPC_PDP_IPV4V6 : MM_MIPC_PDP_IP;
+        record[MM_MIPC_APN_REC_ROAM_PDP_OFF] = record[MM_MIPC_APN_REC_PDP_OFF];
+        /* Captured values; coding of authentication and enabled is unverified. */
+        record[MM_MIPC_APN_REC_AUTH_OFF] = i ? 0 : 1;
+        mm_mipc_put (record + MM_MIPC_APN_REC_ENABLED_OFF, 4, 1);
+        mm_mipc_tlv_add (tlvs, (guint16) (0x10000u - count + index++), record, sizeof (record));
+    }
+    return tlvs;
+}
+
+GByteArray *
+mm_mipc_build_set_rat (guint8 rat, guint8 prefer)
+{
+    GByteArray *b = g_byte_array_new ();
+
+    mm_mipc_tlv_add_u8 (b, MM_MIPC_T_SET_RAT_RAT, rat);
+    mm_mipc_tlv_add_u8 (b, MM_MIPC_T_SET_RAT_PREFER, prefer);
+    return b;
+}
diff --git a/src/plugins/mtk-ccci/mm-mipc-proto.h b/src/plugins/mtk-ccci/mm-mipc-proto.h
new file mode 100644
index 00000000..b77191e6
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-mipc-proto.h
@@ -0,0 +1,345 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * MIPC: the MediaTek modem's binary request/confirm/indication protocol on
+ * the WWAN "MIPC" ports (/dev/wwan0mipcN) of the MT6878 integrated modem.
+ * Framing and TLV coding only; no I/O. Layout and ids from a clean-room
+ * behavioural description of the protocol (no code of the factory firmware
+ * was used); items not confirmed on the device are marked (unverified). Ported to GLib from tools/modemd/src/mipc.c
+ * (t2-modemd) of the same project.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_MIPC_PROTO_H
+#define MM_MIPC_PROTO_H
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* --- header, little-endian --- */
+
+#define MM_MIPC_HDR_SIZE        16
+#define MM_MIPC_MAGIC           0x24541984u /* bytes 84 19 54 24 */
+#define MM_MIPC_HDR_MAGIC_OFF   0   /* u32 */
+#define MM_MIPC_HDR_RES_OFF     4   /* u32, always 0 */
+#define MM_MIPC_HDR_SLOT_OFF    8   /* u8 slot bit mask: 0x01 SIM1, 0x02 SIM2, 0xFF any */
+#define MM_MIPC_HDR_UNUSED_OFF  9   /* u8 0 */
+#define MM_MIPC_HDR_MSGID_OFF   10  /* u16 */
+#define MM_MIPC_HDR_TXID_OFF    12  /* u16 */
+#define MM_MIPC_HDR_LEN_OFF     14  /* u16 payload length */
+#define MM_MIPC_SLOT_ANY        0xFF
+#define MM_MIPC_SLOT_SIM1       0x01
+#define MM_MIPC_SLOT_SIM2       0x02
+#define MM_MIPC_TXID_NONE       0xFFFF /* indications and notifications */
+#define MM_MIPC_PAYLOAD_MAX     0xFFF0 /* the serializer refuses more */
+#define MM_MIPC_MSG_MAX         (MM_MIPC_HDR_SIZE + 8192) /* what we accept in one message */
+
+/* message classes: bits 15..14 of the id */
+#define MM_MIPC_CLASS(id)       (((id) >> 14) & 3)
+#define MM_MIPC_CLASS_REQCNF    0
+#define MM_MIPC_CLASS_IND       1
+#define MM_MIPC_CLASS_CMDRSP    2
+#define MM_MIPC_CLASS_NTF       3
+#define MM_MIPC_IS_IND(id)      (MM_MIPC_CLASS (id) == MM_MIPC_CLASS_IND)
+#define MM_MIPC_IS_CMD(id)      (MM_MIPC_CLASS (id) == MM_MIPC_CLASS_CMDRSP && ((id) & 1))
+#define MM_MIPC_CNF_OF(req)     ((req) + 1)
+
+/* --- TLV: u16 id (bit 15 = privacy flag), u16 len, value,
+ * padded to 8 bytes; len == 0 is a 16-byte array descriptor --- */
+
+#define MM_MIPC_TLV_HDR         4
+#define MM_MIPC_TLV_ALIGN       8
+#define MM_MIPC_TLV_ID_MASK     0x7FFF
+#define MM_MIPC_TLV_DESCR_SIZE  16
+#define MM_MIPC_TLV_SIZE(len)   ((len) ? ((MM_MIPC_TLV_HDR + (len) + 7) & ~(gsize) 7) : MM_MIPC_TLV_DESCR_SIZE)
+#define MM_MIPC_T_RESULT        0x0000 /* u32 in every CNF, 0 = success */
+#define MM_MIPC_RESULT_MISSING  2      /* a CNF without a result TLV counts as 2 */
+
+/* --- message ids --- */
+
+/* INTERNAL group */
+#define MM_MIPC_INTERNAL_OPEN_REQ           0x0301
+#define MM_MIPC_INTERNAL_OPEN_CNF           0x0302
+#define MM_MIPC_INTERNAL_CLOSE_REQ          0x0303
+#define MM_MIPC_INTERNAL_CLOSE_CNF          0x0304
+#define MM_MIPC_INTERNAL_TEST_REQ           0x0305
+#define MM_MIPC_INTERNAL_TEST_CNF           0x0306
+#define MM_MIPC_INTERNAL_REGISTER_IND_REQ   0x0307
+#define MM_MIPC_INTERNAL_REGISTER_IND_CNF   0x0308
+#define MM_MIPC_INTERNAL_UNREGISTER_IND_REQ 0x0309
+#define MM_MIPC_INTERNAL_REGISTER_CMD_REQ 0x030B
+#define MM_MIPC_INTERNAL_REGISTER_CMD_CNF 0x030C
+#define MM_MIPC_INTERNAL_EIF_IND            0x4302 /* interface state */
+#define MM_MIPC_T_OPEN_VERSION              0x0100 /* u32 = 2 (meaning unverified) */
+#define MM_MIPC_T_OPEN_CLIENT_NAME          0x0101 /* string */
+#define MM_MIPC_T_OPEN_FLAG                 0x0102 /* u8 = 1 */
+#define MM_MIPC_T_OPEN_CNF_TIMEOUT          0x0101 /* u32 default request timeout ms */
+#define MM_MIPC_T_REGISTER_IND_ID           0x0100 /* u16 indication id */
+#define MM_MIPC_OPEN_VERSION                2
+
+/* SYS group: AT tunnel */
+#define MM_MIPC_SYS_AT_REQ                  0x0003
+#define MM_MIPC_SYS_AT_CNF                  0x0004
+#define MM_MIPC_SYS_AT_IND                  0x4001
+#define MM_MIPC_T_AT_STRING                 0x8100
+
+/* DATA group */
+#define MM_MIPC_DATA_ACT_CALL_REQ           0x0201
+#define MM_MIPC_DATA_ACT_CALL_CNF           0x0202
+#define MM_MIPC_DATA_DEACT_CALL_REQ         0x0203
+#define MM_MIPC_DATA_DEACT_CALL_CNF         0x0204
+#define MM_MIPC_DATA_ACT_CALL_IND           0x4201
+#define MM_MIPC_DATA_DEACT_CALL_IND         0x4202
+
+/* DATA_ACT_CALL_REQ TLVs */
+#define MM_MIPC_T_ACT_APN                   0x0101 /* string */
+#define MM_MIPC_T_ACT_APN_TYPE              0x0102 /* u32 mask, 1 = default (inferred) */
+#define MM_MIPC_T_ACT_PDP_TYPE              0x0103 /* u8 1 IP, 2 IPV6, 3 IPV4V6 */
+#define MM_MIPC_T_ACT_ROAM_PDP_TYPE         0x0104 /* u8 */
+#define MM_MIPC_T_ACT_AUTH_TYPE             0x0105 /* u8 (unverified) */
+#define MM_MIPC_T_ACT_USER                  0x8106 /* string, "" */
+#define MM_MIPC_T_ACT_PASSWORD              0x8107 /* string, "" */
+#define MM_MIPC_T_ACT_CONST_7F              0x0108 /* u8 0x7F (meaning unverified) */
+#define MM_MIPC_T_ACT_BEARER_MASK           0x0109 /* u32 */
+#define MM_MIPC_T_ACT_SPECIAL               0x010A /* u8 0 (meaning unverified) */
+#define MM_MIPC_T_ACT_APN_INDEX             0x010C /* u32, only when in the APN table */
+#define MM_MIPC_T_ACT_TRAFFIC_DESCR         0x010D /* 672 bytes (layout partly unverified) */
+#define MM_MIPC_T_ACT_NO_MATCH_ALL          0x010F /* u32 0 */
+#define MM_MIPC_ACT_APN_TYPE_DEFAULT        1
+#define MM_MIPC_ACT_APN_TYPE_IMS            0x40
+#define MM_MIPC_ACT_CONST_7F                0x7F
+#define MM_MIPC_ACT_BEARER_ALL              0x7FFFFFFFu
+#define MM_MIPC_TRAFFIC_DESCR_SIZE          672
+#define MM_MIPC_TRAFFIC_DESCR_DNN_OFF       4
+#define MM_MIPC_TRAFFIC_DESCR_DNN_MAX       99
+#define MM_MIPC_PDP_IP                      1
+#define MM_MIPC_PDP_IPV6                    2
+#define MM_MIPC_PDP_IPV4V6                  3
+
+/* DATA_ACT_CALL_CNF TLVs */
+#define MM_MIPC_T_CNF_AID                   0x0100 /* u8 */
+#define MM_MIPC_T_CNF_APN                   0x0101 /* string */
+#define MM_MIPC_T_CNF_PDP_TYPE              0x0102 /* u8 */
+#define MM_MIPC_T_CNF_V4_COUNT              0x0103 /* u8 */
+#define MM_MIPC_T_CNF_V4_ADDRS              0x8104 /* 4 bytes x count */
+#define MM_MIPC_T_CNF_V4_DNS_COUNT          0x010D /* u8 */
+#define MM_MIPC_T_CNF_V4_DNS                0x810E /* 4 bytes x count */
+#define MM_MIPC_T_CNF_V6_DNS_COUNT          0x0112 /* u8 */
+#define MM_MIPC_T_CNF_V6_DNS                0x8113 /* 16 bytes x count */
+#define MM_MIPC_T_CNF_MTU_V4                0x0123 /* u32, 0 = none */
+#define MM_MIPC_T_CNF_MTU_V6                0x0124 /* u32 */
+#define MM_MIPC_T_CNF_IF_ID                 0x0125 /* u32 (direct interface id, absent in capture) */
+#define MM_MIPC_T_CNF_PRIMARY_AID           0x0126 /* u8 */
+#define MM_MIPC_T_CNF_TRANS_INTF_ID         0x012A /* u32: link id = value mod 100 */
+#define MM_MIPC_T_CNF_RAN                   0x012B /* u8, 1 = cellular */
+#define MM_MIPC_T_CNF_EPS_BEARER            0x012C /* u32 */
+#define MM_MIPC_TRANS_INTF_MOD              100
+
+/* INTERNAL_EIF_IND TLVs */
+#define MM_MIPC_T_EIF_TRANS_INTF_ID         0x0100 /* u32 */
+#define MM_MIPC_T_EIF_CMD                   0x0101 /* u8: 0 up, 1 down, 4 ho addr, 5 change, 6 mtu */
+#define MM_MIPC_T_EIF_REASON                0x0102 /* u32 */
+#define MM_MIPC_T_EIF_MTU                   0x0103 /* u32 */
+#define MM_MIPC_T_EIF_V4_COUNT              0x0104 /* u8 */
+#define MM_MIPC_T_EIF_V4_RECORDS            0x8105 /* 12 bytes x count, address in bytes 0..3 */
+#define MM_MIPC_T_EIF_V6_COUNT              0x0106 /* u8 */
+#define MM_MIPC_T_EIF_V6_RECORDS            0x8107 /* records, size unverified */
+#define MM_MIPC_EIF_RECORD_SIZE             12
+#define MM_MIPC_EIF_UP                      0
+#define MM_MIPC_EIF_DOWN                    1
+#define MM_MIPC_EIF_HO_ADDR                 4
+#define MM_MIPC_EIF_CHANGE                  5
+#define MM_MIPC_EIF_MTU                     6
+
+/* DATA_DEACT_CALL_REQ/CNF, indications */
+#define MM_MIPC_T_DEACT_AID                 0x0101 /* u8 */
+#define MM_MIPC_T_DEACT_CAUSE               0x0102 /* u8, values unverified; 1 = normal */
+#define MM_MIPC_DEACT_CAUSE_NORMAL          1
+#define MM_MIPC_T_IND_AID                   0x0100 /* u8 in 0x4201/0x4202 */
+#define MM_MIPC_T_IND_CAUSE                 0x0102 /* u32 in 0x4202 */
+
+/* APN_ADD_PROFILE_LIST_REQ / CNF: u8 count, an array descriptor 0x8101
+ * and one 284-byte record per profile (elements 0xFFFF downwards) */
+#define MM_MIPC_APN_ADD_PROFILE_LIST_REQ	0x0113
+#define MM_MIPC_APN_ADD_PROFILE_LIST_CNF	0x0114
+#define MM_MIPC_T_APNLIST_COUNT		0x0100	/* u8 */
+#define MM_MIPC_T_APNLIST_ARRAY		0x8101	/* array descriptor */
+#define MM_MIPC_APN_REC_SIZE		284
+#define MM_MIPC_APN_REC_ID_OFF		0	/* u32 0xFFFFFFFF: modem assigns (unverified) */
+#define MM_MIPC_APN_REC_APN_OFF		12	/* char[100] */
+#define MM_MIPC_APN_REC_APN_MAX		100
+#define MM_MIPC_APN_REC_USER_OFF		112	/* char[64] (unverified) */
+#define MM_MIPC_APN_REC_PASS_OFF		176	/* char[64] (unverified) */
+#define MM_MIPC_APN_REC_BEARER_OFF		244	/* u32 */
+#define MM_MIPC_APN_REC_TYPE_OFF		248	/* u32, this message's own coding */
+#define MM_MIPC_APN_REC_PDP_OFF		252	/* u8 */
+#define MM_MIPC_APN_REC_ROAM_PDP_OFF	253	/* u8 */
+#define MM_MIPC_APN_REC_AUTH_OFF		254	/* u8 (unverified) */
+#define MM_MIPC_APN_REC_ENABLED_OFF	256	/* u32 1 (unverified) */
+#define MM_MIPC_APN_REC_BEARER_ALL		0x7FFDFFFFu	/* the captured value */
+#define MM_MIPC_APN_REC_TYPE_DEFAULT	0x29	/* default (+dun/supl/fota class bits, unverified) */
+#define MM_MIPC_APN_REC_TYPE_IMS		0x02
+#define MM_MIPC_APN_REC_TYPE_MMS		0x04
+#define MM_MIPC_APN_REC_TYPE_EMERGENCY	0x100
+#define MM_MIPC_APN_MAX_PROFILES		4
+
+/* IMS_SET_CONFIG_REQ / CNF (as the factory firmware's RIL sends it): key/value form
+ * (0x0100 u32 1, 0x0101 key string with NUL, 0x0102 u8 value) and the
+ * feature-switch form (0x0100 u32 0, 0x0102 6 bytes volte, vilte, vowifi,
+ * viwifi, sms, eims = the AT+EIMSCFG flags) */
+#define MM_MIPC_IMS_SET_CONFIG_REQ		0x0A00
+#define MM_MIPC_IMS_SET_CONFIG_CNF		0x0A01
+#define MM_MIPC_T_IMSCFG_FORM		0x0100	/* u32: 1 key/value, 0 feature switches */
+#define MM_MIPC_T_IMSCFG_KEY		0x0101	/* string (with the terminating NUL) */
+#define MM_MIPC_T_IMSCFG_VALUE		0x0102	/* u8 value / 6 bytes of flags */
+#define MM_MIPC_IMSCFG_FORM_KEY		1
+#define MM_MIPC_IMSCFG_FORM_FLAGS		0
+#define MM_MIPC_IMSCFG_FLAGS		6
+#define MM_MIPC_IMSCFG_KEY_VOLTE		"mtk_ct_volte_support"	/* 21 bytes with NUL */
+#define MM_MIPC_IMSCFG_KEY_VOLTE_VALUE	0x32	/* ASCII '2' (meaning unverified) */
+
+/* IMS_PDN_IND (captured on the phone): short form = bookkeeping
+ * reset (0x0100 u8 1, 0x0103 u32 0); full form when the modem brings the IMS
+ * PDN up/down by itself (0x8100 20 bytes, 0x0100 u8 0, aid, action, type,
+ * interface id, 0x0105 u8 1) */
+#define MM_MIPC_IMS_PDN_IND		0x4A03
+#define MM_MIPC_T_IMSPDN_IND_TYPE		0x0100	/* u8: 1 short form (reset), 0 full form */
+#define MM_MIPC_T_IMSPDN_AID		0x0101	/* u32 */
+#define MM_MIPC_T_IMSPDN_ACTION		0x0102	/* u8: 1 up, 0 down */
+#define MM_MIPC_T_IMSPDN_TYPE		0x0103	/* u32: 2 = ims */
+#define MM_MIPC_T_IMSPDN_IFACE		0x0104	/* u32 interface id = transIntfId (0x65 = 101) */
+#define MM_MIPC_IMSPDN_TYPE_IMS		2
+
+/* INTERNAL_EIPSPI_CMD / _RSP: the modem asks for an IPsec SPI */
+#define MM_MIPC_INTERNAL_EIPSPI_CMD	0x8305
+#define MM_MIPC_INTERNAL_EIPSPI_RSP	0x8306
+#define MM_MIPC_T_SPI_INDEX		0x0100	/* u32 request index, echoed */
+#define MM_MIPC_T_SPI_ADDR1		0x8102	/* 20 bytes: u32 family/length 4, 16 address bytes (role unverified) */
+#define MM_MIPC_T_SPI_ADDR2		0x8103	/* 20 bytes: the IMS PDN's own address */
+#define MM_MIPC_T_SPI_PROTO		0x0104	/* u8, 50 = ESP (reading unverified) */
+#define MM_MIPC_T_SPI_MIN			0x0106	/* u32 lowest SPI allowed */
+#define MM_MIPC_T_SPI_MAX			0x0107	/* u32 highest SPI allowed */
+#define MM_MIPC_T_SPI_RSP_INDEX		0x0100	/* u32 = the request index */
+#define MM_MIPC_T_SPI_RSP_RESULT		0x0101	/* u8, 0 = success */
+#define MM_MIPC_T_SPI_RSP_SPI		0x8102	/* u32 the SPI */
+#define MM_MIPC_SPI_DEFAULT_MIN		0x00000100u	/* captured values, used when absent */
+#define MM_MIPC_SPI_DEFAULT_MAX		0x0fffffffu
+
+
+/* slot-addressed call indications and incoming approval. */
+#define MM_MIPC_CALL_STATUS_IND 0x4901
+#define MM_MIPC_CALL_EVENT_IND 0x4902
+#define MM_MIPC_CALL_APPROVE_CMD 0x8901
+#define MM_MIPC_CALL_APPROVE_RSP 0x8902
+
+/* SMS group 0x06 (ids and names from the protocol description's id
+ * tables). The factory firmware's RIL registers these indications for both slots at boot
+ * and the modem accepts every registration with result 0 (CCCI trace
+ * 2026-10-28, out/android-capture-dpmaif/ccci-boot-trace.txt, 0x0307/0x0308
+ * pairs); 0x4601 arrives once per slot after SIM start-up. The payload of the
+ * new-message indications was never captured: the plugin only takes them as
+ * "look at the storage now" and reads the message with +CMGL on the AT port.
+ * The modem->AP commands SMS_NEW_SMS_CMD 0x8601 / SMS_NEW_STATUS_REPORT_CMD
+ * 0x8603 (the factory firmware's RIL registers them too) need an answer whose format is
+ * unknown, so they are NOT registered: an unanswered delivery could be lost. */
+#define MM_MIPC_SMS_CFG_IND                 0x4601
+#define MM_MIPC_SMS_NEW_SMS_IND             0x4602
+#define MM_MIPC_SMS_STORE_STATUS_IND        0x4603
+#define MM_MIPC_SMS_NEW_STATUS_REPORT_IND   0x4606
+#define MM_MIPC_IS_SMS_IND(id)              (((id) & 0xFF00) == 0x4600)
+
+/* Network group 0x04: the RAT mode. The factory firmware's RIL
+ * sends NW_SET_RAT_REQ per slot at start-up with rat 22 and prefer_rat 128
+ * (factory-firmware logcat "handleSetPreferredNetworkTypeRequest: rat = 22, prefer_rat =
+ * 128", MIPC trace 2026-10-27, out/android-capture-calls); the CNF carries
+ * only the result and the modem then sends NW_CURRENT_RAT_IND. */
+#define MM_MIPC_NW_SET_RAT_REQ              0x0427
+#define MM_MIPC_NW_SET_RAT_CNF              0x0428
+#define MM_MIPC_NW_CURRENT_RAT_IND          0x441D
+#define MM_MIPC_T_SET_RAT_RAT               0x0100 /* u8 rat mode */
+#define MM_MIPC_T_SET_RAT_PREFER            0x0101 /* u8 prefer_rat */
+#define MM_MIPC_T_CURRENT_RAT_UNKNOWN       0x0100 /* u32 0x0F seen (meaning unverified) */
+#define MM_MIPC_T_CURRENT_RAT_RAT           0x0101 /* u8, = the rat sent */
+#define MM_MIPC_T_CURRENT_RAT_PREFER        0x0102 /* u8, = the prefer_rat sent */
+
+/* --- the API --- */
+
+/* a parsed message: payload points into the caller's buffer */
+typedef struct {
+    guint16       msg_id;
+    guint16       txid;
+    guint8        slot;
+    const guint8 *payload;
+    gsize         len;
+} MMMipcMsg;
+
+typedef struct {
+    guint16       id;     /* with bit 15 masked */
+    guint16       raw_id;
+    const guint8 *val;
+    gsize         len;    /* 0 = array descriptor (val points at the 12-byte body) */
+} MMMipcTlv;
+
+/* little-endian bytes */
+void    mm_mipc_put (guint8 *p, gsize size, guint32 v);
+guint32 mm_mipc_get (const guint8 *p, gsize size);
+
+/* TLV builder: appends to a GByteArray that will become the payload.
+ * Returns FALSE (and appends nothing) when the TLV cannot be encoded. */
+gboolean mm_mipc_tlv_add     (GByteArray *b, guint16 id, gconstpointer val, gsize len);
+gboolean mm_mipc_tlv_add_u8  (GByteArray *b, guint16 id, guint8 v);
+gboolean mm_mipc_tlv_add_u16 (GByteArray *b, guint16 id, guint16 v);
+gboolean mm_mipc_tlv_add_u32 (GByteArray *b, guint16 id, guint32 v);
+/* string with its terminating NUL (len includes it) */
+gboolean mm_mipc_tlv_add_str (GByteArray *b, guint16 id, const gchar *s);
+
+/* TLV parser: iterate (*off starts at 0); 1 element, 0 end, -1 malformed */
+gint          mm_mipc_tlv_next      (const guint8 *p, gsize len, gsize *off, MMMipcTlv *t);
+/* lookup by id (bit 15 ignored), not by order; array descriptors never match */
+const guint8 *mm_mipc_tlv_find      (const guint8 *p, gsize len, guint16 id, gsize *vlen);
+gboolean      mm_mipc_tlv_find_uint (const guint8 *p, gsize len, guint16 id, guint32 *v);
+/* newly allocated, control characters replaced, NULL when absent */
+gchar        *mm_mipc_tlv_find_str  (const guint8 *p, gsize len, guint16 id);
+/* AT text preserves CR/LF/TAB for parsing; other control bytes are replaced. */
+gchar        *mm_mipc_tlv_find_at_string (const guint8 *p, gsize len);
+/* result TLV 0x0000; MM_MIPC_RESULT_MISSING when absent */
+guint32       mm_mipc_tlv_result    (const guint8 *p, gsize len);
+
+/* framing: build a whole message (NULL when the payload is too long); parse
+ * one from a byte stream (1 ok, 0 need more bytes, -1 malformed: the caller
+ * drops its buffer) */
+GByteArray *mm_mipc_frame_build (guint16       msg_id,
+                                 guint16       txid,
+                                 guint8        slot,
+                                 const guint8 *payload,
+                                 gsize         len);
+gint        mm_mipc_frame_parse (const guint8 *buf,
+                                 gsize         len,
+                                 MMMipcMsg    *msg,
+                                 gsize        *consumed);
+
+gboolean mm_mipc_request_is_valid (guint16 id);
+const guint8 *mm_mipc_tlv_find_record (const guint8 *p, gsize len, guint16 id, gsize *vlen);
+GByteArray *mm_mipc_build_ims_config (gboolean key_form, const guint8 flags[6]);
+GByteArray *mm_mipc_build_apn_profiles (const gchar *internet, const gchar *ims, const gchar *sos);
+/* NW_SET_RAT_REQ payload: TLV 0x0100 u8 rat, 0x0101 u8 prefer_rat */
+GByteArray *mm_mipc_build_set_rat (guint8 rat, guint8 prefer);
+
+/* names of the ids this plugin knows, for logs ("0x1234" otherwise) */
+const gchar *mm_mipc_msg_id_get_string (guint16 msg_id);
+
+G_END_DECLS
+
+#endif /* MM_MIPC_PROTO_H */
diff --git a/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c b/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c
new file mode 100644
index 00000000..2fed20a6
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.c
@@ -0,0 +1,239 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Response helpers of the mtk-ccci plugin.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#include <string.h>
+
+#include "mm-modem-helpers-mtk-ccci.h"
+#include "mm-mipc-proto.h"
+
+gchar *
+mm_mtk_ccci_clcc_normalize (const gchar *response)
+{
+    g_autoptr(GRegex) regex = NULL;
+    gchar            *out;
+
+    if (!response)
+        return NULL;
+
+    /* +CLCC: <id>,<dir>,<stat>,<mode>, ... with <mode> 20..25; observed on the
+     * phone: "+CLCC: 1,0,2,20,0,"+7...",145" for a dialing VoLTE call */
+    regex = g_regex_new ("(\\+CLCC:\\s*\\d+,\\s*\\d+,\\s*\\d+,\\s*)(2[0-5])(\\s*,)",
+                         G_REGEX_RAW | G_REGEX_MULTILINE, 0, NULL);
+    g_assert (regex);
+    out = g_regex_replace (regex, response, -1, 0, "\\g<1>0\\g<3>", 0, NULL);
+    return out ? out : g_strdup (response);
+}
+
+/* speechd is a stream, not one read per response. */
+gint
+mm_mtk_ccci_speech_reply_feed (gchar **reply, const guint8 *data, gsize len, GError **error)
+{
+    gsize previous = *reply ? strlen (*reply) : 0;
+    if (len > 4096 || previous > 4096 - len || (len && memchr (data, 0, len))) {
+        g_set_error_literal (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT, "Invalid or oversized speechd reply");
+        return -1;
+    }
+    *reply = g_realloc (*reply, previous + len + 1);
+    if (len)
+        memcpy (*reply + previous, data, len);
+    (*reply)[previous + len] = 0;
+    if (len && (g_str_equal (*reply, "ok\n") || g_str_has_suffix (*reply, "\nok\n")))
+        return 1;
+    if (!len || strstr (*reply, "error:")) {
+        g_set_error (error, G_MARKUP_ERROR, G_MARKUP_ERROR_INVALID_CONTENT,
+                     "speechd: %s", (*reply)[0] ? *reply : "no reply");
+        return -1;
+    }
+    return 0;
+}
+
+guint mm_mtk_ccci_call_index (guint8 slot, guint id)
+{
+    if ((slot != 1 && slot != 2) || id < 1 || id > 7)
+        return 0;
+    return id + (slot == 2 ? 100 : 0);
+}
+
+gboolean mm_mtk_ccci_call_parse (guint8 slot, const guint8 *payload, gsize len, MMCallInfo *info)
+{
+    guint32 id, event, dir;
+    memset (info, 0, sizeof (*info));
+    if (!mm_mipc_tlv_find_uint (payload, len, 0x0100, &id) ||
+        !mm_mipc_tlv_find_uint (payload, len, 0x0109, &event) ||
+        !(info->index = mm_mtk_ccci_call_index (slot, id)))
+        return FALSE;
+    if (mm_mipc_tlv_find_uint (payload, len, 0x0101, &dir) && dir <= 1)
+        info->direction = dir ? MM_CALL_DIRECTION_INCOMING : MM_CALL_DIRECTION_OUTGOING;
+    switch (event) {
+    case 0: info->state = MM_CALL_STATE_RINGING_IN; info->direction = MM_CALL_DIRECTION_INCOMING; break;
+    case 2: info->state = MM_CALL_STATE_RINGING_OUT; info->direction = MM_CALL_DIRECTION_OUTGOING; break;
+    case 6: info->state = MM_CALL_STATE_ACTIVE; break;
+    case 130: info->state = MM_CALL_STATE_DIALING; info->direction = MM_CALL_DIRECTION_OUTGOING; break;
+    case 133: info->state = MM_CALL_STATE_TERMINATED; break;
+    default: return FALSE;
+    }
+    info->number = mm_mipc_tlv_find_str (payload, len, 0x8104);
+    return TRUE;
+}
+
+/*****************************************************************************/
+/* RAT mode */
+
+#define RAT_BIT_GSM  0x01
+#define RAT_BIT_UMTS 0x02
+#define RAT_BIT_LTE  0x04
+#define RAT_BIT_C2K  0x08
+#define RAT_BIT_NR   0x10
+
+#define MODES_2345 (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G | MM_MODEM_MODE_5G)
+
+typedef struct {
+    MMModemMode allowed;
+    MMModemMode preferred;
+    guint8      rat;
+    guint8      prefer;
+} RatMode;
+
+/* offered combinations, most useful first; the rat values follow the mask
+ * rule above, the first entry is the captured factory-firmware one */
+static const RatMode rat_modes[] = {
+    { MODES_2345, MM_MODEM_MODE_5G, MM_MTK_CCCI_RAT_STOCK_DEFAULT, MM_MTK_CCCI_RAT_PREFER_STOCK },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G, MM_MODEM_MODE_4G,   6, 3 },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G, MM_MODEM_MODE_NONE, 6, 0 },
+    { MM_MODEM_MODE_4G | MM_MODEM_MODE_5G, MM_MODEM_MODE_NONE, 19, 0 },
+    { MM_MODEM_MODE_4G,                    MM_MODEM_MODE_NONE,  3, 0 },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G, MM_MODEM_MODE_3G,    2, 2 },
+    { MM_MODEM_MODE_2G | MM_MODEM_MODE_3G, MM_MODEM_MODE_NONE,  2, 0 },
+    { MM_MODEM_MODE_3G,                    MM_MODEM_MODE_NONE,  1, 0 },
+    { MM_MODEM_MODE_2G,                    MM_MODEM_MODE_NONE,  0, 0 },
+};
+
+static MMModemMode
+rat_mask_normalize (MMModemMode mask)
+{
+    mask &= MODES_2345;
+    /* nothing usable reported: the 2G/3G/4G modem every MT6878 is */
+    return mask ? mask : (MM_MODEM_MODE_2G | MM_MODEM_MODE_3G | MM_MODEM_MODE_4G);
+}
+
+GArray *
+mm_mtk_ccci_rat_build_combinations (MMModemMode mask)
+{
+    GArray *combinations = g_array_new (FALSE, FALSE, sizeof (MMModemModeCombination));
+    guint   i;
+
+    mask = rat_mask_normalize (mask);
+    for (i = 0; i < G_N_ELEMENTS (rat_modes); i++) {
+        MMModemModeCombination mode;
+
+        if ((rat_modes[i].allowed & mask) != rat_modes[i].allowed)
+            continue;
+        mode.allowed = rat_modes[i].allowed;
+        mode.preferred = rat_modes[i].preferred;
+        g_array_append_val (combinations, mode);
+    }
+    return combinations;
+}
+
+void
+mm_mtk_ccci_rat_default (MMModemMode mask, MMModemMode *allowed, MMModemMode *preferred)
+{
+    if (!(mask & MODES_2345) || (mask & MM_MODEM_MODE_5G)) {
+        *allowed = rat_modes[0].allowed;
+        *preferred = rat_modes[0].preferred;
+    } else {
+        *allowed = rat_modes[1].allowed;
+        *preferred = rat_modes[1].preferred;
+    }
+}
+
+gboolean
+mm_mtk_ccci_rat_from_modes (MMModemMode mask, MMModemMode allowed, MMModemMode preferred,
+                            guint8 *rat, guint8 *prefer)
+{
+    guint i;
+
+    if (allowed == MM_MODEM_MODE_ANY && preferred == MM_MODEM_MODE_NONE)
+        mm_mtk_ccci_rat_default (mask, &allowed, &preferred);
+    if (mask & MODES_2345)
+        mask = rat_mask_normalize (mask);
+    else
+        mask = MODES_2345;   /* not probed yet */
+    for (i = 0; i < G_N_ELEMENTS (rat_modes); i++) {
+        if (rat_modes[i].allowed != allowed || rat_modes[i].preferred != preferred ||
+            (allowed & mask) != allowed)
+            continue;
+        *rat = rat_modes[i].rat;
+        *prefer = rat_modes[i].prefer;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+gboolean
+mm_mtk_ccci_rat_to_modes (guint rat, guint prefer, MMModemMode *allowed, MMModemMode *preferred)
+{
+    guint bits;
+
+    if (rat > 30)
+        return FALSE;
+    bits = (rat + 1) & ~RAT_BIT_C2K;   /* C2K has no MM mode of its own here */
+    *allowed = MM_MODEM_MODE_NONE;
+    if (bits & RAT_BIT_GSM)
+        *allowed |= MM_MODEM_MODE_2G;
+    if (bits & RAT_BIT_UMTS)
+        *allowed |= MM_MODEM_MODE_3G;
+    if (bits & RAT_BIT_LTE)
+        *allowed |= MM_MODEM_MODE_4G;
+    if (bits & RAT_BIT_NR)
+        *allowed |= MM_MODEM_MODE_5G;
+    if (*allowed == MM_MODEM_MODE_NONE)
+        return FALSE;
+
+    switch (prefer) {
+    case 1:  *preferred = MM_MODEM_MODE_2G; break;
+    case 2:  *preferred = MM_MODEM_MODE_3G; break;
+    case 3:  *preferred = MM_MODEM_MODE_4G; break;
+    case MM_MTK_CCCI_RAT_PREFER_STOCK:
+        *preferred = (*allowed & MM_MODEM_MODE_5G) ? MM_MODEM_MODE_5G : MM_MODEM_MODE_4G;
+        break;
+    default: *preferred = MM_MODEM_MODE_NONE; break;
+    }
+    /* a preference outside the allowed set or a lone allowed mode: none */
+    if (!(*preferred & *allowed) || *preferred == *allowed)
+        *preferred = MM_MODEM_MODE_NONE;
+    return TRUE;
+}
+
+gboolean
+mm_mtk_ccci_parse_erat (const gchar *reply, guint *curr_rat, guint *rat, guint *prefer)
+{
+    g_autoptr(GRegex)     regex = NULL;
+    g_autoptr(GMatchInfo) match = NULL;
+
+    if (!reply)
+        return FALSE;
+    regex = g_regex_new ("\\+ERAT:\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)",
+                         G_REGEX_RAW, 0, NULL);
+    g_assert (regex);
+    if (!g_regex_match (regex, reply, 0, &match))
+        return FALSE;
+    return mm_get_uint_from_match_info (match, 1, curr_rat) &&
+           mm_get_uint_from_match_info (match, 3, rat) &&
+           mm_get_uint_from_match_info (match, 4, prefer);
+}
diff --git a/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h b/src/plugins/mtk-ccci/mm-modem-helpers-mtk-ccci.h
