+    g_assert_cmpstr (c, ==, "+CLCC: 1,0,0,2,0,\"1\",129\r\n+CLCC: 2,0,0,200,0,\"2\",129");
+    g_assert_null (mm_mtk_ccci_clcc_normalize (NULL));
