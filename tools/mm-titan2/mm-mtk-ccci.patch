+ *
+ * Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ */
+
+#ifndef MM_BROADBAND_MODEM_MTK_CCCI_H
+#define MM_BROADBAND_MODEM_MTK_CCCI_H
+
+#include "mm-broadband-modem.h"
+#include "mm-port-mipc.h"
+
+#define MM_TYPE_BROADBAND_MODEM_MTK_CCCI            (mm_broadband_modem_mtk_ccci_get_type ())
+#define MM_BROADBAND_MODEM_MTK_CCCI(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_BROADBAND_MODEM_MTK_CCCI, MMBroadbandModemMtkCcci))
+#define MM_BROADBAND_MODEM_MTK_CCCI_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_BROADBAND_MODEM_MTK_CCCI, MMBroadbandModemMtkCcciClass))
+#define MM_IS_BROADBAND_MODEM_MTK_CCCI(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_BROADBAND_MODEM_MTK_CCCI))
+#define MM_IS_BROADBAND_MODEM_MTK_CCCI_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_BROADBAND_MODEM_MTK_CCCI))
+#define MM_BROADBAND_MODEM_MTK_CCCI_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_BROADBAND_MODEM_MTK_CCCI, MMBroadbandModemMtkCcciClass))
+
+/* udev properties read from the AT port's kernel device (set in the rules file) */
+#define ID_MM_MTK_CCCI_RADIO_MASK "ID_MM_MTK_CCCI_RADIO_MASK" /* AT+EFUN=<mask>: 1 SIM1, 2 SIM2, 3 both (default 3) */
+#define ID_MM_MTK_CCCI_SIM_SLOT   "ID_MM_MTK_CCCI_SIM_SLOT"   /* protocol stack on the AT port and MIPC slot: 1 or 2 (default 1) */
+#define ID_MM_MTK_CCCI_MIPC_DATA  "ID_MM_MTK_CCCI_MIPC_DATA"  /* the MIPC port used for data calls */
+/* dual-modem mode (DESIGN.md §11): one modem object per SIM stack */
+#define ID_MM_MTK_CCCI_DUAL_MODEM "ID_MM_MTK_CCCI_DUAL_MODEM" /* on wwan0at0: 1 (default) two objects, 0 the single-object mode */
+#define ID_MM_MTK_CCCI_SIM_ANCHOR "ID_MM_MTK_CCCI_SIM_ANCHOR" /* "2" on wwan0mipc2: the SIM2 object's device (never opened) */
+#define ID_MM_MTK_CCCI_MIPC_PORT  "ID_MM_MTK_CCCI_MIPC_PORT"  /* on the anchor: the shared MIPC port (default <wwan>mipc1) */
+#define ID_MM_MTK_CCCI_SIM2_DATA  "ID_MM_MTK_CCCI_SIM2_DATA"  /* on the anchor: 1 allows bearers on SIM2 (default 0) */
+#define ID_MM_MTK_CCCI_DSDS_BUSY  "ID_MM_MTK_CCCI_DSDS_BUSY"  /* on wwan0at0: 1 (default) reject an incoming call while the other SIM has a call, 0 approve always */
+
+typedef struct _MMBroadbandModemMtkCcci MMBroadbandModemMtkCcci;
+typedef struct _MMBroadbandModemMtkCcciClass MMBroadbandModemMtkCcciClass;
+typedef struct _MMBroadbandModemMtkCcciPrivate MMBroadbandModemMtkCcciPrivate;
+
+struct _MMBroadbandModemMtkCcci {
+    MMBroadbandModem parent;
+    MMBroadbandModemMtkCcciPrivate *priv;
+};
+
+struct _MMBroadbandModemMtkCcciClass {
+    MMBroadbandModemClass parent;
+};
+
+GType mm_broadband_modem_mtk_ccci_get_type (void);
+
+MMBroadbandModemMtkCcci *mm_broadband_modem_mtk_ccci_new (const gchar  *device,
+                                                          const gchar  *physdev,
+                                                          const gchar **drivers,
+                                                          const gchar  *plugin,
+                                                          guint16       vendor_id,
+                                                          guint16       product_id);
+
+/* the SIM2 modem object of the dual-modem mode: @anchor is the probed
+ * wwan0mipc2 (ID_MM_MTK_CCCI_SIM_ANCHOR=2); its AT port is created here
+ * (a virtual AT port over the slot-2 MIPC AT tunnel) */
+MMBroadbandModemMtkCcci *mm_broadband_modem_mtk_ccci_new_sim2 (const gchar     *device,
+                                                               const gchar     *physdev,
+                                                               const gchar    **drivers,
+                                                               const gchar     *plugin,
+                                                               MMKernelDevice  *anchor,
+                                                               GError         **error);
+
+/* TRUE in the dual-modem mode (each object serves one SIM stack) */
+gboolean mm_broadband_modem_mtk_ccci_is_dual (MMBroadbandModemMtkCcci *self);
+/* MIPC slot bits this object serves (0x03 in the single-object mode) */
+guint8   mm_broadband_modem_mtk_ccci_get_served_slots (MMBroadbandModemMtkCcci *self);
+
+/* the MIPC data port (NULL when the modem has none); not referenced */
+MMPortMipc *mm_broadband_modem_mtk_ccci_peek_port_mipc (MMBroadbandModemMtkCcci *self);
+
+/* MIPC header slot bit of the selected SIM stack (0x01 SIM1, 0x02 SIM2) */
+guint8 mm_broadband_modem_mtk_ccci_get_mipc_slot (MMBroadbandModemMtkCcci *self);
+
+/* kernel name of the WWAN device the ports belong to ("wwan0"): the parent of
+ * the data links */
+const gchar *mm_broadband_modem_mtk_ccci_get_wwan_device (MMBroadbandModemMtkCcci *self);
+
+gboolean mm_broadband_modem_mtk_ccci_ims_owns_link (MMBroadbandModemMtkCcci *self, guint link_id);
+/* a data event on the LTE-loss diagnostics trace of @slot (0: this
+ * object's slots), followed by a serving-state snapshot */
+void mm_broadband_modem_mtk_ccci_trace_event (MMBroadbandModemMtkCcci *self, guint8 slot, const gchar *what);
+
+/* Synchronize the selected SIM's internet APN with the connection manager. */
+void mm_broadband_modem_mtk_ccci_prepare_data (MMBroadbandModemMtkCcci *self, const gchar *apn,
+                                             GAsyncReadyCallback callback, gpointer user_data);
+gboolean mm_broadband_modem_mtk_ccci_prepare_data_finish (MMBroadbandModemMtkCcci *self,
+                                                        GAsyncResult *res, GError **error);
+
+#endif /* MM_BROADBAND_MODEM_MTK_CCCI_H */
diff --git a/src/plugins/mtk-ccci/mm-call-mtk-ccci.c b/src/plugins/mtk-ccci/mm-call-mtk-ccci.c
new file mode 100644
index 00000000..bae1f9ab
--- /dev/null
+++ b/src/plugins/mtk-ccci/mm-call-mtk-ccci.c
@@ -0,0 +1,244 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Copyright (C) 2026 serlk <22211586+Serlk@users.noreply.github.com>
+ * Per-SIM noninteractive AT call control via SYS_AT. Written from
+ * a clean-room behavioural description of the protocol; no code of the phone's Android software was used.
+ */
+#include <config.h>
+#include <string.h>
+#include <mm-errors-types.h>
+#include "mm-call-mtk-ccci.h"
+#include "mm-modem-helpers-mtk-ccci.h"
+#include "mm-bind.h"
+#include "mm-call-list.h"
+
+typedef struct { MMBaseCall parent; MMPortMipc *port; guint8 default_slot; } MMCallMtkCcci;
+typedef struct { MMBaseCallClass parent; } MMCallMtkCcciClass;
+GType mm_call_mtk_ccci_get_type (void);
+G_DEFINE_TYPE (MMCallMtkCcci, mm_call_mtk_ccci, MM_TYPE_BASE_CALL)
+
+static guint8 call_slot (MMCallMtkCcci *self)
+{
+    guint index = mm_base_call_get_index (MM_BASE_CALL (self));
+    return index ? (index > 100 ? 2 : 1) : self->default_slot;
+}
+
+static gboolean command_finish (MMBaseCall *self, GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void command_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    g_autofree gchar *reply = mm_port_mipc_at_command_finish (port, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void command (MMCallMtkCcci *self, const gchar *text, GCancellable *cancellable,
+                      GAsyncReadyCallback callback, gpointer user_data)
+{
+    GTask *task = g_task_new (self, cancellable, callback, user_data);
+    mm_port_mipc_at_command (self->port, call_slot (self), text, 30,
+                              (GAsyncReadyCallback) command_ready, task);
+}
+
+static void start (MMBaseCall *base, GCancellable *cancellable, GAsyncReadyCallback cb, gpointer data)
+{
+    const gchar *number = mm_base_call_get_number (base);
+    g_autofree gchar *text = NULL;
+    if (!number || !number[0] || strlen (number) > 128 || strspn (number, "+0123456789*#ABCDabcd") != strlen (number)) {
+        g_task_report_new_error (base, cb, data, start, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid dial number");
+        return;
+    }
+    text = g_strdup_printf ("ATD%s;", number);
+    command ((MMCallMtkCcci *) base, text, cancellable, cb, data);
+}
+
+static void accept_call (MMBaseCall *base, GAsyncReadyCallback cb, gpointer data)
+{
+    command ((MMCallMtkCcci *) base, "ATA", NULL, cb, data);
+}
+
+static void hangup (MMBaseCall *base, GAsyncReadyCallback cb, gpointer data)
+{
+    guint index = mm_base_call_get_index (base);
+    g_autofree gchar *text = index ? g_strdup_printf ("AT+CHLD=1%u", index % 100) : g_strdup ("AT+CHUP");
+    command ((MMCallMtkCcci *) base, text, NULL, cb, data);
+}
+
+static void dtmf_ready (MMPortMipc *port, GAsyncResult *res, GTask *task)
+{
+    GError *error = NULL;
+    g_autofree gchar *reply = mm_port_mipc_at_command_finish (port, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_int (task, GPOINTER_TO_UINT (g_task_get_task_data (task)));
+    g_object_unref (task);
+}
+
+static void send_dtmf (MMBaseCall *base, const gchar *digits, GAsyncReadyCallback cb, gpointer data)
+{
+    MMCallMtkCcci *self = (MMCallMtkCcci *) base;
+    GTask *task = g_task_new (self, NULL, cb, data);
+    g_autofree gchar *text = NULL;
+    if (!digits || !digits[0] || strlen (digits) > 32 || strspn (digits, "0123456789*#ABCDabcd") != strlen (digits)) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS, "Invalid DTMF string");
+        g_object_unref (task);
+        return;
+    }
+    text = g_strdup_printf ("AT+VTS=\"%s\"", digits);
+    g_task_set_task_data (task, GUINT_TO_POINTER (strlen (digits)), NULL);
+    mm_port_mipc_at_command (self->port, call_slot (self), text, 10, (GAsyncReadyCallback) dtmf_ready, task);
+}
+
+static gssize dtmf_finish (MMBaseCall *self, GAsyncResult *res, GError **error)
+{
+    return g_task_propagate_int (G_TASK (res), error);
+}
+
+static void dispose (GObject *object)
+{
+    g_clear_object (&((MMCallMtkCcci *) object)->port);
+    G_OBJECT_CLASS (mm_call_mtk_ccci_parent_class)->dispose (object);
+}
+
+static void mm_call_mtk_ccci_init (MMCallMtkCcci *self) { }
+static void mm_call_mtk_ccci_class_init (MMCallMtkCcciClass *klass)
+{
+    MMBaseCallClass *base = MM_BASE_CALL_CLASS (klass);
+    G_OBJECT_CLASS (klass)->dispose = dispose;
+    base->start = start; base->start_finish = command_finish;
+    base->accept = accept_call; base->accept_finish = command_finish;
+    base->hangup = hangup; base->hangup_finish = command_finish;
+    base->send_dtmf = send_dtmf; base->send_dtmf_finish = dtmf_finish;
+}
+
+MMBaseCall *mm_call_mtk_ccci_new (MMBaseModem *modem, MMPortMipc *port, guint8 slot,
+                                 MMCallDirection direction, const gchar *number, guint dtmf_duration)
+{
+    MMCallMtkCcci *self = g_object_new (mm_call_mtk_ccci_get_type (),
+        MM_BASE_CALL_IFACE_MODEM_VOICE, modem, MM_BIND_TO, modem,
+        MM_CALL_DIRECTION, direction, MM_CALL_NUMBER, number,
+        MM_CALL_DTMF_TONE_DURATION, dtmf_duration,
+        MM_BASE_CALL_SKIP_INCOMING_TIMEOUT, TRUE,
+        MM_BASE_CALL_SUPPORTS_DIALING_TO_RINGING, TRUE,
+        MM_BASE_CALL_SUPPORTS_RINGING_TO_ACTIVE, TRUE, NULL);
+    self->port = g_object_ref (port);
+    self->default_slot = slot;
+    return MM_BASE_CALL (self);
+}
+
+/* Generic voice matching may match equal phone numbers despite distinct call
+ * indexes. DSDS requires strict (slot,id) matching, including when both SIMs
+ * are called by the same number. */
+typedef struct { guint8 slot; MMBaseCall *call; } FindCall;
+static void find_outgoing (MMBaseCall *call, gpointer user_data)
+{
+    FindCall *ctx = user_data;
+    if (ctx->call || mm_base_call_get_index (call) ||
+        mm_base_call_get_state (call) == MM_CALL_STATE_TERMINATED ||
+        mm_base_call_get_direction (call) != MM_CALL_DIRECTION_OUTGOING ||
+        !G_TYPE_CHECK_INSTANCE_TYPE (call, mm_call_mtk_ccci_get_type ()))
+        return;
+    if (((MMCallMtkCcci *) call)->default_slot == ctx->slot)
+        ctx->call = call;
+}
+
+void mm_call_mtk_ccci_report (MMIfaceModemVoice *modem, MMPortMipc *port, guint8 slot, const MMCallInfo *info)
+{
+    g_autoptr(MMCallList) list = NULL;
+    MMBaseCall *call;
+    gboolean created = FALSE;
+    g_object_get (modem, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+    if (!list || !info->index)
+        return;
+    call = mm_call_list_get_call_by_index (list, info->index);
+    if (call && mm_base_call_get_state (call) == MM_CALL_STATE_TERMINATED) {
+        /* Modem call ids are reusable; retain the old D-Bus object as ended. */
+        mm_base_call_set_index (call, 0);
+        call = NULL;
+    }
+    if (!call && info->direction == MM_CALL_DIRECTION_OUTGOING) {
+        FindCall ctx = { slot, NULL };
+        mm_call_list_foreach (list, find_outgoing, &ctx);
+        call = ctx.call;
+    }
+    if (!call) {
+        if (info->state == MM_CALL_STATE_TERMINATED || info->direction == MM_CALL_DIRECTION_UNKNOWN)
+            return;
+        call = mm_call_mtk_ccci_new (MM_BASE_MODEM (modem), port, slot, info->direction, info->number, 0);
+        created = TRUE;
+    }
+    mm_base_call_set_index (call, info->index);
+    if (info->number)
+        mm_base_call_set_number (call, info->number);
+    mm_base_call_change_state (call, info->state,
+        created && info->direction == MM_CALL_DIRECTION_INCOMING ? MM_CALL_STATE_REASON_INCOMING_NEW : MM_CALL_STATE_REASON_UNKNOWN);
+    if (created) {
+        if (info->direction == MM_CALL_DIRECTION_INCOMING)
+            mm_base_call_incoming_refresh (call);
+        mm_base_call_export (call);
+        mm_call_list_add_call (list, call);
+        g_object_unref (call);
+    }
+}
+
+/* DSDS policy (mm-mtk-ccci-shared.c): does the slot have a call? */
+typedef struct { guint8 slot; guint n; } CountCalls;
+static void count_present (MMBaseCall *call, gpointer user_data)
+{
+    CountCalls *ctx = user_data;
+    switch (mm_base_call_get_state (call)) {
+    case MM_CALL_STATE_DIALING:
+    case MM_CALL_STATE_RINGING_OUT:
+    case MM_CALL_STATE_ACTIVE:
+    case MM_CALL_STATE_HELD:
+    case MM_CALL_STATE_RINGING_IN:
+    case MM_CALL_STATE_WAITING:
+        break;
+    case MM_CALL_STATE_UNKNOWN:      /* created, not started */
+    case MM_CALL_STATE_TERMINATED:
+    default:
+        return;
+    }
+    /* a call of another class has no slot: count it (the safe side) */
+    if (!G_TYPE_CHECK_INSTANCE_TYPE (call, mm_call_mtk_ccci_get_type ()) ||
+        call_slot ((MMCallMtkCcci *) call) == ctx->slot)
+        ctx->n++;
+}
+
+guint mm_call_mtk_ccci_count_present (MMIfaceModemVoice *modem, guint8 slot)
+{
+    g_autoptr(MMCallList) list = NULL;
+    CountCalls ctx = { slot, 0 };
+    g_object_get (modem, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+    if (list)
+        mm_call_list_foreach (list, count_present, &ctx);
+    return ctx.n;
+}
+
+gboolean mm_call_mtk_ccci_report_rejected (MMIfaceModemVoice *modem, MMPortMipc *port, guint8 slot, const gchar *number)
+{
+    g_autoptr(MMCallList) list = NULL;
+    MMBaseCall *call;
+    g_object_get (modem, MM_IFACE_MODEM_VOICE_CALL_LIST, &list, NULL);
+    if (!list)
+        return FALSE;
+    /* Index 0 and terminated before it is listed: the +CLCC reconciliation,
+     * the call reports (index lookups) and the generic matching all skip
+     * terminated calls; no state change follows, so no in-call setup (no
+     * speech path) and no incoming timeout. The client removes it with
+     * DeleteCall like any ended call. */
+    call = mm_call_mtk_ccci_new (MM_BASE_MODEM (modem), port, slot, MM_CALL_DIRECTION_INCOMING,
+                                 number ? number : "", 0);
+    mm_base_call_change_state (call, MM_CALL_STATE_TERMINATED, MM_CALL_STATE_REASON_REFUSED_OR_BUSY);
+    mm_base_call_export (call);
+    mm_call_list_add_call (list, call);
+    g_object_unref (call);
+    return TRUE;
+}
diff --git a/src/plugins/mtk-ccci/mm-call-mtk-ccci.h b/src/plugins/mtk-ccci/mm-call-mtk-ccci.h
new file mode 100644
