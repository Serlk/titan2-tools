# A maintenance window with the screen off: the network is back after the
# resume (Wi-Fi reassociates, the modem's data stays up), do the periodic
# work here. This one only nudges the clock (busybox ntpd, if installed).
command -v ntpd >/dev/null 2>&1 && ntpd -n -q -p pool.ntp.org 2>/dev/null &
exit 0
