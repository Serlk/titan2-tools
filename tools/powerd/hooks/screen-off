# /etc/t2-powerd/hooks/screen-off: the power key was pressed with the screen
# on. Ask every running niri session to switch its outputs off.
for s in /run/user/*/niri*.sock /run/user/*/niri/*.sock; do
	[ -S "$s" ] || continue
	NIRI_SOCKET=$s niri msg action power-off-monitors 2>/dev/null
done
exit 0
