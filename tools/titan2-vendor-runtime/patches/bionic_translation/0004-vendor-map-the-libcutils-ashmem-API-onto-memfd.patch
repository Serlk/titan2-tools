From 75c56d863e6aa6187350ba43b8cc4338cbcce79a Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Wed, 4 Nov 2026 02:19:09 +0300
Subject: [PATCH 4/4] vendor: map the libcutils ashmem API onto memfd

Add bionic_-prefixed replacements for ashmem_valid,
ashmem_create_region, ashmem_set_prot_region, ashmem_get_prot_region,
ashmem_pin_region, ashmem_unpin_region and ashmem_get_size_region to
libvendor_bio.so. Regions are memfd_create(2) files sized with
ftruncate; dropping PROT_WRITE from the protection mask seals future
writes, which is how newer libcutils builds emulate ashmem on memfd as
well. Pinning is a no-op since memfd pages are never purged.

Libraries that open /dev/ashmem themselves and use the ioctls directly
are not covered; that needs open/ioctl interception in libc_bio.
---
 README.md       |   3 +-
 meson.build     |   1 +
 vendor/ashmem.c | 106 ++++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 109 insertions(+), 1 deletion(-)
 create mode 100644 vendor/ashmem.c

diff --git a/README.md b/README.md
index 0edd0ec..47e2808 100644
--- a/README.md
+++ b/README.md
@@ -52,7 +52,8 @@ BIONIC_LOG_SYSLOG=1      - Send log messages to syslog(3) instead of stderr.
 
 With `BIONIC_VENDOR_ROOT` set, `libdl_bio.so` also loads `libvendor_bio.so.0` into the global scope. It
 holds `bionic_`-prefixed replacements for the parts of Android system libraries that only make sense
-with Android daemons around (liblog's `__android_log_*`, which would otherwise try to reach logd).
+with Android daemons around (liblog's `__android_log_*`, which would otherwise try to reach logd) or
+with Android-only kernel drivers (libcutils' `ashmem_*`, mapped onto memfd_create(2)).
 A program that does not use the environment variable can link `libvendor_bio.so` itself; nothing
 in it depends on the vendor root.
 
diff --git a/meson.build b/meson.build
index a700e35..139d386 100644
--- a/meson.build
+++ b/meson.build
@@ -159,6 +159,7 @@ stdcpp_bio = shared_library('stdc++_bio',
 vendor_bio = shared_library('vendor_bio',
 	sources: [
 		'vendor/liblog.c',
+		'vendor/ashmem.c',
 	],
 	soversion: 0,
 	install: true,
diff --git a/vendor/ashmem.c b/vendor/ashmem.c
new file mode 100644
index 0000000..a6bb66d
--- /dev/null
+++ b/vendor/ashmem.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ * ashmem (libcutils) replacements for the vendor profile, backed by memfd.
+ *
+ * ashmem_create_region() and friends are the libcutils API in front of the
+ * /dev/ashmem driver. Kernels without that driver offer memfd_create(2),
+ * which newer Android builds use for the same purpose. Sealing stands in for
+ * ASHMEM_SET_PROT_MASK: dropping PROT_WRITE seals future writes.
+ *
+ * Libraries that open /dev/ashmem directly and issue the ioctls themselves are
+ * not covered by this file.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef F_SEAL_FUTURE_WRITE
+#define F_SEAL_FUTURE_WRITE 0x0010
+#endif
+
+#ifndef MFD_ALLOW_SEALING
+#define MFD_ALLOW_SEALING 0x0002
+#endif
+
+#define ASHMEM_NAME_LEN 256
+#define ASHMEM_NOT_PURGED 0
+
+int bionic_ashmem_valid(int fd)
+{
+	/* only memfd and a few other special files support sealing */
+	return fcntl(fd, F_GET_SEALS) != -1;
+}
+
+int bionic_ashmem_create_region(const char *name, size_t size)
+{
+	char memfd_name[ASHMEM_NAME_LEN];
+
+	snprintf(memfd_name, sizeof(memfd_name), "%s", name && *name ? name : "ashmem");
+
+	int fd = memfd_create(memfd_name, MFD_CLOEXEC | MFD_ALLOW_SEALING);
+	if (fd < 0)
+		return -errno;
+
+	if (ftruncate(fd, size) < 0) {
+		int saved = errno;
+		close(fd);
+		return -saved;
+	}
+
+	return fd;
+}
+
+int bionic_ashmem_set_prot_region(int fd, int prot)
+{
+	if (prot & PROT_WRITE)
+		return 0; /* nothing to seal; ashmem cannot grant more than it already has */
+
+	if (fcntl(fd, F_ADD_SEALS, F_SEAL_FUTURE_WRITE) < 0)
+		return -errno;
+
+	return 0;
+}
+
+int bionic_ashmem_get_prot_region(int fd)
+{
+	int seals = fcntl(fd, F_GET_SEALS);
+	if (seals < 0)
+		return -errno;
+
+	int prot = PROT_READ | PROT_EXEC;
+	if (!(seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE)))
+		prot |= PROT_WRITE;
+	return prot;
+}
+
+int bionic_ashmem_pin_region(int fd, size_t offset, size_t len)
+{
+	(void)fd;
+	(void)offset;
+	(void)len;
+	return ASHMEM_NOT_PURGED;
+}
+
+int bionic_ashmem_unpin_region(int fd, size_t offset, size_t len)
+{
+	(void)fd;
+	(void)offset;
+	(void)len;
+	return 0; /* memfd pages are never purged */
+}
+
+int bionic_ashmem_get_size_region(int fd)
+{
+	struct stat st;
+
+	if (fstat(fd, &st) < 0)
+		return -errno;
+
+	return (int)st.st_size;
+}
