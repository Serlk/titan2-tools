index 38b6c25..f6a3e29 100644
--- a/README.md
+++ b/README.md
@@ -29,6 +29,24 @@ LINKER_PRINT_MISSING_SYMBOLS_AND_DIE= - When a non-function symbol is not found
 LINKER_IGNORE_UNKNOWN_RELOCS= - Don't set this. It's used when we run tests, because we know the missing relocs are only needed by a few tests which will correctly be marked as failing with this set.
 ```
 
+### vendor profile
+
+The linker can also load bionic-linked libraries out of a directory tree laid out like the
+Android partitions (`vendor/`, `system/`, `apex/`), for example an extracted or bind-mounted
+copy of them. This is opt-in:
+
+```
+BIONIC_VENDOR_ROOT=<dir> - Adds <dir>/vendor/lib64, <dir>/vendor/lib64/hw, <dir>/apex/<vndk>/lib64 and
+                           <dir>/system/lib64 (in this order) to the directories searched for bionic-linked
+                           libraries, and resolves absolute paths such as /vendor/lib64/hw/foo.so below <dir>
+                           first. libm.so is mapped to libc_bio.so.0, because libm is part of libc here.
+BIONIC_VNDK_APEX=<name>  - Name of the VNDK apex directory below <dir>/apex (default: com.android.vndk.v34).
+```
+
+Only 64-bit library directories are added; the vendor profile is not meant for 32-bit libraries.
+Note that the libraries found this way are linked by this linker with all the usual caveats, and that
+anything they need beyond libc/libdl/libm (e.g. libc++.so) has to be present in those directories too.
+
 ### dependencies
 
 the -dev(el) packages for: `egl libelf libbsd libunwind`
diff --git a/linker/dlfcn.c b/linker/dlfcn.c
index 5389531..eae3f7d 100644
--- a/linker/dlfcn.c
+++ b/linker/dlfcn.c
@@ -386,4 +386,16 @@ __attribute__((constructor)) void construct(void)
 	if (bionic_ld_library_path) {
 		dl_parse_library_path(bionic_ld_library_path, ":");
 	} // it might make sense to not specify the env, for example translation layer code calls dl_parse_library_path directly with the app's lib dir
+
+	// vendor profile: a directory with Android-style partition trees whose
+	// 64-bit library directories hold bionic-linked libraries
+	const char *vendor_root = getenv("BIONIC_VENDOR_ROOT");
+	if (vendor_root) {
+		if (apkenv_set_vendor_root(vendor_root) < 0) {
+			fprintf(stderr, "BIONIC_VENDOR_ROOT: failed to set up library directories below '%s'\n", vendor_root);
+		} else {
+			// libm is part of libc on musl/glibc; never load a foreign libm.so from the root
+			override_map_append(&lib_override_map, "libm.so", "libc_bio.so.0");
+		}
+	}
 }
