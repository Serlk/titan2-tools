index f77a87d..f1937dc 100644
--- a/linker/linker.c
+++ b/linker/linker.c
@@ -744,7 +744,7 @@ static void dump(soinfo *si)
 }
 #endif
 
-#define SOPATH_MAX 8
+#define SOPATH_MAX 16
 
 static const char *apkenv_sopaths[SOPATH_MAX + 1] = {
 	"/vendor/lib",
@@ -772,6 +772,58 @@ int apkenv_add_sopath(const char *path)
 	return -1;
 }
 
+/* Vendor profile: a directory holding Android-style partition trees (vendor/,
+ * system/, apex/). Libraries found below it are linked by this linker. */
+static const char *apkenv_vendor_root;
+
+const char *apkenv_get_vendor_root(void)
+{
+	return apkenv_vendor_root;
+}
+
+int apkenv_set_vendor_root(const char *root)
+{
+	if (!root || !*root)
+		return -1;
+
+	char *copy = strdup(root);
+	if (!copy)
+		return -1;
+	size_t len = strlen(copy);
+	while (len > 1 && copy[len - 1] == '/')
+		copy[--len] = '\0';
+	apkenv_vendor_root = copy;
+
+	const char *vndk_apex = getenv("BIONIC_VNDK_APEX") ?: "com.android.vndk.v34";
+
+	/* order matters: vendor libraries must see the VNDK copies of the shared
+	 * framework libraries before anything in system/lib64 */
+	const char *subdirs[] = {
+		"vendor/lib64",
+		"vendor/lib64/hw",
+		NULL, /* apex/<vndk>/lib64, filled in below */
+		"system/lib64",
+	};
+
+	for (size_t i = 0; i < sizeof(subdirs) / sizeof(subdirs[0]); i++) {
+		char *dir;
+		int n;
+		if (subdirs[i])
+			n = asprintf(&dir, "%s/%s", copy, subdirs[i]);
+		else
+			n = asprintf(&dir, "%s/apex/%s/lib64", copy, vndk_apex);
+		if (n < 0)
+			return -1;
+		if (apkenv_add_sopath(dir) < 0) {
+			free(dir);
+			return -1;
+		}
+		INFO("[ %5d vendor profile: added library directory %s ]\n", apkenv_pid, dir);
+	}
+
+	return 0;
+}
+
 static int apkenv__open_lib(const char *name)
 {
 	int fd;
@@ -806,6 +858,15 @@ static int apkenv_open_library(const char *name, char *fullpath)
 
 	strcpy(fullpath, name);
 
+	/* vendor profile: an absolute Android path is looked up below the vendor root first */
+	if (apkenv_vendor_root && name[0] == '/') {
+		n = format_buffer(buf, sizeof(buf), "%s%s", apkenv_vendor_root, name);
+		if (n > 0 && n < (int)sizeof(buf) && (fd = apkenv__open_lib(buf)) >= 0) {
+			strcpy(fullpath, buf);
+			return fd;
+		}
+	}
+
 	tmp_name = strdup(name);
 	path_normalized_name = realpath(dirname(tmp_name), NULL);
 	free(tmp_name);
@@ -855,6 +916,21 @@ static int apkenv_open_library(const char *name, char *fullpath)
 		}
 	}
 
+	/* an absolute path inside one of the fixed library directories is ours as well */
+	if (path_normalized_name && name[0] == '/') {
+		for (path = apkenv_sopaths; *path; path++) {
+			char *sopath_normalized = realpath(*path, NULL);
+			if (!sopath_normalized)
+				continue;
+			int same = !strcmp(sopath_normalized, path_normalized_name);
+			free(sopath_normalized);
+			if (same && (fd = apkenv__open_lib(name)) >= 0) {
+				free(path_normalized_name);
+				return fd;
+			}
+		}
+	}
+
 	free(path_normalized_name);
 
 	for (path = apkenv_sopaths; *path; path++) {
