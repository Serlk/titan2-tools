// Titan 2: the niri session is not a logind "active" session, so iio-sensor-proxy's default
// (allow_active) refuses ClaimProximity/ClaimAccelerometer/ClaimLight to the session's programs.
// The session user is in group input: allow the sensor claims there.
polkit.addRule(function(action, subject) {
	if (action.id == "net.hadess.SensorProxy.claim-sensor" && subject.isInGroup("input"))
		return polkit.Result.YES;
});
