--- a/src/api-impl/android/provider/Settings.java
+++ b/src/api-impl/android/provider/Settings.java
@@ -1,10 +1,18 @@
 package android.provider;
 
+import android.atl.ATLLoadedApp;
+import android.atl.ATLPaths;
 import android.content.ContentResolver;
 import android.content.Context;
 import android.net.Uri;
 import android.util.AndroidException;
 import android.util.Slog;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
 
 public class Settings {
 	public static class NameValueTable implements BaseColumns {}
@@ -17,10 +25,71 @@ public class Settings {
 			return Uri.withAppendedPath(CONTENT_URI, name);
 		}
 
+		public static final String ANDROID_ID = "android_id";
+
+		private static String android_id;
+
+		/* Like Android 8+: a 64-bit value, as 16 hex digits, stable for this installation (a
+		 * random seed kept in the ATL data directory) and different for each app signing key
+		 * (or package name, for unsigned packages), so apps cannot correlate users by it. */
+		private static synchronized String getAndroidId() {
+			if (android_id != null)
+				return android_id;
+			byte[] seed = loadSeed(new File(ATLPaths.app_data_dir_base, ".android_id_seed"));
+			String scope = "";
+			try {
+				android.content.pm.PackageParser.Package pkg = ATLLoadedApp.getPrimaryApplication().pkg;
+				if (pkg.mSignatures != null && pkg.mSignatures.length > 0)
+					scope = pkg.mSignatures[0].toCharsString();
+				else
+					scope = pkg.packageName;
+			} catch (Exception e) {
+				Slog.w(TAG, "android_id: no package information: " + e);
+			}
+			try {
+				MessageDigest md = MessageDigest.getInstance("SHA-256");
+				md.update(seed);
+				md.update(scope.getBytes("UTF-8"));
+				byte[] d = md.digest();
+				StringBuilder sb = new StringBuilder();
+				for (int i = 0; i < 8; i++)
+					sb.append(String.format("%02x", d[i] & 0xff));
+				android_id = sb.toString();
+			} catch (Exception e) {
+				android_id = "0000000000000000";
+			}
+			return android_id;
+		}
+
+		private static byte[] loadSeed(File file) {
+			byte[] seed = new byte[32];
+			try (FileInputStream in = new FileInputStream(file)) {
+				int n = 0, r;
+				while (n < seed.length && (r = in.read(seed, n, seed.length - n)) > 0)
+					n += r;
+				if (n == seed.length)
+					return seed;
+			} catch (IOException e) {
+			}
+			new SecureRandom().nextBytes(seed);
+			try {
+				file.getParentFile().mkdirs();
+				File tmp = new File(file.getPath() + ".tmp");
+				try (FileOutputStream out = new FileOutputStream(tmp)) {
+					out.write(seed);
+				}
+				if (!tmp.renameTo(file))
+					Slog.w(TAG, "android_id: cannot store the seed in " + file);
+			} catch (IOException e) {
+				Slog.w(TAG, "android_id: cannot store the seed in " + file + ": " + e);
+			}
+			return seed;
+		}
+
 		public static String getString(ContentResolver content_resolver, String key) {
 			switch (key) {
 				case "android_id":
-					return "_totally_an_androidID"; // TODO: is this a good ID? :P
+					return getAndroidId();
 				case "advertising_id":
 					return "";
 				default:
