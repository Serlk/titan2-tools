diff --git a/src/api-impl/android/os/SystemProperties.java b/src/api-impl/android/os/SystemProperties.java
index 814bdff..73e68eb 100644
--- a/src/api-impl/android/os/SystemProperties.java
+++ b/src/api-impl/android/os/SystemProperties.java
@@ -1,16 +1,24 @@
 package android.os;
 
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStreamReader;
 import java.util.Properties;
 
 public class SystemProperties {
 	private static final Properties properties = new Properties();
 
+	/* Device profile: build.prop-style "name=value" lines describing the device the apps should
+	 * see (ro.product.*, ro.build.*, ro.serialno, ...). The path can be overridden with
+	 * ATL_DEVICE_PROFILE (an empty value disables the profile). Without a profile the built-in
+	 * defaults below are used. */
+	public static final String DEFAULT_DEVICE_PROFILE = "/etc/atl/device.prop";
+
 	static {
-		String SDK_INT_str = System.getProperty("Build.VERSION.SDK_INT");
-		if (SDK_INT_str == null)
-			SDK_INT_str = "" + Build.VERSION_CODES.GINGERBREAD;
-		properties.put("ro.build.version.sdk", SDK_INT_str);
 		properties.put("ro.product.brand", "google");
+		properties.put("ro.product.manufacturer", "HTC"); /* HTC picked at random */
 		properties.put("ro.build.tags", "release-keys");
 		properties.put("ro.build.type", "user");
 		// TODO how to actually get the system's supported abis?
@@ -25,33 +33,105 @@ public class SystemProperties {
 			properties.put("ro.product.cpu.abilist", "arm64-v8a");
 			properties.put("ro.product.cpu.abilist64", "arm64-v8a");
 		}
+		String profile = System.getenv("ATL_DEVICE_PROFILE");
+		if (profile == null)
+			profile = DEFAULT_DEVICE_PROFILE;
+		if (!profile.isEmpty())
+			loadProfile(new File(profile));
+	}
+
+	/* Properties that describe what this runtime can do rather than the device; a profile
+	 * taken from the device's firmware must not change them. */
+	private static boolean isRuntimeProperty(String name) {
+		return name.equals("ro.build.version.sdk") || name.equals("ro.build.version.preview_sdk") || name.startsWith("ro.product.cpu.");
+	}
+
+	private static void loadProfile(File file) {
+		if (!file.isFile())
+			return;
+		int count = 0;
+		try (BufferedReader reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), "UTF-8"))) {
+			String line;
+			while ((line = reader.readLine()) != null) {
+				line = line.trim();
+				if (line.isEmpty() || line.startsWith("#"))
+					continue;
+				int eq = line.indexOf('=');
+				if (eq <= 0)
+					continue;
+				String name = line.substring(0, eq).trim();
+				String value = line.substring(eq + 1).trim();
+				if (isRuntimeProperty(name))
+					continue;
+				properties.put(name, value);
+				count++;
+			}
+		} catch (IOException e) {
+			System.err.println("SystemProperties: cannot read device profile " + file + ": " + e);
+			return;
+		}
+		System.out.println("SystemProperties: " + count + " properties from device profile " + file);
+	}
+
+	private static String lookup(String prop) {
+		/* the API level is the one this runtime emulates for the app (see Build.VERSION) */
+		if ("ro.build.version.sdk".equals(prop))
+			return String.valueOf(Build.VERSION.SDK_INT);
+		return properties.getProperty(prop);
 	}
 
 	public static String get(String prop) {
 		android.util.Log.i("SystemProperties", "Grabbing String prop " + prop);
-		return properties.getProperty(prop);
+		String val = lookup(prop);
+		/* the Android API returns "" for unset properties, never null */
+		return val == null ? "" : val;
 	}
 
 	public static String get(String prop, String def) {
 		android.util.Log.i("SystemProperties", "Grabbing String prop " + prop + ", default " + def);
-		return properties.getProperty(prop, def);
+		String val = lookup(prop);
+		return (val == null || val.isEmpty()) ? def : val;
 	}
 
-	public boolean getBoolean(String prop, boolean def) {
+	public static boolean getBoolean(String prop, boolean def) {
 		android.util.Log.i("SystemProperties", "Grabbing boolean prop " + prop + ", default " + def);
-		String val = properties.getProperty(prop);
-		return val == null ? def : Boolean.parseBoolean(val);
+		String val = lookup(prop);
+		if (val == null || val.isEmpty())
+			return def;
+		if (val.equals("1") || val.equals("y") || val.equals("yes") || val.equals("on") || val.equals("true"))
+			return true;
+		if (val.equals("0") || val.equals("n") || val.equals("no") || val.equals("off") || val.equals("false"))
+			return false;
+		return def;
 	}
 
 	public static int getInt(String prop, int def) {
 		android.util.Log.i("SystemProperties", "Grabbing int prop " + prop + ", default " + def);
-		String val = properties.getProperty(prop);
-		return val == null ? def : Integer.parseInt(val);
+		String val = lookup(prop);
+		try {
+			return val == null ? def : Integer.parseInt(val.trim());
+		} catch (NumberFormatException e) {
+			return def;
+		}
 	}
 
 	public static long getLong(String prop, long def) {
 		android.util.Log.i("SystemProperties", "Grabbing long prop " + prop + ", default " + def);
-		String val = properties.getProperty(prop);
-		return val == null ? def : Long.parseLong(val);
+		String val = lookup(prop);
+		try {
+			return val == null ? def : Long.parseLong(val.trim());
+		} catch (NumberFormatException e) {
+			return def;
+		}
+	}
+
+	/* hidden API, used by some apps through reflection; only changes this process' copy */
+	public static void set(String prop, String val) {
+		if (prop == null || isRuntimeProperty(prop))
+			return;
+		if (val == null)
+			properties.remove(prop);
+		else
+			properties.put(prop, val);
 	}
 }
diff --git a/src/api-impl/android/provider/Settings.java b/src/api-impl/android/provider/Settings.java
