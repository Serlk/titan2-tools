+/* apply a change the application made to its Editable; the widget's own change signals stay quiet */
+JNIEXPORT void JNICALL Java_android_widget_EditText_native_1replace(JNIEnv *env, jobject this, jlong widget_ptr, jint start, jint end, jstring text_jstr)
+{
+	GtkWidget *widget = GTK_WIDGET(_PTR(widget_ptr));
+	struct edit_state *state = edit_state_get(widget);
+	const char *text = (*env)->GetStringUTFChars(env, text_jstr, NULL);
+
+	g_signal_handlers_block_matched(state->source, G_SIGNAL_MATCH_DATA, 0, 0, NULL, NULL, widget);
+	if (GTK_IS_TEXT_VIEW(widget)) {
+		GtkTextBuffer *buffer = GTK_TEXT_BUFFER(state->source);
+		GtkTextIter a, b;
+		gtk_text_buffer_get_iter_at_offset(buffer, &a, start);
+		gtk_text_buffer_get_iter_at_offset(buffer, &b, end);
+		if (end > start)
+			gtk_text_buffer_delete(buffer, &a, &b);
+		if (*text)
+			gtk_text_buffer_insert(buffer, &a, text, -1);
+	} else {
+		int position = start;
+		if (end > start)
+			gtk_editable_delete_text(GTK_EDITABLE(widget), start, end);
+		if (*text)
+			gtk_editable_insert_text(GTK_EDITABLE(widget), text, -1, &position);
+	}
+	g_signal_handlers_unblock_matched(state->source, G_SIGNAL_MATCH_DATA, 0, 0, NULL, NULL, widget);
+	(*env)->ReleaseStringUTFChars(env, text_jstr, text);
+}
+
