+package android.atl;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageInstaller;
+import android.net.Uri;
+import android.util.Slog;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The intents with which an application asks for a package to be installed or removed:
+ * ACTION_VIEW / ACTION_INSTALL_PACKAGE on an APK, ACTION_DELETE / ACTION_UNINSTALL_PACKAGE on a
+ * "package:" URI. They end in the same confirmed catalogue operation as PackageInstaller sessions.
+ */
+public final class ATLInstallIntents {
+	private static final String TAG = "ATLInstallIntents";
+	private static final String APK_MIME = "application/vnd.android.package-archive";
+
+	public static final int RESULT_OK = -1;
+	public static final int RESULT_CANCELED = 0;
+	public static final int RESULT_FIRST_USER = 1;
+
+	private ATLInstallIntents() {}
+
+	public interface Result {
+		void onResult(int resultCode, Intent data);
+	}
+
+	/** returns false if the intent is not an install or uninstall request */
+	public static boolean handle(Context context, Intent intent, final Result result) {
+		String action = intent.getAction();
+		Uri data = intent.getData();
+		if (action == null || data == null)
+			return false;
+		String scheme = data.getScheme();
+		if ((action.equals("android.intent.action.DELETE") || action.equals("android.intent.action.UNINSTALL_PACKAGE")) && "package".equals(scheme)) {
+			PackageInstaller.atl_uninstall_confirmed(data.getSchemeSpecificPart(), adapt(result));
+			return true;
+		}
+		boolean install = action.equals("android.intent.action.INSTALL_PACKAGE");
+		boolean view = action.equals("android.intent.action.VIEW");
+		String path = data.getPath();
+		boolean apk = APK_MIME.equals(intent.getType()) || (path != null && path.endsWith(".apk") && "file".equals(scheme));
+		if (!(install || (view && apk)))
+			return false;
+		final File file;
+		final boolean temporary;
+		try {
+			if ("file".equals(scheme)) {
+				file = new File(path);
+				temporary = false;
+			} else if ("content".equals(scheme)) {
+				file = File.createTempFile("install-", ".apk", context.getCacheDir());
+				temporary = true;
+				byte[] buf = new byte[1 << 16];
+				try (InputStream in = context.getContentResolver().openInputStream(data); FileOutputStream out = new FileOutputStream(file)) {
+					if (in == null)
+						throw new IOException("cannot open " + data);
+					int n;
+					while ((n = in.read(buf)) > 0)
+						out.write(buf, 0, n);
+				}
+			} else {
+				return false;
+			}
+		} catch (IOException | RuntimeException e) {
+			Slog.e(TAG, "cannot read " + data, e);
+			if (result != null)
+				result.onResult(RESULT_FIRST_USER, new Intent().putExtra("android.intent.extra.INSTALL_RESULT", -2 /* INSTALL_FAILED_INVALID_APK */));
+			return true;
+		}
+		List<File> files = new ArrayList<>();
+		files.add(file);
+		final Result inner = result;
+		PackageInstaller.atl_install_confirmed(files, 0, new PackageInstaller.InstallDone() {
+			@Override
+			public void done(int status, String packageName, String message) {
+				if (temporary)
+					file.delete();
+				adapt(inner).done(status, packageName, message);
+			}
