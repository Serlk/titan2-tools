+/* a process without a window ends once nothing is left running in it */
+static gboolean background_idle_check(gpointer user_data)
+{
+	struct jni_callback_data *d = user_data;
+	JNIEnv *env = get_jni_env();
+
+	if (d->main_activity_shown) {
+		/* the window took over; it ends the process when it is closed */
+		g_application_release(G_APPLICATION(d->app));
+		return G_SOURCE_REMOVE;
+	}
+	jboolean busy = J__ATLLoadedAppManager__has_background_work(env);
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionDescribe(env);
+		(*env)->ExceptionClear(env);
+	}
+	if (busy)
+		return G_SOURCE_CONTINUE;
+	g_application_release(G_APPLICATION(d->app));
+	return G_SOURCE_REMOVE;
+}
