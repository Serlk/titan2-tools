+	char real_base[PATH_MAX];
+	char real_apk[PATH_MAX];
+	gboolean ret = FALSE;
+
+	if (!realpath(base, real_base) || !realpath(apk, real_apk))
+		return FALSE;
+	char *prefix = g_strdup_printf("%s/" PACKAGES_DIR "/", real_base);
+	if (g_str_has_prefix(real_apk, prefix)) {
+		char **parts = g_strsplit(real_apk + strlen(prefix), "/", -1);
+		if (g_strv_length(parts) == 4 && !strcmp(parts[1], "versions") && !strcmp(parts[3], "base.apk")) {
+			*package = g_strdup(parts[0]);
+			*version_dir = g_path_get_dirname(real_apk);
+			ret = TRUE;
+		}
+		g_strfreev(parts);
+	}
+	g_free(prefix);
+	return ret;
+}
+
+static int compare_strings(gconstpointer a, gconstpointer b)
+{
+	return strcmp(*(const char *const *)a, *(const char *const *)b);
+}
+
+/* the files of the published version of a package: base.apk first, then its splits; NULL if it is not installed */
+static GPtrArray *installed_package_files(const char *base, const char *package)
+{
+	char *current = g_build_filename(base, PACKAGES_DIR, package, "current", NULL);
+	char *base_apk = g_build_filename(current, "base.apk", NULL);
+	GPtrArray *files = NULL;
+	GDir *dir = NULL;
+
+	if (strchr(package, '/') || access(base_apk, R_OK) || !(dir = g_dir_open(current, 0, NULL)))
+		goto out;
+	files = g_ptr_array_new_with_free_func(g_free);
+	const char *name;
+	while ((name = g_dir_read_name(dir))) {
+		if (g_str_has_prefix(name, "split_") && g_str_has_suffix(name, ".apk"))
+			g_ptr_array_add(files, g_build_filename(current, name, NULL));
+	}
+	g_dir_close(dir);
+	g_ptr_array_sort(files, compare_strings);
+	g_ptr_array_insert(files, 0, g_strdup(base_apk));
+out:
+	g_free(base_apk);
+	g_free(current);
+	return files;
+}
+
+static char *application_object_path(const char *app_id)
+{
+	char *path = g_strdup_printf("/%s", app_id);
+	for (char *c = path; *c; c++) {
+		if (*c == '.')
+			*c = '/';
+		else if (*c == '-')
+			*c = '_';
+	}
+	return path;
+}
+
+/*
+ * One process per installed package: if the package already runs, hand the request (show the
+ * window, or open the URI) to that process. Two processes on one data directory would corrupt it.
+ */
+static gboolean forward_to_running_instance(const char *package, const char *uri, gboolean background)
+{
+	if (!g_application_id_is_valid(package))
+		return FALSE;
+	GDBusConnection *bus = g_bus_get_sync(G_BUS_TYPE_SESSION, NULL, NULL);
+	if (!bus)
+		return FALSE;
+	gboolean has_owner = FALSE;
+	GVariant *reply = g_dbus_connection_call_sync(bus, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+	                                              "NameHasOwner", g_variant_new("(s)", package), G_VARIANT_TYPE("(b)"),
+	                                              G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL);
+	if (reply) {
+		g_variant_get(reply, "(b)", &has_owner);
+		g_variant_unref(reply);
+	}
+	if (!has_owner) {
+		g_object_unref(bus);
+		return FALSE;
+	}
+	if (!background) {
+		char *path = application_object_path(package);
+		GVariantBuilder platform_data;
+		g_variant_builder_init(&platform_data, G_VARIANT_TYPE_VARDICT);
+		GError *error = NULL;
+		if (uri && *uri) {
+			GVariantBuilder uris;
+			g_variant_builder_init(&uris, G_VARIANT_TYPE("as"));
+			g_variant_builder_add(&uris, "s", uri);
+			reply = g_dbus_connection_call_sync(bus, package, path, "org.freedesktop.Application", "Open",
+			                                    g_variant_new("(asa{sv})", &uris, &platform_data), NULL,
+			                                    G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+		} else {
+			reply = g_dbus_connection_call_sync(bus, package, path, "org.freedesktop.Application", "Activate",
+			                                    g_variant_new("(a{sv})", &platform_data), NULL,
+			                                    G_DBUS_CALL_FLAGS_NONE, -1, NULL, &error);
+		}
+		if (reply)
+			g_variant_unref(reply);
+		if (error) {
+			fprintf(stderr, "%s is running, but did not take the request: %s\n", package, error->message);
+			g_error_free(error);
+		}
+		g_free(path);
+	}
+	g_object_unref(bus);
+	return TRUE;
+}
