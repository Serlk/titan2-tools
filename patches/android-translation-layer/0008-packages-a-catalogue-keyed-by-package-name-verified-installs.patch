+static const char *package_from_argv(int argc, char **argv)
+{
+	for (int i = 1; i < argc; i++) {
+		if (!strcmp(argv[i], "--"))
+			break;
+		if ((!strcmp(argv[i], "--package") || !strcmp(argv[i], "-p")) && i + 1 < argc)
+			return argv[i + 1];
+		if (g_str_has_prefix(argv[i], "--package="))
+			return argv[i] + strlen("--package=");
+	}
+	return NULL;
+}
+
+/*
+ * `--pm WORD...` (and the older --install / --install-internal): run a catalogue command in a VM
+ * that loads no application. Returns the exit status, or -1 if the command line is not such a command.
+ */
+static int run_pm_from_argv(int argc, char **argv)
+{
+	GString *args = g_string_new(NULL);
+	GString *files = g_string_new(NULL);
+	gboolean is_pm = FALSE;
+	gboolean install = FALSE;
+	gboolean no_launcher = FALSE;
+
+	for (int i = 1; i < argc; i++) {
+		const char *a = argv[i];
+		if (!strcmp(a, "--pm") && i + 1 < argc) {
+			is_pm = TRUE;
+			g_string_append_printf(args, "%s\n", argv[++i]);
+		} else if (g_str_has_prefix(a, "--pm=")) {
+			is_pm = TRUE;
+			g_string_append_printf(args, "%s\n", a + strlen("--pm="));
+		} else if (!strcmp(a, "--install") || !strcmp(a, "-i")) {
+			install = TRUE;
+		} else if (!strcmp(a, "--install-internal")) {
+			install = no_launcher = TRUE;
+		} else if (a[0] != '-') {
+			char *path = g_canonicalize_filename(a, NULL);
+			g_string_append_printf(files, "%s\n", path);
+			g_free(path);
+		}
+	}
+	if (!is_pm && !install)
+		return -1;
+	if (!is_pm)
+		g_string_append_printf(args, "install\n%s", no_launcher ? "--no-launcher\n" : "");
+
+	char *dex_install_dir = get_dex_install_dir();
+	char *api_impl_jar = find_jar_or_die(API_IMPL_JAR_PATH_LOCAL, REL_API_IMPL_JAR_INSTALL_PATH, dex_install_dir);
+	char *framework_res_apk = find_jar_or_die(FRAMEWORK_RES_PATH_LOCAL, REL_FRAMEWORK_RES_INSTALL_PATH, dex_install_dir);
+	char *api_impl_natives_dir = g_strdup_printf("%s/%s", dex_install_dir, REL_API_IMPL_NATIVES_INSTALL_PATH);
+	char *base = get_app_data_dir_base();
+	app_data_dir = g_strdup_printf("%s/" PACKAGES_DIR "/", base);
+	g_mkdir_with_parents(app_data_dir, 0755);
+
+	/* icons that are not plain bitmaps are drawn through GTK; everything else works without a display */
+	gtk_init_check();
+
+	char *vm_options[] = {"-Datl.pm=1", NULL};
+	JNIEnv *env = create_vm(api_impl_jar, NULL, framework_res_apk, NULL, api_impl_natives_dir, app_data_dir, NULL, vm_options);
+	if (!env)
+		return 1;
+	jobject class_loader = J__Class__getClassLoader(env, _CACHED_CLASS(View));
+	jobject java_runtime = J__Runtime__getRuntime(env);
+	J__Runtime__loadLibrary(env, java_runtime, _JSTRING("translation_layer_main"), class_loader);
+	(*env)->GetJavaVM(env, &jvm);
+
+	int status = J__ATLPackageShell__run(env, _JSTRING(args->str), _JSTRING(files->str));
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionDescribe(env);
+		status = 1;
+	}
+	/*
+	 * Leave without unwinding the runtime: its daemon threads are still starting up at this
+	 * point, and a regular exit races with them. Everything the command wrote is already on disk.
+	 */
+	fflush(NULL);
+	_exit(status);
+}
