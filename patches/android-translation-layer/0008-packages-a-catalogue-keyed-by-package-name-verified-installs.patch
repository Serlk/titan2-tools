+	/** the certificates the package is really signed with, whatever PackageManager reports for it */
+	private static final java.util.Map<String, Signature[]> real_signatures = new java.util.HashMap<>();
+
+	public static Signature[] realSignatures(PackageParser.Package pkg) {
+		synchronized (real_signatures) {
+			Signature[] real = real_signatures.get(pkg.packageName);
+			return real != null ? real : pkg.mSignatures;
+		}
+	}
+
+	public static boolean hasCompatSignature(PackageParser.Package pkg) {
+		synchronized (real_signatures) {
+			return real_signatures.containsKey(pkg.packageName);
+		}
+	}
+
+	/**
+	 * Client libraries accept a Play services provider only if PackageManager reports one fixed
+	 * signature for it. Report that signature for the selected package names, and only when the
+	 * package is really signed by a certificate the system administrator trusts for this role.
+	 * Everything that decides about trust (updates, data access, caller identity) keeps using the
+	 * real signer: realSignatures().
+	 */
+	public static void applyCompatSignature(PackageParser.Package pkg) {
+		if (!java.util.Arrays.asList(compat_packages).contains(pkg.packageName) || pkg.mSignatures == null)
+			return;
+		java.util.Set<String> trusted = trustedSigners();
+		for (Signature s : pkg.mSignatures) {
+			if (!trusted.contains(ATLApkVerifier.sha256Hex(s.toByteArray()))) {
+				android.util.Slog.w("ATLSigHelper", pkg.packageName + " is signed by " + ATLApkVerifier.sha256Hex(s.toByteArray())
+				                                        + ", which is not listed in gms-signers: reported with its own signature");
+				return;
+			}
+		}
+		synchronized (real_signatures) {
+			real_signatures.put(pkg.packageName, pkg.mSignatures);
+		}
+		pkg.mSignatures = gmsSignatures;
+	}
+
+	/** the built-in stand-in for Play services has no signer of its own */
+	static void addGMSSignatures(PackageParser.Package pkg) {
 		pkg.mSignatures = gmsSignatures;
 	}
 }
