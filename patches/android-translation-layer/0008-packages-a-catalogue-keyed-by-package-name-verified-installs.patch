diff --git a/src/api-impl/android/atl/ATLLauncherEntry.java b/src/api-impl/android/atl/ATLLauncherEntry.java
new file mode 100644
index 0000000..679736e
--- /dev/null
+++ b/src/api-impl/android/atl/ATLLauncherEntry.java
@@ -0,0 +1,259 @@
+package android.atl;
+
+import android.content.pm.PackageParser;
+import android.content.res.Resources;
+import android.graphics.drawable.Drawable;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.util.Slog;
+import android.util.TypedValue;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.TreeSet;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * What the desktop sees of an installed package: one launcher entry
+ * ($XDG_DATA_HOME/applications/&lt;package&gt;.desktop) and one D-Bus activation file
+ * ($XDG_DATA_HOME/dbus-1/services/&lt;package&gt;.service), both derived from the published version and
+ * removed with it. The entry shows the label and icon of the first enabled launcher activity (or
+ * activity alias), so switching aliases through PackageManager changes the entry too.
+ */
+public final class ATLLauncherEntry {
+	private static final String TAG = "ATLLauncherEntry";
+
+	private ATLLauncherEntry() {}
+
+	private static native boolean native_render_svg(long paintable, String path, int size);
+
+	private static File userDataDir() {
+		String d = System.getenv("XDG_DATA_HOME");
+		if (d == null || d.isEmpty())
+			d = System.getenv("HOME") + "/.local/share";
+		return new File(d);
+	}
+
+	static File desktopFile(String packageName) {
+		return new File(userDataDir(), "applications/" + packageName + ".desktop");
+	}
+
+	static File serviceFile(String packageName) {
+		return new File(userDataDir(), "dbus-1/services/" + packageName + ".service");
+	}
+
+	/** a package name is not always a valid well-known bus name: at least two elements, none starting with a digit */
+	public static boolean isBusName(String name) {
+		if (name.length() > 255 || !name.contains("."))
+			return false;
+		for (String part : name.split("\\.", -1)) {
+			if (part.isEmpty() || Character.isDigit(part.charAt(0)))
+				return false;
+		}
+		return true;
+	}
+
+	/** the command that starts ATL for an installed package; the wrapper of the distribution if there is one */
+	private static String launchCommand() {
+		String cmd = System.getenv("ATL_LAUNCH_COMMAND");
+		if (cmd != null && !cmd.isEmpty())
+			return cmd;
+		for (String c : new String[] {"/usr/local/bin/atl-run", "/usr/bin/atl-run"}) {
+			if (new File(c).canExecute())
+				return c;
+		}
+		return "android-translation-layer";
+	}
+
+	private static String envPrefix() {
+		// a non-default data directory has to reach the launched process too
+		String d = System.getenv("ANDROID_APP_DATA_DIR");
+		return (d == null || d.isEmpty()) ? "" : "env ANDROID_APP_DATA_DIR=" + quote(d) + " ";
+	}
+
+	private static String quote(String s) {
+		return "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"").replace("$", "\\$").replace("`", "\\`") + "\"";
+	}
+
+	private static String oneLine(String s) {
+		return s.replace('\n', ' ').replace('\r', ' ');
+	}
+
+	private static PackageParser.Activity launcherActivity(PackageParser.Package pkg) {
+		for (PackageParser.Activity a : pkg.activities) {
+			if (!a.info.enabled || a.intents == null)
+				continue;
+			for (PackageParser.IntentInfo i : a.intents) {
+				if (i.hasAction("android.intent.action.MAIN") && i.hasCategory("android.intent.category.LAUNCHER"))
+					return a;
+			}
+		}
+		return null;
+	}
+
+	private static String mimeTypes(PackageParser.Package pkg) {
+		TreeSet<String> out = new TreeSet<>();
+		for (PackageParser.Activity a : pkg.activities) {
+			if (!a.info.enabled || !a.info.exported || a.intents == null)
+				continue;
+			for (PackageParser.IntentInfo i : a.intents) {
+				for (int n = 0; n < i.countDataSchemes(); n++) {
+					String scheme = i.getDataScheme(n);
+					// a .desktop entry cannot claim single hosts, and files/content are handed over as paths
+					if (scheme == null || scheme.equals("http") || scheme.equals("https") || scheme.equals("file") || scheme.equals("content"))
+						continue;
+					if (scheme.matches("[a-z][a-z0-9+.-]*"))
+						out.add("x-scheme-handler/" + scheme);
+				}
+			}
+		}
+		StringBuilder sb = new StringBuilder();
+		for (String m : out)
+			sb.append(m).append(';');
+		return sb.toString();
+	}
+
+	/** Write (or rewrite) the entry for the published version. Failures are logged: the package stays installed. */
+	public static void publish(ATLPackageStore.Record r, ATLPackageStore.Parsed parsed) {
+		try {
+			ATLPackageStore.applyComponentStates(parsed.pkg);
+			PackageParser.Activity launcher = launcherActivity(parsed.pkg);
+			File desktop = desktopFile(r.packageName);
+			File service = serviceFile(r.packageName);
+			String exec = envPrefix() + launchCommand() + " --package " + r.packageName;
+			boolean bus = isBusName(r.packageName);
+
+			if (bus) {
+				service.getParentFile().mkdirs();
+				writeAtomically(service, "[D-BUS Service]\nName=" + r.packageName + "\nExec=" + exec + " --background\n");
+			} else {
+				service.delete();
+			}
+
+			if (launcher == null) {
+				// nothing to show in a menu (a service-only package, or every launcher alias disabled)
+				desktop.delete();
+				return;
+			}
+			String label = r.label;
+			int icon = parsed.pkg.applicationInfo.icon;
+			try {
+				if (launcher.info.labelRes != 0)
+					label = parsed.resources.getText(launcher.info.labelRes).toString();
+				else if (launcher.info.nonLocalizedLabel != null)
+					label = launcher.info.nonLocalizedLabel.toString();
+			} catch (RuntimeException e) {
+				Slog.w(TAG, "label of " + launcher.className + ": " + e);
+			}
+			if (launcher.info.icon != 0)
+				icon = launcher.info.icon;
+			String iconPath = icon != 0 ? exportIcon(r, parsed.resources, icon) : null;
+
+			StringBuilder d = new StringBuilder("[Desktop Entry]\nType=Application\n");
+			d.append("Name=").append(oneLine(label != null ? label : r.packageName)).append('\n');
+			d.append("Comment=Android: ").append(r.packageName).append('\n');
+			d.append("Exec=").append(exec).append(" --uri %u\n");
+			d.append("Icon=").append(iconPath != null ? iconPath : "application-x-executable").append('\n');
+			d.append("Terminal=false\nStartupNotify=true\n");
+			d.append("StartupWMClass=").append(r.packageName).append('\n');
+			d.append("Categories=Android;\nX-Purism-FormFactor=Workstation;Mobile;\n");
+			d.append("X-ATL-Package=").append(r.packageName).append('\n');
+			d.append("X-ATL-VersionCode=").append(r.versionCode).append('\n');
+			String mime = mimeTypes(parsed.pkg);
+			if (!mime.isEmpty())
+				d.append("MimeType=").append(mime).append('\n');
+			desktop.getParentFile().mkdirs();
+			writeAtomically(desktop, d.toString());
+			updateDesktopDatabase(desktop.getParentFile());
+		} catch (IOException | RuntimeException e) {
+			Slog.e(TAG, "launcher entry of " + r.packageName + " not written", e);
+		}
+	}
+
+	/** rewrite the entry of an installed package after its component states changed */
+	public static void refresh(String packageName) {
+		ATLPackageStore.Record r = ATLPackageStore.get(packageName);
+		if (r == null)
+			return;
+		try {
+			publish(r, ATLPackageStore.parse(r.baseApk().getPath(), r.codePath()));
+		} catch (IOException e) {
+			Slog.e(TAG, "launcher entry of " + packageName + " not refreshed", e);
+		}
+	}
+
+	public static void remove(String packageName) {
+		File desktop = desktopFile(packageName);
+		boolean had = desktop.delete();
+		serviceFile(packageName).delete();
+		if (had)
+			updateDesktopDatabase(desktop.getParentFile());
+	}
+
+	private static void updateDesktopDatabase(File dir) {
+		try {
+			// refreshes mimeinfo.cache for the x-scheme-handler lines; fine if the tool is absent
+			Runtime.getRuntime().exec(new String[] {"update-desktop-database", "-q", dir.getPath()}).waitFor();
+		} catch (IOException | InterruptedException e) {
+			// optional
+		}
+	}
+
+	private static void writeAtomically(File f, String text) throws IOException {
+		File tmp = new File(f.getParentFile(), "." + f.getName() + ".new");
+		try (FileOutputStream out = new FileOutputStream(tmp)) {
+			out.write(text.getBytes(StandardCharsets.UTF_8));
+			out.getFD().sync();
+		}
+		try {
+			Os.rename(tmp.getPath(), f.getPath());
+		} catch (ErrnoException e) {
+			tmp.delete();
+			throw new IOException("rename " + tmp + ": " + e.getMessage());
+		}
+	}
+
+	/** the icon as a file next to the package: the bitmap from the APK as it is, anything else drawn into an SVG */
+	private static String exportIcon(ATLPackageStore.Record r, Resources res, int icon) {
+		File dir = new File(ATLPackageStore.packageDir(r.packageName), "icon");
+		ATLPackageStore.deleteTree(dir);
+		if (!dir.mkdirs())
+			return null;
+		// the file name changes with the version so that icon caches notice an update
+		String stem = r.versionCode + "-" + Integer.toHexString(icon);
+		try {
+			TypedValue value = new TypedValue();
+			res.getValue(icon, value, true);
+			String path = value.string != null ? value.string.toString() : null;
+			if (path != null && path.matches(".*\\.(png|webp|jpg|jpeg)")) {
+				File out = new File(dir, stem + path.substring(path.lastIndexOf('.')));
+				for (String apk : r.codePath().split(File.pathSeparator)) {
+					try (ZipFile zip = new ZipFile(apk)) {
+						ZipEntry e = zip.getEntry(path);
+						if (e == null)
+							continue;
+						byte[] buf = new byte[1 << 16];
+						try (InputStream in = zip.getInputStream(e); FileOutputStream os = new FileOutputStream(out)) {
+							int n;
+							while ((n = in.read(buf)) > 0)
+								os.write(buf, 0, n);
+						}
+						return out.getPath();
+					}
+				}
+			}
+			Drawable drawable = res.getDrawable(icon);
+			if (drawable != null && drawable.paintable != 0) {
+				File out = new File(dir, stem + ".svg");
+				if (native_render_svg(drawable.paintable, out.getPath(), 108))
+					return out.getPath();
+			}
+		} catch (IOException | RuntimeException | UnsatisfiedLinkError e) {
+			Slog.w(TAG, "icon of " + r.packageName + ": " + e);
+		}
+		return null;
+	}
+}
