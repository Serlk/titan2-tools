+	public static class Session implements Closeable {
+		private final int id;
+		private final SessionParams params;
+		private final File dir;
+		private float progress;
+		private boolean committed;
+		private boolean finished;
+		private int open_streams;
+
+		Session(int id, SessionParams params, File dir) {
+			this.id = id;
+			this.params = params;
+			this.dir = dir;
+		}
+
+		SessionInfo info() {
+			SessionInfo i = new SessionInfo();
+			i.sessionId = id;
+			i.installerPackageName = ATLLoadedApp.getPrimaryApplication().pkg.packageName;
+			i.appPackageName = params.appPackageName;
+			i.appLabel = params.appLabel;
+			i.progress = progress;
+			i.active = open_streams > 0;
+			i.committed = committed;
+			i.sizeBytes = params.sizeBytes;
+			i.mode = params.mode;
+			return i;
+		}
+
+		private File file(String name) throws IOException {
+			if (name == null || name.isEmpty() || name.contains("/") || name.startsWith("."))
+				throw new IOException("invalid name '" + name + "'");
+			return new File(dir, name.endsWith(".apk") ? name : name + ".apk");
+		}
+
+		public void setStagingProgress(float progress) {
+			this.progress = Math.max(0f, Math.min(1f, progress));
+			notifyCallbacks(id, 2, false, this.progress);
+		}
+
+		public OutputStream openWrite(String name, long offsetBytes, long lengthBytes) throws IOException {
+			synchronized (this) {
+				if (committed || finished)
+					throw new SecurityException("session " + id + " is sealed");
+				open_streams++;
+			}
+			final java.io.RandomAccessFile raf = new java.io.RandomAccessFile(file(name), "rw");
+			if (offsetBytes > 0)
+				raf.seek(offsetBytes);
+			else
+				raf.setLength(0);
+			notifyCallbacks(id, 1, true, 0);
+			return new FileOutputStream(raf.getFD()) {
+				private boolean closed;
+
+				@Override
+				public void close() throws IOException {
+					if (closed)
+						return;
+					closed = true;
+					try {
+						super.close();
+					} finally {
+						raf.close();
+						synchronized (Session.this) {
+							open_streams--;
+						}
+						notifyCallbacks(id, 1, false, 0);
+					}
+				}
+			};
+		}
+
+		public void fsync(OutputStream out) throws IOException {
+			out.flush();
+			if (out instanceof FileOutputStream)
+				((FileOutputStream)out).getFD().sync();
+		}
+
+		public String[] getNames() throws IOException {
+			String[] names = dir.list();
+			return names == null ? new String[0] : names;
+		}
+
+		public InputStream openRead(String name) throws IOException {
+			return new FileInputStream(file(name));
+		}
+
+		public void removeSplit(String splitName) throws IOException {
+			throw new IOException("removing a split of an installed package is not supported");
+		}
+
+		public void commit(final IntentSender statusReceiver) {
+			final List<File> files = new ArrayList<>();
+			synchronized (this) {
+				if (committed || finished)
+					throw new SecurityException("session " + id + " was already committed");
+				if (open_streams > 0)
+					throw new SecurityException("session " + id + " has files that are still being written");
+				committed = true;
+			}
+			File[] staged = dir.listFiles();
+			if (staged != null) {
+				java.util.Arrays.sort(staged);
+				files.addAll(java.util.Arrays.asList(staged));
+			}
+			int flags = params.mode == SessionParams.MODE_INHERIT_EXISTING ? ATLPackageStore.FLAG_INHERIT_EXISTING : 0;
+			atl_install_confirmed(files, flags, new InstallDone() {
+				@Override
+				public void done(int status, String packageName, String message) {
+					if (status == STATUS_SUCCESS && params.appPackageName != null && !params.appPackageName.equals(packageName))
+						Slog.w(TAG, "session " + id + " announced " + params.appPackageName + " and installed " + packageName);
+					finish(status == STATUS_SUCCESS);
+					report(statusReceiver, id, packageName, status, message);
+				}
+			});
+		}
+
+		private void finish(boolean success) {
+			synchronized (this) {
+				if (finished)
+					return;
+				finished = true;
+			}
+			ATLPackageStoreAccess.deleteTree(dir);
+			synchronized (sessions) {
+				sessions.remove(id);
+			}
+			notifyCallbacks(id, 3, success, 0);
+		}
+
+		public void abandon() {
+			finish(false);
+		}
+
+		@Override
+		public void close() {
+			// the staged files stay until commit() or abandon()
+		}
+	}
 
