+	/**
+	 * SHA-256 fingerprints of the signing certificates whose packages may be presented with the
+	 * compatibility signature: one per line in $ATL_GMS_SIGNERS or the first existing of
+	 * /etc/atl/gms-signers, /usr/share/atl/gms-signers ('#' starts a comment, colons and case are
+	 * ignored). No file, no entry: no package gets it.
+	 */
+	private static java.util.Set<String> trustedSigners() {
+		java.util.Set<String> out = new java.util.HashSet<>();
+		String env = System.getenv("ATL_GMS_SIGNERS");
+		java.util.List<String> files = new java.util.ArrayList<>();
+		if (env != null && !env.isEmpty())
+			files.add(env);
+		else
+			files.addAll(java.util.Arrays.asList(trust_files));
+		for (String f : files) {
+			java.io.File file = new java.io.File(f);
+			if (!file.isFile())
+				continue;
+			try (java.io.BufferedReader r = new java.io.BufferedReader(new java.io.FileReader(file))) {
+				String line;
+				while ((line = r.readLine()) != null) {
+					int hash = line.indexOf('#');
+					if (hash >= 0)
+						line = line.substring(0, hash);
+					line = line.replace(":", "").trim().toLowerCase();
+					if (line.matches("[0-9a-f]{64}"))
+						out.add(line);
+				}
+			} catch (java.io.IOException e) {
+				android.util.Slog.w("ATLSigHelper", "unreadable " + f + ": " + e);
+			}
