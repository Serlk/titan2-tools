+	public static Result verify(File apk) throws VerificationException {
+		try (RandomAccessFile f = new RandomAccessFile(apk, "r")) {
+			Zip zip = Zip.locate(f);
+			ByteBuffer block = zip.readSigningBlock(f);
+			if (block != null) {
+				ByteBuffer v3 = findBlock(block, ID_V3);
+				if (v3 != null)
+					return verifyBlock(f, zip, v3, 3);
+				ByteBuffer v2 = findBlock(block, ID_V2);
+				if (v2 != null)
+					return verifyBlock(f, zip, v2, 2);
+				if (findBlock(block, ID_V31) != null)
+					throw new VerificationException("only an APK Signature Scheme v3.1 block is present");
+			}
+		} catch (IOException | BufferUnderflowException | IllegalArgumentException e) {
+			throw new VerificationException("malformed APK: " + e, e);
+		}
+		return verifyJar(apk);
+	}
+
+	/* ---- ZIP layout ---- */
+
+	private static final class Zip {
+		long eocdOffset;
+		ByteBuffer eocd;
+		long cdOffset;
+		long cdSize;
+		/** start of the APK Signing Block, or cdOffset when there is none */
+		long entriesEnd;
+
+		static Zip locate(RandomAccessFile f) throws IOException, VerificationException {
+			long len = f.length();
+			if (len < 22)
+				throw new VerificationException("not a ZIP archive");
+			int tail = (int)Math.min(len, 22 + 0xffff);
+			byte[] buf = new byte[tail];
+			f.seek(len - tail);
+			f.readFully(buf);
+			ByteBuffer b = ByteBuffer.wrap(buf).order(ByteOrder.LITTLE_ENDIAN);
+			for (int i = tail - 22; i >= 0; i--) {
+				if (b.getInt(i) != EOCD_MAGIC)
+					continue;
+				int comment = b.getShort(i + 20) & 0xffff;
+				if (i + 22 + comment != tail)
+					continue;
+				Zip z = new Zip();
+				z.eocdOffset = len - tail + i;
+				z.eocd = ByteBuffer.wrap(Arrays.copyOfRange(buf, i, tail)).order(ByteOrder.LITTLE_ENDIAN);
+				z.cdSize = z.eocd.getInt(12) & 0xffffffffL;
+				z.cdOffset = z.eocd.getInt(16) & 0xffffffffL;
+				if (z.cdOffset + z.cdSize != z.eocdOffset)
+					throw new VerificationException("ZIP central directory is not followed by the end record");
+				if (z.eocdOffset >= 20) {
+					f.seek(z.eocdOffset - 20);
+					if (Integer.reverseBytes(f.readInt()) == ZIP64_LOCATOR_MAGIC)
+						throw new VerificationException("ZIP64 archives are not supported");
+				}
+				z.entriesEnd = z.cdOffset;
+				return z;
+			}
+			throw new VerificationException("ZIP end record not found");
+		}
+
+		/** the id-value area of the APK Signing Block, or null if the file has none */
+		ByteBuffer readSigningBlock(RandomAccessFile f) throws IOException, VerificationException {
+			if (cdOffset < 32)
+				return null;
+			byte[] footer = new byte[24];
+			f.seek(cdOffset - 24);
+			f.readFully(footer);
+			ByteBuffer fb = ByteBuffer.wrap(footer).order(ByteOrder.LITTLE_ENDIAN);
+			if (fb.getLong(8) != SIG_BLOCK_MAGIC_LO || fb.getLong(16) != SIG_BLOCK_MAGIC_HI)
+				return null;
+			long size = fb.getLong(0);
+			if (size < 24 || size > Integer.MAX_VALUE - 8 || size + 8 > cdOffset)
+				throw new VerificationException("APK Signing Block size out of range");
+			long start = cdOffset - (size + 8);
+			byte[] all = new byte[(int)(size + 8)];
+			f.seek(start);
+			f.readFully(all);
+			ByteBuffer ab = ByteBuffer.wrap(all).order(ByteOrder.LITTLE_ENDIAN);
+			if (ab.getLong(0) != size)
+				throw new VerificationException("APK Signing Block sizes differ");
+			entriesEnd = start;
+			ByteBuffer pairs = ab.duplicate().order(ByteOrder.LITTLE_ENDIAN);
+			pairs.position(8);
+			pairs.limit(all.length - 24);
+			return pairs.slice().order(ByteOrder.LITTLE_ENDIAN);
+		}
+	}
+
+	private static ByteBuffer findBlock(ByteBuffer pairs, int id) throws VerificationException {
+		ByteBuffer p = pairs.duplicate().order(ByteOrder.LITTLE_ENDIAN);
+		while (p.remaining() >= 12) {
+			long len = p.getLong();
+			if (len < 4 || len > p.remaining())
+				throw new VerificationException("APK Signing Block entry out of range");
+			int entryId = p.getInt();
+			ByteBuffer value = slice(p, (int)len - 4);
+			if (entryId == id)
+				return value;
+		}
+		return null;
+	}
+
+	private static ByteBuffer slice(ByteBuffer b, int len) {
+		if (len < 0 || len > b.remaining())
+			throw new BufferUnderflowException();
+		ByteBuffer s = b.slice().order(ByteOrder.LITTLE_ENDIAN);
+		s.limit(len);
+		b.position(b.position() + len);
+		return s;
+	}
+
+	private static ByteBuffer prefixed(ByteBuffer b) {
+		return slice(b, b.getInt());
+	}
+
+	private static byte[] bytes(ByteBuffer b) {
+		byte[] out = new byte[b.remaining()];
+		b.duplicate().get(out);
+		return out;
+	}
+
+	/* ---- v2 / v3 ---- */
+
+	private static Result verifyBlock(RandomAccessFile f, Zip zip, ByteBuffer block, int scheme)
+	    throws VerificationException, IOException {
+		ByteBuffer signers = prefixed(block);
+		List<byte[]> leafs = new ArrayList<>();
+		byte[][] past = new byte[0][];
+		int count = 0;
+		while (signers.hasRemaining()) {
+			ByteBuffer signer = prefixed(signers);
+			count++;
+			ByteBuffer signedData = prefixed(signer);
+			if (scheme == 3) {
+				signer.getInt(); // lowest platform version this signer applies to
+				signer.getInt(); // highest
+			}
+			ByteBuffer signatures = prefixed(signer);
+			byte[] publicKey = bytes(prefixed(signer));
+
+			// the strongest signature we can check decides
+			int bestAlgo = -1;
+			byte[] bestSig = null;
+			List<Integer> sigAlgos = new ArrayList<>();
+			while (signatures.hasRemaining()) {
+				ByteBuffer sig = prefixed(signatures);
+				int algo = sig.getInt();
+				sigAlgos.add(algo);
+				byte[] value = bytes(prefixed(sig));
+				if (jcaSignature(algo) == null)
+					continue;
+				if (bestAlgo == -1 || rank(algo) > rank(bestAlgo)) {
+					bestAlgo = algo;
+					bestSig = value;
+				}
+			}
+			if (bestAlgo == -1)
+				throw new VerificationException("signer " + count + ": no supported signature algorithm");
+			if (!checkSignature(bestAlgo, publicKey, bytes(signedData), bestSig))
+				throw new VerificationException("signer " + count + ": signature over the signed data does not verify");
+
+			ByteBuffer digests = prefixed(signedData);
+			ByteBuffer certs = prefixed(signedData);
+			if (scheme == 3) {
+				signedData.getInt();
+				signedData.getInt();
+			}
+			ByteBuffer attrs = signedData.hasRemaining() ? prefixed(signedData) : ByteBuffer.allocate(0);
+
+			byte[] expected = null;
+			List<Integer> digestAlgos = new ArrayList<>();
+			while (digests.hasRemaining()) {
+				ByteBuffer d = prefixed(digests);
+				int algo = d.getInt();
+				digestAlgos.add(algo);
+				byte[] value = bytes(prefixed(d));
+				if (algo == bestAlgo)
+					expected = value;
+			}
+			if (!sigAlgos.equals(digestAlgos))
+				throw new VerificationException("signer " + count + ": signature and digest algorithm lists differ");
+			if (expected == null)
+				throw new VerificationException("signer " + count + ": no digest for the verified algorithm");
+			byte[] actual = contentDigest(f, zip, digestName(bestAlgo));
+			if (!MessageDigest.isEqual(expected, actual))
+				throw new VerificationException("signer " + count + ": file contents do not match the signed digest");
+
+			if (!certs.hasRemaining())
+				throw new VerificationException("signer " + count + ": no certificates");
+			byte[] leaf = bytes(prefixed(certs));
+			X509Certificate leafCert = parseCert(leaf);
+			if (!Arrays.equals(leafCert.getPublicKey().getEncoded(), publicKey))
+				throw new VerificationException("signer " + count + ": public key differs from the certificate");
+			leafs.add(leaf);
+
+			if (scheme == 3) {
+				while (attrs.hasRemaining()) {
+					ByteBuffer attr = prefixed(attrs);
+					if (attr.remaining() >= 4 && attr.getInt() == ATTR_PROOF_OF_ROTATION)
+						past = verifyLineage(attr, leaf);
+				}
+			}
+		}
+		if (count == 0)
+			throw new VerificationException("no signers");
+		if (scheme == 3 && count != 1)
+			throw new VerificationException("APK Signature Scheme v3 allows one signer per platform range; " + count + " found");
+		Result r = new Result();
+		r.scheme = scheme;
+		r.signers = leafs.toArray(new byte[0][]);
+		r.pastSigners = past;
+		return r;
+	}
+
+	/**
+	 * The proof-of-rotation record: a version word, then one level per certificate, oldest first.
+	 * Each level carries its certificate plus the algorithm the previous level signed it with, and
+	 * the signature of that data made with the previous level's key. The last level must be the
+	 * certificate that signed the file.
+	 */
+	private static byte[][] verifyLineage(ByteBuffer por, byte[] currentLeaf) throws VerificationException {
+		List<byte[]> chain = new ArrayList<>();
+		X509Certificate prev = null;
+		int prevNextAlgo = -1;
+		por.getInt(); // version
+		while (por.hasRemaining()) {
+			ByteBuffer level = prefixed(por);
+			ByteBuffer signedData = prefixed(level);
+			level.getInt(); // capability flags of this certificate
+			int nextAlgo = level.getInt();
+			byte[] signature = bytes(prefixed(level));
+			byte[] signedBytes = bytes(signedData);
+			byte[] cert = bytes(prefixed(signedData));
+			int signedWith = signedData.getInt();
+			if (prev != null) {
+				if (signedWith != prevNextAlgo)
+					throw new VerificationException("signer succession: algorithm mismatch between levels");
+				if (!checkSignature(prevNextAlgo, prev.getPublicKey().getEncoded(), signedBytes, signature))
+					throw new VerificationException("signer succession: a level is not signed by its predecessor");
+			}
+			for (byte[] seen : chain) {
+				if (Arrays.equals(seen, cert))
+					throw new VerificationException("signer succession: certificate listed twice");
+			}
+			prev = parseCert(cert);
+			prevNextAlgo = nextAlgo;
+			chain.add(cert);
+		}
+		if (chain.isEmpty() || !Arrays.equals(chain.get(chain.size() - 1), currentLeaf))
+			throw new VerificationException("signer succession does not end in the signing certificate");
+		chain.remove(chain.size() - 1);
+		return chain.toArray(new byte[0][]);
+	}
+
+	private static int rank(int algo) {
+		switch (algo) {
+			case RSA_PSS_SHA512:
+			case RSA_PKCS1_SHA512:
+			case ECDSA_SHA512:
+				return 2;
+			default:
+				return 1;
+		}
+	}
+
+	private static String digestName(int algo) {
+		return rank(algo) == 2 ? "SHA-512" : "SHA-256";
+	}
+
+	private static String jcaSignature(int algo) {
+		switch (algo) {
+			case RSA_PSS_SHA256:
+				return "SHA256withRSA/PSS";
+			case RSA_PSS_SHA512:
+				return "SHA512withRSA/PSS";
+			case RSA_PKCS1_SHA256:
+				return "SHA256withRSA";
+			case RSA_PKCS1_SHA512:
+				return "SHA512withRSA";
+			case ECDSA_SHA256:
+				return "SHA256withECDSA";
+			case ECDSA_SHA512:
+				return "SHA512withECDSA";
+			case DSA_SHA256:
+				return "SHA256withDSA";
+			default:
+				return null;
+		}
+	}
+
+	private static String keyAlgorithm(int algo) {
+		switch (algo) {
+			case ECDSA_SHA256:
+			case ECDSA_SHA512:
+				return "EC";
+			case DSA_SHA256:
+				return "DSA";
+			default:
+				return "RSA";
+		}
+	}
+
+	private static boolean checkSignature(int algo, byte[] publicKey, byte[] data, byte[] signature)
+	    throws VerificationException {
+		String name = jcaSignature(algo);
+		if (name == null)
+			throw new VerificationException("unsupported signature algorithm 0x" + Integer.toHexString(algo));
+		try {
+			PublicKey key = KeyFactory.getInstance(keyAlgorithm(algo)).generatePublic(new X509EncodedKeySpec(publicKey));
+			java.security.Signature s = java.security.Signature.getInstance(name);
+			s.initVerify(key);
+			if (algo == RSA_PSS_SHA256)
+				s.setParameter(new PSSParameterSpec("SHA-256", "MGF1", MGF1ParameterSpec.SHA256, 32, 1));
+			else if (algo == RSA_PSS_SHA512)
+				s.setParameter(new PSSParameterSpec("SHA-512", "MGF1", MGF1ParameterSpec.SHA512, 64, 1));
+			s.update(data);
+			return s.verify(signature);
+		} catch (GeneralSecurityException e) {
+			throw new VerificationException("signature check failed (" + name + "): " + e, e);
+		}
+	}
+
+	private static X509Certificate parseCert(byte[] der) throws VerificationException {
+		try {
+			return (X509Certificate)CertificateFactory.getInstance("X.509").generateCertificate(new ByteArrayInputStream(der));
+		} catch (GeneralSecurityException e) {
+			throw new VerificationException("unreadable signing certificate: " + e, e);
+		}
+	}
+
+	/**
+	 * Digest of the three protected sections (entries, central directory, end record with the
+	 * directory offset pointing at the signing block), each cut into 1 MiB chunks:
+	 * chunk digest = H(0xa5 | len | data), result = H(0x5a | count | chunk digests).
+	 */
+	private static byte[] contentDigest(RandomAccessFile f, Zip zip, String digest)
+	    throws IOException, VerificationException {
+		MessageDigest md;
+		MessageDigest top;
+		try {
+			md = MessageDigest.getInstance(digest);
+			top = MessageDigest.getInstance(digest);
+		} catch (GeneralSecurityException e) {
+			throw new VerificationException("no " + digest, e);
+		}
+		ByteBuffer eocd = ByteBuffer.wrap(bytes(zip.eocd)).order(ByteOrder.LITTLE_ENDIAN);
+		eocd.putInt(16, (int)zip.entriesEnd);
+		long[] start = {0, zip.cdOffset};
+		long[] size = {zip.entriesEnd, zip.cdSize};
+		long chunks = 0;
+		for (long s : size)
+			chunks += (s + CHUNK - 1) / CHUNK;
+		chunks += (eocd.capacity() + CHUNK - 1) / CHUNK;
+		byte[] head = new byte[5];
+		head[0] = 0x5a;
+		putLe32(head, 1, (int)chunks);
+		top.update(head);
+		byte[] buf = new byte[CHUNK];
+		head[0] = (byte)0xa5;
+		for (int i = 0; i < 2; i++) {
+			long off = start[i];
+			long left = size[i];
+			f.seek(off);
+			while (left > 0) {
+				int n = (int)Math.min(left, CHUNK);
+				f.readFully(buf, 0, n);
+				putLe32(head, 1, n);
+				md.update(head);
+				md.update(buf, 0, n);
+				top.update(md.digest());
+				left -= n;
+			}
+		}
+		byte[] e = eocd.array();
+		for (int off = 0; off < e.length; off += CHUNK) {
+			int n = Math.min(e.length - off, CHUNK);
+			putLe32(head, 1, n);
+			md.update(head);
+			md.update(e, off, n);
+			top.update(md.digest());
+		}
+		return top.digest();
+	}
+
+	private static void putLe32(byte[] b, int off, int v) {
+		b[off] = (byte)v;
+		b[off + 1] = (byte)(v >>> 8);
+		b[off + 2] = (byte)(v >>> 16);
+		b[off + 3] = (byte)(v >>> 24);
+	}
+
+	/* ---- JAR signature ---- */
+
+	private static Result verifyJar(File apk) throws VerificationException {
+		byte[] buf = new byte[65536];
+		Certificate[] signers = null;
+		int files = 0;
+		try (JarFile jar = new JarFile(apk, true)) {
+			if (jar.getManifest() == null)
+				throw new VerificationException("no signature: neither an APK Signing Block nor META-INF/MANIFEST.MF");
+			Enumeration<JarEntry> entries = jar.entries();
+			while (entries.hasMoreElements()) {
+				JarEntry je = entries.nextElement();
+				String name = je.getName();
+				if (je.isDirectory())
+					continue;
+				if (name.startsWith("META-INF/")) {
+					if (name.endsWith(".SF") && name.indexOf('/', 9) < 0)
+						checkNotStripped(jar, je);
+					continue;
+				}
+				try (InputStream in = jar.getInputStream(je)) {
+					// reading to the end makes the JAR layer check the entry digest
+					while (in.read(buf) != -1) {
+					}
+				}
+				Certificate[] certs = je.getCertificates();
+				if (certs == null || certs.length == 0)
+					throw new VerificationException("entry " + name + " is not signed");
+				files++;
+				// the signer's own certificate comes first in each chain
+				if (signers == null) {
+					signers = certs;
+				} else if (!sameSigners(signers, certs)) {
+					throw new VerificationException("entry " + name + " is signed by a different certificate set");
+				}
+			}
+			if (signers == null || files == 0)
+				throw new VerificationException("no signed entries");
+			Result r = new Result();
+			r.scheme = 1;
+			r.signers = new byte[signers.length][];
+			for (int i = 0; i < signers.length; i++)
+				r.signers[i] = signers[i].getEncoded();
+			return r;
+		} catch (SecurityException e) {
+			throw new VerificationException("JAR signature does not verify: " + e.getMessage(), e);
+		} catch (IOException | GeneralSecurityException e) {
+			throw new VerificationException("JAR signature could not be read: " + e, e);
+		}
+	}
+
+	private static boolean sameSigners(Certificate[] a, Certificate[] b) {
+		if (a.length != b.length)
+			return false;
+		for (Certificate x : a) {
+			boolean found = false;
+			for (Certificate y : b)
+				found |= x.equals(y);
+			if (!found)
+				return false;
+		}
+		return true;
+	}
+
+	/** a signature file that names scheme 2 or 3 while the file has no such block was tampered with */
+	private static void checkNotStripped(JarFile jar, JarEntry sf) throws IOException, VerificationException {
+		java.util.jar.Manifest m;
+		try (InputStream in = jar.getInputStream(sf)) {
+			m = new java.util.jar.Manifest(in);
+		}
+		String v = m.getMainAttributes().getValue("X-Android-APK-Signed");
+		if (v == null)
+			return;
+		for (String s : v.split(",")) {
+			s = s.trim();
+			if (s.equals("2") || s.equals("3"))
+				throw new VerificationException("the JAR signature announces APK Signature Scheme v" + s + ", but the file carries no such signature");
+		}
+	}
+
+	public static String sha256Hex(byte[] data) {
+		try {
+			byte[] d = MessageDigest.getInstance("SHA-256").digest(data);
+			StringBuilder sb = new StringBuilder();
+			for (byte b : d)
+				sb.append(String.format("%02x", b & 0xff));
+			return sb.toString();
+		} catch (GeneralSecurityException e) {
+			throw new RuntimeException(e);
+		}
+	}
+}
