+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+import java.util.Set;
+
+/**
+ * Permission decisions per package.
+ *
+ * Normal permissions are held by whoever declares them. Signature permissions are held by packages
+ * signed like the one that defines the permission. The permissions below guard something of the
+ * user's (camera, microphone, position, notifications, ...) and need the user's decision, which is
+ * stored with the package (permissions.properties) and can be changed at any time from outside
+ * (`--pm grant|revoke|reset-permission`); a running process sees the change at its next check.
+ */
+public final class ATLPermissions {
+	private static final String TAG = "ATLPermissions";
+
+	public static final int UNSET = 0;
+	public static final int GRANTED = 1;
+	public static final int DENIED = 2;
+	/** refused once: the next request asks again, a second refusal is final until changed from outside */
+	public static final int DENIED_ONCE = 3;
+
+	private ATLPermissions() {}
+
+	private static final Set<String> USER_DECIDED = new HashSet<>(Arrays.asList(
+	    "android.permission.CAMERA",
+	    "android.permission.RECORD_AUDIO",
+	    "android.permission.ACCESS_FINE_LOCATION",
+	    "android.permission.ACCESS_COARSE_LOCATION",
+	    "android.permission.ACCESS_BACKGROUND_LOCATION",
+	    "android.permission.POST_NOTIFICATIONS",
+	    "android.permission.READ_CONTACTS",
+	    "android.permission.WRITE_CONTACTS",
+	    "android.permission.GET_ACCOUNTS",
+	    "android.permission.READ_CALENDAR",
+	    "android.permission.WRITE_CALENDAR",
+	    "android.permission.READ_PHONE_STATE",
+	    "android.permission.READ_PHONE_NUMBERS",
+	    "android.permission.CALL_PHONE",
+	    "android.permission.ANSWER_PHONE_CALLS",
+	    "android.permission.READ_CALL_LOG",
+	    "android.permission.WRITE_CALL_LOG",
+	    "android.permission.SEND_SMS",
+	    "android.permission.RECEIVE_SMS",
+	    "android.permission.READ_SMS",
+	    "android.permission.RECEIVE_MMS",
+	    "android.permission.BODY_SENSORS",
+	    "android.permission.ACTIVITY_RECOGNITION",
+	    "android.permission.BLUETOOTH_CONNECT",
+	    "android.permission.BLUETOOTH_SCAN",
+	    "android.permission.BLUETOOTH_ADVERTISE",
+	    "android.permission.NEARBY_WIFI_DEVICES"));
+
+	/** application data is private to the package already; these two only ever meant the app's own "external" directory here */
+	private static final Set<String> OWN_STORAGE = new HashSet<>(Arrays.asList(
+	    "android.permission.WRITE_EXTERNAL_STORAGE",
+	    "android.permission.READ_EXTERNAL_STORAGE"));
+
+	public static boolean isUserDecided(String permission) {
+		return USER_DECIDED.contains(permission);
+	}
+
+	/** API level from which the app asks for the permission itself; below it the first use asks */
+	public static int runtimeSince(String permission) {
+		switch (permission) {
+			case "android.permission.POST_NOTIFICATIONS":
+			case "android.permission.NEARBY_WIFI_DEVICES":
+				return 33;
+			case "android.permission.BLUETOOTH_CONNECT":
+			case "android.permission.BLUETOOTH_SCAN":
+			case "android.permission.BLUETOOTH_ADVERTISE":
+				return 31;
+			case "android.permission.ACCESS_BACKGROUND_LOCATION":
+			case "android.permission.ACTIVITY_RECOGNITION":
+				return 29;
+			default:
+				return 23;
+		}
+	}
+
+	/* ---- stored decisions ---- */
+
+	/** decisions of packages that run from a loose file and have no place in the catalogue */
+	private static final Map<String, Integer> volatileDecisions = new HashMap<>();
+
+	private static File file(String packageName) {
+		return new File(ATLPackageStore.packageDir(packageName), "permissions.properties");
+	}
+
+	public static int get(String packageName, String permission) {
+		if (ATLPackageStore.get(packageName) == null) {
+			synchronized (volatileDecisions) {
+				Integer v = volatileDecisions.get(packageName + " " + permission);
+				return v == null ? UNSET : v;
+			}
+		}
+		Properties p = ATLPackageStore.loadProperties(file(packageName));
+		if (p == null)
+			return UNSET;
+		try {
+			return Integer.parseInt(p.getProperty(permission, "0"));
+		} catch (NumberFormatException e) {
+			return UNSET;
+		}
+	}
+
+	public static void set(String packageName, String permission, int decision) {
+		if (ATLPackageStore.get(packageName) == null) {
+			synchronized (volatileDecisions) {
+				volatileDecisions.put(packageName + " " + permission, decision);
+			}
+			return;
+		}
+		synchronized (ATLPermissions.class) {
+			File f = file(packageName);
+			Properties p = ATLPackageStore.loadProperties(f);
+			if (p == null)
+				p = new Properties();
+			if (decision == UNSET)
+				p.remove(permission);
+			else
+				p.setProperty(permission, String.valueOf(decision));
+			try {
+				ATLPackageStore.storeProperties(f, p, "user decisions: 1 granted, 2 denied");
+			} catch (IOException e) {
+				Slog.e(TAG, "decision for " + packageName + " not stored", e);
+			}
+		}
+	}
+
+	/* ---- checks ---- */
+
+	private static boolean requests(PackageParser.Package pkg, String permission) {
+		return pkg.requestedPermissions.contains(permission);
+	}
+
+	private static PackageParser.Permission definition(String permission, PackageParser.Package hint) {
+		// a permission belongs to the package that defined it first; a later package declaring the
+		// same name does not take it over
+		PackageParser.Permission found = null;
+		long foundSince = Long.MAX_VALUE;
+		List<PackageParser.Package> candidates = new ArrayList<>();
+		for (String name : ATLPackageStore.list()) {
+			PackageParser.Package p = ATLLoadedAppManager.getPackageFromPackageName(name);
+			if (p != null)
+				candidates.add(p);
+		}
+		if (!candidates.contains(hint))
+			candidates.add(hint);
+		for (PackageParser.Package p : candidates) {
+			ATLPackageStore.Record r = ATLPackageStore.get(p.packageName);
+			long since = r != null ? r.firstInstall : Long.MAX_VALUE - 1;
+			for (PackageParser.Permission perm : p.permissions) {
+				if (permission.equals(perm.info.name) && since < foundSince) {
+					found = perm;
+					foundSince = since;
+				}
+			}
+		}
+		return found;
+	}
+
+	static boolean sameSigners(Signature[] a, Signature[] b) {
+		if (a == null || b == null || a.length == 0 || a.length != b.length)
+			return false;
+		return new HashSet<>(Arrays.asList(a)).equals(new HashSet<>(Arrays.asList(b)));
+	}
+
+	/**
+	 * Does the package hold the permission? With legacyAsGranted, a user-decided permission that
+	 * was not decided yet counts as held when the app runs at an API level that has no request
+	 * call for it: such an app cannot ask, so the first real use asks instead (see request()).
+	 */
+	public static boolean holds(PackageParser.Package pkg, String permission, boolean legacyAsGranted) {
+		if (pkg == null || permission == null)
+			return false;
+		if (permission.endsWith(".DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"))
+			return true;
+		if (!requests(pkg, permission))
+			return false;
+		if (OWN_STORAGE.contains(permission))
+			return true;
+		if (USER_DECIDED.contains(permission)) {
+			int d = get(pkg.packageName, permission);
+			if (d != UNSET)
+				return d == GRANTED;
+			return legacyAsGranted && android.os.Build.VERSION.SDK_INT < runtimeSince(permission);
+		}
+		PackageParser.Permission def = definition(permission, pkg);
+		if (def == null) {
+			// platform permissions without a definition in the framework resources: the ordinary ones are harmless here
+			return permission.startsWith("android.permission.") || permission.startsWith("com.android.")
+			    || permission.startsWith("com.google.android.c2dm.permission.");
+		}
+		int base = def.info.protectionLevel & PermissionInfo.PROTECTION_MASK_BASE;
+		if (base == PermissionInfo.PROTECTION_SIGNATURE || base == PermissionInfo.PROTECTION_SIGNATURE_OR_SYSTEM)
+			return def.owner.packageName.equals(pkg.packageName)
+			    || sameSigners(ATLSigHelper.realSignatures(def.owner), ATLSigHelper.realSignatures(pkg));
+		return true;
+	}
+
+	public static int check(String packageName, String permission) {
+		PackageParser.Package pkg = ATLLoadedAppManager.getPackageFromPackageName(packageName);
+		return holds(pkg, permission, true) ? PackageManager.PERMISSION_GRANTED : PackageManager.PERMISSION_DENIED;
+	}
+
+	/** for the code that hands out the guarded thing: only an explicit grant counts */
+	public static boolean allowed(String packageName, String permission) {
+		PackageParser.Package pkg = ATLLoadedAppManager.getPackageFromPackageName(packageName);
+		return holds(pkg, permission, false);
+	}
+
+	/* ---- asking the user ---- */
+
+	public interface Callback {
+		void onResult(String[] permissions, int[] grantResults);
+	}
+
+	private static String describe(String permission) {
+		switch (permission) {
+			case "android.permission.CAMERA":
+				return "use the camera";
+			case "android.permission.RECORD_AUDIO":
+				return "record audio with the microphone";
+			case "android.permission.ACCESS_FINE_LOCATION":
+				return "read the precise position of this device";
+			case "android.permission.ACCESS_COARSE_LOCATION":
+				return "read the approximate position of this device";
+			case "android.permission.ACCESS_BACKGROUND_LOCATION":
+				return "read the position while it is not on screen";
+			case "android.permission.POST_NOTIFICATIONS":
+				return "show notifications";
+			case "android.permission.READ_CONTACTS":
+			case "android.permission.WRITE_CONTACTS":
+			case "android.permission.GET_ACCOUNTS":
+				return "access contacts and accounts";
+			case "android.permission.READ_PHONE_STATE":
+			case "android.permission.READ_PHONE_NUMBERS":
+				return "read the phone state and SIM identity";
+			case "android.permission.SEND_SMS":
+			case "android.permission.RECEIVE_SMS":
+			case "android.permission.READ_SMS":
+			case "android.permission.RECEIVE_MMS":
+				return "send and read SMS";
+			case "android.permission.CALL_PHONE":
+			case "android.permission.ANSWER_PHONE_CALLS":
+				return "make and answer phone calls";
+			case "android.permission.BLUETOOTH_CONNECT":
+			case "android.permission.BLUETOOTH_SCAN":
+			case "android.permission.BLUETOOTH_ADVERTISE":
+				return "use Bluetooth";
+			default:
+				return permission.substring(permission.lastIndexOf('.') + 1).toLowerCase().replace('_', ' ');
+		}
+	}
+
+	/**
+	 * Decide the given permissions for a package, asking the user about each one that is user-decided,
+	 * requested in the manifest and not decided yet. The callback always runs on the main thread, after
+	 * this call has returned, with one result per permission. While no activity of the process is in
+	 * front of the user, nothing is asked: undecided permissions are reported as denied and stay undecided.
+	 */
+	public static void request(Activity activity, String packageName, String[] permissions, Callback callback) {
+		final PackageParser.Package pkg = ATLLoadedAppManager.getPackageFromPackageName(packageName);
+		final int[] results = new int[permissions.length];
+		final List<Integer> ask = new ArrayList<>();
+		for (int i = 0; i < permissions.length; i++) {
+			String p = permissions[i];
+			int known = p == null ? UNSET : get(packageName, p);
+			if (pkg != null && p != null && USER_DECIDED.contains(p) && requests(pkg, p) && (known == UNSET || known == DENIED_ONCE))
+				ask.add(i);
+			else
+				results[i] = holds(pkg, p, false) ? PackageManager.PERMISSION_GRANTED : PackageManager.PERMISSION_DENIED;
+		}
+		final Handler main = new Handler(Looper.getMainLooper());
+		main.post(new Runnable() {
+			@Override
+			public void run() {
+				askNext(activity, packageName, permissions, results, ask, callback);
+			}
+		});
+	}
+
+	private static void askNext(Activity activity, String packageName, String[] permissions, int[] results,
+	                            List<Integer> ask, Callback callback) {
+		if (ask.isEmpty()) {
+			if (callback != null)
+				callback.onResult(permissions, results);
+			return;
+		}
+		final int index = ask.remove(0);
+		final String permission = permissions[index];
+		// an earlier answer in the same request may have covered this one (fine + coarse position)
+		final int known = get(packageName, permission);
+		if (known == GRANTED || known == DENIED || !Activity.atl_in_foreground()) {
+			results[index] = known == GRANTED ? PackageManager.PERMISSION_GRANTED : PackageManager.PERMISSION_DENIED;
+			askNext(activity, packageName, permissions, results, ask, callback);
+			return;
+		}
+		ATLPackageStore.Record r = ATLPackageStore.get(packageName);
+		String who = r != null && r.label != null ? r.label : packageName;
+		final boolean[] answered = {false};
+		DialogInterface.OnClickListener listener = new DialogInterface.OnClickListener() {
+			@Override
+			public void onClick(DialogInterface dialog, int which) {
+				if (answered[0])
+					return;
+				answered[0] = true;
+				boolean granted = which == DialogInterface.BUTTON_POSITIVE;
+				set(packageName, permission, granted ? GRANTED : known == DENIED_ONCE ? DENIED : DENIED_ONCE);
+				if (permission.equals("android.permission.ACCESS_FINE_LOCATION") && granted)
+					set(packageName, "android.permission.ACCESS_COARSE_LOCATION", GRANTED);
+				results[index] = granted ? PackageManager.PERMISSION_GRANTED : PackageManager.PERMISSION_DENIED;
+				askNext(activity, packageName, permissions, results, ask, callback);
+			}
+		};
+		try {
+			android.content.Context context = activity != null ? activity : ATLLoadedApp.getPrimaryApplication().getApplication();
+			AlertDialog dialog = new AlertDialog.Builder(context)
+			                         .setTitle(who)
+			                         .setMessage("Allow " + who + " (" + packageName + ") to " + describe(permission) + "?")
+			                         .setPositiveButton("Allow", listener)
+			                         .setNegativeButton("Deny", listener)
+			                         .create();
+			dialog.setOnDismissListener(new DialogInterface.OnDismissListener() {
+				@Override
+				public void onDismiss(DialogInterface d) {
+					// closed without an answer: denied for this request, asked again next time
+					if (answered[0])
+						return;
+					answered[0] = true;
+					results[index] = PackageManager.PERMISSION_DENIED;
+					askNext(activity, packageName, permissions, results, ask, callback);
+				}
+			});
+			dialog.show();
+		} catch (RuntimeException e) {
+			Slog.e(TAG, "cannot ask for " + permission, e);
+			results[index] = PackageManager.PERMISSION_DENIED;
+			askNext(activity, packageName, permissions, results, ask, callback);
+		}
+	}
+
+	/* ---- command line ---- */
+
+	static int shellList(ATLPackageStore.Record r) throws ATLPackageStore.InstallException {
+		ATLPackageStore.Parsed p;
+		try {
+			p = ATLPackageStore.parse(r.baseApk().getPath(), r.codePath());
+		} catch (IOException e) {
+			throw new ATLPackageStore.InstallException(ATLPackageStore.STATUS_FAILURE, "PARSE_FAILED", e.getMessage());
+		}
+		for (String perm : p.pkg.requestedPermissions) {
+			String state;
+			if (USER_DECIDED.contains(perm)) {
+				int d = get(r.packageName, perm);
+				state = d == GRANTED ? "granted" : d == DENIED ? "denied" : d == DENIED_ONCE ? "denied once (will be asked again)" : "not decided";
+			} else {
+				state = "install-time";
+			}
+			System.out.println(perm + "\t" + state);
+		}
+		return 0;
+	}
+}
