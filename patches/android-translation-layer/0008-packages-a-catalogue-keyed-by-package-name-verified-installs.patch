+/* the package's own intents travel with its key, see actions.c */
+static const char *own_actionname_from_type(int type)
+{
+	switch (type) {
+		case 0:
+			return "app.ownActivity";
+		case 1:
+			return "app.ownService";
+		case 2:
+			return "app.ownBroadcast";
+		default:
+			return NULL;
+	}
+}
+
+static GVariant *own_action_target(JNIEnv *env, jobject intent)
+{
+	jstring key_jstr = J__NotificationManager__atl_action_key(env);
+	const char *key = (*env)->GetStringUTFChars(env, key_jstr, NULL);
+	GVariant *target = g_variant_new("(sv)", key, intent_serialize(env, intent));
+	(*env)->ReleaseStringUTFChars(env, key_jstr, key);
+	return target;
+}
