+import java.util.TreeSet;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import org.xmlpull.v1.XmlPullParser;
+
+/**
+ * The installed-package catalogue of one user.
+ *
+ * <pre>
+ * &lt;ATL data dir&gt;/_packages_/
+ *   .lock                       taken for every change of the catalogue
+ *   .uids                       package (or shared user) -&gt; application id, never reused
+ *   &lt;package name&gt;/
+ *     current -&gt; versions/&lt;id&gt;  the published version; replaced with one rename()
+ *     versions/&lt;id&gt;/base.apk, split_&lt;name&gt;.apk, lib/, signer-N.der, package.properties
+ *     components.properties     component enabled states set through PackageManager
+ *     permissions.properties    runtime permission decisions
+ *     data/                     the application's private data
+ * </pre>
+ *
+ * A package is identified by the package name of its verified manifest, never by the name of the
+ * file it came from. Nothing of the package runs while it is being installed: the files are only
+ * read (signature, manifest, resources for the label and icon).
+ */
+public final class ATLPackageStore {
+	private static final String TAG = "ATLPackageStore";
+
+	public static final int FLAG_ALLOW_DOWNGRADE = 1;
+	/** the given files are added to the installed version of the same version code (splits only) */
+	public static final int FLAG_INHERIT_EXISTING = 2;
+	public static final int FLAG_NO_LAUNCHER = 4;
+
+	/* results, in the numbering of android.content.pm.PackageInstaller.STATUS_* */
+	public static final int STATUS_SUCCESS = 0;
+	public static final int STATUS_FAILURE = 1;
+	public static final int STATUS_FAILURE_ABORTED = 3;
+	public static final int STATUS_FAILURE_INVALID = 4;
+	public static final int STATUS_FAILURE_CONFLICT = 5;
+	public static final int STATUS_FAILURE_STORAGE = 6;
+	public static final int STATUS_FAILURE_INCOMPATIBLE = 7;
+
+	public static final class InstallException extends Exception {
+		public final int status;
+		public final String code;
+
+		public InstallException(int status, String code, String message) {
+			super(code + ": " + message);
+			this.status = status;
+			this.code = code;
+		}
+	}
+
+	/** What one APK file says about itself, after its signature was verified. */
+	public static final class ApkInfo {
+		public File file;
+		public String packageName;
+		public long versionCode;
+		public String versionName;
+		public String split; // null for the base APK
+		public String configForSplit;
+		public boolean isSplitRequired;
+		public String[] requiredSplitTypes = new String[0];
+		public String[] splitTypes = new String[0];
+		public ATLApkVerifier.Result signature;
+		public TreeSet<String> abis = new TreeSet<>();
+		public long nativeSize; // uncompressed size of the libraries for this machine
+	}
+
+	/** One published version. */
+	public static final class Record {
+		public String packageName;
+		public long versionCode;
+		public String versionName;
+		public int minSdk;
+		public int targetSdk;
+		public String[] signers = new String[0];     // SHA-256 of the signing certificates
+		public String[] pastSigners = new String[0]; // earlier certificates the signer proved succession from
+		public int scheme;
+		public String[] splits = new String[0];
+		public String[] abis = new String[0];
+		public String nativeAbi; // ABI whose libraries are in lib/, null if the package has no native code
+		public String installer;
+		public String label;
+		public String sharedUserId;
+		public long firstInstall;
+		public long lastUpdate;
+		public int appId;
+		public File versionDir;
+
+		public File baseApk() {
+			return new File(versionDir, "base.apk");
+		}
+
+		public File splitApk(String name) {
+			return new File(versionDir, splitFileName(name));
+		}
+
+		public File libDir() {
+			return new File(versionDir, "lib");
+		}
+
+		/** base APK first, then the splits: class path and resource path of this version */
+		public String codePath() {
+			StringBuilder sb = new StringBuilder(baseApk().getPath());
+			for (String s : splits)
+				sb.append(File.pathSeparatorChar).append(splitApk(s).getPath());
+			return sb.toString();
+		}
+
+		public Signature[] signatures() {
+			List<Signature> out = new ArrayList<>();
+			for (int i = 0;; i++) {
+				File f = new File(versionDir, "signer-" + i + ".der");
+				if (!f.isFile())
+					break;
+				try {
+					out.add(new Signature(readAll(f)));
+				} catch (IOException e) {
+					Slog.e(TAG, "unreadable " + f, e);
+				}
+			}
+			return out.toArray(new Signature[0]);
+		}
+	}
+
+	private ATLPackageStore() {}
+
+	/* ---- layout ---- */
+
+	public static File root() {
+		return new File(ATLPaths.app_data_dir_base, "_packages_");
+	}
+
+	public static File packageDir(String packageName) {
+		return new File(root(), packageName);
+	}
+
+	public static File dataDir(String packageName) {
+		return new File(packageDir(packageName), "data");
+	}
+
+	static String splitFileName(String split) {
+		return "split_" + split.replaceAll("[^A-Za-z0-9._-]", "_") + ".apk";
+	}
+
+	public static boolean isValidPackageName(String name) {
+		if (name == null || name.isEmpty() || name.length() > 223 || name.startsWith(".") || name.endsWith("."))
+			return false;
+		if (name.equals("android") || name.equals("atl") || !name.contains("."))
+			return false;
+		for (int i = 0; i < name.length(); i++) {
+			char c = name.charAt(i);
+			if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.'))
+				return false;
+		}
+		return !name.contains("..");
+	}
+
+	public static String nativeAbi() {
+		String arch = System.getProperty("os.arch", "");
+		switch (arch) {
+			case "aarch64":
+			case "arm64":
+				return "arm64-v8a";
+			case "arm":
+			case "armv7l":
+				return "armeabi-v7a";
+			case "x86_64":
+			case "amd64":
+				return "x86_64";
+			default:
+				return "x86";
+		}
+	}
+
+	/* ---- reading ---- */
+
+	private static final Map<String, Record> cache = new HashMap<>();
+
+	/** the published version of a package, or null if it is not installed */
+	public static synchronized Record get(String packageName) {
+		if (!isValidPackageName(packageName))
+			return null;
+		File current = new File(packageDir(packageName), "current");
+		String target;
+		try {
+			target = Os.readlink(current.getPath());
+		} catch (ErrnoException e) {
+			cache.remove(packageName);
+			return null;
+		}
+		File versionDir = new File(packageDir(packageName), target);
+		Record r = cache.get(packageName);
+		if (r != null && r.versionDir.equals(versionDir))
+			return r;
+		r = readRecord(versionDir);
+		if (r == null || !packageName.equals(r.packageName)) {
+			cache.remove(packageName);
+			return null;
+		}
+		cache.put(packageName, r);
+		return r;
+	}
+
+	/** the record a running process was started from: an APK path inside the catalogue */
+	public static Record forApkPath(String apkPath) {
+		if (apkPath == null)
+			return null;
+		File f;
+		try {
+			// a start through the "current" link names the same file as the version directory does
+			f = new File(apkPath).getCanonicalFile();
+		} catch (IOException e) {
+			return null;
+		}
+		File versionDir = f.getParentFile();
+		if (versionDir == null || !"base.apk".equals(f.getName()))
+			return null;
+		File versions = versionDir.getParentFile();
+		if (versions == null || !"versions".equals(versions.getName()))
+			return null;
+		File pkgDir = versions.getParentFile();
+		File root;
+		try {
+			root = root().getCanonicalFile();
+		} catch (IOException e) {
+			return null;
+		}
+		if (pkgDir == null || !root.equals(pkgDir.getParentFile()))
+			return null;
+		Record r = readRecord(versionDir);
+		return (r != null && pkgDir.getName().equals(r.packageName)) ? r : null;
+	}
+
+	public static List<String> list() {
+		List<String> out = new ArrayList<>();
+		String[] names = root().list();
+		if (names != null) {
+			Arrays.sort(names);
+			for (String n : names) {
+				if (get(n) != null)
+					out.add(n);
+			}
+		}
+		return out;
+	}
+
+	private static String[] csv(String s) {
+		return (s == null || s.isEmpty()) ? new String[0] : s.split(",");
+	}
+
+	private static String join(Iterable<String> parts) {
+		StringBuilder sb = new StringBuilder();
+		for (String p : parts) {
+			if (sb.length() > 0)
+				sb.append(',');
+			sb.append(p);
+		}
+		return sb.toString();
+	}
+
+	private static Record readRecord(File versionDir) {
+		Properties p = loadProperties(new File(versionDir, "package.properties"));
+		if (p == null || p.getProperty("package") == null)
+			return null;
+		try {
+			Record r = new Record();
+			r.versionDir = versionDir;
+			r.packageName = p.getProperty("package");
+			r.versionCode = Long.parseLong(p.getProperty("versionCode", "0"));
+			r.versionName = p.getProperty("versionName");
+			r.minSdk = Integer.parseInt(p.getProperty("minSdk", "1"));
+			r.targetSdk = Integer.parseInt(p.getProperty("targetSdk", "1"));
+			r.signers = csv(p.getProperty("signers"));
+			r.pastSigners = csv(p.getProperty("pastSigners"));
+			r.scheme = Integer.parseInt(p.getProperty("scheme", "0"));
+			r.splits = csv(p.getProperty("splits"));
+			r.abis = csv(p.getProperty("abis"));
+			r.nativeAbi = p.getProperty("nativeAbi");
+			r.installer = p.getProperty("installer");
+			r.label = p.getProperty("label");
+			r.sharedUserId = p.getProperty("sharedUserId");
+			r.firstInstall = Long.parseLong(p.getProperty("firstInstall", "0"));
+			r.lastUpdate = Long.parseLong(p.getProperty("lastUpdate", "0"));
+			r.appId = Integer.parseInt(p.getProperty("appId", "0"));
+			return r;
+		} catch (NumberFormatException e) {
+			Slog.e(TAG, "damaged " + versionDir + "/package.properties", e);
+			return null;
+		}
+	}
+
+	static Properties loadProperties(File f) {
+		if (!f.isFile())
+			return null;
+		Properties p = new Properties();
+		try (FileInputStream in = new FileInputStream(f)) {
+			p.load(in);
+		} catch (IOException e) {
+			Slog.e(TAG, "unreadable " + f, e);
+			return null;
+		}
+		return p;
+	}
+
+	/** write a small file so that a reader sees the old or the new contents, never a part */
+	static void storeProperties(File f, Properties p, String comment) throws IOException {
+		File tmp = new File(f.getParentFile(), "." + f.getName() + ".new");
+		try (FileOutputStream out = new FileOutputStream(tmp)) {
+			p.store(out, comment);
+			out.getFD().sync();
+		}
+		try {
+			Os.rename(tmp.getPath(), f.getPath());
+		} catch (ErrnoException e) {
+			tmp.delete();
+			throw new IOException("rename " + tmp + ": " + e.getMessage());
+		}
+	}
+
+	static byte[] readAll(File f) throws IOException {
+		byte[] buf = new byte[(int)f.length()];
+		try (FileInputStream in = new FileInputStream(f)) {
+			int off = 0;
+			while (off < buf.length) {
+				int n = in.read(buf, off, buf.length - off);
+				if (n < 0)
+					throw new IOException("short read: " + f);
+				off += n;
+			}
+		}
+		return buf;
+	}
+
+	/* ---- locking ---- */
+
+	private interface Locked<T> {
+		T run() throws InstallException, IOException;
+	}
+
+	private static <T> T locked(Locked<T> body) throws InstallException {
+		File root = root();
+		root.mkdirs();
+		try (FileChannel ch = FileChannel.open(new File(root, ".lock").toPath(), StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+		     FileLock lock = ch.lock()) {
+			return body.run();
+		} catch (IOException e) {
+			throw new InstallException(STATUS_FAILURE, "INSTALL_FAILED_INTERNAL_ERROR", String.valueOf(e));
+		}
+	}
+
+	/* ---- application ids ---- */
+
+	private static final int FIRST_APP_ID = 10000;
+
+	/** called with the catalogue lock held */
+	private static int allocateAppId(String packageName, String sharedUserId) throws IOException {
+		File f = new File(root(), ".uids");
+		Properties p = loadProperties(f);
+		if (p == null)
+			p = new Properties();
+		String key = sharedUserId != null ? "shared:" + sharedUserId : packageName;
+		String v = p.getProperty(key);
+		if (v != null)
+			return Integer.parseInt(v);
+		int next = Integer.parseInt(p.getProperty(".next", String.valueOf(FIRST_APP_ID)));
+		p.setProperty(key, String.valueOf(next));
+		p.setProperty(".next", String.valueOf(next + 1));
+		storeProperties(f, p, "application ids; entries are never reused");
+		return next;
+	}
+
+	/** package names (and shared users) by application id */
+	public static List<String> packagesForAppId(int appId) {
+		List<String> out = new ArrayList<>();
+		for (String name : list()) {
+			Record r = get(name);
+			if (r != null && r.appId == appId)
+				out.add(name);
+		}
+		return out;
+	}
+
+	/* ---- inspecting an APK file ---- */
+
+	private static final int ATTR_VERSION_CODE = 0x0101021b;
+	private static final int ATTR_VERSION_NAME = 0x0101021c;
+	private static final int ATTR_VERSION_CODE_MAJOR = 0x01010576;
+	private static final int ATTR_IS_SPLIT_REQUIRED = 0x01010591;
+	private static final int ATTR_REQUIRED_SPLIT_TYPES = 0x0101064e;
+	private static final int ATTR_SPLIT_TYPES = 0x0101064f;
+
+	/** verify the signature and read the head of the manifest; no code of the file is run */
+	public static ApkInfo inspect(File apk) throws InstallException {
+		ApkInfo info = new ApkInfo();
+		info.file = apk;
+		if (!apk.isFile() || !apk.canRead())
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_URI", "cannot read " + apk);
+		try {
+			info.signature = ATLApkVerifier.verify(apk);
+		} catch (ATLApkVerifier.VerificationException e) {
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_NO_CERTIFICATES", apk.getName() + ": " + e.getMessage());
+		}
+		String abiPrefix = "lib/" + nativeAbi() + "/";
+		try (ZipFile zip = new ZipFile(apk)) {
+			Enumeration<? extends ZipEntry> entries = zip.entries();
+			while (entries.hasMoreElements()) {
+				ZipEntry e = entries.nextElement();
+				String name = e.getName();
+				if (e.isDirectory() || !name.startsWith("lib/"))
+					continue;
+				int slash = name.indexOf('/', 4);
+				if (slash < 0 || name.indexOf('/', slash + 1) >= 0)
+					continue;
+				info.abis.add(name.substring(4, slash));
+				if (name.startsWith(abiPrefix))
+					info.nativeSize += Math.max(0, e.getSize());
+			}
+		} catch (IOException e) {
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK", apk.getName() + ": " + e);
+		}
+		long major = 0;
+		long minor = 0;
+		AssetManager am = new AssetManager(apk.getPath());
+		try (XmlResourceParser xml = am.openXmlResourceParser(1, "AndroidManifest.xml")) {
+			int type;
+			while ((type = xml.next()) != XmlPullParser.START_TAG && type != XmlPullParser.END_DOCUMENT) {
+			}
+			if (type != XmlPullParser.START_TAG || !"manifest".equals(xml.getName()))
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_BAD_MANIFEST", apk.getName() + ": no <manifest>");
+			for (int i = 0; i < xml.getAttributeCount(); i++) {
+				String name = xml.getAttributeName(i);
+				int res = xml.getAttributeNameResource(i);
+				if ("package".equals(name) && res == 0)
+					info.packageName = xml.getAttributeValue(i);
+				else if ("split".equals(name) && res == 0)
+					info.split = xml.getAttributeValue(i);
+				else if ("configForSplit".equals(name) && res == 0)
+					info.configForSplit = xml.getAttributeValue(i);
+				else if (res == ATTR_VERSION_CODE)
+					minor = xml.getAttributeIntValue(i, 0) & 0xffffffffL;
+				else if (res == ATTR_VERSION_CODE_MAJOR)
+					major = xml.getAttributeIntValue(i, 0) & 0xffffffffL;
+				else if (res == ATTR_VERSION_NAME)
+					info.versionName = xml.getAttributeValue(i);
+				else if (res == ATTR_IS_SPLIT_REQUIRED)
+					info.isSplitRequired = xml.getAttributeBooleanValue(i, false);
+				else if (res == ATTR_REQUIRED_SPLIT_TYPES)
+					info.requiredSplitTypes = csv(xml.getAttributeValue(i));
+				else if (res == ATTR_SPLIT_TYPES)
+					info.splitTypes = csv(xml.getAttributeValue(i));
+			}
+		} catch (InstallException e) {
+			throw e;
+		} catch (Exception e) {
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_BAD_MANIFEST", apk.getName() + ": " + e);
+		}
+		info.versionCode = (major << 32) | minor;
+		if (info.split != null && info.split.isEmpty())
+			info.split = null;
+		if (!isValidPackageName(info.packageName))
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_BAD_PACKAGE_NAME", apk.getName() + ": package name '" + info.packageName + "'");
+		return info;
+	}
+
+	/** resources and parsed manifest of an APK set, without a class loader */
+	public static final class Parsed {
+		public PackageParser.Package pkg;
+		public Resources resources;
+	}
+
+	public static Parsed parse(String baseApk, String codePath) throws IOException {
+		AssetManager am = new AssetManager(codePath + File.pathSeparator + System.getProperty("java.class.path"));
+		Resources res = new Resources(am, new DisplayMetrics(), android.content.Context.sys_config);
+		PackageParser parser = new PackageParser(baseApk);
+		String[] err = new String[1];
+		Parsed out = new Parsed();
+		try {
+			out.pkg = parser.parsePackage(res, am.openXmlResourceParser(1, "AndroidManifest.xml"), 0, err);
+		} catch (Exception e) {
+			throw new IOException(err[0] != null ? err[0] : String.valueOf(e), e);
+		}
+		if (out.pkg == null)
+			throw new IOException(err[0] != null ? err[0] : "manifest could not be parsed");
+		out.resources = res;
+		return out;
+	}
+
+	/* ---- install ---- */
+
+	private static void fault(String point) throws IOException {
+		// test hook: ATL_INSTALL_FAULT=copy|publish breaks the installation at that step
+		if (point.equals(System.getenv("ATL_INSTALL_FAULT")))
+			throw new IOException("injected fault at '" + point + "'");
+	}
+
+	private static Set<String> digests(byte[][] certs) {
+		Set<String> out = new TreeSet<>();
+		for (byte[] c : certs)
+			out.add(ATLApkVerifier.sha256Hex(c));
+		return out;
+	}
+
+	public static Record install(List<File> files, String installer, int flags) throws InstallException {
+		if (files.isEmpty())
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK", "no files");
+		List<ApkInfo> apks = new ArrayList<>();
+		for (File f : files)
+			apks.add(inspect(f));
+		return locked(new Locked<Record>() {
+			@Override
+			public Record run() throws InstallException, IOException {
+				return installLocked(apks, installer, flags);
+			}
+		});
+	}
+
+	private static Record installLocked(List<ApkInfo> apks, String installer, int flags) throws InstallException, IOException {
+		/* one package, one version, one signer set, one base, distinct splits */
+		ApkInfo first = apks.get(0);
+		ApkInfo base = null;
+		Map<String, ApkInfo> splits = new java.util.TreeMap<>();
+		Set<String> signerSet = digests(first.signature.signers);
+		for (ApkInfo a : apks) {
+			if (!a.packageName.equals(first.packageName))
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK",
+				                           a.file.getName() + " belongs to " + a.packageName + ", " + first.file.getName() + " to " + first.packageName);
+			if (a.versionCode != first.versionCode)
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK",
+				                           a.file.getName() + " has version code " + a.versionCode + ", " + first.file.getName() + " has " + first.versionCode);
+			if (!digests(a.signature.signers).equals(signerSet))
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_INCONSISTENT_CERTIFICATES",
+				                           a.file.getName() + " is signed by a different certificate than " + first.file.getName());
+			if (a.split == null) {
+				if (base != null)
+					throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK",
+					                           "two base APKs: " + base.file.getName() + " and " + a.file.getName());
+				base = a;
+			} else if (splits.put(a.split, a) != null) {
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK", "split '" + a.split + "' given twice");
+			}
+		}
+		String packageName = first.packageName;
+		Record old = get(packageName);
+
+		/* files taken over from the installed version */
+		File inheritedBase = null;
+		Map<String, File> inheritedSplits = new java.util.TreeMap<>();
+		if ((flags & FLAG_INHERIT_EXISTING) != 0) {
+			if (old == null)
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK", packageName + " is not installed, nothing to add splits to");
+			if (base == null) {
+				if (old.versionCode != first.versionCode)
+					throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK",
+					                           "the splits have version code " + first.versionCode + ", the installed base " + old.versionCode);
+				inheritedBase = old.baseApk();
+				base = inspect(inheritedBase);
+			}
+			if (old.versionCode == first.versionCode) {
+				for (String s : old.splits) {
+					if (!splits.containsKey(s))
+						inheritedSplits.put(s, old.splitApk(s));
+				}
+			}
+		}
+		if (base == null)
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_FAILED_INVALID_APK",
+			                           "no base APK among the given files (all of them are splits of " + packageName + ")");
+
+		/* the set must be complete */
+		List<ApkInfo> all = new ArrayList<>();
+		all.add(base);
+		all.addAll(splits.values());
+		for (File f : inheritedSplits.values())
+			all.add(inspect(f));
+		for (ApkInfo a : all) {
+			if (!digests(a.signature.signers).equals(signerSet))
+				throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_INCONSISTENT_CERTIFICATES",
+				                           "the installed files of " + packageName + " are signed by a different certificate than " + first.file.getName());
+		}
+		Set<String> splitNames = new TreeSet<>(splits.keySet());
+		splitNames.addAll(inheritedSplits.keySet());
+		if (base.isSplitRequired && splitNames.isEmpty())
+			throw new InstallException(STATUS_FAILURE_INCOMPATIBLE, "INSTALL_FAILED_MISSING_SPLIT",
+			                           packageName + " declares that it cannot run from the base APK alone; its split APKs are missing");
+		Set<String> providedTypes = new HashSet<>();
+		for (ApkInfo a : all)
+			providedTypes.addAll(Arrays.asList(a.splitTypes));
+		for (ApkInfo a : all) {
+			for (String t : a.requiredSplitTypes) {
+				if (!providedTypes.contains(t))
+					throw new InstallException(STATUS_FAILURE_INCOMPATIBLE, "INSTALL_FAILED_MISSING_SPLIT",
+					                           a.file.getName() + " requires a split of type '" + t + "', none of the given files provides it");
+			}
+			if (a.configForSplit != null && !a.configForSplit.isEmpty() && !splitNames.contains(a.configForSplit))
+				throw new InstallException(STATUS_FAILURE_INCOMPATIBLE, "INSTALL_FAILED_MISSING_SPLIT",
+				                           a.file.getName() + " configures split '" + a.configForSplit + "', which is missing");
+		}
+
+		/* machine code */
+		String abi = nativeAbi();
+		TreeSet<String> abis = new TreeSet<>();
+		long nativeSize = 0;
+		for (ApkInfo a : all) {
+			abis.addAll(a.abis);
+			nativeSize += a.nativeSize;
+		}
+		if (!abis.isEmpty() && !abis.contains(abi)) {
+			boolean only32 = abi.equals("arm64-v8a") && (abis.contains("armeabi-v7a") || abis.contains("armeabi"));
+			throw new InstallException(STATUS_FAILURE_INCOMPATIBLE, "INSTALL_FAILED_NO_MATCHING_ABIS",
+			                           packageName + " carries native libraries only for " + abis + "; this system runs " + abi
+			                               + (only32 ? " (64-bit) and cannot load 32-bit ARM libraries" : ""));
+		}
+
+		/* manifest of the whole set */
+		StringBuilder codePath = new StringBuilder(base.file.getPath());
+		for (ApkInfo a : all) {
+			if (a != base)
+				codePath.append(File.pathSeparatorChar).append(a.file.getPath());
+		}
+		Parsed parsed;
+		try {
+			parsed = parse(base.file.getPath(), codePath.toString());
+		} catch (IOException e) {
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_BAD_MANIFEST", base.file.getName() + ": " + e.getMessage());
+		}
+		if (!packageName.equals(parsed.pkg.packageName))
+			throw new InstallException(STATUS_FAILURE_INVALID, "INSTALL_PARSE_FAILED_BAD_MANIFEST", "package name changed while parsing");
+
+		/* update rules */
+		Set<String> past = digests(base.signature.pastSigners);
+		if (old != null) {
+			Set<String> oldSigners = new TreeSet<>(Arrays.asList(old.signers));
+			boolean same = oldSigners.equals(signerSet);
+			boolean successor = oldSigners.size() == 1 && past.containsAll(oldSigners);
+			if (!same && !successor)
+				throw new InstallException(STATUS_FAILURE_CONFLICT, "INSTALL_FAILED_UPDATE_INCOMPATIBLE",
+				                           packageName + " is installed with signer " + oldSigners + "; the new files are signed by " + signerSet
+				                               + " and prove no succession from it. The installed version and its data are kept");
+			if (first.versionCode < old.versionCode && (flags & FLAG_ALLOW_DOWNGRADE) == 0)
+				throw new InstallException(STATUS_FAILURE_CONFLICT, "INSTALL_FAILED_VERSION_DOWNGRADE",
+				                           packageName + " " + old.versionCode + " is installed, refusing to replace it with " + first.versionCode);
+		}
+
+		/* room for the copy */
+		File pkgDir = packageDir(packageName);
+		File versions = new File(pkgDir, "versions");
+		if (!versions.isDirectory() && !versions.mkdirs())
+			throw new InstallException(STATUS_FAILURE_STORAGE, "INSTALL_FAILED_INSUFFICIENT_STORAGE", "cannot create " + versions);
+		sweepStaging(versions);
+		long need = nativeSize + (8 << 20);
+		for (ApkInfo a : all)
+			need += a.file.length();
+		long free = versions.getUsableSpace();
+		if (free < need)
+			throw new InstallException(STATUS_FAILURE_STORAGE, "INSTALL_FAILED_INSUFFICIENT_STORAGE",
+			                           "need " + (need >> 20) + " MiB in " + versions + ", " + (free >> 20) + " MiB free");
+
+		/* stage */
+		long now = System.currentTimeMillis();
+		String id = first.versionCode + "-" + Long.toHexString(now);
+		File stage = new File(versions, ".staging-" + id);
+		File dest = new File(versions, id);
+		Record r = new Record();
+		try {
+			if (!stage.mkdir())
+				throw new IOException("cannot create " + stage);
+			copy(base.file, new File(stage, "base.apk"));
+			fault("copy");
+			for (ApkInfo a : all) {
+				if (a != base)
+					copy(a.file, new File(stage, splitFileName(a.split)));
+			}
+			File lib = new File(stage, "lib");
+			if (abis.contains(abi)) {
+				if (!lib.mkdir())
+					throw new IOException("cannot create " + lib);
+				for (ApkInfo a : all)
+					extractLibs(a.file, "lib/" + abi + "/", lib);
+			}
+			for (int i = 0; i < base.signature.signers.length; i++)
+				write(new File(stage, "signer-" + i + ".der"), base.signature.signers[i]);
+
+			r.packageName = packageName;
+			r.versionCode = first.versionCode;
+			r.versionName = base.versionName;
+			r.minSdk = parsed.pkg.applicationInfo.minSdkVersion;
+			r.targetSdk = parsed.pkg.applicationInfo.targetSdkVersion;
+			r.signers = signerSet.toArray(new String[0]);
+			r.pastSigners = past.toArray(new String[0]);
+			r.scheme = base.signature.scheme;
+			r.splits = splitNames.toArray(new String[0]);
+			r.abis = abis.toArray(new String[0]);
+			r.nativeAbi = abis.contains(abi) ? abi : null;
+			r.installer = installer != null ? installer : (old != null ? old.installer : null);
+			r.sharedUserId = parsed.pkg.mSharedUserId;
+			r.firstInstall = old != null ? old.firstInstall : now;
+			r.lastUpdate = now;
+			r.appId = old != null ? old.appId : allocateAppId(packageName, r.sharedUserId);
+			r.label = label(parsed);
+			Properties p = new Properties();
+			p.setProperty("package", r.packageName);
+			p.setProperty("versionCode", String.valueOf(r.versionCode));
+			if (r.versionName != null)
+				p.setProperty("versionName", r.versionName);
+			p.setProperty("minSdk", String.valueOf(r.minSdk));
+			p.setProperty("targetSdk", String.valueOf(r.targetSdk));
+			p.setProperty("signers", join(signerSet));
+			p.setProperty("pastSigners", join(past));
+			p.setProperty("scheme", String.valueOf(r.scheme));
+			p.setProperty("splits", join(splitNames));
+			p.setProperty("abis", join(abis));
+			if (r.nativeAbi != null)
+				p.setProperty("nativeAbi", r.nativeAbi);
+			if (r.installer != null)
+				p.setProperty("installer", r.installer);
+			if (r.sharedUserId != null)
+				p.setProperty("sharedUserId", r.sharedUserId);
+			if (r.label != null)
+				p.setProperty("label", r.label);
+			p.setProperty("firstInstall", String.valueOf(r.firstInstall));
+			p.setProperty("lastUpdate", String.valueOf(r.lastUpdate));
+			p.setProperty("appId", String.valueOf(r.appId));
+			p.setProperty("sha256.base", fileSha256(new File(stage, "base.apk")));
+			storeProperties(new File(stage, "package.properties"), p, "written by the installer; do not edit");
+			syncDir(stage);
+
+			/* publish: the version directory appears whole, then 'current' is switched with one rename */
+			fault("publish");
+			Os.rename(stage.getPath(), dest.getPath());
+			File link = new File(pkgDir, ".current.new");
+			link.delete();
+			Os.symlink("versions/" + id, link.getPath());
+			Os.rename(link.getPath(), new File(pkgDir, "current").getPath());
+			syncDir(pkgDir);
+		} catch (IOException | ErrnoException e) {
+			deleteTree(stage);
+			deleteTree(dest);
+			boolean full = versions.getUsableSpace() < (1 << 20);
+			throw new InstallException(full ? STATUS_FAILURE_STORAGE : STATUS_FAILURE, full ? "INSTALL_FAILED_INSUFFICIENT_STORAGE" : "INSTALL_FAILED_INTERNAL_ERROR",
+			                           "writing " + packageName + " failed (" + e.getMessage() + ")"
+			                               + (old != null ? "; version " + old.versionCode + " and its data are unchanged" : "; nothing was installed"));
+		}
+		r.versionDir = dest;
+		synchronized (ATLPackageStore.class) {
+			cache.remove(packageName);
+		}
+		dataDir(packageName).mkdirs();
+		sweepVersions(versions, id);
+		if ((flags & FLAG_NO_LAUNCHER) == 0)
+			ATLLauncherEntry.publish(r, parsed);
+		return r;
+	}
+
+	private static String label(Parsed parsed) {
+		try {
+			if (parsed.pkg.applicationInfo.labelRes != 0)
+				return parsed.resources.getText(parsed.pkg.applicationInfo.labelRes).toString();
+		} catch (RuntimeException e) {
+			Slog.w(TAG, "label of " + parsed.pkg.packageName + ": " + e);
+		}
+		CharSequence l = parsed.pkg.applicationInfo.nonLocalizedLabel;
+		return l != null ? l.toString() : parsed.pkg.packageName;
+	}
+
+	private static void copy(File from, File to) throws IOException {
+		byte[] buf = new byte[1 << 16];
+		try (FileInputStream in = new FileInputStream(from); FileOutputStream out = new FileOutputStream(to)) {
+			int n;
+			while ((n = in.read(buf)) > 0)
+				out.write(buf, 0, n);
+			out.getFD().sync();
+		}
+		if (to.length() != from.length())
+			throw new IOException("short copy of " + from.getName());
+	}
+
+	private static void write(File to, byte[] data) throws IOException {
+		try (FileOutputStream out = new FileOutputStream(to)) {
+			out.write(data);
+			out.getFD().sync();
+		}
+	}
+
+	private static void extractLibs(File apk, String prefix, File lib) throws IOException {
+		byte[] buf = new byte[1 << 16];
+		try (ZipFile zip = new ZipFile(apk)) {
+			Enumeration<? extends ZipEntry> entries = zip.entries();
+			while (entries.hasMoreElements()) {
+				ZipEntry e = entries.nextElement();
+				String name = e.getName();
+				if (e.isDirectory() || !name.startsWith(prefix))
+					continue;
+				String leaf = name.substring(prefix.length());
+				if (leaf.isEmpty() || leaf.contains("/") || leaf.equals("..") || leaf.equals("."))
+					continue;
+				File out = new File(lib, leaf);
+				try (InputStream in = zip.getInputStream(e); FileOutputStream os = new FileOutputStream(out)) {
+					int n;
+					while ((n = in.read(buf)) > 0)
+						os.write(buf, 0, n);
+					os.getFD().sync();
+				}
+				out.setExecutable(true, false);
+			}
+		}
+	}
+
+	static String fileSha256(File f) throws IOException {
+		try (FileInputStream in = new FileInputStream(f)) {
+			MessageDigest md = MessageDigest.getInstance("SHA-256");
+			byte[] buf = new byte[1 << 16];
+			int n;
+			while ((n = in.read(buf)) > 0)
+				md.update(buf, 0, n);
+			StringBuilder sb = new StringBuilder();
+			for (byte b : md.digest())
+				sb.append(String.format("%02x", b & 0xff));
+			return sb.toString();
+		} catch (java.security.GeneralSecurityException e) {
+			throw new IOException(e);
+		}
+	}
+
+	private static void syncDir(File dir) {
+		try (FileChannel ch = FileChannel.open(dir.toPath(), StandardOpenOption.READ)) {
+			ch.force(true);
+		} catch (IOException | RuntimeException e) {
+			// not every file system lets a directory be synced through this interface
+		}
+	}
+
+	static void deleteTree(File f) {
+		try {
+			// never follow a link out of the tree
+			if (!android.system.OsConstants.S_ISLNK(Os.lstat(f.getPath()).st_mode)) {
+				File[] children = f.listFiles();
+				if (children != null) {
+					for (File c : children)
+						deleteTree(c);
+				}
+			}
+		} catch (ErrnoException e) {
+			return;
+		}
+		f.delete();
+	}
+
+	/** staging directories are only left behind by an installer that died; the lock is held, so none is in use */
+	private static void sweepStaging(File versions) {
+		File[] entries = versions.listFiles();
+		if (entries == null)
+			return;
+		for (File e : entries) {
+			if (e.getName().startsWith(".staging-"))
+				deleteTree(e);
+		}
+	}
+
+	/** Remove superseded versions that no running process holds (a process keeps a lock on the .lock file of its version). */
+	private static void sweepVersions(File versions, String keep) {
+		File[] entries = versions.listFiles();
+		if (entries == null)
+			return;
+		// locks do not exclude within one process: a package that updates itself must not lose the files it runs from
+		ATLPackageStore.Record self = forApkPath(System.getProperty("atl.app.class.path", "").split(File.pathSeparator)[0]);
+		for (File e : entries) {
+			if (e.getName().equals(keep) || e.getName().startsWith(".") || (self != null && e.equals(self.versionDir)))
+				continue;
+			File lockFile = new File(e, ".lock");
+			try (FileChannel ch = FileChannel.open(lockFile.toPath(), StandardOpenOption.CREATE, StandardOpenOption.WRITE)) {
+				FileLock l = ch.tryLock();
+				if (l == null)
+					continue; // in use: the next installation removes it
+				deleteTree(e);
+				l.release();
+			} catch (IOException | RuntimeException ex) {
+				Slog.w(TAG, "keeping " + e + ": " + ex);
+			}
+		}
+	}
+
+	/* ---- uninstall ---- */
+
+	public static void uninstall(String packageName, boolean keepData) throws InstallException {
+		locked(new Locked<Void>() {
+			@Override
+			public Void run() throws InstallException {
+				Record r = get(packageName);
+				File pkgDir = packageDir(packageName);
+				if (r == null && !(isValidPackageName(packageName) && pkgDir.isDirectory()))
+					throw new InstallException(STATUS_FAILURE, "DELETE_FAILED_INTERNAL_ERROR", packageName + " is not installed");
+				ATLLauncherEntry.remove(packageName);
+				new File(pkgDir, "current").delete();
+				synchronized (ATLPackageStore.class) {
+					cache.remove(packageName);
+				}
+				deleteTree(new File(pkgDir, "versions"));
+				new File(pkgDir, "components.properties").delete();
+				new File(pkgDir, "permissions.properties").delete();
+				deleteTree(new File(pkgDir, "icon"));
+				if (!keepData) {
+					deleteTree(new File(pkgDir, "data"));
+					deleteTree(new File("/tmp/atl_cache/" + packageName));
+				}
+				pkgDir.delete(); // stays if the data was kept
+				return null;
+			}
+		});
+	}
+
+	/* ---- data written by the older layout ---- */
+
+	/**
+	 * Earlier builds kept an application's data in "&lt;ATL data dir&gt;/&lt;APK file name&gt;_/", so
+	 * the owner of such a directory is only known through the file it was started from. A directory
+	 * counts as owned by a package when the APK of that name kept in _installed_apks_ has this
+	 * package name and a signer of the installed version.
+	 */
+	public static List<File> legacyDataCandidates(Record r) {
+		List<File> out = new ArrayList<>();
+		File base = ATLPaths.app_data_dir_base;
+		File[] entries = base.listFiles();
+		if (entries == null)
+			return out;
+		Set<String> signers = new HashSet<>(Arrays.asList(r.signers));
+		signers.addAll(Arrays.asList(r.pastSigners));
+		for (File dir : entries) {
+			String n = dir.getName();
+			if (!dir.isDirectory() || !n.endsWith("_") || n.startsWith("_"))
+				continue;
+			File apk = new File(ATLPaths.installed_apks_dir, n.substring(0, n.length() - 1));
+			if (!apk.isFile())
+				continue;
+			try {
+				ApkInfo info = inspect(apk);
+				if (!r.packageName.equals(info.packageName))
+					continue;
+				Set<String> their = digests(info.signature.signers);
+				their.retainAll(signers);
+				if (!their.isEmpty())
+					out.add(dir);
+			} catch (InstallException e) {
+				// not a verifiable APK: ownership cannot be confirmed
+			}
+		}
+		return out;
+	}
+
+	/**
+	 * Move data of the older layout into the package's data directory. With an explicit directory
+	 * the caller vouches for the ownership; otherwise exactly one confirmed candidate is required.
+	 * Returns a description of what was done; data is never merged or overwritten.
+	 */
+	public static String migrateData(String packageName, File explicit) throws InstallException {
+		return locked(new Locked<String>() {
+			@Override
+			public String run() throws InstallException {
+				Record r = get(packageName);
+				if (r == null)
+					throw new InstallException(STATUS_FAILURE, "MIGRATE_FAILED", packageName + " is not installed");
+				File data = dataDir(packageName);
+				String[] existing = data.list();
+				File source = explicit;
+				if (source == null) {
+					List<File> c = legacyDataCandidates(r);
+					if (c.isEmpty())
+						return "no data of the older layout belongs to " + packageName;
+					if (c.size() > 1)
+						return "ambiguous: " + c + " all belong to " + packageName + "; nothing was moved. Choose one: --pm migrate-data --pm " + packageName + " --pm DIR";
+					source = c.get(0);
+				}
+				if (!source.isDirectory())
+					throw new InstallException(STATUS_FAILURE, "MIGRATE_FAILED", source + " is not a directory");
+				if (existing != null && existing.length > 0)
+					return packageName + " already has data in " + data + "; " + source + " was left untouched";
+				data.delete();
+				try {
+					Os.rename(source.getPath(), data.getPath());
+				} catch (ErrnoException e) {
+					data.mkdirs();
+					throw new InstallException(STATUS_FAILURE, "MIGRATE_FAILED", "rename " + source + " -> " + data + ": " + e.getMessage());
+				}
+				// libraries unpacked by the older layout belong to whatever file was last run
+				deleteTree(new File(data, "lib"));
+				return "moved " + source + " to " + data;
+			}
+		});
+	}
+
+	/* ---- component states ---- */
+
+	public static final String APPLICATION_KEY = "*";
+
+	/** 0 default, 1 enabled, 2 disabled (android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_*) */
+	public static int getComponentState(String packageName, String className) {
+		Properties p = loadProperties(new File(packageDir(packageName), "components.properties"));
+		if (p == null)
+			return 0;
+		try {
+			return Integer.parseInt(p.getProperty(className, "0"));
+		} catch (NumberFormatException e) {
+			return 0;
+		}
+	}
+
+	public static Map<String, Integer> getComponentStates(String packageName) {
+		Map<String, Integer> out = new HashMap<>();
+		Properties p = loadProperties(new File(packageDir(packageName), "components.properties"));
+		if (p != null) {
+			for (String k : p.stringPropertyNames()) {
+				try {
+					out.put(k, Integer.parseInt(p.getProperty(k)));
+				} catch (NumberFormatException e) {
+					// ignore a damaged line
+				}
+			}
+		}
+		return out;
+	}
+
+	public static void setComponentState(String packageName, String className, int state) throws InstallException {
+		locked(new Locked<Void>() {
+			@Override
+			public Void run() throws IOException, InstallException {
+				if (get(packageName) == null)
+					throw new InstallException(STATUS_FAILURE, "NAME_NOT_FOUND", packageName + " is not installed");
+				File f = new File(packageDir(packageName), "components.properties");
+				Properties p = loadProperties(f);
+				if (p == null)
+					p = new Properties();
+				if (state == 0)
+					p.remove(className);
+				else
+					p.setProperty(className, String.valueOf(state));
+				storeProperties(f, p, "component enabled states: 1 enabled, 2 disabled");
+				return null;
+			}
+		});
+	}
+
+	/**
+	 * Apply the stored states to a freshly parsed package: afterwards info.enabled of every
+	 * component is what resolution has to obey. The manifest's own value is remembered so that a
+	 * later return to "default" can restore it.
+	 */
+	public static void applyComponentStates(PackageParser.Package pkg) {
+		applyComponentStates(pkg, null);
+	}
+
+	/** `session` holds states by flattened component name for packages without a catalogue entry */
+	public static void applyComponentStates(PackageParser.Package pkg, Map<String, Integer> session) {
+		Map<String, Integer> states = getComponentStates(pkg.packageName);
+		if (session != null && get(pkg.packageName) == null) {
+			String prefix = pkg.packageName + "/";
+			for (Map.Entry<String, Integer> e : session.entrySet()) {
+				if (e.getKey().startsWith(prefix))
+					states.put(e.getKey().substring(prefix.length()), e.getValue());
+			}
+		}
+		List<PackageParser.Component<?>> all = new ArrayList<>();
+		all.addAll(pkg.activities);
+		all.addAll(pkg.receivers);
+		all.addAll(pkg.services);
+		all.addAll(pkg.providers);
+		synchronized (manifestEnabled) {
+			for (PackageParser.Component<?> c : all) {
+				android.content.pm.ComponentInfo info = componentInfo(c);
+				if (info == null)
+					continue;
+				String key = pkg.packageName + "/" + c.className;
+				Boolean declared = manifestEnabled.get(key);
+				if (declared == null) {
+					declared = info.enabled;
+					manifestEnabled.put(key, declared);
+				}
+				Integer s = states.get(c.className);
+				info.enabled = s == null || s == 0 ? declared : s == 1;
+			}
+		}
+	}
+
+	private static final Map<String, Boolean> manifestEnabled = new HashMap<>();
+
+	public static android.content.pm.ComponentInfo componentInfo(PackageParser.Component<?> c) {
+		if (c instanceof PackageParser.Activity)
+			return ((PackageParser.Activity)c).info;
+		if (c instanceof PackageParser.Service)
+			return ((PackageParser.Service)c).info;
+		if (c instanceof PackageParser.Provider)
+			return ((PackageParser.Provider)c).info;
+		return null;
+	}
+
+	/* ---- what a running process knows about its own package ---- */
+
+	/** fill in what only the catalogue knows; called for every package loaded from it */
+	public static void describe(PackageParser.Package pkg, Record r) {
+		pkg.mSignatures = r.signatures();
+		pkg.applicationInfo.uid = r.appId;
+		pkg.applicationInfo.sourceDir = r.baseApk().getPath();
+		pkg.applicationInfo.publicSourceDir = pkg.applicationInfo.sourceDir;
+		pkg.applicationInfo.dataDir = dataDir(r.packageName).getPath();
+		pkg.applicationInfo.nativeLibraryDir = r.libDir().getPath();
+		applyComponentStates(pkg);
+	}
+
+	public static List<String> describeLines(Record r) {
+		List<String> out = new ArrayList<>();
+		out.add("package:      " + r.packageName);
+		out.add("label:        " + r.label);
+		out.add("version:      " + r.versionCode + (r.versionName != null ? " (" + r.versionName + ")" : ""));
+		out.add("minSdk:       " + r.minSdk);
+		out.add("targetSdk:    " + r.targetSdk);
+		out.add("signature:    scheme v" + r.scheme);
+		for (String s : r.signers)
+			out.add("signer:       " + s);
+		for (String s : r.pastSigners)
+			out.add("past signer:  " + s);
+		out.add("splits:       " + (r.splits.length == 0 ? "none" : join(Arrays.asList(r.splits))));
+		out.add("ABIs:         " + (r.abis.length == 0 ? "none (no native code)" : join(Arrays.asList(r.abis))));
+		out.add("native ABI:   " + (r.nativeAbi != null ? r.nativeAbi : "-"));
+		out.add("app id:       " + r.appId);
+		out.add("installer:    " + (r.installer != null ? r.installer : "-"));
+		out.add("code:         " + r.versionDir);
+		out.add("data:         " + dataDir(r.packageName));
+		return out;
+	}
+
+	public static List<String> sortedList() {
+		List<String> l = list();
+		Collections.sort(l);
+		return l;
+	}
+}
