@@ -0,0 +1,252 @@
+package android.atl;
+
+import android.atl.annotation.Export;
+import android.content.pm.PackageParser;
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * The command line of the package catalogue: `android-translation-layer --pm WORD [--pm WORD...] [FILE...]`.
+ * It runs in a VM without an application, so nothing of the packages it handles is executed.
+ */
+public final class ATLPackageShell {
+	private ATLPackageShell() {}
+
+	private static final String HELP =
+	    "package catalogue commands (one word per --pm):\n"
+	    + "  install [--no-launcher] [--allow-downgrade] [--inherit] [--installer NAME] FILE...\n"
+	    + "        install or update one package from a base APK and its split APKs.\n"
+	    + "        --inherit adds the given splits to the installed version\n"
+	    + "  uninstall PACKAGE [--keep-data]\n"
+	    + "  list                              installed packages\n"
+	    + "  info PACKAGE | info FILE...       what is installed / what a file would install\n"
+	    + "  path PACKAGE                      files of the installed version\n"
+	    + "  components PACKAGE                components and their enabled state\n"
+	    + "  enable|disable|default PACKAGE COMPONENT_CLASS\n"
+	    + "  permissions PACKAGE               requested permissions and the decisions taken\n"
+	    + "  grant|revoke|reset-permission PACKAGE PERMISSION\n"
+	    + "  migrate-data PACKAGE [DIR]        take over data written by the older file-name based layout\n";
+
+	@Export
+	static int run(String argLines, String fileLines) {
+		int status;
+		try {
+			status = dispatch(argLines, fileLines);
+		} catch (Throwable t) {
+			t.printStackTrace();
+			status = 1;
+		}
+		System.out.flush();
+		System.err.flush();
+		return status;
+	}
+
+	private static int dispatch(String argLines, String fileLines) {
+		List<String> args = lines(argLines);
+		List<File> files = new ArrayList<>();
+		for (String f : lines(fileLines))
+			files.add(new File(f));
+		if (args.isEmpty() || args.get(0).equals("help")) {
+			System.out.print(HELP);
+			return args.isEmpty() ? 2 : 0;
+		}
+		String cmd = args.remove(0);
+		List<String> words = new ArrayList<>();
+		List<String> options = new ArrayList<>();
+		String installer = null;
+		for (int i = 0; i < args.size(); i++) {
+			String a = args.get(i);
+			if (a.equals("--installer") && i + 1 < args.size())
+				installer = args.get(++i);
+			else if (a.startsWith("--"))
+				options.add(a);
+			else
+				words.add(a);
+		}
+		try {
+			switch (cmd) {
+				case "install":
+					return install(files, options, installer);
+				case "uninstall":
+					need(words, 1, "uninstall PACKAGE");
+					ATLPackageStore.uninstall(words.get(0), options.contains("--keep-data"));
+					System.out.println("Success: " + words.get(0) + " removed" + (options.contains("--keep-data") ? ", data kept" : ""));
+					return 0;
+				case "list":
+					for (String name : ATLPackageStore.sortedList()) {
+						ATLPackageStore.Record r = ATLPackageStore.get(name);
+						System.out.println(name + "\t" + r.versionCode + "\t" + (r.versionName != null ? r.versionName : "-") + "\t" + r.label);
+					}
+					return 0;
+				case "info":
+					return info(words, files);
+				case "path": {
+					need(words, 1, "path PACKAGE");
+					ATLPackageStore.Record r = installed(words.get(0));
+					for (String p : r.codePath().split(File.pathSeparator))
+						System.out.println(p);
+					return 0;
+				}
+				case "components":
+					need(words, 1, "components PACKAGE");
+					return components(installed(words.get(0)));
+				case "enable":
+				case "disable":
+				case "default": {
+					need(words, 2, cmd + " PACKAGE COMPONENT_CLASS");
+					ATLPackageStore.Record r = installed(words.get(0));
+					String cls = words.get(1).startsWith(".") ? r.packageName + words.get(1) : words.get(1);
+					ATLPackageStore.setComponentState(r.packageName, cls, cmd.equals("enable") ? 1 : cmd.equals("disable") ? 2 : 0);
+					ATLLauncherEntry.refresh(r.packageName);
+					System.out.println("Success: " + r.packageName + "/" + cls + " -> " + cmd);
+					return 0;
+				}
+				case "permissions":
+					need(words, 1, "permissions PACKAGE");
+					return ATLPermissions.shellList(installed(words.get(0)));
+				case "grant":
+				case "revoke":
+				case "reset-permission": {
+					need(words, 2, cmd + " PACKAGE PERMISSION");
+					ATLPackageStore.Record r = installed(words.get(0));
+					ATLPermissions.set(r.packageName, words.get(1),
+					                   cmd.equals("grant") ? ATLPermissions.GRANTED : cmd.equals("revoke") ? ATLPermissions.DENIED : ATLPermissions.UNSET);
+					System.out.println("Success: " + r.packageName + " " + words.get(1) + " -> " + cmd);
+					return 0;
+				}
+				case "migrate-data": {
+					need(words, 1, "migrate-data PACKAGE [DIR]");
+					System.out.println(ATLPackageStore.migrateData(words.get(0), words.size() > 1 ? new File(words.get(1)) : null));
+					return 0;
+				}
+				default:
+					System.err.println("unknown command '" + cmd + "'\n" + HELP);
+					return 2;
+			}
+		} catch (ATLPackageStore.InstallException e) {
+			System.out.println("Failure [" + e.getMessage() + "]");
+			return 1;
+		} catch (IllegalArgumentException e) {
+			System.err.println("usage: --pm " + e.getMessage());
+			return 2;
+		}
+	}
+
+	private static List<String> lines(String s) {
+		List<String> out = new ArrayList<>();
+		if (s != null) {
+			for (String l : s.split("\n")) {
+				if (!l.isEmpty())
+					out.add(l);
+			}
+		}
+		return out;
+	}
+
+	private static void need(List<String> words, int n, String usage) {
+		if (words.size() < n)
+			throw new IllegalArgumentException(usage);
+	}
+
+	private static ATLPackageStore.Record installed(String name) throws ATLPackageStore.InstallException {
+		ATLPackageStore.Record r = ATLPackageStore.get(name);
+		if (r == null)
+			throw new ATLPackageStore.InstallException(ATLPackageStore.STATUS_FAILURE, "NAME_NOT_FOUND", name + " is not installed");
+		return r;
+	}
+
+	private static int install(List<File> files, List<String> options, String installer) throws ATLPackageStore.InstallException {
+		int flags = 0;
+		if (options.contains("--allow-downgrade"))
+			flags |= ATLPackageStore.FLAG_ALLOW_DOWNGRADE;
+		if (options.contains("--inherit"))
+			flags |= ATLPackageStore.FLAG_INHERIT_EXISTING;
+		if (options.contains("--no-launcher"))
+			flags |= ATLPackageStore.FLAG_NO_LAUNCHER;
+		ATLPackageStore.Record old = files.isEmpty() ? null : ATLPackageStore.get(ATLPackageStore.inspect(files.get(0)).packageName);
+		ATLPackageStore.Record r = ATLPackageStore.install(files, installer != null ? installer : "cli", flags);
+		System.out.println("Success: " + r.packageName + " " + r.versionCode + (old != null ? " (replaces " + old.versionCode + ", data kept)" : " (new)"));
+		for (String l : ATLPackageStore.describeLines(r))
+			System.out.println("  " + l);
+		String[] data = ATLPackageStore.dataDir(r.packageName).list();
+		if (old == null && (data == null || data.length == 0)) {
+			List<File> legacy = ATLPackageStore.legacyDataCandidates(r);
+			if (legacy.size() == 1)
+				System.out.println("  " + ATLPackageStore.migrateData(r.packageName, null));
+			else if (legacy.size() > 1)
+				System.out.println("  data of the older layout found in " + legacy + ": ambiguous, nothing was moved (--pm migrate-data --pm " + r.packageName + " --pm DIR)");
+		}
+		return 0;
+	}
+
+	private static int info(List<String> words, List<File> files) throws ATLPackageStore.InstallException {
+		if (files.isEmpty()) {
+			need(words, 1, "info PACKAGE | info FILE...");
+			for (String l : ATLPackageStore.describeLines(installed(words.get(0))))
+				System.out.println(l);
+			return 0;
+		}
+		for (File f : files) {
+			ATLPackageStore.ApkInfo a = ATLPackageStore.inspect(f);
+			System.out.println("file:         " + f);
+			System.out.println("package:      " + a.packageName);
+			System.out.println("version:      " + a.versionCode + (a.versionName != null ? " (" + a.versionName + ")" : ""));
+			System.out.println("split:        " + (a.split != null ? a.split : "- (base APK)"));
+			if (a.isSplitRequired || a.requiredSplitTypes.length > 0)
+				System.out.println("needs splits: yes" + (a.requiredSplitTypes.length > 0 ? " " + java.util.Arrays.toString(a.requiredSplitTypes) : ""));
+			System.out.println("signature:    scheme v" + a.signature.scheme);
+			for (byte[] c : a.signature.signers)
+				System.out.println("signer:       " + ATLApkVerifier.sha256Hex(c));
+			for (byte[] c : a.signature.pastSigners)
+				System.out.println("past signer:  " + ATLApkVerifier.sha256Hex(c));
+			System.out.println("ABIs:         " + (a.abis.isEmpty() ? "none (no native code)" : a.abis.toString()));
+			try {
+				System.out.println("sha256:       " + ATLPackageStore.fileSha256(f));
+				if (a.split == null) {
+					ATLPackageStore.Parsed p = ATLPackageStore.parse(f.getPath(), f.getPath());
+					System.out.println("minSdk:       " + p.pkg.applicationInfo.minSdkVersion);
+					System.out.println("targetSdk:    " + p.pkg.applicationInfo.targetSdkVersion);
+				}
+			} catch (IOException e) {
+				System.out.println("manifest:     " + e.getMessage());
+			}
+			ATLPackageStore.Record r = ATLPackageStore.get(a.packageName);
+			System.out.println("installed:    " + (r != null ? String.valueOf(r.versionCode) : "no"));
+			System.out.println();
+		}
+		return 0;
+	}
+
+	private static int components(ATLPackageStore.Record r) throws ATLPackageStore.InstallException {
+		ATLPackageStore.Parsed p;
+		try {
+			p = ATLPackageStore.parse(r.baseApk().getPath(), r.codePath());
+		} catch (IOException e) {
+			throw new ATLPackageStore.InstallException(ATLPackageStore.STATUS_FAILURE, "PARSE_FAILED", e.getMessage());
+		}
+		Map<String, Integer> states = ATLPackageStore.getComponentStates(r.packageName);
+		Map<String, String> rows = new TreeMap<>();
+		collect(rows, "activity", p.pkg.activities, states);
+		collect(rows, "receiver", p.pkg.receivers, states);
+		collect(rows, "service", p.pkg.services, states);
+		collect(rows, "provider", p.pkg.providers, states);
+		for (String row : rows.values())
+			System.out.println(row);
+		return 0;
+	}
+
+	private static void collect(Map<String, String> rows, String kind, List<? extends PackageParser.Component<?>> list, Map<String, Integer> states) {
+		for (PackageParser.Component<?> c : list) {
+			android.content.pm.ComponentInfo info = ATLPackageStore.componentInfo(c);
+			if (info == null)
+				continue;
+			Integer s = states.get(c.className);
+			String state = s == null || s == 0 ? "default(" + (info.enabled ? "enabled" : "disabled") + ")" : s == 1 ? "enabled" : "disabled";
+			rows.put(kind + c.className, kind + "\t" + c.className + "\t" + state + "\t" + (info.exported ? "exported" : "private"));
+		}
+	}
+}
