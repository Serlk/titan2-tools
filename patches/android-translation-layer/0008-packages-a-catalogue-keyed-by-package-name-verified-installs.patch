+void activity_close_all(void);
+
+/*
+ * Actions carried by the package's own notifications: (key, intent). The key is a secret of the
+ * package (NotificationManager), so these may reach components that are not exported, which a
+ * request from another package (the plain start/send actions above) may not.
+ */
+#define OWN_INTENT_G_VARIANT_TYPE_STRING "(sv)"
+
+static jobject own_intent(JNIEnv *env, GVariant *parameter)
+{
+	const char *key;
+	GVariant *inner;
+	jobject intent = NULL;
+
+	g_variant_get(parameter, "(&sv)", &key, &inner);
+	if (J__NotificationManager__atl_check_action_key(env, _JSTRING(key)))
+		intent = intent_deserialize(env, inner);
+	else
+		fprintf(stderr, "notification action with a wrong key ignored\n");
 	if ((*env)->ExceptionCheck(env)) {
 		(*env)->ExceptionDescribe(env);
+		(*env)->ExceptionClear(env);
+		intent = NULL;
 	}
+	g_variant_unref(inner);
+	return intent;
+}
+
+static void action_own_activity(GSimpleAction *action, GVariant *parameter, gpointer user_data)
+{
+	JNIEnv *env = get_jni_env();
+	jobject intent = own_intent(env, parameter);
+	if (!intent)
+		return;
+	jobject context = _GET_STATIC_OBJ_FIELD(_CACHED_CLASS(Context), "this_application", "Landroid/app/Application;");
+	J__Context__startActivity(env, context, intent);
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionDescribe(env);
+	/* a tap on a notification brings the application to the front, also when it had no window yet */
+	g_application_activate(g_application_get_default());
+}
+
+static void action_own_service(GSimpleAction *action, GVariant *parameter, gpointer user_data)
+{
+	JNIEnv *env = get_jni_env();
+	jobject intent = own_intent(env, parameter);
+	if (!intent)
+		return;
+	jobject context = _GET_STATIC_OBJ_FIELD(_CACHED_CLASS(Context), "this_application", "Landroid/app/Application;");
+	J__Context__startService(env, context, intent);
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionDescribe(env);
+}
+
+static void action_own_broadcast(GSimpleAction *action, GVariant *parameter, gpointer user_data)
+{
+	JNIEnv *env = get_jni_env();
+	jobject intent = own_intent(env, parameter);
+	if (!intent)
+		return;
+	jobject context = _GET_STATIC_OBJ_FIELD(_CACHED_CLASS(Context), "this_application", "Landroid/app/Application;");
+	J__Context__sendBroadcast(env, context, intent);
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionDescribe(env);
+}
+
+/* asked to stop from outside (`atl-pm stop`): end activities, then leave the main loop even if the process had no window */
+static void action_quit(GSimpleAction *action, GVariant *parameter, gpointer user_data)
+{
+	activity_close_all();
+	g_application_quit(g_application_get_default());
 }
 
