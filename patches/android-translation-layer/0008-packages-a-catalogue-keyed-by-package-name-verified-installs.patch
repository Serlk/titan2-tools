diff --git a/src/api-impl/android/accounts/AccountManager.java b/src/api-impl/android/accounts/AccountManager.java
index 98b4bad..5caf0d6 100644
--- a/src/api-impl/android/accounts/AccountManager.java
+++ b/src/api-impl/android/accounts/AccountManager.java
@@ -45,7 +45,87 @@ public class AccountManager {
 		return getAccountsByType(null);
 	}
 
-	public Account[] getAccountsByType(String type) {
+	public static final int VISIBILITY_UNDEFINED = 0;
+	public static final int VISIBILITY_USER_MANAGED_NOT_VISIBLE = 4;
+	private static final String AUTHENTICATOR_ACTION = "android.accounts.AccountAuthenticator";
+	private static final int ATTR_ACCOUNT_TYPE = 0x0101028f;
+
+	private static String atl_caller() {
+		return android.atl.ATLLoadedApp.getPrimaryApplication().pkg.packageName;
+	}
+
+	private static final Map<String, java.util.Set<String>> atl_authenticator_types = new HashMap<>();
+
+	/** the account types a package is the authenticator of: declared by its authenticator services */
+	private static java.util.Set<String> atl_types_of(String packageName) {
+		synchronized (atl_authenticator_types) {
+			java.util.Set<String> types = atl_authenticator_types.get(packageName);
+			if (types != null)
+				return types;
+			types = new java.util.HashSet<>();
+			android.content.pm.PackageParser.Package pkg = android.atl.ATLLoadedAppManager.getPackageFromPackageName(packageName);
+			android.atl.ATLLoadedApp app = android.atl.ATLLoadedAppManager.peekAppFromPackageName(packageName);
+			if (pkg != null && app != null) {
+				for (android.content.pm.PackageParser.Service service : pkg.services) {
+					if (service.intents == null || service.metaData == null)
+						continue;
+					boolean authenticator = false;
+					for (android.content.pm.PackageParser.IntentInfo filter : service.intents)
+						authenticator |= filter.hasAction(AUTHENTICATOR_ACTION);
+					int xml = service.metaData.getInt(AUTHENTICATOR_ACTION, 0);
