diff --git a/src/api-impl-jni/content/android_atl_ATLLauncherEntry.c b/src/api-impl-jni/content/android_atl_ATLLauncherEntry.c
new file mode 100644
index 0000000..25f8bf8
--- /dev/null
+++ b/src/api-impl-jni/content/android_atl_ATLLauncherEntry.c
@@ -0,0 +1,36 @@
+#include <cairo-svg.h>
+#include <gtk/gtk.h>
+
+#include "../defines.h"
+#include "../util.h"
+
+#include "../generated_headers/android_atl_ATLLauncherEntry.h"
+
+/* Draw a paintable (an icon that is not a plain bitmap: adaptive, vector, layered) into an SVG file. */
+JNIEXPORT jboolean JNICALL Java_android_atl_ATLLauncherEntry_native_1render_1svg(JNIEnv *env, jclass this, jlong paintable_ptr, jstring path_jstr, jint size)
+{
+	GdkPaintable *paintable = GDK_PAINTABLE(_PTR(paintable_ptr));
+	const char *path = (*env)->GetStringUTFChars(env, path_jstr, NULL);
+	jboolean ok = JNI_FALSE;
+
+	/* vector drawables normally draw through a cached texture, which cairo cannot record */
+	_SET_STATIC_BOOL_FIELD(_CACHED_CLASS(VectorDrawable), "direct_draw_override", true);
+
+	GtkSnapshot *snapshot = gtk_snapshot_new();
+	gdk_paintable_snapshot(paintable, snapshot, size, size);
+	GskRenderNode *node = gtk_snapshot_free_to_node(snapshot);
+	if (node) {
+		cairo_surface_t *surface = cairo_svg_surface_create(path, size, size);
+		cairo_t *cr = cairo_create(surface);
+		gsk_render_node_draw(node, cr);
+		gsk_render_node_unref(node);
+		cairo_destroy(cr);
+		cairo_surface_finish(surface);
+		ok = cairo_surface_status(surface) == CAIRO_STATUS_SUCCESS;
+		cairo_surface_destroy(surface);
+	}
+
+	_SET_STATIC_BOOL_FIELD(_CACHED_CLASS(VectorDrawable), "direct_draw_override", false);
+	(*env)->ReleaseStringUTFChars(env, path_jstr, path);
+	return ok;
+}
