+static int android_key_code(JNIEnv *env, guint keyval, guint hardware_keycode)
+{
+	switch (keyval) {
+		case GDK_KEY_Shift_L:
+			return KEYCODE_SHIFT_LEFT;
+		case GDK_KEY_Shift_R:
+			return KEYCODE_SHIFT_RIGHT;
+		case GDK_KEY_Alt_L:
+			return KEYCODE_ALT_LEFT;
+		case GDK_KEY_Alt_R:
+		case GDK_KEY_ISO_Level3_Shift:
+			return KEYCODE_ALT_RIGHT;
+		case GDK_KEY_Control_L:
+			return KEYCODE_CTRL_LEFT;
+		case GDK_KEY_Control_R:
+			return KEYCODE_CTRL_RIGHT;
+		case GDK_KEY_Super_L:
+		case GDK_KEY_Meta_L:
+			return KEYCODE_META_LEFT;
+		case GDK_KEY_Super_R:
+		case GDK_KEY_Meta_R:
+			return KEYCODE_META_RIGHT;
+		case GDK_KEY_Caps_Lock:
+			return KEYCODE_CAPS_LOCK;
+		case GDK_KEY_Back:
+			return KEYCODE_BACK;
+		case GDK_KEY_Menu:
+			return KEYCODE_MENU;
+	}
+	/* on Wayland and X11 the hardware key code is the Linux input code plus 8 */
+	if (hardware_keycode > 8) {
