diff --git a/src/api-impl/android/atl/ATLExternalStart.java b/src/api-impl/android/atl/ATLExternalStart.java
new file mode 100644
index 0000000..048a030
--- /dev/null
+++ b/src/api-impl/android/atl/ATLExternalStart.java
@@ -0,0 +1,121 @@
+package android.atl;
+
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.PackageParser;
+import android.util.Slog;
+
+/**
+ * Starting an activity of another installed package. Every package runs in a process of its own,
+ * so the request is handed to that package: to its running process, or to a process the session
+ * bus starts for it (the activation file the catalogue wrote), or, without one, to a new
+ * `--package` start. The intent travels with its action, component, data and those extras that
+ * can be carried (strings and parcelables).
+ *
+ * The caller's side checks what the caller may do: the target must be installed, enabled and
+ * exported, and the caller must hold the permission the activity asks for. The target's side
+ * checks again that the component is exported.
+ */
+public final class ATLExternalStart {
+	private static final String TAG = "ATLExternalStart";
+
+	private ATLExternalStart() {}
+
+	private static native void nativeStartExternalActivity(Intent intent, String packageName, String launchCommand);
+
+	/** the activity of `pkg` an intent means: by component, else the best match of the filters; null if none */
+	public static PackageParser.Activity resolve(PackageParser.Package pkg, Intent intent) {
+		ComponentName component = intent.getComponent();
+		if (component != null) {
+			for (PackageParser.Activity activity : pkg.activities) {
+				if (activity.className.equals(component.getClassName()))
+					return activity;
+			}
+			return null;
+		}
+		PackageParser.Activity found = null;
+		int best = 0;
+		for (PackageParser.Activity activity : pkg.activities) {
+			if (activity.intents == null || !activity.info.enabled)
+				continue;
+			for (PackageParser.IntentInfo filter : activity.intents) {
+				int score = filter.match(intent.getAction(), intent.getType(), intent.getScheme(), intent.getData(), intent.getCategories(), TAG);
+				if (score > best) {
+					best = score;
+					found = activity;
+				}
+			}
+		}
+		return found;
+	}
+
+	/** the activity a start from the launcher shows: the first enabled one with MAIN and LAUNCHER */
+	public static PackageParser.Activity launcherActivity(PackageParser.Package pkg) {
+		for (PackageParser.Activity activity : pkg.activities) {
+			if (!activity.info.enabled || activity.intents == null)
+				continue;
+			for (PackageParser.IntentInfo filter : activity.intents) {
+				if (filter.hasAction(Intent.ACTION_MAIN) && filter.hasCategory(Intent.CATEGORY_LAUNCHER))
+					return activity;
+			}
+		}
+		return null;
+	}
+
+	/**
+	 * If the intent names another package, start its activity there and return true. Returns false
+	 * for an intent that stays in this process.
+	 *
+	 * @throws ActivityNotFoundException the package is not installed, or has no such activity, or
+	 *         the activity is disabled or not exported
+	 * @throws SecurityException the caller lacks the permission the activity requires
+	 */
+	public static boolean startActivity(ATLLoadedApp caller, Intent intent) {
+		String target = intent.getComponent() != null ? intent.getComponent().getPackageName() : intent.getPackage();
+		if (target == null || target.equals(caller.pkg.packageName) || "android".equals(target) || "atl".equals(target)
+		    || ATLLoadedAppManager.runsInThisProcess(target))
+			return false;
+
+		PackageParser.Package pkg = ATLPackageStore.get(target) != null ? ATLLoadedAppManager.getPackageFromPackageName(target) : null;
+		if (pkg == null)
+			throw new ActivityNotFoundException("No Activity found to handle " + intent + ": package " + target + " is not installed");
+		PackageParser.Activity activity = resolve(pkg, intent);
+		if (activity == null || !activity.info.enabled)
+			throw new ActivityNotFoundException("No Activity found to handle " + intent + " in " + target);
+		if (!activity.info.exported)
+			throw new ActivityNotFoundException("Unable to start " + target + "/" + activity.className + " from " + caller.pkg.packageName + ": the activity is not exported");
+		if (activity.info.permission != null && !ATLPermissions.holds(caller.pkg, activity.info.permission, false))
+			throw new SecurityException("Permission Denial: starting " + intent + " from " + caller.pkg.packageName + " requires " + activity.info.permission);
+
+		Intent out = new Intent(intent);
+		out.setComponent(new ComponentName(target, activity.className));
+		out.setPackage(target);
+		Slog.i(TAG, caller.pkg.packageName + " starts " + target + "/" + activity.className + " in its own process");
+		nativeStartExternalActivity(out, target, ATLLauncherEntry.launchCommandFor(target));
+		return true;
+	}
+
+	/**
+	 * A start request that arrived from another package, seen from the target's side:
+	 * 0 refuse it, 1 start the activity it names, 2 it is the launcher start: show the application
+	 * as a start from the launcher would.
+	 */
+	public static int incomingKind(Intent intent) {
+		PackageParser.Package pkg = ATLLoadedApp.getPrimaryApplication().pkg;
+		PackageParser.Activity activity = resolve(pkg, intent);
+		if (activity == null) {
+			Slog.w(TAG, "request from another package: no activity for " + intent);
+			return 0;
+		}
+		if (!activity.info.enabled || !activity.info.exported || activity.info.permission != null) {
+			Slog.w(TAG, "request from another package refused: " + pkg.packageName + "/" + activity.className
+			                + (!activity.info.enabled ? " is disabled" : !activity.info.exported ? " is not exported" : " requires " + activity.info.permission));
+			return 0;
+		}
+		// a start that carries data or extras is a request to that activity, not just "show the application"
+		boolean plain = intent.getData() == null && (intent.getAction() == null || Intent.ACTION_MAIN.equals(intent.getAction()))
+		                && (intent.getExtras() == null || intent.getExtras().isEmpty());
+		return plain && activity == launcherActivity(pkg) ? 2 : 1;
+	}
+}
