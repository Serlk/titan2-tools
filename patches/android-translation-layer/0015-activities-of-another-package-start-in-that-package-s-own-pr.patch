new file mode 100644
index 0000000..e31b85c
--- /dev/null
+++ b/src/api-impl-jni/content/android_atl_ATLExternalStart.c
@@ -0,0 +1,110 @@
+#include <gio/gio.h>
+
+#include "../defines.h"
+#include "../util.h"
+
+#include "../generated_headers/android_atl_ATLExternalStart.h"
+
+/*
+ * Hand an activity start to another package. The session bus is asked to start the package's
+ * process if it is not running (the activation file written at installation); the request then
+ * goes to the "startActivity" action of that process. A package the bus cannot start (no
+ * activation file: its name is not a valid bus name, or the file is missing) is started directly;
+ * such a start can only carry the data URI.
+ */
+struct external_start {
+	char *package;
+	char *command;
+	char *uri;
+	GVariant *intent;
+};
+
+static void external_start_free(struct external_start *s)
+{
+	g_free(s->package);
+	g_free(s->command);
+	g_free(s->uri);
+	g_variant_unref(s->intent);
+	g_free(s);
+}
+
+static void started_by_name(GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	struct external_start *s = user_data;
+	GDBusConnection *connection = G_DBUS_CONNECTION(source);
+	GError *error = NULL;
+	GVariant *reply = g_dbus_connection_call_finish(connection, result, &error);
+
+	if (reply)
+		g_variant_unref(reply);
+	if (error && g_error_matches(error, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN)) {
+		GPtrArray *argv = g_ptr_array_new();
+		g_ptr_array_add(argv, s->command);
+		g_ptr_array_add(argv, "--package");
+		g_ptr_array_add(argv, s->package);
+		if (s->uri && *s->uri) {
+			g_ptr_array_add(argv, "--uri");
+			g_ptr_array_add(argv, s->uri);
+		}
+		g_ptr_array_add(argv, NULL);
+		GError *spawn_error = NULL;
+		if (!g_spawn_async(NULL, (char **)argv->pdata, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &spawn_error)) {
+			fprintf(stderr, "cannot start %s: %s\n", s->package, spawn_error->message);
+			g_error_free(spawn_error);
+		}
+		g_ptr_array_free(argv, TRUE);
+	} else {
+		/* running, started, or still starting: the bus holds the call until the name is taken */
+		if (error)
+			fprintf(stderr, "starting %s over the session bus: %s (sending the request anyway)\n", s->package, error->message);
+		char *object_path = g_strdup_printf("/%s", s->package);
+		g_strdelimit(object_path, ".", '/');
+		g_strdelimit(object_path, "-", '_');
+		GActionGroup *action_group = G_ACTION_GROUP(g_dbus_action_group_get(connection, s->package, object_path));
+		g_action_group_activate_action(action_group, "startActivity", s->intent);
+		g_object_unref(action_group);
+		g_free(object_path);
+	}
+	g_clear_error(&error);
+	external_start_free(s);
+}
+
+JNIEXPORT void JNICALL Java_android_atl_ATLExternalStart_nativeStartExternalActivity(JNIEnv *env, jclass this, jobject intent, jstring package_jstr, jstring command_jstr)
+{
+	GDBusConnection *connection = g_bus_get_sync(G_BUS_TYPE_SESSION, NULL, NULL);
+	struct external_start *s = g_new0(struct external_start, 1);
+	const char *package = (*env)->GetStringUTFChars(env, package_jstr, NULL);
+	const char *command = (*env)->GetStringUTFChars(env, command_jstr, NULL);
+	jstring data_jstr = J__Intent__getDataString(env, intent);
+
+	s->package = g_strdup(package);
+	s->command = g_strdup(command);
+	if (data_jstr) {
+		const char *data = (*env)->GetStringUTFChars(env, data_jstr, NULL);
+		s->uri = g_strdup(data);
+		(*env)->ReleaseStringUTFChars(env, data_jstr, data);
+	}
+	s->intent = g_variant_ref_sink(intent_serialize(env, intent));
+	(*env)->ReleaseStringUTFChars(env, package_jstr, package);
+	(*env)->ReleaseStringUTFChars(env, command_jstr, command);
+
+	if (!connection || !g_dbus_is_name(s->package)) {
+		/* no bus, or a package name that cannot be a bus name: start it directly */
+		GError *error = g_error_new_literal(G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN, "no bus name");
+		char *argv[] = {s->command, "--package", s->package, (s->uri && *s->uri) ? "--uri" : NULL, s->uri, NULL};
+		GError *spawn_error = NULL;
+		if (!g_spawn_async(NULL, argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &spawn_error)) {
+			fprintf(stderr, "cannot start %s: %s\n", s->package, spawn_error->message);
+			g_error_free(spawn_error);
+		}
+		g_error_free(error);
+		external_start_free(s);
+		if (connection)
+			g_object_unref(connection);
+		return;
+	}
+	g_dbus_connection_call(connection, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
+	                       "StartServiceByName", g_variant_new("(su)", s->package, 0), G_VARIANT_TYPE("(u)"),
+	                       G_DBUS_CALL_FLAGS_NONE, 120000, NULL, started_by_name, s);
+	g_object_unref(connection);
+}
