From: serlk <22211586+Serlk@users.noreply.github.com>
Subject: [PATCH] main: hardware Back key acts like the header bar back button

Phones with a hardware keyboard (Unihertz Titan 2) report KEY_BACK, which
GTK delivers as GDK_KEY_Back (XF86Back). map_key_code() passes unknown
keyvals through unchanged, so the app never sees a KEYCODE_BACK and the
only way back is the header bar button. Add a global-scope shortcut on the
window that activates the back button; while the button is insensitive
(no activity to go back to) the key is not consumed.

SPDX-License-Identifier: GPL-3.0-only
---
--- a/src/main-executable/main.c
+++ b/src/main-executable/main.c
@@ -256,6 +256,16 @@
 	g_regex_unref(regex);
 }
 
+static gboolean on_back_key(GtkWidget *widget, GVariant *args, gpointer user_data)
+{
+	/* same as clicking the header bar back button: does nothing while it is insensitive */
+	GtkWidget *back_button = GTK_WIDGET(user_data);
+
+	if (!gtk_widget_is_sensitive(back_button))
+		return FALSE;
+	return gtk_widget_activate(back_button);
+}
+
 /* Drag and drop callback to simulate ACTION_SEND intents */
 static gboolean on_drop(GtkDropTarget *target, const GValue *value, double x, double y, gpointer user_data)
 {
@@ -654,6 +664,14 @@
 
 	gtk_header_bar_pack_start(GTK_HEADER_BAR(header_bar), back_button);
 	gtk_window_set_titlebar(GTK_WINDOW(window), header_bar);
+	/* hardware Back key (KEY_BACK -> XF86Back, e.g. on phone keyboards) acts like the back button */
+	GtkEventController *back_key = gtk_shortcut_controller_new();
+	gtk_shortcut_controller_set_scope(GTK_SHORTCUT_CONTROLLER(back_key), GTK_SHORTCUT_SCOPE_GLOBAL);
+	gtk_event_controller_set_propagation_phase(back_key, GTK_PHASE_CAPTURE);
+	gtk_shortcut_controller_add_shortcut(GTK_SHORTCUT_CONTROLLER(back_key),
+		gtk_shortcut_new(gtk_keyval_trigger_new(GDK_KEY_Back, 0), gtk_callback_action_new(on_back_key, back_button, NULL)));
+	gtk_widget_add_controller(window, back_key);
+
 	GtkDropTarget *drop_target = gtk_drop_target_new(G_TYPE_STRING, GDK_ACTION_COPY);
 	g_signal_connect(drop_target, "drop", G_CALLBACK(on_drop), NULL);
 	gtk_widget_add_controller(window, GTK_EVENT_CONTROLLER(drop_target));
