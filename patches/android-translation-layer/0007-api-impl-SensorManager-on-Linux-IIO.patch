-gboolean on_accel_data(struct accel_callback_data *d)
-{
-	JNIEnv *env;
-	(*d->jvm)->GetEnv(d->jvm, (void **)&env, JNI_VERSION_1_6);
-
-	char *x_str;
-	char *y_str;
