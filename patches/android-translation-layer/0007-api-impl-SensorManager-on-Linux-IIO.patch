+		if (I != null) {
+			double normE = Math.sqrt(ex * ex + ey * ey + ez * ez);
+			float c = 1, s = 0;
+			if (normE > 0) {
+				c = (float)((ex * mx + ey * my + ez * mz) / normE);
+				s = (float)((ex * ax + ey * ay + ez * az) / normE);
+			}
+			setMatrix(I, 1, 0, 0, 0, c, s, 0, -s, c);
+		}
+		return true;
+	}
+
+	private static void setMatrix(float[] M, float a, float b, float c, float d, float e, float f, float g, float h, float i) {
+		if (M.length == 9) {
+			M[0] = a; M[1] = b; M[2] = c;
+			M[3] = d; M[4] = e; M[5] = f;
+			M[6] = g; M[7] = h; M[8] = i;
+		} else if (M.length == 16) {
+			M[0] = a; M[1] = b; M[2] = c; M[3] = 0;
+			M[4] = d; M[5] = e; M[6] = f; M[7] = 0;
+			M[8] = g; M[9] = h; M[10] = i; M[11] = 0;
+			M[12] = 0; M[13] = 0; M[14] = 0; M[15] = 1;
+		}
+	}
+
+	private static float at(float[] M, int row, int col) {
+		return M.length == 16 ? M[row * 4 + col] : M[row * 3 + col];
+	}
+
+	/* R -> azimuth (around -z), pitch (around x), roll (around y), radians */
+	public static float[] getOrientation(float[] R, float[] values) {
+		values[0] = (float)Math.atan2(at(R, 0, 1), at(R, 1, 1));
+		values[1] = (float)Math.asin(-at(R, 2, 1));
+		values[2] = (float)Math.atan2(-at(R, 2, 0), at(R, 2, 2));
+		return values;
+	}
+
+	public static float getInclination(float[] I) {
+		return (float)Math.atan2(at(I, 1, 2), at(I, 1, 1));
+	}
+
+	/* altitude in m from the pressure p (hPa) and the sea-level pressure p0 (hPa) */
+	public static float getAltitude(float p0, float p) {
+		return (float)(44330.0 * (1.0 - Math.pow(p / p0, 1.0 / 5.255)));
+	}
+
+	public static boolean remapCoordinateSystem(float[] inR, int X, int Y, float[] outR) {
+		if (inR == outR || inR == null || outR == null)
+			return false;
+		if ((X & 0x7C) != 0 || (Y & 0x7C) != 0)
+			return false;
+		int xi = (X & 3) - 1, yi = (Y & 3) - 1;
+		if (xi < 0 || yi < 0 || xi == yi)
+			return false;
+		if (inR.length != outR.length || (inR.length != 9 && inR.length != 16))
+			return false;
+		int zi = 3 - xi - yi;
+		float sx = (X & 0x80) != 0 ? -1 : 1;
+		float sy = (Y & 0x80) != 0 ? -1 : 1;
+		/* X/Y name the new axes that the original x/y axes coincide with; the original z goes
+		 * to the remaining axis, with the sign that keeps the system right-handed */
+		float sz = sx * sy * (((xi + 1) % 3 == yi) ? 1 : -1);
+		int[] dst = {xi, yi, zi};
+		float[] sign = {sx, sy, sz};
+		int n = inR.length == 16 ? 4 : 3;
+		for (int row = 0; row < 3; row++) {
+			for (int col = 0; col < 3; col++)
+				outR[row * n + dst[col]] = sign[col] * inR[row * n + col];
+		}
+		if (n == 4) {
+			outR[3] = outR[7] = outR[11] = outR[12] = outR[13] = outR[14] = 0;
+			outR[15] = 1;
+		}
+		return true;
+	}
+
+	/* rotation vector (x, y, z[, w]) -> rotation matrix */
+	public static void getRotationMatrixFromVector(float[] R, float[] rotationVector) {
+		float[] q = new float[4];
+		getQuaternionFromVector(q, rotationVector);
+		float w = q[0], x = q[1], y = q[2], z = q[3];
+		setMatrix(R,
+		          1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w),
+		          2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w),
+		          2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y));
+	}
+
+	/* rotation vector -> quaternion (w, x, y, z) */
+	public static void getQuaternionFromVector(float[] Q, float[] rv) {
+		float x = rv[0], y = rv[1], z = rv[2];
+		float w;
+		if (rv.length >= 4) {
+			w = rv[3];
+		} else {
+			double t = 1 - x * x - y * y - z * z;
+			w = t > 0 ? (float)Math.sqrt(t) : 0;
+		}
+		Q[0] = w;
+		Q[1] = x;
+		Q[2] = y;
+		Q[3] = z;
 	}
 }
