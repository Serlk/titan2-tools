-struct iio_accel_files *get_iio_accel_files(void)
-{
-	GError *error = NULL;
-	const gchar *iio_device_path;
-	bool found_accelerometer = false;
-
-	GDir *iio_dir = g_dir_open("/sys/bus/iio/devices", 0, &error);
-	if (!iio_dir) {
-		g_log(NULL, G_LOG_LEVEL_WARNING, "cannot register accelerometer listener: cannot open /sys/bus/iio/devices (error: %s)", error->message);
-		return NULL;
-	}
-
-	struct iio_accel_files *iio_accel_files = malloc(sizeof(struct iio_accel_files));
-	iio_accel_files->in_accel_x_raw = g_string_new(NULL);
-	iio_accel_files->in_accel_y_raw = g_string_new(NULL);
-	iio_accel_files->in_accel_z_raw = g_string_new(NULL);
-	iio_accel_files->in_accel_scale = g_string_new(NULL);
-	iio_accel_files->in_mount_matrix = g_string_new(NULL);
-
-	while ((iio_device_path = g_dir_read_name(iio_dir))) {
-		g_string_printf(iio_accel_files->in_accel_x_raw, "/sys/bus/iio/devices/%s/in_accel_x_raw", iio_device_path);
-		g_string_printf(iio_accel_files->in_accel_y_raw, "/sys/bus/iio/devices/%s/in_accel_y_raw", iio_device_path);
-		g_string_printf(iio_accel_files->in_accel_z_raw, "/sys/bus/iio/devices/%s/in_accel_z_raw", iio_device_path);
-		g_string_printf(iio_accel_files->in_accel_scale, "/sys/bus/iio/devices/%s/in_accel_scale", iio_device_path);
-		g_string_printf(iio_accel_files->in_mount_matrix, "/sys/bus/iio/devices/%s/in_mount_matrix", iio_device_path);
-		if (g_file_test(iio_accel_files->in_accel_x_raw->str, G_FILE_TEST_IS_REGULAR)
-		    && g_file_test(iio_accel_files->in_accel_y_raw->str, G_FILE_TEST_IS_REGULAR)
-		    && g_file_test(iio_accel_files->in_accel_z_raw->str, G_FILE_TEST_IS_REGULAR)
-		    && g_file_test(iio_accel_files->in_accel_scale->str, G_FILE_TEST_IS_REGULAR)
-		    && g_file_test(iio_accel_files->in_mount_matrix->str, G_FILE_TEST_IS_REGULAR)) {
-			found_accelerometer = true;
-			break;
-		}
-	}
-
-	g_dir_close(iio_dir);
-
-	if (!found_accelerometer) {
-		g_log(NULL, G_LOG_LEVEL_WARNING, "cannot register accelerometer listener: haven't found an iio accelerometer");
-		g_string_free(iio_accel_files->in_accel_x_raw, true);
-		g_string_free(iio_accel_files->in_accel_y_raw, true);
-		g_string_free(iio_accel_files->in_accel_z_raw, true);
-		g_string_free(iio_accel_files->in_accel_scale, true);
-		g_string_free(iio_accel_files->in_mount_matrix, true);
-		free(iio_accel_files);
-		return NULL;
-	}
-
-	return iio_accel_files;
-}
-
-JNIEXPORT void JNICALL Java_android_hardware_SensorManager_register_1accelerometer_1listener_1native(JNIEnv *env, jobject this, jobject listener, jobject sensor, jint sampling_period)
-{
-	JavaVM *jvm;
-	(*env)->GetJavaVM(env, &jvm);
-
-	struct iio_accel_files *iio_accel_files = get_iio_accel_files();
-	if (!iio_accel_files)
-		return;
-
-	struct accel_callback_data *callback_data = malloc(sizeof(struct accel_callback_data));
-	callback_data->jvm = jvm;
-	callback_data->listener = _REF(listener);
-	callback_data->listener_class = _REF(_CLASS(callback_data->listener));
-	callback_data->sensor = _REF(sensor);
-	callback_data->iio_accel_files = iio_accel_files;
-	callback_data->matrix = get_mount_matrix(iio_accel_files->in_mount_matrix->str);
-
-	/* FIXME: too short of a sampling period can lock up the process */
-	g_timeout_add(MAX(10, sampling_period), G_SOURCE_FUNC(on_accel_data), callback_data);
-}
diff --git a/src/api-impl/android/hardware/IioSensors.java b/src/api-impl/android/hardware/IioSensors.java
new file mode 100644
index 0000000..88e58f4
--- /dev/null
+++ b/src/api-impl/android/hardware/IioSensors.java
@@ -0,0 +1,488 @@
+package android.hardware;
+
+import android.os.Handler;
+import android.os.SystemClock;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+/*
+ * Sensors on the Linux Industrial I/O subsystem (sysfs, /sys/bus/iio/devices, or $ATL_IIO_ROOT).
+ *
+ * Every IIO device is checked for the channels of the supported sensor types (accelerometer,
+ * gyroscope, magnetometer, light, proximity); devices named hub-accel, hub-gyro, hub-magn,
+ * hub-light and hub-prox (the Titan 2 sensor hub bridge) come first, so they are the default
+ * sensors, any other IIO device with the same channels is a fallback.
+ *
+ * While at least one listener is registered for a sensor, a thread of its own polls the sysfs
+ * values (reading a value can block: the hub enables a sensor on the first read and waits for a
+ * sample), converts them to Android units and posts SensorEvents to each listener's Handler.
+ *
+ * Units: IIO gives m/s^2, rad/s, gauss, lux after (raw + offset) * scale; Android wants m/s^2,
+ * rad/s, uT, lux. The accelerometer sign: Linux IIO (and iio-sensor-proxy) see an upright phone
+ * as y < 0, Android as y = +g, so accelerometer values are negated (ATL_IIO_ACCEL_SIGN=1 keeps
+ * them). A mount matrix (in_<type>_mount_matrix or in_mount_matrix) is applied first.
+ * Proximity: Android reports a distance in cm. hub-prox gives closeness 0..5 (5 - distance cm);
+ * for other devices raw > in_proximity_nearlevel is "near" (0 cm), else "far" (maxRange).
+ */
+final class IioSensors {
+	static final String DEFAULT_ROOT = "/sys/bus/iio/devices";
+	static final String VENDOR = "Linux IIO";
+
+	/* fastest polling, microseconds */
+	static final int MIN_DELAY_US = 10000;
+	static final int MIN_DELAY_ON_CHANGE_US = 50000;
+	static final int MAX_DELAY_US = 1000000;
+
+	static final int KIND_VECTOR = 0;
+	static final int KIND_LIGHT = 1;
+	static final int KIND_PROX_HUB = 2;
+	static final int KIND_PROX_NEAR = 3;
+
+	static final float HUB_PROX_MAX_CM = 5f;
+
+	private static List<Channel> channels;
+
+	static synchronized List<Channel> getChannels() {
+		if (channels == null)
+			channels = discover();
+		return channels;
+	}
+
+	static Channel find(Sensor sensor) {
+		for (Channel ch : getChannels()) {
+			if (ch.sensor == sensor)
+				return ch;
+		}
+		return null;
+	}
+
+	static String root() {
+		String root = System.getenv("ATL_IIO_ROOT");
+		return (root == null || root.isEmpty()) ? DEFAULT_ROOT : root;
+	}
+
+	/* --- discovery --- */
+
+	private static final class Candidate {
+		File dir;
+		String name;
+		int type;
+		int kind;
+		String prefix; /* "in_accel", "in_illuminance0", ... */
+		boolean processed; /* *_input instead of *_raw */
+	}
+
+	private static List<Channel> discover() {
+		List<Candidate> found = new ArrayList<Candidate>();
+		File rootDir = new File(root());
+		File[] devices = rootDir.listFiles();
+		if (devices == null) {
+			System.out.println("SensorManager: no IIO devices in " + rootDir);
+			return Collections.<Channel>emptyList();
+		}
+		Arrays.sort(devices);
+		for (File dir : devices) {
+			if (!dir.isDirectory())
+				continue;
+			String name = readString(new File(dir, "name"));
+			if (name == null)
+				name = dir.getName();
+			addVector(found, dir, name, Sensor.TYPE_ACCELEROMETER, "in_accel");
+			addVector(found, dir, name, Sensor.TYPE_GYROSCOPE, "in_anglvel");
+			addVector(found, dir, name, Sensor.TYPE_MAGNETIC_FIELD, "in_magn");
+			addScalar(found, dir, name, Sensor.TYPE_LIGHT, KIND_LIGHT, new String[] {"in_illuminance", "in_illuminance0"});
+			addScalar(found, dir, name, Sensor.TYPE_PROXIMITY, "hub-prox".equals(name) ? KIND_PROX_HUB : KIND_PROX_NEAR,
+			          new String[] {"in_proximity", "in_proximity0"});
+		}
+		/* hub-* devices first (stable sort: then in directory order) */
+		Collections.sort(found, new Comparator<Candidate>() {
+			@Override
+			public int compare(Candidate a, Candidate b) {
+				return (b.name.startsWith("hub-") ? 1 : 0) - (a.name.startsWith("hub-") ? 1 : 0);
+			}
+		});
+		List<Channel> result = new ArrayList<Channel>();
+		for (Candidate c : found) {
+			Channel ch = new Channel(c, result.size() + 1);
+			result.add(ch);
+			System.out.println("SensorManager: " + ch.sensor + " <- " + c.dir);
+		}
+		return Collections.unmodifiableList(result);
+	}
+
+	private static void addVector(List<Candidate> found, File dir, String name, int type, String prefix) {
+		for (String axis : new String[] {"x", "y", "z"}) {
+			if (!new File(dir, prefix + "_" + axis + "_raw").isFile())
+				return;
+		}
+		Candidate c = new Candidate();
+		c.dir = dir;
+		c.name = name;
+		c.type = type;
+		c.kind = KIND_VECTOR;
+		c.prefix = prefix;
+		found.add(c);
+	}
+
+	private static void addScalar(List<Candidate> found, File dir, String name, int type, int kind, String[] prefixes) {
+		for (String prefix : prefixes) {
+			boolean input = new File(dir, prefix + "_input").isFile();
+			if (input || new File(dir, prefix + "_raw").isFile()) {
+				Candidate c = new Candidate();
+				c.dir = dir;
+				c.name = name;
+				c.type = type;
+				c.kind = kind;
+				c.prefix = prefix;
+				c.processed = input;
+				found.add(c);
+				return;
+			}
+		}
+	}
+
+	/* --- sysfs --- */
+
+	static String readString(File file) {
+		try (FileInputStream in = new FileInputStream(file)) {
+			byte[] buf = new byte[256];
+			int n = 0, r;
+			while (n < buf.length && (r = in.read(buf, n, buf.length - n)) > 0)
+				n += r;
+			return new String(buf, 0, n, "UTF-8").trim();
+		} catch (IOException e) {
+			return null;
+		}
+	}
+
+	static double readDouble(File file, double def) {
+		String s = readString(file);
+		if (s == null || s.isEmpty())
+			return def;
+		try {
+			return Double.parseDouble(s);
+		} catch (NumberFormatException e) {
+			return def;
+		}
+	}
+
+	/* "a, b, c; d, e, f; g, h, i" -> row-major 3x3, null for identity or garbage */
+	static float[] parseMountMatrix(String s) {
+		if (s == null)
+			return null;
+		String[] parts = s.split("[;,]");
+		if (parts.length != 9)
+			return null;
+		float[] m = new float[9];
+		try {
+			for (int i = 0; i < 9; i++)
+				m[i] = Float.parseFloat(parts[i].trim());
+		} catch (NumberFormatException e) {
+			return null;
+		}
+		if (Arrays.equals(m, new float[] {1, 0, 0, 0, 1, 0, 0, 0, 1}))
+			return null;
+		return m;
+	}
+
+	/* --- one sensor --- */
+
+	static final class Channel {
+		final Sensor sensor;
+		final int kind;
+		final boolean onChange;
+		private final File[] value;
+		private final double[] scale;
+		private final double[] offset;
+		private final float[] matrix;
+		private final double unit;
+		private final double nearLevel;
+
+		final List<Registration> registrations = new ArrayList<Registration>();
+		Poller poller;
+
+		Channel(Candidate c, int handle) {
+			kind = c.kind;
+			onChange = c.type == Sensor.TYPE_LIGHT || c.type == Sensor.TYPE_PROXIMITY;
+			String suffix = c.processed ? "_input" : "_raw";
+			if (kind == KIND_VECTOR) {
+				String[] axes = {"x", "y", "z"};
+				value = new File[3];
+				scale = new double[3];
+				offset = new double[3];
+				for (int i = 0; i < 3; i++) {
+					value[i] = new File(c.dir, c.prefix + "_" + axes[i] + "_raw");
+					scale[i] = readDouble(new File(c.dir, c.prefix + "_" + axes[i] + "_scale"),
+					                      readDouble(new File(c.dir, c.prefix + "_scale"), 1));
+					offset[i] = readDouble(new File(c.dir, c.prefix + "_" + axes[i] + "_offset"),
+					                       readDouble(new File(c.dir, c.prefix + "_offset"), 0));
+				}
+				String mm = readString(new File(c.dir, c.prefix + "_mount_matrix"));
+				if (mm == null)
+					mm = readString(new File(c.dir, "in_mount_matrix"));
+				matrix = parseMountMatrix(mm);
+			} else {
+				value = new File[] {new File(c.dir, c.prefix + suffix)};
+				scale = new double[] {c.processed ? 1 : readDouble(new File(c.dir, c.prefix + "_scale"), 1)};
+				offset = new double[] {c.processed ? 0 : readDouble(new File(c.dir, c.prefix + "_offset"), 0)};
+				matrix = null;
+			}
+			nearLevel = readDouble(new File(c.dir, c.prefix + "_nearlevel"), 0);
+
+			double u = 1;
+			float maxRange, resolution;
+			String what;
+			switch (c.type) {
+				case Sensor.TYPE_ACCELEROMETER:
+					u = "1".equals(System.getenv("ATL_IIO_ACCEL_SIGN")) ? 1 : -1;
+					maxRange = 8 * 9.80665f;
+					what = "Accelerometer";
+					break;
+				case Sensor.TYPE_GYROSCOPE:
+					maxRange = 34.906586f; /* 2000 deg/s */
+					what = "Gyroscope";
+					break;
+				case Sensor.TYPE_MAGNETIC_FIELD:
+					u = 100; /* gauss -> uT */
+					maxRange = 4900f;
+					what = "Magnetic field";
+					break;
+				case Sensor.TYPE_LIGHT:
+					maxRange = 65535f;
+					what = "Light";
+					break;
+				default: /* proximity */
+					maxRange = HUB_PROX_MAX_CM;
+					what = "Proximity";
+					break;
+			}
+			unit = u;
+			if (kind == KIND_PROX_HUB || kind == KIND_PROX_NEAR)
+				resolution = 1f;
+			else
+				resolution = (float)Math.abs(scale[0] * unit);
+			sensor = new Sensor(c.type, c.name + " " + what, VENDOR, handle, maxRange, resolution, 0.25f,
+			                    onChange ? 0 : MIN_DELAY_US, onChange ? 0 : MAX_DELAY_US,
+			                    c.type == Sensor.TYPE_PROXIMITY);
+		}
+
+		/* one sample in Android units, or null if the device could not be read */
+		float[] read() {
+			double[] v = new double[value.length];
+			for (int i = 0; i < value.length; i++) {
+				String s = readString(value[i]);
+				if (s == null || s.isEmpty())
+					return null;
+				try {
+					v[i] = (Double.parseDouble(s) + offset[i]) * scale[i];
+				} catch (NumberFormatException e) {
+					return null;
+				}
+			}
+			float[] out = new float[3];
+			switch (kind) {
+				case KIND_VECTOR:
+					if (matrix != null) {
+						double[] t = new double[3];
+						for (int r = 0; r < 3; r++)
+							t[r] = matrix[3 * r] * v[0] + matrix[3 * r + 1] * v[1] + matrix[3 * r + 2] * v[2];
+						v = t;
+					}
+					for (int i = 0; i < 3; i++)
