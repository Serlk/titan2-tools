+					break;
+				case KIND_PROX_HUB:
+					out[0] = (float)Math.min(HUB_PROX_MAX_CM, Math.max(0, HUB_PROX_MAX_CM - v[0]));
+					break;
+				default:
+					out[0] = v[0] > nearLevel ? 0f : sensor.getMaximumRange();
+					break;
+			}
+			return out;
+		}
+
+		long pollPeriodNs() {
+			long p = Long.MAX_VALUE;
+			for (Registration r : registrations)
+				p = Math.min(p, r.periodNs);
+			long min = (onChange ? MIN_DELAY_ON_CHANGE_US : MIN_DELAY_US) * 1000L;
+			return Math.max(min, Math.min(p, MAX_DELAY_US * 1000L));
+		}
+	}
+
+	/* --- listeners --- */
+
+	static final class Registration implements Runnable {
+		final SensorEventListener listener;
+		final Channel channel;
+		final Handler handler;
+		final long periodNs;
+		long lastNs;
+		boolean gotFirst;
+		/* guarded by this */
+		private float[] pendingValues;
+		private long pendingTimestamp;
+		private boolean posted;
+		private boolean active = true;
+		/* handler thread only */
+		private boolean accuracySent;
+
+		Registration(SensorEventListener listener, Channel channel, Handler handler, int samplingPeriodUs) {
+			this.listener = listener;
+			this.channel = channel;
+			this.handler = handler;
+			this.periodNs = samplingPeriodUs * 1000L;
+		}
+
+		/* poller thread: hand over a sample; at most one is queued, newer ones replace it */
+		void offer(float[] values, long timestamp) {
+			synchronized (this) {
+				if (!active)
+					return;
+				pendingValues = values;
+				pendingTimestamp = timestamp;
+				if (posted)
+					return;
+				posted = true;
+			}
+			if (!handler.post(this)) {
+				synchronized (this) {
+					posted = false;
+				}
+			}
+		}
+
+		synchronized void cancel() {
+			active = false;
+			pendingValues = null;
+		}
+
+		/* handler thread */
+		@Override
+		public void run() {
+			float[] values;
+			long timestamp;
+			synchronized (this) {
+				posted = false;
+				if (!active || pendingValues == null)
+					return;
+				values = pendingValues;
+				timestamp = pendingTimestamp;
+				pendingValues = null;
+			}
+			if (!accuracySent) {
+				accuracySent = true;
+				try {
+					listener.onAccuracyChanged(channel.sensor, SensorManager.SENSOR_STATUS_ACCURACY_HIGH);
+				} catch (AbstractMethodError e) {
+					/* listener built without onAccuracyChanged */
+				}
+			}
+			listener.onSensorChanged(new SensorEvent(values, channel.sensor, SensorManager.SENSOR_STATUS_ACCURACY_HIGH, timestamp));
+		}
+	}
+
+	static void register(Registration r) {
+		Channel ch = r.channel;
+		synchronized (ch) {
+			ch.registrations.add(r);
+			if (ch.poller == null) {
+				ch.poller = new Poller(ch);
+				ch.poller.start();
+			} else {
+				ch.poller.interrupt(); /* pick up a shorter period now */
+			}
+		}
+	}
+
+	/* sensor == null: all sensors of this listener */
+	static void unregister(SensorEventListener listener, Sensor sensor) {
+		for (Channel ch : getChannels()) {
+			if (sensor != null && ch.sensor != sensor)
+				continue;
+			synchronized (ch) {
+				for (int i = ch.registrations.size() - 1; i >= 0; i--) {
+					Registration r = ch.registrations.get(i);
+					if (r.listener == listener) {
+						r.cancel();
+						ch.registrations.remove(i);
+					}
+				}
+				if (ch.registrations.isEmpty() && ch.poller != null)
+					ch.poller.interrupt();
+			}
+		}
+	}
+
+	static boolean isRegistered(SensorEventListener listener, Channel ch) {
+		synchronized (ch) {
+			for (Registration r : ch.registrations) {
+				if (r.listener == listener)
+					return true;
+			}
+		}
+		return false;
+	}
+
+	static final class Poller extends Thread {
+		private final Channel ch;
+		private float[] last;
+
+		Poller(Channel ch) {
+			super("atl-sensor-" + ch.sensor.getHandle());
+			this.ch = ch;
+			setDaemon(true);
+		}
+
+		@Override
+		public void run() {
+			while (true) {
+				Registration[] regs;
+				long period;
+				synchronized (ch) {
+					if (ch.registrations.isEmpty()) {
+						ch.poller = null;
+						return;
+					}
+					regs = ch.registrations.toArray(new Registration[0]);
+					period = ch.pollPeriodNs();
+				}
+				long start = SystemClock.elapsedRealtimeNanos();
+				float[] v = ch.read(); /* may block (the hub enables the sensor on first read) */
+				long now = SystemClock.elapsedRealtimeNanos();
+				if (v != null) {
+					boolean changed = last == null || !Arrays.equals(v, last);
+					last = v;
+					for (Registration r : regs) {
+						if (ch.onChange) {
+							if (r.gotFirst && !changed)
+								continue;
+						} else if (r.gotFirst && now - r.lastNs < r.periodNs - period / 2) {
+							continue;
+						}
+						r.gotFirst = true;
+						r.lastNs = now;
+						r.offer(v.clone(), now);
+					}
+				}
+				long sleepNs = start + period - SystemClock.elapsedRealtimeNanos();
+				if (sleepNs > 0) {
+					try {
+						Thread.sleep(sleepNs / 1000000, (int)(sleepNs % 1000000));
+					} catch (InterruptedException e) {
+						/* registrations changed */
+					}
+				}
+			}
+		}
+	}
+}
