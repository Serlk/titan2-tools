@@ -59,6 +60,10 @@ public class WolfSSLAuthStore {
     private SecureRandom sr = null;
     private String alias = null;
     private SessionStore<Integer, WolfSSLImplementSSLSession> store;
+    /* The session table is read and changed by every connection of every
+     * thread that uses this context; all access to it holds this lock.
+     * Lock order: storeLock, then a session, then its WolfSSLSession. */
+    private final Object storeLock = new Object();
     private WolfSSLSessionContext serverCtx = null;
     private WolfSSLSessionContext clientCtx = null;
 
@@ -269,8 +274,12 @@ public class WolfSSLAuthStore {
                     new SessionStore<Integer, WolfSSLImplementSSLSession>(sz);
 
         //@TODO check for side server/client, currently a resize is for all
-        store.putAll(newStore);
-        store = newStore;
+        synchronized (storeLock) {
+            /* keep the cached sessions (the newest ones, if the table
+             * shrinks: the table drops its eldest entry when it is full) */
+            newStore.putAll(store);
+            store = newStore;
+        }
     }
 
     /** Returns either an existing session to use or creates a new session. Can
@@ -301,21 +310,28 @@ public class WolfSSLAuthStore {
 
         /* check if is in table */
         toHash = host.concat(Integer.toString(port));
-        ses = store.get(toHash.hashCode());
-        if (ses != null && !ses.isValid())
-            ses = null;
-        if (ses == null) {
-            WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
-                    "session not found in cache table, creating new");
-            /* not found in stored sessions create a new one */
-            ses = new WolfSSLImplementSSLSession(ssl, port, host, this);
-            ses.setValid(true); /* new sessions marked as valid */
-            ses.setPseudoSessionId(Integer.toString(ssl.hashCode()).getBytes());
-        }
-        else {
-            WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
-                    "session found in cache, trying to resume");
-            ses.resume(ssl);
+        synchronized (storeLock) {
+            ses = store.get(toHash.hashCode());
+            if (ses != null && !ses.isValid()) {
+                /* an invalidated session is of no use to anyone: drop it,
+                 * so that the next good session of this peer can be stored */
+                store.remove(toHash.hashCode());
+                ses = null;
+            }
+            if (ses == null) {
+                WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
+                        "session not found in cache table, creating new");
+                /* not found in stored sessions create a new one */
+                ses = new WolfSSLImplementSSLSession(ssl, port, host, this);
+                ses.setValid(true); /* new sessions marked as valid */
+                ses.setPseudoSessionId(
+                        Integer.toString(ssl.hashCode()).getBytes());
+            }
+            else {
+                WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
+                        "session found in cache, trying to resume");
+                ses.resume(ssl);
+            }
         }
         return ses;
     }
@@ -357,13 +373,16 @@ public class WolfSSLAuthStore {
                 hashCode = Arrays.toString(session.getId()).hashCode();
         }
 
-        if (hashCode != 0 && store.containsKey(hashCode) != true) {
-            WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
-                    "stored session in cache table (host: " +
-                    session.getPeerHost() + ", port: " +
-                    session.getPeerPort() + ") " +
-                    "hashCode = " + hashCode + " side = " + session.getSide());
+        synchronized (storeLock) {
+            if (hashCode != 0 && store.containsKey(hashCode) != true) {
+                WolfSSLDebug.log(getClass(), WolfSSLDebug.INFO,
+                        "stored session in cache table (host: " +
+                        session.getPeerHost() + ", port: " +
+                        session.getPeerPort() + ") " +
+                        "hashCode = " + hashCode + " side = " +
+                        session.getSide());
                 store.put(hashCode, session);
+            }
         }
         return WolfSSL.SSL_SUCCESS;
     }
@@ -377,10 +396,13 @@ public class WolfSSLAuthStore {
     protected Enumeration<byte[]> getAllIDs(int side) {
         List<byte[]> ret = new ArrayList<byte[]>();
 
-        for (Object obj : store.values()) {
-            WolfSSLImplementSSLSession current = (WolfSSLImplementSSLSession)obj;
-            if (current.getSide() == side) {
-                ret.add(current.getId());
+        synchronized (storeLock) {
+            for (Object obj : store.values()) {
+                WolfSSLImplementSSLSession current =
+                    (WolfSSLImplementSSLSession)obj;
+                if (current.getSide() == side && current.isValid()) {
+                    ret.add(current.getId());
+                }
             }
         }
         return Collections.enumeration(ret);
@@ -396,12 +418,15 @@ public class WolfSSLAuthStore {
     protected WolfSSLImplementSSLSession getSession(byte[] ID, int side) {
         WolfSSLImplementSSLSession ret = null;
 
-        for (Object obj : store.values()) {
-            WolfSSLImplementSSLSession current = (WolfSSLImplementSSLSession)obj;
-            if (current.getSide() == side &&
-                    java.util.Arrays.equals(ID, current.getId())) {
-                ret = current;
-                break;
+        synchronized (storeLock) {
+            for (Object obj : store.values()) {
+                WolfSSLImplementSSLSession current =
+                    (WolfSSLImplementSSLSession)obj;
+                if (current.getSide() == side &&
+                        java.util.Arrays.equals(ID, current.getId())) {
+                    ret = current;
+                    break;
+                }
             }
         }
         return ret;
@@ -418,12 +443,18 @@ public class WolfSSLAuthStore {
         Date currentDate = new Date();
         long now = currentDate.getTime();
 
-        for (Object obj : store.values()) {
-            long diff;
-            WolfSSLImplementSSLSession current =
-                (WolfSSLImplementSSLSession)obj;
+        synchronized (storeLock) {
+            Iterator<WolfSSLImplementSSLSession> it =
+                store.values().iterator();
+
+            while (it.hasNext()) {
+                long diff;
+                WolfSSLImplementSSLSession current = it.next();
+
+                if (current.getSide() != side) {
+                    continue;
+                }
 
-            if (current.getSide() == side) {
                 /* difference in seconds */
                 diff = (now - current.creation.getTime()) / 1000;
 
@@ -435,6 +466,17 @@ public class WolfSSLAuthStore {
                 if (in > 0 && diff > in) {
                     current.invalidate();
                 }
+
+                if (!current.isValid()) {
+                    /* timed out or invalidated: it leaves the table and
+                     * its native session is not touched any more */
+                    it.remove();
+                    continue;
+                }
+
+                /* A session whose connection is closed has no live native
+                 * object; it keeps the value for when it is resumed, see
+                 * WolfSSLImplementSSLSession.setNativeTimeout(). */
                 current.setNativeTimeout(in);
             }
         }
diff --git a/external/wolfssljni/src/java/com/wolfssl/provider/jsse/WolfSSLImplementSSLSession.java b/external/wolfssljni/src/java/com/wolfssl/provider/jsse/WolfSSLImplementSSLSession.java
index e5eb1a9..c92bcdd 100644
--- a/external/wolfssljni/src/java/com/wolfssl/provider/jsse/WolfSSLImplementSSLSession.java
+++ b/external/wolfssljni/src/java/com/wolfssl/provider/jsse/WolfSSLImplementSSLSession.java
@@ -66,6 +66,13 @@ public class WolfSSLImplementSSLSession implements SSLSession {
     protected boolean fromTable = false;
 
     private long sesPtr = 0;
+    /* Timeout given while no live WOLFSSL object was attached to this
+     * session; applied when the session is attached to one again. */
+    private long pendingTimeout = 0;
+    private boolean timeoutPending = false;
+    /* Session ID as last read from the WOLFSSL object, for the time after
+     * that object has been freed. */
+    private byte[] lastId = null;
     private String nullCipher = "SSL_NULL_WITH_NULL_NULL";
     private String nullProtocol = "NONE";
 
@@ -140,15 +147,17 @@ public class WolfSSLImplementSSLSession implements SSLSession {
             /* use pseudo session ID if session tickets are being used */
             if (this.ssl.getVersion().equals("TLSv1.3") ||
                 this.ssl.sessionTicketsEnabled()) {
-                 return this.pseudoSessionID;
+                this.lastId = this.pseudoSessionID;
             }
             else {
-                return this.ssl.getSessionID();
+                this.lastId = this.ssl.getSessionID();
             }
         } catch (IllegalStateException | WolfSSLJNIException e) {
-            e.printStackTrace();
-            return null;
+            /* The connection this session came from is closed and its
+             * WOLFSSL object freed: a session waiting in the cache to be
+             * resumed keeps the ID it had. */
         }
+        return (this.lastId != null) ? this.lastId : new byte[0];
     }
 
     /**
@@ -533,6 +542,13 @@ public class WolfSSLImplementSSLSession implements SSLSession {
     protected synchronized void resume(WolfSSLSession in) {
         ssl = in;
         ssl.setSession(this.sesPtr);
+        if (this.timeoutPending) {
+            /* a timeout set while the session had no live WOLFSSL object */
+            if (ssl.setSessTimeoutIfActive(this.pendingTimeout) ==
+                    WolfSSL.SSL_SUCCESS) {
+                this.timeoutPending = false;
+            }
+        }
     }
 
 
@@ -541,6 +557,8 @@ public class WolfSSLImplementSSLSession implements SSLSession {
      */
     protected synchronized void setResume() {
         if (ssl != null) {
+            /* last chance to read the ID before the WOLFSSL object goes */
+            getId();
             this.sesPtr = ssl.getSession();
         }
     }
@@ -549,8 +567,20 @@ public class WolfSSLImplementSSLSession implements SSLSession {
      * Sets the native WOLFSSL_SESSION timeout
      * @param in timeout in seconds
      */
-    protected void setNativeTimeout(long in) {
-        ssl.setSessTimeout(in);
+    protected synchronized void setNativeTimeout(long in) {
+        /* A session stays in the cache after its connection was closed and
+         * the WOLFSSL object freed, so that a later connection can resume
+         * it. Such a session has no native object to take the timeout now:
+         * keep the value and apply it in resume(). The same holds if the
+         * object is freed by another thread while this runs. */
+        if (ssl == null ||
+            ssl.setSessTimeoutIfActive(in) != WolfSSL.SSL_SUCCESS) {
+            this.pendingTimeout = in;
+            this.timeoutPending = true;
+        }
+        else {
+            this.timeoutPending = false;
+        }
     }
 
 
