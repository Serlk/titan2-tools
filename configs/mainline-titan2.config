# Mainline (MT6878-Mainline 7.2, titan2 branch) for Titan 2 on top of arm64 defconfig.
# LK framebuffer via simpledrm + console
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# display kick: the panel is in DSI command mode, a frame is sent only when triggered; after
# every simpledrm update the driver does mutex0 EN + DSI START,
# and at probe it hides the OVL0 layer with the LK text (titan2-docs: docs/hardware)
CONFIG_DRM_MTK_CMDFB_KICK=y
# LK passes androidboot.* in the bootconfig appended to the initrd
CONFIG_BOOT_CONFIG=y
# log without UART: LK itself passes ramoops.mem_address=0x48090000 (shared with Android pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# watchdog that LK may leave enabled
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# LK boots Image.gz
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# power domains: SCPSYS MT6878 (mtk-pm-domains), syscon for bus protection/HWV
# (already =y in arm64 defconfig; set explicitly)
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_MFD_SYSCON=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
# SPMI/PMIC: PMIF bus (MT6878), MT6363/MT6369, power key
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6369=y
CONFIG_KEYBOARD_MTK_PMIC=y
# clocks: MT6878 CCF. The base controllers are bool, the multimedia ones
# are built in so the clocks exist before any module; first boot with clk_ignore_unused
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_COMMON_CLK_MT6878=y
CONFIG_COMMON_CLK_MT6878_CAMSYS=y
CONFIG_COMMON_CLK_MT6878_IMGSYS=y
CONFIG_COMMON_CLK_MT6878_MDPSYS=y
CONFIG_COMMON_CLK_MT6878_MMSYS=y
CONFIG_COMMON_CLK_MT6878_VCODEC=y
# USB gadget / initramfs (tools/initramfs): console on a PC without a display:
# configfs gadget NCM + ACM on SSUSB (mtu3, dr_mode=peripheral in the DT), dropbear and getty.
# All built in: the initramfs has no modules.
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_U_SERIAL=y
# virtual UDC, only for testing the initramfs in qemu (init ignores it without t2.udc=)
CONFIG_USB_DUMMY_HCD=y
# dropbear: pty, network
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_TMPFS=y
# /proc/sys/kernel/hotplug: the initramfs sets every new UFS block device read-only
CONFIG_UEVENT_HELPER=y
# input (titan2-docs: docs/hardware):
# keyboard is an AW9523B used as a matrix (own aw9523-keypad driver), touchscreen and keyboard
# touchpad are Synaptics RMI4 over I2C (F12 / F11), Func2 is gpio-keys. Built in: the initramfs has no modules.
CONFIG_I2C_MT65XX=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_AW9523=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F55=y
# charger (titan2-docs: docs/hardware):
# SH366100 fuel gauge via bq27xxx (read-only, no data flash writes),
# MT6375 core + charger. The DT nodes are disabled for now. Built in: the initramfs has no modules.
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_HDQ is not set
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_MT6375=y
# modem: stage 1, mtk_ccci only reads what LK prepared (memory reservations,
# ccci_tag_mem tags); it does not start the modem. The DT node is disabled.
# WWAN depends on GNSS (defconfig: m), otherwise WWAN=y does not stick
CONFIG_GNSS=y
CONFIG_WWAN=y
CONFIG_MTK_CCCI=y

# wifi: CONNINFRA, power and bus of CONNSYS
# (Wi-Fi/BT/GNSS/FM). Binds only to the consys node of mt6878-unihertz-titan2-wifi.dtb;
# with the normal DTB the driver does not load.
CONFIG_MTK_CONNINFRA=y
# typec: MT6375 ADC (IIO, VBUS/IBUS for the charger), MT6375 TCPC under TCPM
# (sink only, PD 5 V, no VBUS/VCONN out),
# mtu3 usb-role-switch. The tcpc DT node is disabled. Built in: the initramfs has no modules.
CONFIG_MEDIATEK_MT6375_ADC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y
# audio, stage 1: the MT6878 AFE platform
# driver (memif/IRQ/clocks, no BE DAI). The afe DT node is disabled.
# Built in: the initramfs has no modules.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT6878=y
# audio, stage 2: the MT6369 codec (an mtk-spmi-pmic cell), the
# FS199x amplifier (I2C6, fs-amp-lib), BE ADDA/I2S4 and the mt6878-titan2 machine. The sound
# and codec DT nodes are disabled (enabled by the -audio board file). Built in.
CONFIG_SND_SOC_MT6369=y
CONFIG_SND_SOC_FS199X=m
CONFIG_SND_SOC_MT6878_TITAN2=y
# netroot (scripts/netroot-serve.sh): rootfs over the network through
# USB-NCM from the PC, nothing is written to the UFS. Main path: NBD (ext4 image on the PC,
# busybox nbd-client in the initramfs); NFSv4 as a fallback (kernel client, mount without
# userspace helpers); overlayfs for the "ro image + tmpfs on top" variant (t2.root_ro). Built
# in: the initramfs has no modules.
CONFIG_BLK_DEV_NBD=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V4=y
CONFIG_ROOT_NFS=y
# suspend/idle: cpuidle through PSCI
# (PC mode, the stock idle states of mt6878.dtsi), SYST as the broadcast timer (systimer node,
# enabled only in the -idle board variant), s2idle as the sleep state (as in the stock firmware:
# ATF does the SPM sleep when all CPUs are in s2idle 0x020180ff). Already =y in arm64 defconfig,
# set explicitly; PM_DEBUG: /sys/power/pm_test and pm_debug_messages for the first checks.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_DT_IDLE_STATES=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_MTK_TIMER=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# cpufreq/thermal: MT6878 CPUFREQ HW
# (MCUPM does the DVFS, the kernel only picks a state from the firmware tables), the efuse copy
# from /chosen atag,devinfo (LVTS calibration), LVTS read-only (polling).
# Binds only to the nodes of mt6878-unihertz-titan2-dvfs.dtb (in the normal DTB
# performance/lvts are disabled). Critical trip -> orderly_poweroff, after 3 s an
# emergency poweroff if userspace did not manage. Built in: the initramfs has no modules.
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=3000
# gpu: Mali-G615 MC2 through panthor. Power and OPP
# are handled by GPUEB (started by BL31); the kernel sends it IPIs through the mailbox
# (MTK_GPUEB_MBOX) from the mtk-mfg-pmdomain power domain. Binds only to the nodes of
# mt6878-unihertz-titan2-gpu.dtb (in the normal DTB gpu/gpufreq/gpueb_mbox are disabled).
# panthor as a module: probe loads arm/mali/arch11.8/mali_csffw.bin (linux-firmware, non-free
# ARM firmware); a built-in driver would not wait for the root file system.
CONFIG_MTK_GPUEB_MBOX=y
CONFIG_MTK_MFG_PM_DOMAIN=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DRM_PANTHOR=m
# drm: mediatek-drm for the main display
# (A61QWERTY46, 1440x1440, DSI command mode). As a module, like mediatek-drm and DRM_MIPI_DSI in
# defconfig (PHY_MTK_MIPI_DSI=m there too). The mmsys/mutex/ovl/dsi/mipi-tx/panel nodes are
# enabled only in mt6878-unihertz-titan2-drm.dtb; by default (simplefb + kick) nothing binds.
# -drm takes the display over from LK (PLL, D-PHY timings, panel without reset); without the
# MT6878 MIPI-TX driver -drm does not come up and the screen keeps the LK picture.
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_PANEL_UNIHERTZ_TITAN2_MAIN=m
# wifi: MT7921 Wi-Fi core of CONNSYS on AXI (mt76 mt7921-soc, node /wifi in -wifi.dtb);
# MAC80211/CFG80211 and WLAN_VENDOR_MEDIATEK already come from arm64 defconfig
CONFIG_MT7921_SOC=m
# bt: the BGF core of CONNSYS, HCI through BEIF rings in EMI (btmtkbgf, node /bt@18800000 in -wifi.dtb);
# CONFIG_BT=m already from arm64 defconfig
CONFIG_BT_MTKBGF=m
# backlight/sleep: disp_pwm0 backlight through
# pwm-backlight (DT: 90 % duty cycle ceiling in &disp_pwm0, keep-boot-brightness), panel off
# with DCS 28/10 and on with 11/29 in mtk_cmdfb_kick on simpledrm DPMS (fb0/blank). Built in:
# kick is =y, so the backlight class is =y too. MT6685 RTC (SPMI SID 9): read-only time + wakealarm.
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_MFD_MT6685=y
CONFIG_RTC_DRV_MT6685=y

# Linux on the linux partition next to Android: read-only lock (block.ro_lock, tools/initramfs diskroot)
CONFIG_BLK_DEV_RO_LOCK=y
